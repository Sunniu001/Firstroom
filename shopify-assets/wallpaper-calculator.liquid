{% comment %}
  Wallpaper Calculator & Product Layout Block for Standalone Shopify.
  Replaces standard product info for a custom unified design matching Next.js.
{% endcomment %}

{%- assign is_wallpaper = false -%}
{%- if product.tags contains 'wallpaper' or product.type == 'Wallpaper' -%}
  {%- assign is_wallpaper = true -%}
{%- else -%}
  {%- for collection in product.collections -%}
    {%- if collection.handle contains 'wallpaper' -%}
      {%- assign is_wallpaper = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign is_wallpaper = false -%}
{%- if is_wallpaper -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign base_price = current_variant.price -%}
  {%- assign material_option = null -%}
  {%- for option in product.options_with_values -%}
    {%- assign downcase_name = option.name | downcase -%}
    {%- if downcase_name == 'material' -%}
      {%- assign material_option = option -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="fr-wp-product-layout" id="fr-wallpaper-calculator"
    data-base-price="{{ base_price }}"
    data-variant-id="{{ current_variant.id }}"
    data-product-id="{{ product.id }}">

    <!-- Title and Base Price -->
    <h1 class="fr-wp-title">{{ product.title }}</h1>
    <div class="fr-wp-base-price">
      <span class="fr-price-amount">{{ base_price | money_without_trailing_zeros }}</span>
      <span class="fr-price-unit">/sq.ft</span>
    </div>

    <!-- Dimensions Section -->
    <div class="fr-wp-section">
      <h3 class="fr-wp-subtitle">Enter Dimensions <span class="fr-title-hint">(Minimum Order: 25 Sq.Ft.)</span></h3>
      <div class="fr-dimensions-grid">
        <div class="fr-calc-group">
          <label class="fr-calc-label" for="fr-wp-height">Height (feet) <span class="fr-required">*</span></label>
          <input type="number" id="fr-wp-height" value="5" min="1" step="0.1" class="fr-calc-input">
        </div>
        <div class="fr-calc-group">
          <label class="fr-calc-label" for="fr-wp-width">Width (feet) <span class="fr-required">*</span></label>
          <input type="number" id="fr-wp-width" value="5" min="1" step="0.1" class="fr-calc-input">
        </div>
      </div>
      <div class="fr-area-summary">
        Total Area: <strong id="fr-wp-display-area">25.00</strong> sq.ft.
        <p id="fr-wp-error-text" class="fr-calc-error" style="display: none;">
          Minimum order is 25 sq.ft. Please increase dimensions.
        </p>
      </div>
    </div>

    <!-- Material Section -->
    {%- if material_option != null -%}
      <div class="fr-wp-section">
        <h3 class="fr-wp-subtitle">Material</h3>
        <div class="fr-material-grid" id="fr-wp-material-options">
          {%- for value in material_option.values -%}
            <button
              type="button"
              class="fr-material-btn {% if forloop.first %}selected{% endif %}"
              data-value="{{ value | escape }}"
            >
              {{ value }}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Total Price Display -->
    <div class="fr-wp-total-price-section">
      <span class="fr-total-label">Total:</span>
      <span class="fr-total-amount" id="fr-wp-total-price">
        {%- assign initial_total = base_price | times: 25 -%}
        {{ initial_total | money }}
      </span>
    </div>

    <!-- Action Buttons -->
    <div class="fr-wp-actions">
      <button type="button" class="fr-btn fr-btn-add-to-cart" id="fr-wp-add-to-cart">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        ADD TO CART
      </button>
      <button type="button" class="fr-btn fr-btn-wishlist">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        ADD TO WISHLIST
      </button>
    </div>

    <!-- Hidden material value store -->
    {%- if material_option != null -%}
      <input type="hidden" id="fr-wp-selected-material" value="{{ material_option.values.first | escape }}">
    {%- endif -%}

    <!-- Hidden data store for variants -->
    <script type="application/json" id="fr-wp-variants-json">
      {{ product.variants | json }}
    </script>
  </div>

  <style>
    .fr-wp-product-layout {
      font-family: inherit;
      color: #1a1a1a;
      max-width: 500px;
    }
    /* Constrain product image gallery height */
    .product-media-gallery,
    .product-media-gallery__list,
    .product-media-gallery__main,
    .product__media-wrapper,
    .product__media-list,
    .product__media,
    .media-gallery,
    [class*="media-gallery"],
    [class*="product-media"],
    .product-information__media,
    .product-information__media-wrapper {
      max-height: 78vh !important;
      overflow: hidden !important;
    }
    .product-media-gallery img,
    .product-media-gallery video,
    [class*="media-gallery"] img,
    [class*="media-gallery"] video,
    [class*="product-media"] img,
    [class*="product-media"] video {
      max-height: 78vh !important;
      object-fit: contain !important;
      width: 100% !important;
    }
    .fr-wp-title {
      font-family: "Playfair Display", serif;
      font-size: 1.75rem;
      font-weight: 500;
      margin: 0 0 0.4rem 0;
      line-height: 1.2;
      color: #1a1a1a;
    }
    .fr-wp-base-price {
      margin-bottom: 1.2rem;
      display: flex;
      align-items: baseline;
      gap: 5px;
    }
    .fr-price-amount {
      font-size: 1.4rem;
      color: #b02a2a;
      font-weight: 600;
    }
    .fr-price-unit {
      font-size: 0.9rem;
      color: #666;
    }
    .fr-wp-section {
      margin-bottom: 1.1rem;
    }
    .fr-wp-subtitle {
      font-size: 0.95rem;
      font-weight: 500;
      margin: 0 0 0.6rem 0;
      color: #1a1a1a;
      display: flex;
      align-items: baseline;
    }
    .fr-title-hint {
      font-size: 0.78rem;
      color: #888;
      font-weight: 400;
      margin-left: 8px;
    }
    .fr-dimensions-grid {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 0.6rem;
    }
    .fr-calc-group {
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .fr-calc-label {
      font-size: 0.85rem;
      color: #555;
      margin-bottom: 0.5rem;
    }
    .fr-required {
      color: #b02a2a;
    }
    .fr-calc-input {
      background: #f5f5f5;
      border: 1px solid #eee;
      padding: 0.6rem 0.9rem;
      border-radius: 4px;
      font-size: 0.95rem;
      color: #1a1a1a;
      width: 100%;
      outline: none;
      box-sizing: border-box;
    }
    .fr-calc-input:focus {
      border-color: #ccc;
    }
    .fr-area-summary {
      font-size: 0.9rem;
      color: #333;
    }
    .fr-calc-error {
      color: #b02a2a;
      font-size: 0.85rem;
      margin-top: 5px;
    }
    .fr-material-grid {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .fr-material-btn {
      background: #fff;
      border: 1px solid #ddd;
      padding: 0.8rem 1.2rem;
      font-size: 0.9rem;
      color: #333;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .fr-material-btn.selected {
      background: #1a1a1a;
      color: #fff;
      border-color: #1a1a1a;
    }
    .fr-wp-total-price-section {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 1rem;
      padding-top: 1rem;
      border-top: 1px solid #eee;
    }
    .fr-total-label {
      font-size: 1.2rem;
      font-weight: 500;
      color: #b02a2a;
    }
    .fr-total-amount {
      font-size: 1.6rem;
      font-weight: 600;
      color: #b02a2a;
    }
    .fr-wp-actions {
      display: flex;
      gap: 1rem;
    }
    .fr-btn {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 0.8rem;
      font-size: 0.85rem;
      font-weight: 600;
      border-radius: 4px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.2s;
    }
    .fr-btn-add-to-cart {
      background: #111;
      color: #fff;
      border: 1px solid #111;
    }
    .fr-btn-add-to-cart:hover { background: #333; }
    .fr-btn-wishlist {
      background: #fff;
      color: #333;
      border: 1px solid #ddd;
    }
    .fr-btn-wishlist:hover { border-color: #999; background: #f9f9f9; }
    .fr-btn:disabled,
    .fr-btn.disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const layout = document.getElementById('fr-wallpaper-calculator');
      if (!layout) return;

      const basePriceInCents = parseInt(layout.getAttribute('data-base-price'), 10) || 0;
      const defaultVariantId = parseInt(layout.getAttribute('data-variant-id'), 10);

      let variants = [];
      try {
        const variantsJsonEl = document.getElementById('fr-wp-variants-json');
        if (variantsJsonEl) {
          variants = JSON.parse(variantsJsonEl.textContent) || [];
        }
      } catch (e) {
        console.error('Failed to parse variants JSON', e);
      }

      const heightInput = document.getElementById('fr-wp-height');
      const widthInput = document.getElementById('fr-wp-width');
      const displayArea = document.getElementById('fr-wp-display-area');
      const errorText = document.getElementById('fr-wp-error-text');
      const totalAmountDisplay = document.getElementById('fr-wp-total-price');
      const addToCartBtn = document.getElementById('fr-wp-add-to-cart');
      const selectedMaterialInput = document.getElementById('fr-wp-selected-material');

      function formatMoney(cents) {
        return '₹' + (cents / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      // Get current variant — lookup using material option or fallback to URL / default
      function getCurrentVariant() {
        const material = selectedMaterialInput ? selectedMaterialInput.value : null;
        if (!material || variants.length === 0) {
          const urlParams = new URLSearchParams(window.location.search);
          const fromUrl = urlParams.get('variant');
          if (fromUrl) {
            const v = variants.find(x => x.id === parseInt(fromUrl, 10));
            if (v) return v;
          }
          const v = variants.find(x => x.id === defaultVariantId);
          if (v) return v;
          return { id: defaultVariantId, price: basePriceInCents };
        }

        const matched = variants.find(v => {
          return (v.option1 && v.option1.toLowerCase() === material.toLowerCase()) ||
                 (v.option2 && v.option2.toLowerCase() === material.toLowerCase()) ||
                 (v.option3 && v.option3.toLowerCase() === material.toLowerCase()) ||
                 (v.title && v.title.toLowerCase() === material.toLowerCase());
        });
        return matched || variants.find(x => x.id === defaultVariantId) || variants[0] || { id: defaultVariantId, price: basePriceInCents };
      }

      function updateCalculator() {
        const currentVariant = getCurrentVariant();
        const priceCents = currentVariant ? currentVariant.price : basePriceInCents;
        const height = parseFloat(heightInput.value) || 0;
        const width = parseFloat(widthInput.value) || 0;
        const area = height * width;
        displayArea.textContent = area.toFixed(2);
        const validArea = Math.max(area, 25);
        totalAmountDisplay.innerHTML = formatMoney(validArea * priceCents);
        if (area < 25) {
          errorText.style.display = 'block';
          addToCartBtn.disabled = true;
          addToCartBtn.classList.add('disabled');
        } else {
          errorText.style.display = 'none';
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove('disabled');
        }
      }

      // Add to Cart via Shopify AJAX Cart API (/cart/add.js)
      addToCartBtn.addEventListener('click', async function(e) {
        e.preventDefault();
        if (addToCartBtn.disabled) return;

        const currentVariant = getCurrentVariant();
        const variantId = currentVariant ? currentVariant.id : defaultVariantId;
        if (!variantId) {
          alert('Could not determine product variant. Please refresh and try again.');
          return;
        }

        const height = parseFloat(heightInput.value) || 0;
        const width = parseFloat(widthInput.value) || 0;
        const area = Math.max(Math.round(height * width), 25);
        const material = selectedMaterialInput ? selectedMaterialInput.value : null;
        const priceCents = currentVariant ? currentVariant.price : basePriceInCents;
        const properties = {
          'Height (ft)': height.toFixed(1),
          'Width (ft)': width.toFixed(1),
          'Area (sq.ft)': area.toFixed(1),
          '_areapro_area': area.toFixed(2),
          '_areapro_rate': (priceCents / 100).toFixed(2),
          '_areapro_enabled': "true"
        };
        if (material) properties['Material'] = material;

        const originalHTML = addToCartBtn.innerHTML;
        addToCartBtn.innerHTML = 'Adding...';
        addToCartBtn.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: 1, properties: properties })
          });
          const data = await response.json();

          if (response.ok) {
            addToCartBtn.innerHTML = '✓ Added!';
            addToCartBtn.style.background = '#2e7d32';
            addToCartBtn.style.borderColor = '#2e7d32';

            // Refresh cart count & try to open cart drawer
            fetch('/cart.js').then(r => r.json()).then(cart => {
              // Update count bubble if theme has one
              document.querySelectorAll('[data-cart-count], .cart-count, #cart-count').forEach(el => {
                el.textContent = cart.item_count;
              });
            });
            // Dispatch events some themes listen to
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { cart: data } }));

            setTimeout(() => {
              addToCartBtn.innerHTML = originalHTML;
              addToCartBtn.style.background = '';
              addToCartBtn.style.borderColor = '';
              addToCartBtn.disabled = false;
            }, 2500);
          } else {
            throw new Error(data.description || 'Failed to add to cart');
          }
        } catch (err) {
          addToCartBtn.innerHTML = originalHTML;
          addToCartBtn.disabled = false;
          alert('Error: ' + err.message);
        }
      });

      heightInput.addEventListener('input', updateCalculator);
      widthInput.addEventListener('input', updateCalculator);

      // Material buttons
      const materialSection = document.getElementById('fr-wp-material-options');
      if (materialSection) {
        materialSection.addEventListener('click', function(e) {
          const btn = e.target.closest('.fr-material-btn');
          if (!btn) return;
          materialSection.querySelectorAll('.fr-material-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          const val = btn.getAttribute('data-value');
          if (selectedMaterialInput) selectedMaterialInput.value = val;

          // Sync with native variant picker (only scoped to the product section)
          const mainSection = layout.closest('section') || document.querySelector('.product-information') || document;
          mainSection.querySelectorAll('input[type="radio"]').forEach(el => {
            if (el.value === val) { el.checked = true; el.dispatchEvent(new Event('change', { bubbles: true })); }
          });
          mainSection.querySelectorAll('select').forEach(el => {
            const opt = Array.from(el.options).find(o => o.value === val || o.text === val);
            if (opt) { el.value = opt.value; el.dispatchEvent(new Event('change', { bubbles: true })); }
          });

          // Sync URL variant param
          const currentVariant = getCurrentVariant();
          if (currentVariant) {
            const url = new URL(window.location.href);
            url.searchParams.set('variant', currentVariant.id);
            window.history.replaceState({}, '', url.toString());
          }

          updateCalculator();
        });
      }

      updateCalculator();
    });
  </script>
{%- endif -%}
