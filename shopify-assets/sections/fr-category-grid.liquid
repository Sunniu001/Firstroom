<section class="fr-category-grid" id="fr-category-{{ section.id }}">
  <h2 class="fr-category-grid__heading">{{ section.settings.heading }}</h2>

  <div class="fr-category-grid__row">
    {%- for block in section.blocks -%}
      {%- if block.settings.row == '1' or section.blocks.size <= 3 and forloop.index <= 3 -%}
        <a href="{{ block.settings.link }}" class="fr-category-grid__card" {{ block.shopify_attributes }}>
          <div class="fr-category-grid__img-wrapper">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.label }}"
                class="fr-category-grid__img"
                loading="lazy"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'fr-category-grid__img fr-category-grid__img--placeholder' }}
            {%- endif -%}
          </div>
          <span class="fr-category-grid__label">{{ block.settings.label }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- assign has_row2 = false -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.row == '2' -%}
      {%- assign has_row2 = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_row2 -%}
    <div class="fr-category-grid__row fr-category-grid__row--second">
      {%- for block in section.blocks -%}
        {%- if block.settings.row == '2' -%}
          <a href="{{ block.settings.link }}" class="fr-category-grid__card" {{ block.shopify_attributes }}>
            <div class="fr-category-grid__img-wrapper">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.label }}"
                  class="fr-category-grid__img"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'fr-category-grid__img fr-category-grid__img--placeholder' }}
              {%- endif -%}
            </div>
            <span class="fr-category-grid__label">{{ block.settings.label }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  #fr-category-{{ section.id }} {
    padding: 100px 2rem;
    background-color: #f4f4f4;
    text-align: center;
  }

  @media (max-width: 768px) {
    #fr-category-{{ section.id }} {
      padding: 40px 24px;
    }
  }

  .fr-category-grid__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 32px;
    font-weight: 400;
    color: #1a1a1a;
    margin-bottom: 40px;
  }

  @media (max-width: 768px) {
    .fr-category-grid__heading {
      font-size: 26px;
      margin-bottom: 30px;
    }
  }

  .fr-category-grid__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .fr-category-grid__row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .fr-category-grid__row--second {
    margin-top: 40px;
  }

  .fr-category-grid__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #1a1a1a;
  }

  .fr-category-grid__img-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    margin-bottom: 1rem;
    background-color: #e2e2e2;
  }

  .fr-category-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    display: block;
  }

  .fr-category-grid__img--placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  .fr-category-grid__card:hover .fr-category-grid__img {
    transform: scale(1.05);
  }

  .fr-category-grid__label {
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 0.975rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.5rem;
  }
</style>

{% schema %}
{
  "name": "FR Category Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Artful Accents For Homes Of Distinctive Taste"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "select",
          "id": "row",
          "label": "Row",
          "options": [
            { "value": "1", "label": "Row 1" },
            { "value": "2", "label": "Row 2" }
          ],
          "default": "1"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Category Label",
          "default": "WALLPAPER"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Category Grid",
      "blocks": [
        { "type": "category", "settings": { "row": "1", "label": "WALLPAPER" } },
        { "type": "category", "settings": { "row": "1", "label": "NAMEPLATE" } },
        { "type": "category", "settings": { "row": "1", "label": "DESK DECOR" } },
        { "type": "category", "settings": { "row": "2", "label": "DECALS" } },
        { "type": "category", "settings": { "row": "2", "label": "FRAMES" } },
        { "type": "category", "settings": { "row": "2", "label": "KIDS WALLPAPER" } }
      ]
    }
  ]
}
{% endschema %}
