<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <script>
      (function() {
        var path = window.location.pathname;
        if (path === '/account' || path === '/account/' || path.startsWith('/account/orders')) {
          window.location.replace('https://firstroom.in/pages/my-account#orders');
        }
        document.addEventListener('click', function(e) {
          var a = e.target.closest('a');
          if (a) {
            var href = a.getAttribute('href') || '';
            var text = (a.textContent || '').trim().toLowerCase();
            if (text === 'view account' || href === '/account' || href === '/account/' || href.includes('/account/orders') || (href.includes('shopify.com') && href.includes('/account'))) {
              e.preventDefault();
              window.location.href = 'https://firstroom.in/pages/my-account#orders';
            }
          }
        }, true);
      })();
    </script>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    <!-- Custom CSS Overrides for Header Icons spacing, sizing, and colors -->
    <style>
      /* Group icons closer */
      header-actions {
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
      }

      /* Reduce wrapper width visually to group icons without overriding hidden display states */
      .header-actions__action,
      .search-action,
      .header-actions__action .svg-wrapper,
      .search-action .svg-wrapper,
      .fr-header-avatar-container {
        width: 30px !important;
        height: 44px !important;
        padding: 0 !important;
        margin: 0 !important;
        position: relative !important;
      }

      /* Prevent any icon or badge clipping */
      .header-actions__action,
      .search-action,
      .header-actions__action .svg-wrapper,
      .search-action .svg-wrapper,
      .fr-header-avatar-container,
      cart-icon,
      .header-actions__cart-icon {
        overflow: visible !important;
      }

      /* Make the SVG icons themselves uniform size */
      .header-actions__action svg,
      .fr-header-avatar-btn svg {
        width: 18px !important;
        height: 18px !important;
      }
      .search-action svg {
        width: 19px !important;
        height: 19px !important;
      }

      /* Push the account icon further away to the right */
      .fr-header-avatar-container,
      .account-button {
        margin-left: 14px !important;
      }

      /* Resized and repositioned Cart count bubble */
      .cart-bubble {
        width: 15px !important;
        height: 15px !important;
        position: absolute !important;
        top: 6px !important;
        right: -3px !important;
        z-index: 10 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        overflow: visible !important;
      }
      /* Force Cart count bubble background to be red and disable mask clipping */
      .cart-bubble__background {
        background-color: #c2593f !important;
      }
      .header-actions__cart-icon.header-actions__cart-icon--has-cart svg {
        mask: none !important;
        -webkit-mask: none !important;
      }
      .cart-bubble__text {
        font-size: 9px !important;
        color: #fff !important;
        font-weight: 700 !important;
        line-height: 1 !important;
      }

      /* Resized and repositioned Wishlist count badge */
      .wishlist-count-badge {
        background-color: #c2593f !important;
        width: 15px !important;
        height: 15px !important;
        font-size: 9px !important;
        color: #fff !important;
        font-weight: 700 !important;
        top: 6px !important;
        right: -3px !important;
        position: absolute !important;
        border-radius: 50% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        line-height: 1 !important;
        overflow: visible !important;
      }

      /* ========================================== */
      /* Hide Old Theme Cart Drawer (Cart Pilot active) */
      /* ========================================== */
      #shopify-section-cart-drawer-section,
      #cart-drawer,
      #cart-drawer .theme-drawer__dialog,
      #cart-drawer + .theme-drawer__overlay,
      theme-drawer#cart-drawer,
      theme-drawer#cart-drawer::backdrop,
      cart-drawer-component {
        display: none !important;
        visibility: hidden !important;
        pointer-events: none !important;
        opacity: 0 !important;
        width: 0 !important;
        height: 0 !important;
        overflow: hidden !important;
      }

      /* ========================================== */
      /* Cart Page Custom Styles                    */
      /* ========================================== */
      .cart-page {
        margin-top: 24px !important;
      }
      .cart-page .cart-items__select {
        grid-area: checkbox !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
      }
      .cart-page .fr-cart-item-checkbox,
      .cart-page .fr-cart-select-all {
        appearance: checkbox !important;
        -webkit-appearance: checkbox !important;
        width: 16px !important;
        height: 16px !important;
        cursor: pointer !important;
        position: relative !important;
        z-index: 10 !important;
        pointer-events: auto !important;
      }
      .cart-page .cart-items__media {
        display: flex !important;
        align-items: center !important;
        gap: 12px !important;
        grid-area: media !important;
      }
      .cart-page thead.visually-hidden {
        position: static !important;
        width: auto !important;
        height: auto !important;
        overflow: visible !important;
        clip: auto !important;
        display: table-header-group !important;
      }
      .cart-page .cart-items__table thead tr {
        display: grid !important;
        grid-template-columns: 40px 100px 1fr 140px 120px !important;
        border-bottom: 1px solid #ebebeb !important;
        padding-bottom: 10px !important;
        margin-bottom: 16px !important;
      }
      .cart-page .cart-items__table thead th {
        font-size: 11px !important;
        font-weight: 600 !important;
        text-transform: uppercase !important;
        color: #666666 !important;
        text-align: left !important;
        display: block !important;
        min-height: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      .cart-page .cart-items__table thead th:last-child {
        text-align: right !important;
      }
      .cart-page .cart-items__table-row {
        display: grid !important;
        grid-template-columns: 40px 100px 1fr 140px 120px !important;
        grid-template-areas: 'checkbox media details quantity subtotal' !important;
        align-items: center !important;
        border-bottom: 1px solid #f0f0f0 !important;
        padding-bottom: 16px !important;
        margin-bottom: 16px !important;
        transition: opacity 0.2s ease !important;
      }
      .cart-page .cart-items__table-row.is-unchecked {
        opacity: 0.4 !important;
      }
      .cart-page tbody .cart-items__details {
        grid-area: details !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
        align-items: flex-start !important;
        gap: 8px !important;
        color: #333333 !important;
      }
      .cart-page tbody .cart-items__product-info,
      .cart-page tbody .cart-items__variants-wrapper {
        /* Reset any rogue grid properties */
      }
      .cart-page .cart-items__title {
        color: #c2593f !important;
        font-weight: 500 !important;
        font-size: 14.5px !important;
        text-decoration: none !important;
      }
      .cart-page .cart-items__title:hover {
        text-decoration: underline !important;
      }
      .cart-page tbody .cart-items__unit-price-wrapper {
        display: flex !important;
        align-items: center !important;
        font-size: 13.5px !important;
        font-weight: 500 !important;
        color: #333333 !important;
        margin-top: 4px !important;
      }
      .cart-page tbody .cart-items__quantity {
        grid-area: quantity !important;
        display: flex !important;
        align-items: center !important;
        justify-content: flex-start !important;
      }
      .cart-page tbody .cart-items__price {
        grid-area: subtotal !important;
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: flex-end !important;
        font-size: 13.5px !important;
        font-weight: 600 !important;
        color: #333333 !important;
      }
      .cart-page .cart-summary {
        background-color: #fcfcfb !important;
        border: 1px solid #ebebeb !important;
        border-radius: 8px !important;
        padding: 24px !important;
      }
      .cart-page .cart-summary__inner {
        padding: 0 !important;
        gap: 16px !important;
      }
      @media screen and (max-width: 749px) {
        .cart-page .cart-summary__inner {
          position: static !important;
          top: auto !important;
        }
        .cart-page .cart-summary {
          margin-bottom: 40px !important;
        }
      }
      .cart-page .cart-summary__inner::before {
        content: "Cart Totals";
        display: block !important;
        font-family: var(--font-heading--family), serif;
        font-size: 20px !important;
        font-weight: bold !important;
        color: #111111 !important;
        width: 100% !important;
        border-bottom: 1px solid #ebebeb !important;
        padding-bottom: 12px !important;
        margin-bottom: 8px !important;
        text-align: left !important;
      }
      .cart-page details.cart-discount {
        display: block !important;
        width: 100% !important;
        border: none !important;
        margin-top: 12px !important;
        padding: 0 !important;
      }
      .cart-page details.cart-discount summary {
        pointer-events: none !important;
        list-style: none !important;
        display: block !important;
        font-weight: 600 !important;
        font-size: 13px !important;
        color: #333333 !important;
        margin-bottom: 8px !important;
        border: none !important;
        padding: 0 !important;
        text-align: left !important;
      }
      .cart-page details.cart-discount summary::-webkit-details-marker {
        display: none !important;
      }
      .cart-page details.cart-discount summary .cart-totals__icon {
        display: none !important;
      }
      .cart-page details.cart-discount[open] .details-content {
        display: block !important;
        padding: 0 !important;
      }
      .cart-page .cart-discount__form {
        display: flex !important;
        gap: 8px !important;
        width: 100% !important;
      }
      .cart-page .cart-discount__input {
        flex: 1 !important;
        border: 1px solid #dcdcd8 !important;
        border-radius: 4px !important;
        padding: 10px 12px !important;
        font-size: 12.5px !important;
        text-transform: uppercase !important;
        background-color: #ffffff !important;
      }
      .cart-page .cart-discount__button {
        background-color: #ebebeb !important;
        color: #333333 !important;
        border: none !important;
        border-radius: 4px !important;
        padding: 10px 14px !important;
        font-size: 11px !important;
        font-weight: 600 !important;
        text-transform: uppercase !important;
        cursor: pointer !important;
        white-space: nowrap !important;
      }
      .cart-page .cart-discount__button:hover {
        background-color: #dcdcd8 !important;
      }
      .cart-page .cart__checkout-button {
        background-color: #000000 !important;
        color: #ffffff !important;
        font-weight: bold !important;
        border-radius: 4px !important;
        font-size: 13px !important;
        height: 48px !important;
        text-transform: uppercase !important;
        border: none !important;
        width: 100% !important;
        margin-top: 12px !important;
        cursor: pointer !important;
      }

      /* ========================================== */
      /* Floating Chat Widget Style                 */
      /* ========================================== */
      shopify-chat,
      .shopify-chat-dummy,
      .shopify-chat-button {
        --shopify-chat-color-button-background: #c2593f !important;
        --shopify-chat-color-button-icon: #ffffff !important;
        --shopify-chat-color-primary: #c2593f !important;
      }
    </style>
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        // Inline header height and menu style calculations to prevent layout shift
        // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
        (function setHeaderHeighCustomProperties() {
          /*
           * Header calculation functions for maintaining CSS variables
           * Mimic calculateHeaderGroupHeight() in utilities.js
           */
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          const hasHeaderSection = headerGroup?.querySelector('.header-section');

          if (!header || !headerGroup) return;

          const headerTopRow = header.querySelector('.header__row--top');
          const headerHeight = header.offsetHeight;

          // Calculate the total height of the header group
          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const element = children[i];
            if (element === header || !(element instanceof HTMLElement)) continue;
            headerGroupHeight += element.offsetHeight;
          }

          // Check for transparent header special case
          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }

          // Set CSS variables
          document.body.style.setProperty('--header-height', `${headerHeight}px`);
          document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

          if (headerTopRow) {
            window.requestAnimationFrame(function () {
              document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
            });
          }

          /**
           * Updates CSS custom properties for transparent header offset calculation
           * Mimic updateTransparentHeaderOffset() in utilities.js
           */

          if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }

          const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

          const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
          document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% comment %}Old cart drawer disabled — Cart Pilot app handles the drawer now{% endcomment %}
    {% comment %}{% render 'cart-drawer', render_wrapper: true %}{% endcomment %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
    <!-- Inject 'View Cart' button into Cart Pilot drawer -->
    <script>
      (function() {
        if (window.location.pathname === '/cart') {
          // Completely isolated CSS systems for Mobile (<990px) and Desktop (>=990px)
          var style = document.createElement('style');
          style.textContent = `
            @media (max-width: 989px) {
              body, html, .page-wrapper {
                overflow-y: auto !important;
                height: auto !important;
                position: static !important;
                filter: none !important;
                backdrop-filter: none !important;
              }

              main, #MainContent, .cart-page, .cart-summary, .cart-summary__inner, .cart-page__summary {
                position: static !important;
                top: auto !important;
                height: auto !important;
                overflow: visible !important;
                max-height: none !important;
                filter: none !important;
                backdrop-filter: none !important;
              }

              #shopify-section-cart-drawer-section,
              #cart-drawer,
              theme-drawer#cart-drawer,
              cart-drawer-component,
              [role="dialog"]:not(#fr-mobile-nav-drawer),
              dialog:not(#fr-mobile-nav-drawer),
              [class*="cart-pilot"], [id*="cart-pilot"], [data-cart-pilot], [class*="cartpilot"], [id*="cartpilot"],
              [class*="cp-drawer"], [class*="cp_drawer"], [class*="cp-modal"], [class*="cp_modal"],
              [class*="backdrop"], [class*="overlay"]:not(.fr-mobile-drawer__overlay),
              [id*="backdrop"], [id*="overlay"]:not(#fr-mobile-nav-overlay) {
                display: none !important;
                visibility: hidden !important;
                pointer-events: none !important;
                opacity: 0 !important;
              }
            }

            @media (min-width: 990px) {
              body, html, .page-wrapper {
                filter: none !important;
                backdrop-filter: none !important;
              }

              main, #MainContent, .cart-page {
                filter: none !important;
                backdrop-filter: none !important;
                overflow: visible !important;
              }

              #shopify-section-cart-drawer-section,
              #cart-drawer,
              theme-drawer#cart-drawer,
              cart-drawer-component,
              [role="dialog"]:not(#fr-mobile-nav-drawer),
              dialog:not(#fr-mobile-nav-drawer),
              [class*="cart-pilot"], [id*="cart-pilot"], [data-cart-pilot], [class*="cartpilot"], [id*="cartpilot"],
              [class*="cp-drawer"], [class*="cp_drawer"], [class*="cp-modal"], [class*="cp_modal"],
              [class*="backdrop"], [class*="overlay"]:not(.fr-mobile-drawer__overlay),
              [id*="backdrop"], [id*="overlay"]:not(#fr-mobile-nav-overlay) {
                display: none !important;
                visibility: hidden !important;
                pointer-events: none !important;
                opacity: 0 !important;
              }
            }
          `;
          document.head.appendChild(style);

          // On mobile, zero JS observers run to guarantee 100% fluid touch scrolling.
          // On desktop, run lightweight drawer observer to suppress dynamic app drawers.
          if (window.innerWidth >= 990) {
            function hideCPDrawerDesktop() {
              document.body.style.filter = 'none';
              document.body.style.backdropFilter = 'none';
              document.body.classList.remove('page-wrapper--drawer-open');

              var dialogs = document.querySelectorAll('dialog, [role="dialog"], [class*="drawer"], [class*="sidebar"], [class*="backdrop"], [class*="overlay"]');
              dialogs.forEach(function(d) {
                if (d.id === 'fr-mobile-nav-drawer' || d.classList.contains('fr-mobile-drawer') || d.id === 'fr-mobile-nav-overlay' || d.classList.contains('fr-mobile-drawer__overlay')) return;
                var txt = d.textContent || '';
                if (txt.includes('Cart Pilot') || txt.includes('Checkout') || (d.className && (d.className.indexOf('backdrop') !== -1 || d.className.indexOf('overlay') !== -1))) {
                  d.style.setProperty('display', 'none', 'important');
                  d.style.setProperty('visibility', 'hidden', 'important');
                  d.style.setProperty('pointer-events', 'none', 'important');
                  d.style.setProperty('opacity', '0', 'important');
                }
              });
            }

            hideCPDrawerDesktop();
            var hideObsTimer = null;
            var hideObs = new MutationObserver(function() {
              if (hideObsTimer) return;
              hideObsTimer = setTimeout(function() {
                hideObsTimer = null;
                hideCPDrawerDesktop();
              }, 300);
            });
            hideObs.observe(document.body, { childList: true, subtree: true });
          }
          return;
        }

        function tryInjectViewCart() {
          if (document.querySelector('.fr-view-cart-btn')) return;

          var btns = document.querySelectorAll('a, button');
          var checkoutBtn = null;
          for (var j = 0; j < btns.length; j++) {
            var txt = btns[j].textContent.trim().toLowerCase();
            if (txt.includes('checkout') && btns[j].offsetParent !== null) {
              if (btns[j].closest('.cart-page')) continue;
              checkoutBtn = btns[j];
              break;
            }
          }
          if (!checkoutBtn) return;

          var viewCartBtn = document.createElement('a');
          viewCartBtn.href = '/cart';
          viewCartBtn.className = 'fr-view-cart-btn';
          viewCartBtn.textContent = 'View Cart';
          viewCartBtn.style.cssText = 'display:block;text-align:center;padding:10px 0;margin-bottom:8px;color:#000;font-weight:600;font-size:14px;text-decoration:none;border:2px solid #000;border-radius:4px;transition:all 0.2s ease;cursor:pointer;';
          viewCartBtn.addEventListener('mouseenter', function() {
            this.style.backgroundColor = '#000';
            this.style.color = '#fff';
          });
          viewCartBtn.addEventListener('mouseleave', function() {
            this.style.backgroundColor = 'transparent';
            this.style.color = '#000';
          });

          checkoutBtn.parentElement.insertBefore(viewCartBtn, checkoutBtn);
        }

        var lastCartFetch = 0;
        var wallpaperTitles = [];

        function tryHideWallpaperQty() {
          var now = Date.now();
          if (now - lastCartFetch > 2000) {
            lastCartFetch = now;
            fetch('/cart.js').then(r => r.json()).then(cart => {
              wallpaperTitles = [];
              cart.items.forEach(function(item) {
                var isWallpaper = false;
                if (item.properties) {
                  if (typeof item.properties === 'object' && !Array.isArray(item.properties)) {
                    if (item.properties['_areapro_enabled']) isWallpaper = true;
                  } else if (Array.isArray(item.properties)) {
                    for (var i=0; i<item.properties.length; i++) {
                      if (item.properties[i].name === '_areapro_enabled') isWallpaper = true;
                    }
                  }
                }
                if (isWallpaper && item.product_title) {
                  wallpaperTitles.push(item.product_title.trim());
                }
              });
              hideQty();
            });
          } else {
            hideQty();
          }
        }

        function hideQty() {
           if (wallpaperTitles.length === 0) return;
           var targetButtons = document.querySelectorAll('quantity-selector button, .cart-items__quantity button, button[name="plus"]');
           var qtyContainers = [];
           for (var i = 0; i < targetButtons.length; i++) {
              if (targetButtons[i].textContent.trim() === '+' && targetButtons[i].offsetParent !== null) {
                 var parent = targetButtons[i].parentElement;
                 if (parent && qtyContainers.indexOf(parent) === -1) {
                    qtyContainers.push(parent);
                 }
              }
           }
           
           qtyContainers.forEach(function(container) {
              var curr = container;
              var isWallpaper = false;
              for (var j = 0; j < 6; j++) {
                 if (!curr) break;
                 for (var k = 0; k < wallpaperTitles.length; k++) {
                    if (curr.textContent.includes(wallpaperTitles[k])) {
                       isWallpaper = true;
                       break;
                    }
                 }
                 if (isWallpaper) break;
                 curr = curr.parentElement;
              }
              if (isWallpaper) {
                 container.style.setProperty('display', 'none', 'important');
              }
           });
        }

        // Persistent observer — debounced to avoid main thread jank during scrolling
        var mainObsTimer = null;
        var obs = new MutationObserver(function() {
          if (mainObsTimer) return;
          mainObsTimer = setTimeout(function() {
            mainObsTimer = null;
            tryInjectViewCart();
            tryHideWallpaperQty();
          }, 250);
        });
        obs.observe(document.body, { childList: true, subtree: true });
      })();
    </script>

    <!-- Restore unselected cart items silently after selective checkout -->
    <script>
      (function() {
        var pending = localStorage.getItem('fr_pending_cart_items');
        var restorePending = localStorage.getItem('fr_restore_pending');

        if (restorePending === 'true' && pending) {
          // Immediately consume the flag to prevent loop
          localStorage.removeItem('fr_restore_pending');

          // Force-hide all drawer elements to avoid visual disruption/flashing
          var style = document.createElement('style');
          style.textContent = `
            .cart-drawer, .cart-drawer-overlay, [data-cart-drawer], .cart-drawer__overlay,
            [class*="cart-pilot"], [id*="cart-pilot"], [data-cart-pilot], [class*="cartpilot"], [id*="cartpilot"] {
              display: none !important;
              visibility: hidden !important;
              pointer-events: none !important;
            }
          `;
          document.head.appendChild(style);

          try {
            var items = JSON.parse(pending);
            if (items && items.length > 0) {
              var updates = {};
              items.forEach(function(item) {
                updates[item.id] = item.quantity;
              });

              // Create a temporary hidden iframe to make the request
              // This completely bypasses Cart Pilot / theme fetch overrides in the parent window,
              // preventing the cart drawer from automatically opening.
              var iframe = document.createElement('iframe');
              iframe.style.display = 'none';
              iframe.onload = function() {
                iframe.contentWindow.fetch('/cart/update.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ updates: updates })
                })
                .then(function(res) {
                  if (res.ok) {
                    localStorage.removeItem('fr_pending_cart_items');
                  }
                  window.location.reload();
                })
                .catch(function() {
                  window.location.reload();
                });
              };
              document.body.appendChild(iframe);
            }
          } catch(e) {
            localStorage.removeItem('fr_pending_cart_items');
          }
        }
      })();
    </script>
    
    {% render 'wishlist-modal' %}
  </body>
</html>
