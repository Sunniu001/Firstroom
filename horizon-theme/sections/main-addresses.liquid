<section class="fr-account fr-addresses" id="fr-addresses-{{ section.id }}">
  <div class="fr-account__container">
    
    <!-- Left Column: Sidebar -->
    <aside class="fr-account__sidebar">
      <div class="fr-account__user-info">
        <h2 class="fr-account__user-name">
          {{ customer.first_name | default: 'Account' }} {{ customer.last_name }}
        </h2>
        <p class="fr-account__user-email">{{ customer.email }}</p>
      </div>

      <nav class="fr-account__nav">
        <a href="{{ routes.account_url }}#profile" class="fr-account__nav-link">
          Account info
        </a>
        <a href="{{ routes.account_url }}#orders" class="fr-account__nav-link">
          My order
        </a>
        <a href="{{ routes.account_addresses_url }}" class="fr-account__nav-link active">
          My address
        </a>
        <a href="{{ routes.account_url }}#password" class="fr-account__nav-link">
          Change password
        </a>
        <a href="{{ routes.account_logout_url }}" class="fr-account__nav-link fr-account__nav-link--logout">
          Log Out
        </a>
      </nav>
    </aside>

    <!-- Right Column: Content Panel -->
    <main class="fr-account__content">
      <h3 class="fr-account__panel-title">My Address</h3>

      <!-- Button to toggle Add New Form (Optional/Auxiliary) -->
      <div class="fr-addresses__action-bar">
        <button type="button" class="fr-account__btn-primary" id="toggle-add-address-btn">
          ADD NEW ADDRESS
        </button>
      </div>

      <!-- Add Address Form Panel -->
      <div class="fr-addresses__form-panel hide" id="add-address-panel">
        <h4 class="fr-addresses__sub-title">Add New Address</h4>
        
        {%- form 'customer_address', customer.new_address, class: 'fr-account__form' -%}
          <input type="hidden" name="address[country]" value="India">
          
          <div class="fr-account__form-grid">
            <div class="fr-account__field">
              <label for="AddressFirstNameNew">First Name <span class="required">*</span></label>
              <input type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" placeholder="First name" required>
            </div>
            <div class="fr-account__field">
              <label for="AddressLastNameNew">Last Name <span class="required">*</span></label>
              <input type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" placeholder="Last name" required>
            </div>
          </div>

          <div class="fr-account__form-grid">
            <div class="fr-account__field">
              <label for="AddressEmailNew">Email <span class="required">*</span></label>
              <input type="email" id="AddressEmailNew" value="{{ customer.email }}" placeholder="Email address" disabled class="disabled-field">
            </div>
            <div class="fr-account__field">
              <label for="AddressPhoneNew">Phone Number <span class="required">*</span></label>
              <input type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" placeholder="+91 XXXXXXXXXX" required>
            </div>
          </div>

          <div class="fr-account__field">
            <label for="AddressAddress1New">Address <span class="required">*</span></label>
            <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" placeholder="Street address, Apartment, Suite, etc." required>
          </div>

          <div class="fr-account__form-grid">
            <div class="fr-account__field">
              <label for="AddressCityNew">City <span class="required">*</span></label>
              <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" placeholder="City" required>
            </div>
            <div class="fr-account__field">
              <label for="AddressProvinceNew">State <span class="required">*</span></label>
              <select id="AddressProvinceNew" name="address[province]" required>
                <option value="" disabled selected>Select State</option>
                <option value="Andhra Pradesh">Andhra Pradesh</option>
                <option value="Arunachal Pradesh">Arunachal Pradesh</option>
                <option value="Assam">Assam</option>
                <option value="Bihar">Bihar</option>
                <option value="Chhattisgarh">Chhattisgarh</option>
                <option value="Goa">Goa</option>
                <option value="Gujarat">Gujarat</option>
                <option value="Haryana">Haryana</option>
                <option value="Himachal Pradesh">Himachal Pradesh</option>
                <option value="Jharkhand">Jharkhand</option>
                <option value="Karnataka">Karnataka</option>
                <option value="Kerala">Kerala</option>
                <option value="Madhya Pradesh">Madhya Pradesh</option>
                <option value="Maharashtra">Maharashtra</option>
                <option value="Manipur">Manipur</option>
                <option value="Meghalaya">Meghalaya</option>
                <option value="Mizoram">Mizoram</option>
                <option value="Nagaland">Nagaland</option>
                <option value="Odisha">Odisha</option>
                <option value="Punjab">Punjab</option>
                <option value="Rajasthan">Rajasthan</option>
                <option value="Sikkim">Sikkim</option>
                <option value="Tamil Nadu">Tamil Nadu</option>
                <option value="Telangana">Telangana</option>
                <option value="Tripura">Tripura</option>
                <option value="Uttar Pradesh">Uttar Pradesh</option>
                <option value="Uttarakhand">Uttarakhand</option>
                <option value="West Bengal">West Bengal</option>
                <option value="Delhi">Delhi</option>
              </select>
            </div>
            <div class="fr-account__field">
              <label for="AddressZipNew">Pincode <span class="required">*</span></label>
              <input type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" placeholder="Pincode" required>
            </div>
          </div>

          <div class="fr-addresses__checkbox-field">
            <input type="checkbox" id="address_default_address_new" name="address[default]" value="1">
            <label for="address_default_address_new">Set as default address</label>
          </div>

          <div class="fr-addresses__form-buttons">
            <button type="submit" class="fr-account__btn-primary">SAVE ADDRESS</button>
            <button type="button" class="fr-account__btn-secondary cancel-add-btn">CANCEL</button>
          </div>
        {%- endform -%}
      </div>

      <!-- Address List -->
      <div class="fr-addresses__list" id="address-list-container">
        {%- if customer.addresses.size > 0 -%}
          <div class="fr-addresses__grid">
            {%- for address in customer.addresses -%}
              <div class="fr-addresses__card {% if address == customer.default_address %}default-card{% endif %}">
                
                <div class="fr-addresses__card-header">
                  <h4 class="fr-addresses__card-name">
                    {{ address.first_name }} {{ address.last_name }}
                    {%- if address == customer.default_address -%}
                      <span class="default-badge">DEFAULT</span>
                    {%- endif -%}
                  </h4>
                </div>

                <div class="fr-addresses__card-body">
                  <p class="fr-addresses__card-text">
                    {{ address.address1 }}<br>
                    {%- if address.address2 != blank -%}{{ address.address2 }}<br>{%- endif -%}
                    {{ address.city }}, {{ address.province }} - {{ address.zip }}<br>
                    India
                  </p>
                  {%- if address.phone != blank -%}
                    <p class="fr-addresses__card-phone">
                      <strong>Phone:</strong> {{ address.phone }}
                    </p>
                  {%- endif -%}
                </div>

                <div class="fr-addresses__card-actions">
                  <button type="button" class="fr-addresses__edit-btn" data-edit-address-id="{{ address.id }}">
                    Edit
                  </button>
                  <form class="fr-addresses__delete-form" method="post" action="/account/addresses/{{ address.id }}" onsubmit="return confirm('Are you sure you want to delete this address?');">
                    <input type="hidden" name="_method" value="delete">
                    <button type="submit" class="fr-addresses__delete-btn">Delete</button>
                  </form>
                </div>

                <!-- Edit Address Form Panel (Hidden by default) -->
                <div class="fr-addresses__edit-form-panel hide" id="edit-address-panel-{{ address.id }}">
                  <h4 class="fr-addresses__sub-title text-left">Edit Address</h4>
                  
                  {%- form 'customer_address', address, class: 'fr-account__form' -%}
                    <input type="hidden" name="address[country]" value="India">
                    
                    <div class="fr-account__form-grid">
                      <div class="fr-account__field">
                        <label for="AddressFirstName_{{ address.id }}">First Name <span class="required">*</span></label>
                        <input type="text" id="AddressFirstName_{{ address.id }}" name="address[first_name]" value="{{ form.first_name }}" required>
                      </div>
                      <div class="fr-account__field">
                        <label for="AddressLastName_{{ address.id }}">Last Name <span class="required">*</span></label>
                        <input type="text" id="AddressLastName_{{ address.id }}" name="address[last_name]" value="{{ form.last_name }}" required>
                      </div>
                    </div>

                    <div class="fr-account__form-grid">
                      <div class="fr-account__field">
                        <label for="AddressEmail_{{ address.id }}">Email <span class="required">*</span></label>
                        <input type="email" id="AddressEmail_{{ address.id }}" value="{{ customer.email }}" disabled class="disabled-field">
                      </div>
                      <div class="fr-account__field">
                        <label for="AddressPhone_{{ address.id }}">Phone Number <span class="required">*</span></label>
                        <input type="tel" id="AddressPhone_{{ address.id }}" name="address[phone]" value="{{ form.phone }}" required>
                      </div>
                    </div>

                    <div class="fr-account__field">
                      <label for="AddressAddress1_{{ address.id }}">Address <span class="required">*</span></label>
                      <input type="text" id="AddressAddress1_{{ address.id }}" name="address[address1]" value="{{ form.address1 }}" required>
                    </div>

                    <div class="fr-account__form-grid">
                      <div class="fr-account__field">
                        <label for="AddressCity_{{ address.id }}">City <span class="required">*</span></label>
                        <input type="text" id="AddressCity_{{ address.id }}" name="address[city]" value="{{ form.city }}" required>
                      </div>
                      <div class="fr-account__field">
                        <label for="AddressProvince_{{ address.id }}">State <span class="required">*</span></label>
                        <select id="AddressProvince_{{ address.id }}" name="address[province]" required>
                          <option value="{{ form.province }}" selected>{{ form.province }}</option>
                          <option value="Andhra Pradesh">Andhra Pradesh</option>
                          <option value="Arunachal Pradesh">Arunachal Pradesh</option>
                          <option value="Assam">Assam</option>
                          <option value="Bihar">Bihar</option>
                          <option value="Chhattisgarh">Chhattisgarh</option>
                          <option value="Goa">Goa</option>
                          <option value="Gujarat">Gujarat</option>
                          <option value="Haryana">Haryana</option>
                          <option value="Himachal Pradesh">Himachal Pradesh</option>
                          <option value="Jharkhand">Jharkhand</option>
                          <option value="Karnataka">Karnataka</option>
                          <option value="Kerala">Kerala</option>
                          <option value="Madhya Pradesh">Madhya Pradesh</option>
                          <option value="Maharashtra">Maharashtra</option>
                          <option value="Manipur">Manipur</option>
                          <option value="Meghalaya">Meghalaya</option>
                          <option value="Mizoram">Mizoram</option>
                          <option value="Nagaland">Nagaland</option>
                          <option value="Odisha">Odisha</option>
                          <option value="Punjab">Punjab</option>
                          <option value="Rajasthan">Rajasthan</option>
                          <option value="Sikkim">Sikkim</option>
                          <option value="Tamil Nadu">Tamil Nadu</option>
                          <option value="Telangana">Telangana</option>
                          <option value="Tripura">Tripura</option>
                          <option value="Uttar Pradesh">Uttar Pradesh</option>
                          <option value="Uttarakhand">Uttarakhand</option>
                          <option value="West Bengal">West Bengal</option>
                          <option value="Delhi">Delhi</option>
                        </select>
                      </div>
                      <div class="fr-account__field">
                        <label for="AddressZip_{{ address.id }}">Pincode <span class="required">*</span></label>
                        <input type="text" id="AddressZip_{{ address.id }}" name="address[zip]" value="{{ form.zip }}" required>
                      </div>
                    </div>

                    <div class="fr-addresses__checkbox-field">
                      {{ form.set_as_default_checkbox }}
                      <label for="address_default_address_{{ address.id }}">Set as default address</label>
                    </div>

                    <div class="fr-addresses__form-buttons">
                      <button type="submit" class="fr-account__btn-primary">UPDATE ADDRESS</button>
                      <button type="button" class="fr-account__btn-secondary cancel-edit-btn" data-cancel-address-id="{{ address.id }}">CANCEL</button>
                    </div>
                  {%- endform -%}
                </div>

              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="fr-addresses__empty">
            <p>No addresses found. Add an address to use during checkout.</p>
          </div>
        {%- endif -%}
      </div>

    </main>

  </div>
</section>

<style>
  /* Reuse base account styles for layout consistency */
  .fr-addresses__action-bar {
    margin-bottom: 30px;
    display: flex;
    justify-content: flex-start;
  }

  .fr-addresses__sub-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 500;
    margin-top: 0;
    margin-bottom: 24px;
    color: #1a1a1a;
  }

  .text-left {
    text-align: left !important;
  }

  /* Form panels spacing */
  .fr-addresses__form-panel {
    border: 1px solid #ebebeb;
    padding: 30px;
    margin-bottom: 40px;
    background-color: #fafafa;
    border-radius: 2px;
  }

  .fr-addresses__form-panel.hide,
  .fr-addresses__edit-form-panel.hide {
    display: none;
  }

  .fr-addresses__checkbox-field {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    font-size: 0.88rem;
    color: #4a4a4a;
  }

  .fr-addresses__checkbox-field input {
    width: 16px;
    height: 16px;
    cursor: pointer;
  }

  .fr-addresses__checkbox-field label {
    cursor: pointer;
    user-select: none;
  }

  .fr-addresses__form-buttons {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .fr-account__btn-secondary {
    height: 48px;
    padding: 0 32px;
    background-color: transparent;
    color: #4a4a4a;
    font-size: 0.88rem;
    font-weight: 600;
    border: 1px solid #ccc;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.2s ease;
    font-family: 'Lato', system-ui, sans-serif;
  }

  .fr-account__btn-secondary:hover {
    border-color: #1a1a1a;
    color: #000;
  }

  /* ── Address Cards Grid ── */
  .fr-addresses__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 600px) {
    .fr-addresses__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fr-addresses__card {
    border: 1px solid #ebebeb;
    padding: 24px;
    border-radius: 2px;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
    position: relative;
  }

  .fr-addresses__card.default-card {
    border-color: #1a1a1a;
    box-shadow: 0 2px 12px rgba(0,0,0,0.03);
  }

  .fr-addresses__card-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 0;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #000;
  }

  .default-badge {
    background-color: #1a1a1a;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: 2px;
  }

  .fr-addresses__card-text {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #555;
    margin-top: 0;
    margin-bottom: 12px;
  }

  .fr-addresses__card-phone {
    font-size: 0.85rem;
    color: #666;
    margin: 0 0 20px 0;
  }

  .fr-addresses__card-actions {
    display: flex;
    gap: 16px;
    border-top: 1px solid #ebebeb;
    padding-top: 16px;
    margin-top: auto;
  }

  .fr-addresses__edit-btn,
  .fr-addresses__delete-btn {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: transparent;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    padding: 4px 0;
    transition: color 0.15s ease;
  }

  .fr-addresses__edit-btn {
    color: #1a1a1a;
    text-decoration: underline;
  }

  .fr-addresses__edit-btn:hover {
    color: #B53939;
  }

  .fr-addresses__delete-btn {
    color: #999;
  }

  .fr-addresses__delete-btn:hover {
    color: #B53939;
  }

  .fr-addresses__delete-form {
    display: inline;
  }

  /* Edit form inside card */
  .fr-addresses__edit-form-panel {
    border-top: 1px solid #ebebeb;
    padding-top: 24px;
    margin-top: 20px;
    width: 100%;
  }

  .fr-addresses__empty {
    text-align: center;
    padding: 60px 0;
    color: #777;
    font-style: italic;
    border: 1px dashed #ccc;
    border-radius: 2px;
  }

  .fr-addresses__empty p {
    margin: 0;
  }

  /* Select customization for clean look */
  .fr-account__field select {
    width: 100%;
    height: 48px;
    border: 1px solid #ddd;
    padding: 0 16px;
    font-size: 0.92rem;
    font-family: 'Lato', system-ui, sans-serif;
    color: #1a1a1a;
    border-radius: 2px;
    background-color: #ffffff;
    cursor: pointer;
  }

  .fr-account__field select:focus {
    outline: none;
    border-color: #1a1a1a;
  }
</style>

<script>
  (function() {
    function initAddresses() {
      var toggleAddBtn = document.getElementById('toggle-add-address-btn');
      var addAddressPanel = document.getElementById('add-address-panel');
      var cancelAddBtn = document.querySelector('.cancel-add-btn');
      var listContainer = document.getElementById('address-list-container');

      // Toggle Add New Form
      if (toggleAddBtn && addAddressPanel) {
        toggleAddBtn.addEventListener('click', function() {
          addAddressPanel.classList.remove('hide');
          toggleAddBtn.classList.add('hide');
          if (listContainer) listContainer.classList.add('hide');
        });
      }

      // Cancel Add Form
      if (cancelAddBtn && addAddressPanel && toggleAddBtn) {
        cancelAddBtn.addEventListener('click', function() {
          addAddressPanel.classList.add('hide');
          toggleAddBtn.classList.remove('hide');
          if (listContainer) listContainer.classList.remove('hide');
        });
      }

      // Bind Edit Address Forms Toggle
      var editButtons = document.querySelectorAll('[data-edit-address-id]');
      editButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = this.getAttribute('data-edit-address-id');
          var panel = document.getElementById('edit-address-panel-' + id);
          if (panel) {
            panel.classList.toggle('hide');
          }
        });
      });

      // Bind Cancel Edit Buttons
      var cancelEditButtons = document.querySelectorAll('[data-cancel-address-id]');
      cancelEditButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = this.getAttribute('data-cancel-address-id');
          var panel = document.getElementById('edit-address-panel-' + id);
          if (panel) {
            panel.classList.add('hide');
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initAddresses);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initAddresses();
    }
  })();
</script>

{% schema %}
{
  "name": "FR Customer Addresses",
  "tag": "section",
  "class": "fr-customer-addresses-section",
  "settings": []
}
{% endschema %}
