{% liquid
  assign free_shipping_threshold = 300000
  assign cart_total = cart.total_price
  
  if cart_total >= free_shipping_threshold
    assign percentage = 100
    assign unlocked = true
  else
    assign unlocked = false
    assign amount_remaining = free_shipping_threshold | minus: cart_total
    assign percentage = cart_total | times: 100 | divided_by: free_shipping_threshold
  endif
%}

<div class="fr-shipping-bar" data-hydration-key="fr-shipping-bar">
  <div class="fr-shipping-bar__info">
    <span class="fr-shipping-bar__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <!-- Truck body -->
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <!-- Wheels -->
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </span>
    <span class="fr-shipping-bar__text">
      {% if unlocked %}
        Congratulations! You've unlocked <strong>Free Shipping</strong>
      {% else %}
        Spend <strong>{{ amount_remaining | money }}</strong> more to unlock <strong>Free Shipping</strong>
      {% endif %}
    </span>
  </div>
  <div class="fr-shipping-bar__progress-track">
    <div class="fr-shipping-bar__progress-fill" style="width: {{ percentage }}%;"></div>
  </div>
</div>

<style>
  .fr-shipping-bar {
    width: 100%;
    padding: 14px var(--theme-drawer-padding, 20px);
    border-bottom: 1px solid #ebebeb;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-sizing: border-box;
  }

  .fr-shipping-bar__info {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #333333;
    font-size: 12.5px;
    font-family: var(--font-body--family), sans-serif;
  }

  .fr-shipping-bar__icon {
    display: inline-flex;
    align-items: center;
    color: #333333;
  }

  .fr-shipping-bar__text {
    line-height: 1.3;
  }

  .fr-shipping-bar__text strong {
    font-weight: 700;
  }

  .fr-shipping-bar__progress-track {
    width: 100%;
    height: 4px;
    background-color: #ebebeb;
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }

  .fr-shipping-bar__progress-fill {
    height: 100%;
    background-color: #000000;
    transition: width 0.3s ease;
  }
</style>
