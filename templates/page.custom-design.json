    "fr_custom_faq_mmhbmM": {
      "type": "fr-custom-faq",
      "blocks": {
        "faq_Bwmw4i": {
          "type": "faq",
          "settings": {
            "question": "How does the custom design process work?",
            "answer": "<p>Our process begins with understanding your vision and requirements. Once you share your ideas, inspirations or space details, our design team creates a personalized concept for your review. After approval, the design moves into production and is delivered to your doorstep.<br/></p>"
          }
        },
        "faq_g48ePg": {
          "type": "faq",
          "settings": {
            "question": "Can I customize the design, colors and dimensions?",
            "answer": "<p>Yes. Every custom design can be tailored to your preferences, including colors, patterns, scale and dimensions. We ensure the final design complements your space and style.<br/></p>"
          }
        },
        "faq_JgPzce": {
          "type": "faq",
          "settings": {
            "question": "What information do I need to provide?",
            "answer": "<p>To help us create the perfect design, you can share room dimensions, reference images, preferred colors, design preferences and any specific ideas you have in mind. The more details you provide, the better we can personalize your design.<br/></p>"
          }
        },
        "faq_cPYxMF": {
          "type": "faq",
          "settings": {
            "question": "How long does the custom design process take?",
            "answer": "<p>The timeline depends on the complexity of the project. Typically, concept development, revisions and production are completed within a few weeks. Our team will provide an estimated timeline once your requirements are reviewed.</p>"
          }
        },
        "faq_r9bjqC": {
          "type": "faq",
          "settings": {
            "question": "Will I receive a design preview before production?",
            "answer": "<p>Yes. A digital preview of your custom design will be shared for approval before production begins. This ensures you are completely satisfied with the design before it is printed or manufactured.<br/></p>"
          }
        }
      },
