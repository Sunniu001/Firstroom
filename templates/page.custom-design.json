    "fr_custom_faq_mmhbmM": {
      "type": "fr-custom-faq",
      "blocks": {
        "faq_Bwmw4i": {
          "type": "faq",
          "settings": {
            "question": "Can I customize a wallpaper ?",
            "answer": "<p>Yes! We specialize in fully customized wallpapers. Whether you have a specific design in mind or need help creating one, our team works closely with you to develop artwork that complements your space, style, dimensions, and preferences. From concept to installation, every detail is<br/>tailored to your vision.</p>"
          }
        },
        "faq_g48ePg": {
          "type": "faq",
          "settings": {
            "question": "Do you provide installation?",
            "answer": "<p>Yes, we provide professional wallpaper installation services to ensure a seamless finish. Our experienced installers handle the process with precision, so your wallpaper looks flawless and lasts for years.</p>"
          }
        },
        "faq_JgPzce": {
          "type": "faq",
          "settings": {
            "question": "Can I order samples ?",
            "answer": "<p>Yes, you can order wallpaper samples to see the design, colors, and material in person before placing your final order. This helps you make a confident choice and ensures the wallpaper is the perfect fit for your space.</p>"
          }
        },
        "faq_cPYxMF": {
          "type": "faq",
          "settings": {
            "question": "How many types of material are used for the base ?",
            "answer": "<p>There are 4 main premium material options- Leather, Feather, Line Texture, and Silk. Each offers a distinct finish and is designed to suit different spaces, aesthetic preferences, and durability needs. Our team will help you select the ideal material based on your interior, application, and budget.</p>"
          }
        },
        "faq_r9bjqC": {
          "type": "faq",
          "settings": {
            "question": "On what surface can I install wallpaper ?",
            "answer": "<p>Wallpapers can be installed on smooth, clean, and properly prepared surfaces such as painted walls, gypsum board, MDF, plywood, glass and acrylic. For the best results, the surface should be dry, even, and free from dust, moisture, or peeling paint.</p>"
          }
        },
        "faq_LD7TWc": {
          "type": "faq",
          "settings": {
            "question": "Are your wallpapers eco - friendly ?",
            "answer": "<p>Yes. Our wallpapers are made using eco-friendly materials and non-toxic inks, making them safe for homes, offices, and commercial spaces. They are designed to be durable while maintaining a lower environmental impact.</p>"
          }
        }
      },
