{% schema %}
{
  "name": "Wall Dimensions Calc",
  "settings": [
    {
      "type": "text",
      "id": "minimum_area",
      "label": "Minimum Area (sq ft)",
      "default": "25"
    }
  ],
  "presets": [
    {
      "name": "Wall Dimensions Calc"
    }
  ]
}
{% endschema %}

{%- assign product_form_id = 'product-form-' | append: section.id -%}
<div class="fr-dimensions-wrapper" {{ block.shopify_attributes }}>
  <div class="fr-dim-header">
    <h3 class="fr-dim-title">Enter Dimensions <span style="font-weight: 400; font-size: 11px; color: #777;">(Minimum Order: {{ block.settings.minimum_area | default: 25 }} Sq.Ft.)</span></h3>
    <div class="fr-dim-toggle">
      <button type="button" class="fr-dim-unit active" data-unit="ft">FT</button>
      <button type="button" class="fr-dim-unit" data-unit="in">IN</button>
    </div>
  </div>

  <div class="fr-dim-inputs">
    <div class="fr-dim-input-group">
      <label for="fr-dim-height">Height (<span class="unit-label">feet</span>) <span style="color: #d32f2f;">*</span></label>
      <input type="number" id="fr-dim-height" value="5" min="1" step="any">
    </div>
    <div class="fr-dim-input-group">
      <label for="fr-dim-width">Width (<span class="unit-label">feet</span>) <span style="color: #d32f2f;">*</span></label>
      <input type="number" id="fr-dim-width" value="5" min="1" step="any">
    </div>
  </div>
  
  <div class="fr-dim-total-area-display" style="margin-bottom: 5px; font-size: 13px; color: #111;">
    Total Area: <strong id="fr-dim-calculated-area">25.00</strong> sq.ft.
  </div>
  <div id="fr-dim-error-msg" style="color: #d32f2f; font-size: 13px; margin-bottom: 15px; display: none;">
    Minimum order is {{ block.settings.minimum_area | default: 25 }} sq.ft. Please increase dimensions.
  </div>

  <details class="fr-dim-accordion">
    <summary>How to measure your wall</summary>
    <div class="fr-dim-accordion-content">
      <p>Measure the maximum width and height of your wall. We automatically add 2 inches to the dimensions for trimming during installation to ensure a perfect fit. <strong>(Minimum order: 25 sq ft)</strong></p>
    </div>
  </details>

  <product-form-component 
    class="product-form"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-product-url="{{ product.url }}"
    on:submit="/handleSubmit"
  >
    {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1" id="fr-qty-input">
      
      <!-- AreaPro hidden inputs for Cart Transform API -->
      <input type="hidden" name="properties[_areapro_area]" id="areapro_area" value="">
      <input type="hidden" name="properties[_areapro_rate]" id="areapro_rate" value="{{ product.price | divided_by: 100.0 }}">
      <input type="hidden" name="properties[_areapro_enabled]" value="true">
      <input type="hidden" name="properties[Width]" id="prop_width" value="">
      <input type="hidden" name="properties[Height]" id="prop_height" value="">

      <div class="fr-dim-price-display">
        <span class="fr-dim-price-label">Custom Price:</span>
        <span class="fr-dim-price-value" id="fr-dim-total-price"></span>
      </div>

      <button type="submit" name="add" id="fr-add-to-cart-btn" class="button button--primary" style="width: 100%;">
        <span class="add-to-cart-text">
          <span aria-hidden="true" class="svg-wrapper add-to-cart-icon">
            {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
          </span>
          <span class="add-to-cart-text__content">
            <span>
              <span>
                ADD TO CART
              </span>
            </span>
          </span>
        </span>
      </button>
    {%- endform -%}
  </product-form-component>

  <button 
    type="button" 
    class="fr-product-wishlist-btn-full" 
    id="fr-product-wishlist-btn-{{ product.handle }}"
  >
    <svg class="fr-heart-empty" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e76483" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
    <svg class="fr-heart-filled" width="20" height="20" viewBox="0 0 24 24" fill="#e76483" stroke="#e76483" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
    <span class="fr-wishlist-text" style="font-size: 14px; font-weight: 500; color: #333;">Add to Wishlist</span>
  </button>
  
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const handle = '{{ product.handle }}';
      const btn = document.getElementById('fr-product-wishlist-btn-' + handle);
      if (!btn) return;

      const emptyHeart = btn.querySelector('.fr-heart-empty');
      const filledHeart = btn.querySelector('.fr-heart-filled');
      const textSpan = btn.querySelector('.fr-wishlist-text');

      const checkWishlistState = () => {
        let inWishlist = false;
        try {
          const dataStr = localStorage.getItem('fr_wishlist_data');
          if (dataStr) {
            const data = JSON.parse(dataStr);
            if (data && data.wishlists) {
              for (const list of data.wishlists) {
                if (list.items && list.items.includes(handle)) {
                  inWishlist = true;
                  break;
                }
              }
            }
          } else {
            const oldItems = JSON.parse(localStorage.getItem('wishlist') || '[]');
            if (oldItems.includes(handle)) inWishlist = true;
          }
        } catch(e) {}

        if (inWishlist) {
          emptyHeart.style.display = 'none';
          filledHeart.style.display = 'block';
          textSpan.textContent = 'Remove from Wishlist';
          btn.onclick = (e) => {
            e.preventDefault();
            if (window.frRemoveFromAllWishlists) window.frRemoveFromAllWishlists(handle);
          };
        } else {
          emptyHeart.style.display = 'block';
          filledHeart.style.display = 'none';
          textSpan.textContent = 'Add to Wishlist';
          btn.onclick = (e) => {
            e.preventDefault();
            if (window.frOpenWishlistModal) window.frOpenWishlistModal(handle);
          };
        }
      };

      checkWishlistState();
      document.addEventListener('wishlist:updated', checkWishlistState);
    });
  </script>
</div>

<style>
.fr-dimensions-wrapper {
  margin-top: 20px;
  margin-bottom: 20px;
  width: 100%;
}
.fr-dim-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.fr-dim-title {
  font-size: 13px;
  font-weight: 600;
  margin: 0;
  color: #111;
}
.fr-dim-toggle {
  display: inline-flex;
  border: 1px solid #ddd;
  border-radius: 20px;
  padding: 2px;
}
.fr-dim-unit {
  padding: 4px 14px;
  border-radius: 16px;
  font-size: 9px;
  font-weight: 600;
  cursor: pointer;
  background: transparent;
  border: none;
  color: #888;
  text-transform: uppercase;
  transition: all 0.2s;
}
.fr-dim-unit.active {
  background: #222;
  color: #fff;
}
.fr-dim-inputs {
  display: flex;
  gap: 12px;
  margin-bottom: 15px;
}
.fr-dim-input-group {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.fr-dim-input-group label {
  font-size: 11px;
  color: #555;
  margin-bottom: 6px;
  font-weight: 500;
}
.fr-dim-input-group input {
  border: 1px solid #ddd;
  padding: 12px;
  border-radius: 4px;
  font-size: 12px;
  outline: none;
  width: 100%;
  box-sizing: border-box;
}
.fr-dim-input-group input:focus {
  border-color: #000;
}
.fr-dim-accordion {
  margin-bottom: 20px;
}
.fr-dim-accordion summary {
  font-size: 11px;
  color: #666;
  cursor: pointer;
  list-style: none;
  font-weight: 500;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 8px;
  border-bottom: 1px solid #eee;
}
.fr-dim-accordion summary::-webkit-details-marker {
  display: none;
}
.fr-dim-accordion summary::after {
  content: '▼';
  font-size: 8px;
}
.fr-dim-accordion[open] summary::after {
  content: '▲';
}
.fr-dim-accordion-content {
  font-size: 11px;
  color: #888;
  padding-top: 10px;
  line-height: 1.5;
}
.fr-btn-calc {
  width: 100%;
  background: #000;
  color: #fff;
  border: none;
  padding: 16px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  cursor: pointer;
  border-radius: 4px;
  text-transform: uppercase;
  transition: background 0.2s;
}
.fr-btn-calc:hover {
  background: #333;
}
.fr-dim-price-display {
  text-align: center;
  margin-bottom: 15px;
  padding: 12px;
  background: #f9f9f9;
  border-radius: 4px;
}
.fr-dim-price-label {
  font-size: 12px;
  color: #666;
  margin-right: 8px;
}
.fr-dim-price-value {
  font-size: 18px;
  font-weight: 600;
  color: #111;
}
.fr-product-wishlist-btn-full {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 14px;
  margin-top: 10px;
  border: 1px solid #e5e5e5;
  border-radius: 4px;
  background: #fff;
  cursor: pointer;
  transition: 0.2s;
}
.fr-product-wishlist-btn-full:hover {
  background: #fdfdfd;
  border-color: #d5d5d5;
}
.fr-product-wishlist-btn-full svg {
  transition: transform 0.2s ease;
}
.fr-product-wishlist-btn-full:hover svg {
  transform: scale(1.1);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.querySelector('.fr-dimensions-wrapper');
  if(!container) return;

  const basePriceCents = {{ product.price | default: 18000 }}; 
  const minArea = {{ block.settings.minimum_area | default: 25 }};
  
  const btnFt = container.querySelector('[data-unit="ft"]');
  const btnIn = container.querySelector('[data-unit="in"]');
  const labels = container.querySelectorAll('.unit-label');
  const widthInput = container.querySelector('#fr-dim-width');
  const heightInput = container.querySelector('#fr-dim-height');
  
  const priceDisplay = container.querySelector('.fr-dim-price-display');
  const priceValue = container.querySelector('#fr-dim-total-price');

  const propArea = container.querySelector('#areapro_area');
  const propWidth = container.querySelector('#prop_width');
  const propHeight = container.querySelector('#prop_height');
  const qtyInput = container.querySelector('#fr-qty-input');

  let currentUnit = 'ft';

  function setUnit(unit) {
    if(unit === 'ft' && currentUnit === 'in') {
      btnFt.classList.add('active');
      btnIn.classList.remove('active');
      labels.forEach(l => l.textContent = 'feet');
      currentUnit = 'ft';
      
      let w = parseFloat(widthInput.value) || 0;
      let h = parseFloat(heightInput.value) || 0;
      widthInput.value = w > 0 ? (w / 12).toFixed(2).replace(/\.00$/, '') : '';
      heightInput.value = h > 0 ? (h / 12).toFixed(2).replace(/\.00$/, '') : '';
    } else if(unit === 'in' && currentUnit === 'ft') {
      btnIn.classList.add('active');
      btnFt.classList.remove('active');
      labels.forEach(l => l.textContent = 'inches');
      currentUnit = 'in';
      
      let w = parseFloat(widthInput.value) || 0;
      let h = parseFloat(heightInput.value) || 0;
      widthInput.value = w > 0 ? (w * 12).toFixed(2).replace(/\.00$/, '') : '';
      heightInput.value = h > 0 ? (h * 12).toFixed(2).replace(/\.00$/, '') : '';
    }
    calculatePrice();
  }

  function calculatePrice() {
    const w = parseFloat(widthInput.value) || 0;
    const h = parseFloat(heightInput.value) || 0;

    let areaSqFt = 0;
    if(w > 0 && h > 0) {
      if(currentUnit === 'ft') {
        areaSqFt = (w * h);
      } else {
        areaSqFt = (w * h) / 144.0;
      }
    }

    const areaDisplay = document.getElementById('fr-dim-calculated-area');
    const errorMsg = document.getElementById('fr-dim-error-msg');
    
    if (areaDisplay) {
      areaDisplay.textContent = areaSqFt.toFixed(2);
    }

    const addToCartBtns = document.querySelectorAll('button[name="add"], #fr-add-to-cart-btn');
    addToCartBtns.forEach(btn => {
      const textEl = btn.querySelector('.add-to-cart-text__content span span') || btn.querySelector('span');
      if (w === 0 || h === 0 || areaSqFt < minArea) {
        btn.disabled = true;
        btn.style.pointerEvents = 'none';
        btn.style.opacity = '0.5';
        if (errorMsg) errorMsg.style.display = 'block';
        if (textEl) {
          if (!btn.dataset.originalText) {
            btn.dataset.originalText = textEl.textContent.trim();
          }
          if (w === 0 || h === 0) {
            textEl.textContent = "Enter Dimensions";
          } else {
            textEl.textContent = `Minimum ${minArea} sqft`;
          }
        }
      } else {
        btn.disabled = false;
        btn.style.pointerEvents = 'auto';
        btn.style.opacity = '1';
        if (errorMsg) errorMsg.style.display = 'none';
        if (textEl && btn.dataset.originalText) {
          textEl.textContent = btn.dataset.originalText;
        }
      }
    });

    if(areaSqFt < minArea) areaSqFt = minArea;

    const totalPriceCents = areaSqFt * basePriceCents;
    const formattedPrice = 'Rs. ' + (totalPriceCents / 100).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});

    priceValue.textContent = formattedPrice;
    
    propArea.value = areaSqFt.toFixed(2);
    propWidth.value = w + ' ' + currentUnit;
    propHeight.value = h + ' ' + currentUnit;
  }

  btnFt.addEventListener('click', () => setUnit('ft'));
  btnIn.addEventListener('click', () => setUnit('in'));
  widthInput.addEventListener('input', calculatePrice);
  heightInput.addEventListener('input', calculatePrice);

  calculatePrice();
});
</script>
