{% schema %}
{
  "name": "Wall Dimensions Calc",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "minimum_area",
      "label": "Minimum Area (sq ft)",
      "default": "25"
    }
  ]
}
{% endschema %}

{%- assign product_form_id = 'product-form-' | append: section.id -%}
<div class="fr-dimensions-wrapper" {{ block.shopify_attributes }}>
  <div class="fr-dim-header">
    <h3 class="fr-dim-title">Wall dimensions</h3>
    <div class="fr-dim-toggle">
      <button type="button" class="fr-dim-unit active" data-unit="cm">CM</button>
      <button type="button" class="fr-dim-unit" data-unit="in">IN</button>
    </div>
  </div>

  <div class="fr-dim-inputs">
    <div class="fr-dim-input-group">
      <label for="fr-dim-width">Width (<span class="unit-label">cm</span>):</label>
      <input type="number" id="fr-dim-width" placeholder="e.g. 300" min="1">
    </div>
    <div class="fr-dim-input-group">
      <label for="fr-dim-height">Height (<span class="unit-label">cm</span>):</label>
      <input type="number" id="fr-dim-height" placeholder="e.g. 250" min="1">
    </div>
  </div>

  <details class="fr-dim-accordion">
    <summary>How to measure your wall</summary>
    <div class="fr-dim-accordion-content">
      <p>Measure the maximum width and height of your wall. We automatically add 5cm (or 2in) to the dimensions for trimming during installation to ensure a perfect fit.</p>
    </div>
  </details>

  <product-form-component class="product-form">
    {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1" id="fr-qty-input">
      
      <!-- AreaPro hidden inputs for Cart Transform API -->
      <input type="hidden" name="properties[_areapro_area]" id="areapro_area" value="">
      <input type="hidden" name="properties[_areapro_rate]" id="areapro_rate" value="{{ product.price | divided_by: 100.0 }}">
      <input type="hidden" name="properties[_areapro_enabled]" value="true">
      <input type="hidden" name="properties[Width]" id="prop_width" value="">
      <input type="hidden" name="properties[Height]" id="prop_height" value="">

      <div class="fr-dim-price-display" style="display: none;">
        <span class="fr-dim-price-label">Custom Price:</span>
        <span class="fr-dim-price-value" id="fr-dim-total-price"></span>
      </div>

      <button type="button" id="fr-calc-btn" class="fr-btn-calc">VIEW YOUR CUSTOM PRICE</button>
      <button type="submit" id="fr-add-to-cart-btn" class="fr-btn-add" style="display: none;" disabled>
        ADD TO CART
      </button>
    {%- endform -%}
  </product-form-component>
</div>

<style>
.fr-dimensions-wrapper {
  margin-top: 20px;
  margin-bottom: 20px;
  width: 100%;
}
.fr-dim-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.fr-dim-title {
  font-size: 13px;
  font-weight: 600;
  margin: 0;
  color: #111;
}
.fr-dim-toggle {
  display: inline-flex;
  border: 1px solid #ddd;
  border-radius: 20px;
  padding: 2px;
}
.fr-dim-unit {
  padding: 4px 14px;
  border-radius: 16px;
  font-size: 9px;
  font-weight: 600;
  cursor: pointer;
  background: transparent;
  border: none;
  color: #888;
  text-transform: uppercase;
  transition: all 0.2s;
}
.fr-dim-unit.active {
  background: #222;
  color: #fff;
}
.fr-dim-inputs {
  display: flex;
  gap: 12px;
  margin-bottom: 15px;
}
.fr-dim-input-group {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.fr-dim-input-group label {
  font-size: 11px;
  color: #555;
  margin-bottom: 6px;
  font-weight: 500;
}
.fr-dim-input-group input {
  border: 1px solid #ddd;
  padding: 12px;
  border-radius: 4px;
  font-size: 12px;
  outline: none;
  width: 100%;
  box-sizing: border-box;
}
.fr-dim-input-group input:focus {
  border-color: #000;
}
.fr-dim-accordion {
  margin-bottom: 20px;
}
.fr-dim-accordion summary {
  font-size: 11px;
  color: #666;
  cursor: pointer;
  list-style: none;
  font-weight: 500;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 8px;
  border-bottom: 1px solid #eee;
}
.fr-dim-accordion summary::-webkit-details-marker {
  display: none;
}
.fr-dim-accordion summary::after {
  content: '▼';
  font-size: 8px;
}
.fr-dim-accordion[open] summary::after {
  content: '▲';
}
.fr-dim-accordion-content {
  font-size: 11px;
  color: #888;
  padding-top: 10px;
  line-height: 1.5;
}
.fr-btn-calc, .fr-btn-add {
  width: 100%;
  background: #000;
  color: #fff;
  border: none;
  padding: 16px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  cursor: pointer;
  border-radius: 4px;
  text-transform: uppercase;
  transition: background 0.2s;
}
.fr-btn-calc:hover, .fr-btn-add:hover {
  background: #333;
}
.fr-dim-price-display {
  text-align: center;
  margin-bottom: 15px;
  padding: 12px;
  background: #f9f9f9;
  border-radius: 4px;
}
.fr-dim-price-label {
  font-size: 12px;
  color: #666;
  margin-right: 8px;
}
.fr-dim-price-value {
  font-size: 18px;
  font-weight: 600;
  color: #111;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.querySelector('.fr-dimensions-wrapper');
  if(!container) return;

  const basePriceCents = {{ product.price | default: 18000 }}; 
  const minArea = {{ block.settings.minimum_area | default: 25 }};
  
  const btnCm = container.querySelector('[data-unit="cm"]');
  const btnIn = container.querySelector('[data-unit="in"]');
  const labels = container.querySelectorAll('.unit-label');
  const widthInput = container.querySelector('#fr-dim-width');
  const heightInput = container.querySelector('#fr-dim-height');
  
  const calcBtn = container.querySelector('#fr-calc-btn');
  const addBtn = container.querySelector('#fr-add-to-cart-btn');
  const priceDisplay = container.querySelector('.fr-dim-price-display');
  const priceValue = container.querySelector('#fr-dim-total-price');

  const propArea = container.querySelector('#areapro_area');
  const propWidth = container.querySelector('#prop_width');
  const propHeight = container.querySelector('#prop_height');
  const qtyInput = container.querySelector('#fr-qty-input');

  let currentUnit = 'cm';

  function setUnit(unit) {
    currentUnit = unit;
    if(unit === 'cm') {
      btnCm.classList.add('active');
      btnIn.classList.remove('active');
      labels.forEach(l => l.textContent = 'cm');
      widthInput.placeholder = 'e.g. 300';
      heightInput.placeholder = 'e.g. 250';
    } else {
      btnIn.classList.add('active');
      btnCm.classList.remove('active');
      labels.forEach(l => l.textContent = 'in');
      widthInput.placeholder = 'e.g. 120';
      heightInput.placeholder = 'e.g. 100';
    }
    resetCalc();
  }

  function resetCalc() {
    calcBtn.style.display = 'block';
    addBtn.style.display = 'none';
    priceDisplay.style.display = 'none';
    addBtn.disabled = true;
  }

  btnCm.addEventListener('click', () => setUnit('cm'));
  btnIn.addEventListener('click', () => setUnit('in'));
  widthInput.addEventListener('input', resetCalc);
  heightInput.addEventListener('input', resetCalc);

  calcBtn.addEventListener('click', () => {
    const w = parseFloat(widthInput.value);
    const h = parseFloat(heightInput.value);

    if(!w || !h || w <= 0 || h <= 0) {
      alert('Please enter valid width and height dimensions.');
      return;
    }

    let areaSqFt = 0;
    if(currentUnit === 'cm') {
      areaSqFt = ((w + 5) * (h + 5)) / 929.03;
    } else {
      areaSqFt = ((w + 2) * (h + 2)) / 144;
    }

    if(areaSqFt < minArea) areaSqFt = minArea;

    const totalPriceCents = areaSqFt * basePriceCents;
    const formattedPrice = 'Rs. ' + (totalPriceCents / 100).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});

    priceValue.textContent = formattedPrice;
    
    propArea.value = areaSqFt.toFixed(2);
    propWidth.value = w + ' ' + currentUnit;
    propHeight.value = h + ' ' + currentUnit;
    
    qtyInput.value = Math.ceil(areaSqFt);

    calcBtn.style.display = 'none';
    priceDisplay.style.display = 'block';
    addBtn.style.display = 'block';
    addBtn.disabled = false;
  });
});
</script>
