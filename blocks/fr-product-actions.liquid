<div class="fr-actions-container" style="margin-top: {{ block.settings.padding_top }}px; margin-bottom: {{ block.settings.padding_bottom }}px;" {{ block.shopify_attributes }}>
  {% if block.settings.note_text != blank %}
    <div class="fr-actions-note">
      {{ block.settings.note_text }}
    </div>
  {% endif %}

  <div class="fr-actions-buttons">
    {% if block.settings.show_order_button %}
      <a href="{{ block.settings.order_link }}" class="fr-action-btn fr-btn-primary">
        {{ block.settings.order_text }}
      </a>
    {% endif %}
    {% assign specialist_link = block.settings.specialist_link %}
    {% if block.settings.use_whatsapp and block.settings.whatsapp_number != blank %}
      {% assign wa_message = block.settings.whatsapp_message | default: '' | url_encode %}
      {% assign specialist_link = 'https://wa.me/' | append: block.settings.whatsapp_number | append: '?text=' | append: wa_message %}
    {% endif %}
    <a href="{{ specialist_link }}" class="fr-action-btn fr-btn-secondary" {% if block.settings.use_whatsapp %}target="_blank" rel="noopener noreferrer"{% endif %}>
      <span class="fr-status-dot"></span>
      {{ block.settings.specialist_text }}
    </a>
  </div>
</div>

<style>
  .fr-actions-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .fr-actions-note {
    font-size: 14px;
    line-height: 1.6;
    color: #555;
    border-top: 1px solid #e5e5e5;
    padding-top: 1rem;
  }
  .fr-actions-buttons {
    display: flex;
    gap: 1rem;
  }
  .fr-action-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    font-size: 14px;
    text-decoration: none;
    border-radius: 4px;
    transition: opacity 0.2s ease;
  }
  .fr-action-btn:hover {
    opacity: 0.8;
  }
  .fr-btn-primary {
    background: #000;
    color: #fff;
  }
  .fr-btn-secondary {
    background: #fff;
    color: #000;
    border: 1px solid #e0e0e0;
    gap: 0.5rem;
  }
  .fr-status-dot {
    width: 8px;
    height: 8px;
    background-color: #4CAF50;
    border-radius: 50%;
    display: inline-block;
  }
  /* When only one button, don't stretch full width */
  .fr-actions-buttons:has(:only-child) .fr-action-btn {
    flex: none;
    padding-left: 2rem;
    padding-right: 2rem;
  }
</style>

{% schema %}
{
  "name": "FR - Custom Actions",
  "settings": [
    {
      "type": "textarea",
      "id": "note_text",
      "label": "Note Text (above buttons)",
      "default": "Made to your exact wall. Order yourself if you have the dimensions, or get expert help with measuring, paper finish, and preview."
    },
    {
      "type": "header",
      "content": "Primary Button (Order)"
    },
    {
      "type": "checkbox",
      "id": "show_order_button",
      "label": "Show Order Button",
      "default": true
    },
    {
      "type": "text",
      "id": "order_text",
      "label": "Primary Button Text",
      "default": "Order directly"
    },
    {
      "type": "url",
      "id": "order_link",
      "label": "Primary Button Link"
    },
    {
      "type": "header",
      "content": "Specialist Button"
    },
    {
      "type": "text",
      "id": "specialist_text",
      "label": "Specialist Button Text",
      "default": "Talk to a specialist"
    },
    {
      "type": "url",
      "id": "specialist_link",
      "label": "Specialist Link"
    },
    {
      "type": "checkbox",
      "id": "use_whatsapp",
      "label": "Use WhatsApp Link",
      "default": false,
      "info": "Overrides the Specialist Link above with a WhatsApp link."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number (with country code)",
      "info": "e.g. 919650706644",
      "default": "919310845706"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp Pre-filled Message",
      "default": "Hi, I'd like to know more about this wallpaper."
    },
    {
      "type": "header",
      "content": "Block Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "FR - Custom Actions"
    }
  ]
}
{% endschema %}
