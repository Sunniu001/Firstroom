<div class="fr-stepper-container" style="margin-top: {{ block.settings.padding_top }}px; margin-bottom: {{ block.settings.padding_bottom }}px;" {{ block.shopify_attributes }}>
  <div class="fr-stepper">
    <div class="fr-step">
      <div class="fr-step-circle">1</div>
      <div class="fr-step-label">{{ block.settings.step_1_text }}</div>
    </div>
    <div class="fr-step-line"></div>
    <div class="fr-step">
      <div class="fr-step-circle">2</div>
      <div class="fr-step-label">{{ block.settings.step_2_text }}</div>
    </div>
    <div class="fr-step-line"></div>
    <div class="fr-step">
      <div class="fr-step-circle">3</div>
      <div class="fr-step-label">{{ block.settings.step_3_text }}</div>
    </div>
    <div class="fr-step-line"></div>
    <div class="fr-step">
      <div class="fr-step-circle">4</div>
      <div class="fr-step-label">{{ block.settings.step_4_text }}</div>
    </div>
  </div>
</div>

<style>
  .fr-stepper-container {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }
  .fr-stepper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .fr-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    z-index: 2;
  }
  .fr-step-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    background: #fff;
  }
  .fr-step-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    color: #666;
  }
  .fr-step-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(0,0,0,0.2);
    margin: 0 10px;
    margin-top: -15px; /* adjust to align with circles */
  }
</style>

{% schema %}
{
  "name": "FR - Progress Stepper",
  "settings": [
    { "type": "header", "content": "Steps Text" },
    { "type": "text", "id": "step_1_text", "label": "Step 1 Text", "default": "Enter size" },
    { "type": "text", "id": "step_2_text", "label": "Step 2 Text", "default": "Digital preview" },
    { "type": "text", "id": "step_3_text", "label": "Step 3 Text", "default": "Production" },
    { "type": "text", "id": "step_4_text", "label": "Step 4 Text", "default": "Delivered" },
    { "type": "header", "content": "Block Padding" },
    { "type": "range", "id": "padding_top", "label": "Top Padding", "min": 0, "max": 100, "step": 4, "default": 0, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom Padding", "min": 0, "max": 100, "step": 4, "default": 32, "unit": "px" }
  ],
  "presets": [
    {
      "name": "FR - Progress Stepper"
    }
  ]
}
{% endschema %}
