{%- doc -%}
  Variant picker styles consolidated into a single snippet for reliable CSS subsetting.
  Rendered from both the variant-main-picker snippet (product pages, where the picker
  originally renders) and from the product-card-related blocks and sections that can
  spawn a quick-add modal (collection/search pages), so the dropdown variant picker
  styles are available when the quick-add modal injects a variant picker via fetched
  product page HTML.

  @example
  {% render 'variant-picker-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* Variant picker container styles - unique to main variant picker */
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  /* Dropdown variant option styles */
  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-variant-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
    color: var(--color-variant-text);
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
    color: var(--color-variant-hover-text);
  }

  .variant-option__select-wrapper:hover .variant-option__select {
    background-color: var(--color-variant-hover-background);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    background-color: var(--color-variant-background);
    color: inherit;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  /* Variant picker alignment modifiers */
  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }
  
  /* Custom Material Finish Cards */
  .fr-material-option-group {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 15px;
    width: 100%;
  }
  .fr-material-option-group > label {
    display: flex;
    flex: 1 1 0;
    min-width: 140px;
  }
  .fr-material-option-group .variant-option__button-label {
    padding: 0 !important;
    border: none !important;
    background: none !important;
    margin: 0 !important;
    min-width: unset !important;
    overflow: visible !important;
    width: 100%;
  }
  .fr-material-option-group .variant-option__button-label::before,
  .fr-material-option-group .variant-option__button-label::after,
  .fr-material-option-group .variant-option__button-label__pill {
    display: none !important;
  }
  .fr-custom-finish-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    border: 1px solid #e5e5e5;
    border-radius: 4px;
    cursor: pointer;
    background: #fff;
    transition: all 0.2s;
    position: relative;
    white-space: normal;
  }
  .fr-finish-image {
    height: 85px;
    position: relative;
    background-color: #f5f5f5;
    border-radius: 3px 3px 0 0;
  }
  .fr-finish-image.fr-finish-feather-finish, .fr-finish-image.fr-finish-canvas { background: url("https://cdn.shopify.com/s/files/1/0777/1183/5294/files/feather_textured_png.png?v=1786202640") center/cover no-repeat; }
  .fr-finish-image.fr-finish-leather-finish, .fr-finish-image.fr-finish-handmade { background: url("https://cdn.shopify.com/s/files/1/0777/1183/5294/files/leather_textured.png?v=1786202640") center/cover no-repeat; }
  .fr-finish-image.fr-finish-line-texture, .fr-finish-image.fr-finish-sandstone { background: url("https://cdn.shopify.com/s/files/1/0777/1183/5294/files/line_textured.png?v=1786202640") center/cover no-repeat; }
  .fr-finish-image.fr-finish-silk-sheen { background: url("https://cdn.shopify.com/s/files/1/0885/8739/9478/files/silk.jpg") center/cover no-repeat; }
  .fr-finish-image.fr-finish-velvet { background: url("https://cdn.shopify.com/s/files/1/0777/1183/5294/files/variant-wizard-material-velvet-ef4c4671-637a-4191-9be2-6517403d49cd.png?v=1783444308") center/cover no-repeat; }

  .fr-finish-image.fr-size-16-x-20-inches { background: url("https://cdn.shopify.com/s/files/1/0777/1183/5294/files/Frame_Large_Variant.jpg?v=1783710158") center/cover no-repeat; }
  .fr-finish-image.fr-size-12-x-16-inches { background: url("https://cdn.shopify.com/s/files/1/0777/1183/5294/files/Frame_Medium_Variant.jpg?v=1783710157") center/cover no-repeat; }
  .fr-finish-image.fr-size-10-x-12-inches { background: url("https://cdn.shopify.com/s/files/1/0777/1183/5294/files/Frame_Small_Variant.jpg?v=1783710157") center/cover no-repeat; }
  
  .fr-finish-check {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 22px !important;
    height: 22px !important;
    color: #000;
    opacity: 0;
    transition: opacity 0.2s;
  }
  
  input:checked + .fr-custom-finish-card .fr-finish-check { opacity: 1; }
  input:checked + .fr-custom-finish-card { border-color: #b58c67; box-shadow: 0 0 0 1px #b58c67; }
  
  .fr-finish-content { padding: 12px 14px; text-align: left; border-radius: 0 0 3px 3px; }
  .fr-finish-title { font-size: 14px; color: #111; font-weight: 500; margin-bottom: 2px; }
  .fr-finish-tag { font-size: 10px; color: #888; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.5px; }
  .fr-finish-desc { font-size: 11px; color: #666; font-style: italic; margin-bottom: 12px; line-height: 1.3; }
  .fr-finish-divider { width: 100%; height: 1px; background-color: #eee; margin-bottom: 12px; }
  .fr-finish-sub { font-size: 10px; color: #888; line-height: 1.4; }
  
  /* Frame Size Placeholders */
  .fr-finish-image.fr-size-16x20, .fr-finish-image.fr-size-16-x-20 { background: url("https://cdn.shopify.com/s/files/1/0777/1183/5294/files/placeholder-16x20.png") center/cover no-repeat, #e0e0e0; }
  .fr-finish-image.fr-size-12x16, .fr-finish-image.fr-size-12-x-16 { background: url("https://cdn.shopify.com/s/files/1/0777/1183/5294/files/placeholder-12x16.png") center/cover no-repeat, #eaeaea; }
  .fr-finish-image.fr-size-10x12, .fr-finish-image.fr-size-10-x-12 { background: url("https://cdn.shopify.com/s/files/1/0777/1183/5294/files/placeholder-10x12.png") center/cover no-repeat, #f0f0f0; }
  
  /* Nameplate Size Placeholders */
  .fr-finish-image.fr-size-nameplate-17x8-inches, .fr-finish-image.fr-size-nameplate-17-x-8-inches { background: #e6e6e6; }
  .fr-finish-image.fr-size-nameplate-12x5-inches, .fr-finish-image.fr-size-nameplate-12-x-5-inches { background: #f2f2f2; }

  /* Mobile Variant Picker Layout & Size Reduction */
  @media (max-width: 767px) {
    .fr-material-option-group {
      gap: 10px;
    }
    .fr-material-option-group > label {
      flex: 1 1 calc(50% - 6px);
      max-width: calc(50% - 5px);
      min-width: 130px;
    }
    .fr-custom-finish-card {
      width: 100%;
      min-width: 0;
    }
    .fr-finish-image {
      height: 65px;
    }
    .fr-finish-content {
      padding: 8px 10px;
    }
    .fr-finish-title {
      font-size: 13px;
      margin-bottom: 2px;
    }
    .fr-finish-tag {
      font-size: 9px;
      margin-bottom: 4px;
    }
    .fr-finish-desc {
      font-size: 10.5px;
      margin-bottom: 6px;
      line-height: 1.25;
    }
    .fr-finish-divider {
      margin-bottom: 6px;
    }
    .fr-finish-sub {
      font-size: 9px;
    }
  }

  /* ========================================================
     FIRST ROOM - REDESIGNED FRAME VARIANT PICKER
     ======================================================== */
  .fr-option-legend {
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0.15em !important;
    text-transform: uppercase !important;
    color: #111 !important;
    margin-bottom: 12px !important;
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    padding: 0 !important;
  }
  .fr-frame-legend {
    letter-spacing: 0.12em !important;
  }
  .fr-option-divider {
    color: #888;
    margin: 0 2px;
    font-weight: 300;
  }
  .fr-frame-selected-title {
    color: #111;
    font-weight: 500;
    text-transform: capitalize;
  }

  /* 1. Size Buttons */
  .fr-size-buttons-group {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    margin-bottom: 18px;
  }
  .fr-size-btn-label {
    display: inline-flex !important;
    position: relative !important;
    cursor: pointer !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    background: none !important;
    min-width: unset !important;
    overflow: visible !important;
    flex: 1 1 0;
    max-width: 120px;
  }
  .fr-size-btn-label::before,
  .fr-size-btn-label::after,
  .fr-size-btn-label .variant-option__button-label__pill {
    display: none !important;
  }
  .fr-size-btn-label input[type="radio"] {
    position: absolute !important;
    opacity: 0 !important;
    width: 0 !important;
    height: 0 !important;
    pointer-events: none !important;
    margin: 0 !important;
  }
  .fr-size-btn-text {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 80px;
    height: 52px;
    padding: 6px 10px;
    border: 1px solid #000;
    background-color: #fff;
    color: #000;
    text-transform: uppercase;
    transition: all 0.15s ease;
    user-select: none;
    box-sizing: border-box;
    gap: 3px;
  }
  .fr-size-code {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.05em;
  }
  .fr-size-dim {
    font-size: 10.5px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    opacity: 0.8;
    text-transform: none;
  }
  .fr-size-btn-label:hover input:not(:checked) + .fr-size-btn-text {
    background-color: #f7f7f7;
  }
  .fr-size-btn-label input:checked + .fr-size-btn-text {
    background-color: #000 !important;
    color: #fff !important;
    border-color: #000 !important;
  }
  .fr-size-btn-label input:checked + .fr-size-btn-text .fr-size-dim {
    color: #f0f0f0 !important;
    opacity: 0.9 !important;
  }

  /* 2. Material Buttons */
  .fr-material-buttons-group {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    margin-bottom: 18px;
  }
  .fr-material-btn-label {
    display: inline-flex !important;
    position: relative !important;
    cursor: pointer !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    background: none !important;
    min-width: unset !important;
    overflow: visible !important;
  }
  .fr-material-btn-label::before,
  .fr-material-btn-label::after,
  .fr-material-btn-label .variant-option__button-label__pill {
    display: none !important;
  }
  .fr-material-btn-label input[type="radio"] {
    position: absolute !important;
    opacity: 0 !important;
    width: 0 !important;
    height: 0 !important;
    pointer-events: none !important;
    margin: 0 !important;
  }
  .fr-material-btn-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 22px;
    border: 1px solid #000;
    background-color: #fff;
    color: #000;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: all 0.15s ease;
    user-select: none;
    box-sizing: border-box;
  }
  .fr-material-btn-label:hover input:not(:checked) + .fr-material-btn-text {
    background-color: #f7f7f7;
  }
  .fr-material-btn-label input:checked + .fr-material-btn-text {
    background-color: #000 !important;
    color: #fff !important;
    border-color: #000 !important;
  }

  /* 3. Frame Image Swatches Carousel */
  .fr-frame-carousel-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    position: relative;
    margin-bottom: 18px;
  }
  .fr-frame-nav-btn {
    width: 32px;
    height: 32px;
    min-width: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e0e0e0;
    background: #fff;
    color: #111;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    flex-shrink: 0;
  }
  .fr-frame-nav-btn:hover {
    border-color: #111;
    background: #f9f9f9;
  }
  .fr-frame-swatches-row {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 3px 0;
    width: 100%;
  }
  .fr-frame-swatches-row::-webkit-scrollbar {
    display: none;
  }
  .fr-frame-swatch-label {
    display: block !important;
    position: relative !important;
    cursor: pointer !important;
    flex-shrink: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    background: none !important;
    min-width: unset !important;
    overflow: visible !important;
  }
  .fr-frame-swatch-label::before,
  .fr-frame-swatch-label::after,
  .fr-frame-swatch-label .variant-option__button-label__pill {
    display: none !important;
  }
  .fr-frame-swatch-label input[type="radio"] {
    position: absolute !important;
    opacity: 0 !important;
    width: 0 !important;
    height: 0 !important;
    pointer-events: none !important;
    margin: 0 !important;
  }
  .fr-frame-swatch-box {
    width: 78px;
    height: 78px;
    padding: 3px;
    background: #fff;
    border: 1.5px solid #d5d5d5;
    transition: all 0.15s ease;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fr-frame-swatch-label:hover input:not(:checked) + .fr-frame-swatch-box {
    border-color: #888;
  }
  .fr-frame-swatch-label input:checked + .fr-frame-swatch-box {
    border: 2px solid #000 !important;
    box-shadow: 0 1px 6px rgba(0,0,0,0.12);
  }
  .fr-frame-swatch-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 767px) {
    .fr-option-legend {
      font-size: 12px !important;
      margin-bottom: 10px !important;
    }
    .fr-size-buttons-group {
      gap: 8px;
    }
    .fr-size-btn-label {
      max-width: none;
    }
    .fr-size-btn-text {
      width: 100%;
      min-width: 65px;
      height: 48px;
      padding: 5px 6px;
      gap: 2px;
    }
    .fr-size-code {
      font-size: 12px;
    }
    .fr-size-dim {
      font-size: 9.5px;
    }
    .fr-material-btn-text {
      height: 40px;
      padding: 0 16px;
      font-size: 11px;
    }
    .fr-frame-swatch-box {
      width: 70px;
      height: 70px;
    }
    .fr-frame-nav-btn {
      width: 28px;
      height: 28px;
      min-width: 28px;
    }
  }
{% endstylesheet %}
