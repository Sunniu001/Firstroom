{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  # Custom styling applies to:
  #   - dropdowns + buttons when variant_style_class == 'custom' (unselected colors)
  #   - buttons only when selected_variant_style_class == 'custom' (selected colors)
  # The 'buttons' label is kept for backwards-compat of the class name.
  assign has_custom_variant_buttons = false
  if block_settings.variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  if block_settings.variant_style == 'buttons' and block_settings.selected_variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  assign fieldset_index = 0
%}

{% liquid
  assign is_nameplate = false
  assign product_type_downcase = product_resource.type | downcase
  assign product_title_downcase = product_resource.title | downcase
  if product_resource.tags contains 'nameplate' or product_type_downcase contains 'nameplate' or product_title_downcase contains 'nameplate'
    assign is_nameplate = true
  endif

  assign is_frame = false
  if template.suffix == 'frame' or product_resource.template_suffix == 'frame' or product_resource.tags contains 'frame' or product_type_downcase contains 'frame' or product_title_downcase contains 'frame'
    unless is_nameplate
      assign is_frame = true
    endunless
  endif

  for opt in product_resource.options_with_values
    assign opt_name_d = opt.name | downcase
    if opt_name_d == 'frame size'
      unless is_nameplate
        assign is_frame = true
      endunless
    endif
  endfor

  assign has_frame_size_option = false
  assign has_material_option = false
  assign has_frame_type_option = false
  for opt in product_resource.options_with_values
    assign opt_name_d = opt.name | downcase
    if opt_name_d contains 'size' or opt_name_d == 'frame size'
      assign has_frame_size_option = true
    elsif opt_name_d contains 'material' or opt_name_d contains 'paper' or opt_name_d contains 'finish'
      assign has_material_option = true
    elsif opt_name_d contains 'frame' and opt_name_d != 'frame size'
      assign has_frame_type_option = true
    endif
  endfor
%}

{% unless product_resource.has_only_default_variant %}
  {% if has_custom_variant_buttons %}
    {% render 'variant-button-custom-styles', block_settings: block_settings, block_id: block.id %}
  {% endif %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}{% if has_custom_variant_buttons %} variant-picker--custom-{{ block.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: block_settings %}
       {% if block_settings.option_label_text_color != blank %}
        --variant-option-label-color: rgba({{ block_settings.option_label_text_color.rgba }});
        --variant-option-label-color-subdued: rgba({{ block_settings.option_label_text_color.rgb }} / var(--opacity-subdued-text));
      {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- if product_option.values.size == 1 and variant_style != 'swatch' and is_frame == false -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' or is_frame -%}
          {%- assign option_name_downcased = product_option.name | downcase -%}

          {%- assign is_frame_size = false -%}
          {%- assign is_frame_material = false -%}
          {%- assign is_frame_type = false -%}
          {%- assign is_nameplate_size = false -%}

          {%- if is_frame -%}
            {%- if option_name_downcased contains 'size' or option_name_downcased == 'frame size' -%}
              {%- assign is_frame_size = true -%}
            {%- elsif option_name_downcased contains 'material' or option_name_downcased contains 'paper' or option_name_downcased contains 'finish' -%}
              {%- assign is_frame_material = true -%}
            {%- elsif option_name_downcased contains 'frame' and option_name_downcased != 'frame size' -%}
              {%- assign is_frame_type = true -%}
            {%- endif -%}
          {%- elsif is_nameplate -%}
            {%- if option_name_downcased == 'size' or option_name_downcased == 'nameplate size' -%}
              {%- assign is_nameplate_size = true -%}
            {%- endif -%}
          {%- endif -%}

          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend class="{% if is_frame %}fr-option-legend{% if is_frame_type %} fr-frame-legend{% endif %}{% endif %}">
              {%- if is_frame_type -%}
                Frame <span class="fr-option-divider">—</span> <span class="fr-frame-selected-title">{{ product_option.selected_value }}</span>
              {%- elsif is_frame_size -%}
                Size
              {%- elsif is_frame_material -%}
                Material
              {%- else -%}
                {{ product_option.name | escape -}}
                {%- if variant_style == 'swatch' -%}
                  <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
                {%- endif %}
              {%- endif -%}
            </legend>

            {%- if is_frame_size -%}
              <div class="fr-size-buttons-group">
            {%- elsif is_frame_material -%}
              <div class="fr-material-buttons-group">
            {%- elsif is_frame_type -%}
              <div class="fr-frame-carousel-wrapper">
                <button type="button" class="fr-frame-nav-btn fr-frame-nav-prev" aria-label="Previous frame" onclick="this.parentElement.querySelector('.fr-frame-swatches-row').scrollBy({left: -180, behavior: 'smooth'})">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <div class="fr-frame-swatches-row">
            {%- elsif option_name_downcased == 'material' or option_name_downcased == 'paper finish' -%}
              <div class="fr-material-option-group">
            {%- elsif is_nameplate_size -%}
              <div class="fr-material-option-group">
            {%- endif -%}

            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}

              {%- if is_frame_size -%}
                {%- assign raw_val = product_option_value | escape -%}
                {%- assign raw_val_clean = raw_val | downcase | replace: ' ', '' | replace: '×', 'x' | replace: '"', '' -%}
                {%- assign display_size = raw_val -%}
                {%- assign display_dim = '' -%}
                {%- if raw_val_clean contains '10x12' or raw_val_clean == 'small' or raw_val_clean == 's' -%}
                  {%- assign display_size = 'S' -%}
                  {%- assign display_dim = '10 x 12 in' -%}
                {%- elsif raw_val_clean contains '12x16' or raw_val_clean == 'medium' or raw_val_clean == 'm' -%}
                  {%- assign display_size = 'M' -%}
                  {%- assign display_dim = '12 x 16 in' -%}
                {%- elsif raw_val_clean contains '16x20' or raw_val_clean == 'large' or raw_val_clean == 'l' -%}
                  {%- assign display_size = 'L' -%}
                  {%- assign display_dim = '16 x 20 in' -%}
                {%- elsif raw_val_clean contains '18x24' or raw_val_clean == 'xl' or raw_val_clean == 'extralarge' -%}
                  {%- assign display_size = 'XL' -%}
                  {%- assign display_dim = '18 x 24 in' -%}
                {%- endif -%}
                <label class="fr-size-btn-label">
                  <input
                    type="radio"
                    name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                    value="{{ product_option_value | escape }}"
                    aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                    {% if product_option_value.available == false %}aria-disabled="true"{% endif %}
                    data-previous-checked="false"
                    data-fieldset-index="{{ fieldset_index }}"
                    data-input-index="{{ forloop.index0 }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-option-available="{{ product_option_value.available }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.variant.id %}data-variant-id="{{ product_option_value.variant.id }}"{% endif %}
                    {% if product_option_value.selected %}data-current-checked="true" checked{% else %}data-current-checked="false"{% endif %}
                  >
                  <span class="fr-size-btn-text" title="{{ product_option_value | escape }}">
                    <span class="fr-size-code">{{ display_size }}</span>
                    {%- if display_dim != blank -%}
                      <span class="fr-size-dim">{{ display_dim }}</span>
                    {%- endif -%}
                  </span>
                </label>

              {%- elsif is_frame_material -%}
                <label class="fr-material-btn-label">
                  <input
                    type="radio"
                    name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                    value="{{ product_option_value | escape }}"
                    aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                    {% if product_option_value.available == false %}aria-disabled="true"{% endif %}
                    data-previous-checked="false"
                    data-fieldset-index="{{ fieldset_index }}"
                    data-input-index="{{ forloop.index0 }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-option-available="{{ product_option_value.available }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.variant.id %}data-variant-id="{{ product_option_value.variant.id }}"{% endif %}
                    {% if product_option_value.selected %}data-current-checked="true" checked{% else %}data-current-checked="false"{% endif %}
                  >
                  <span class="fr-material-btn-text">{{ product_option_value | escape }}</span>
                </label>

              {%- elsif is_frame_type -%}
                {%- liquid
                  assign frame_handle = product_option_value | handleize
                  assign frame_image_url = ''
                  if product_option_value.variant.featured_media != blank
                    assign frame_image_url = product_option_value.variant.featured_media | image_url: width: 240
                  elsif product_option_value.swatch.image != blank
                    assign frame_image_url = product_option_value.swatch.image | image_url: width: 240
                  endif

                  if frame_image_url == blank
                    if frame_handle contains 'white'
                      assign frame_image_url = 'frame-corner-white.jpg' | asset_url
                    elsif frame_handle contains 'black'
                      assign frame_image_url = 'frame-corner-black.jpg' | asset_url
                    elsif frame_handle contains 'light' or frame_handle contains 'natural'
                      assign frame_image_url = 'frame-corner-light-wood.jpg' | asset_url
                    elsif frame_handle contains 'dark' or frame_handle contains 'walnut'
                      assign frame_image_url = 'frame-corner-dark-wood.jpg' | asset_url
                    else
                      if forloop.index == 1
                        assign frame_image_url = 'frame-corner-white.jpg' | asset_url
                      elsif forloop.index == 2
                        assign frame_image_url = 'frame-corner-black.jpg' | asset_url
                      elsif forloop.index == 3
                        assign frame_image_url = 'frame-corner-light-wood.jpg' | asset_url
                      elsif forloop.index == 4
                        assign frame_image_url = 'frame-corner-dark-wood.jpg' | asset_url
                      else
                        assign frame_image_url = 'frame-corner-white.jpg' | asset_url
                      endif
                    endif
                  endif
                -%}
                <label class="fr-frame-swatch-label">
                  <input
                    type="radio"
                    name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                    value="{{ product_option_value | escape }}"
                    data-frame-title="{{ product_option_value | escape }}"
                    aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                    {% if product_option_value.available == false %}aria-disabled="true"{% endif %}
                    data-previous-checked="false"
                    data-fieldset-index="{{ fieldset_index }}"
                    data-input-index="{{ forloop.index0 }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-option-available="{{ product_option_value.available }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.variant.id %}data-variant-id="{{ product_option_value.variant.id }}"{% endif %}
                    {% if product_option_value.selected %}data-current-checked="true" checked{% else %}data-current-checked="false"{% endif %}
                  >
                  <div class="fr-frame-swatch-box" title="{{ product_option_value | escape }}">
                    <img src="{{ frame_image_url }}" alt="{{ product_option_value | escape }}" class="fr-frame-swatch-img" loading="lazy" width="80" height="80">
                  </div>
                </label>

              {%- else -%}
                <label
                  class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
                >
                  <input
                    type="radio"
                    name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                    value="{{ product_option_value | escape }}"
                    aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                    {% if product_option_value.available == false %}
                      aria-disabled="true"
                    {% endif %}
                    data-previous-checked="false"
                    data-fieldset-index="{{ fieldset_index }}"
                    data-input-index="{{ forloop.index0 }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-option-available="{{ product_option_value.available }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.variant.id %}
                      data-variant-id="{{ product_option_value.variant.id }}"
                    {% endif %}
                    {% if product_option_value.selected %}
                      data-current-checked="true"
                      checked
                    {% else %}
                      data-current-checked="false"
                    {% endif %}
                  >
                  {% if option_name_downcased == 'material' or option_name_downcased == 'paper finish' %}
                    {% assign finish_name = product_option_value | escape %}
                    <div class="fr-custom-finish-card">
                      {% liquid
                        assign bg_image = product_option_value.variant.featured_media
                        assign bg_style = ''
                        if bg_image != blank
                          assign bg_image_url = bg_image | image_url: width: 300
                          assign bg_style = 'background: url(' | append: bg_image_url | append: ') center/cover no-repeat;'
                        endif
                      %}
                      <div class="fr-finish-image fr-finish-{{ finish_name | handleize }}" {% if bg_style != blank %}style="{{ bg_style }}"{% endif %}>
                        <svg class="fr-finish-check" viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="10" fill="#222"/><path d="M9 12l2 2 4-4" stroke="#fff" stroke-width="2" fill="none"/></svg>
                      </div>
                      <div class="fr-finish-content">
                        <div class="fr-finish-title">{{ finish_name }}</div>
                        <div class="fr-finish-tag">
                          {%- if finish_name == 'Feather Finish' or finish_name == 'Canvas' -%}PREMIUM
                          {%- elsif finish_name == 'Leather Finish' or finish_name == 'Handmade' -%}LUXURY
                          {%- else -%}SUPER LUXURY{%- endif -%}
                        </div>
                        <div class="fr-finish-desc">
                          {%- if finish_name == 'Feather Finish' or finish_name == 'Canvas' -%}Even texture, vibrant colors
                          {%- elsif finish_name == 'Leather Finish' or finish_name == 'Handmade' -%}Natural, earthy feel
                          {%- elsif finish_name == 'Silk Sheen' -%}Soft sheen and ultra premium
                          {%- else -%}Rough texture, painting look{%- endif -%}
                        </div>
                      </div>
                    </div>
                  {% elsif is_nameplate_size %}
                    {% assign finish_name = product_option_value | escape %}
                    <div class="fr-custom-finish-card">
                      {% liquid
                        assign bg_image = product_option_value.variant.featured_media
                        assign bg_style = ''
                        if finish_name contains '17x8' or finish_name contains '17 x 8'
                          assign bg_style = 'background: url(https://cdn.shopify.com/s/files/1/0777/1183/5294/files/d6742761-4600-411b-a398-1c4d115a6836_1.png?v=1783708142) center/cover no-repeat;'
                        elsif finish_name contains '12x5' or finish_name contains '12 x 5'
                          assign bg_style = 'background: url(https://cdn.shopify.com/s/files/1/0777/1183/5294/files/455389c9-482e-410d-b4c1-606028330f93_1.png?v=1783708142) center/cover no-repeat;'
                        elsif bg_image != blank
                          assign bg_image_url = bg_image | image_url: width: 300
                          assign bg_style = 'background: url(' | append: bg_image_url | append: ') center/cover no-repeat;'
                        endif
                      %}
                      <div class="fr-finish-image fr-size-nameplate-{{ finish_name | handleize }}" {% if bg_style != blank %}style="{{ bg_style }}"{% endif %}>
                        <svg class="fr-finish-check" viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="10" fill="#222"/><path d="M9 12l2 2 4-4" stroke="#fff" stroke-width="2" fill="none"/></svg>
                      </div>
                      <div class="fr-finish-content">
                        <div class="fr-finish-title">{{ finish_name }}</div>
                        <div class="fr-finish-tag">
                          {%- if finish_name contains '17x8' or finish_name contains '17 x 8' -%}LARGE
                          {%- else -%}STANDARD{%- endif -%}
                        </div>
                        <div class="fr-finish-desc">
                          {%- if finish_name contains '17x8' or finish_name contains '17 x 8' -%}Ideal for villas & large entrances
                          {%- else -%}Perfect for apartments & small homes{%- endif -%}
                        </div>
                      </div>
                    </div>
                  {% elsif variant_style == 'swatch' %}
                    {% liquid
                      assign featured_media = product_option_value.variant.featured_media

                      if featured_media == blank and product_option_value.product_url
                        assign featured_media = product_option_value.variant.product.featured_media
                      endif
                    %}

                    {% render 'swatch',
                      swatch: product_option_value.swatch,
                      variant_image: featured_media,
                      mode: 'unscaled'
                    %}
                  {% else %}
                    {% if product_option_value.available == true %}
                      <span
                        class="variant-option__button-label__pill"
                        data-key="variant-option-pill"
                      ></span>
                    {% endif %}
                    <span
                      class="variant-option__button-label__text"
                      data-key="variant-option-text"
                    >
                      {{- product_option_value | escape -}}
                    </span>
                  {% endif %}
                  {% render 'strikethrough-variant', product_option: product_option_value %}
                </label>
              {%- endif -%}
            {%- endfor -%}

            {%- if is_frame_size or is_frame_material -%}
              </div>
            {%- elsif is_frame_type -%}
                </div>
                <button type="button" class="fr-frame-nav-btn fr-frame-nav-next" aria-label="Next frame" onclick="this.parentElement.querySelector('.fr-frame-swatches-row').scrollBy({left: 180, behavior: 'smooth'})">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              </div>
            {%- elsif option_name_downcased == 'material' or option_name_downcased == 'paper finish' -%}
              </div>
            {%- elsif is_nameplate_size -%}
              </div>
            {%- endif -%}

            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if is_frame -%}
        {%- assign fr_product_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
        {%- unless has_material_option -%}
          <div class="variant-option variant-option--buttons fr-fallback-fieldset" role="group" data-property-group="Material">
            <div class="fr-option-legend">Material</div>
            <div class="fr-material-buttons-group">
              <label class="fr-material-btn-label">
                <input type="radio" name="properties[Material]" value="Matte Paper" form="{{ fr_product_form_id }}" checked>
                <span class="fr-material-btn-text">MATTE PAPER</span>
              </label>
              <label class="fr-material-btn-label">
