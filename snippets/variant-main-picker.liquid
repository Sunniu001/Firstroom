      <script>
        (function() {
          window.FR_FRAME_PREFS = window.FR_FRAME_PREFS || {
            material: 'Matte Paper',
            frame: 'White Fibre Frame'
          };

          var isSyncing = false;
          function syncFrameProperties() {
            if (isSyncing) return;
            isSyncing = true;
            try {
              // Apply saved preferences to all radio inputs
              var matRadios = document.querySelectorAll('.fr-material-buttons-group input[type="radio"], input[name="properties[Material]"][type="radio"]');
              matRadios.forEach(function(r) {
                if (r.value === window.FR_FRAME_PREFS.material) {
                  r.checked = true;
                } else {
                  r.checked = false;
                }
              });

              var frmRadios = document.querySelectorAll('.fr-frame-swatches-row input[type="radio"], input[name="properties[Frame]"][type="radio"]');
              frmRadios.forEach(function(r) {
                var title = r.getAttribute('data-frame-title') || r.value;
                if (title === window.FR_FRAME_PREFS.frame || r.value === window.FR_FRAME_PREFS.frame) {
                  r.checked = true;
                } else {
                  r.checked = false;
                }
              });

              // Update title only if different
              var frameTitleEl = document.querySelector('.fr-frame-selected-title');
              if (frameTitleEl && frameTitleEl.textContent !== window.FR_FRAME_PREFS.frame) {
                frameTitleEl.textContent = window.FR_FRAME_PREFS.frame;
              }

              // Sync to all hidden inputs in add to cart forms
              var hiddenMatInputs = document.querySelectorAll('.fr-active-property-material, input[name="properties[Material]"][type="hidden"]');
              hiddenMatInputs.forEach(function(input) {
                if (input.value !== window.FR_FRAME_PREFS.material) {
                  input.value = window.FR_FRAME_PREFS.material;
                }
              });

              var hiddenFrmInputs = document.querySelectorAll('.fr-active-property-frame, input[name="properties[Frame]"][type="hidden"]');
              hiddenFrmInputs.forEach(function(input) {
                if (input.value !== window.FR_FRAME_PREFS.frame) {
                  input.value = window.FR_FRAME_PREFS.frame;
                }
              });
            } finally {
              isSyncing = false;
            }
          }

          document.addEventListener('change', function(e) {
            if (e.target && e.target.type === 'radio') {
              var isMaterial = e.target.name === 'properties[Material]' || e.target.closest('.fr-material-buttons-group');
              var isFrame = e.target.name === 'properties[Frame]' || e.target.closest('.fr-frame-swatches-row');
              var isSize = e.target.closest('.fr-size-buttons-group') || (e.target.dataset && e.target.dataset.variantId);

              if (isMaterial) {
                window.FR_FRAME_PREFS.material = e.target.value;
                syncFrameProperties();
              } else if (isFrame) {
                var title = e.target.getAttribute('data-frame-title') || e.target.value;
                window.FR_FRAME_PREFS.frame = title;
                syncFrameProperties();
              } else if (isSize && e.target.dataset && e.target.dataset.variantId) {
                var newVarId = e.target.dataset.variantId;
                var idInputs = document.querySelectorAll('form[action*="/cart/add"] input[name="id"], product-form-component input[name="id"]');
                idInputs.forEach(function(inp) {
                  inp.value = newVarId;
                });
                try {
                  var url = new URL(window.location.href);
                  url.searchParams.set('variant', newVarId);
                  window.history.replaceState({}, '', url.toString());
                } catch(err) {}
              }
            }
          });

          // Also hook into form submit to make sure the inputs exist and are populated
          document.addEventListener('submit', function(e) {
            var form = e.target;
            if (form && (form.matches('form[action*="/cart/add"]') || form.dataset.type === 'add-to-cart-form')) {
              syncFrameProperties();

              // Ensure the selected variant ID is set
              var selectedSizeInput = document.querySelector('.fr-size-buttons-group input[type="radio"]:checked') ||
                                      document.querySelector('variant-picker input[data-variant-id]:checked');
              if (selectedSizeInput && selectedSizeInput.dataset && selectedSizeInput.dataset.variantId) {
                var idInput = form.querySelector('input[name="id"]');
                if (idInput) {
                  idInput.value = selectedSizeInput.dataset.variantId;
                }
              }

              var existMat = form.querySelector('input[name="properties[Material]"]');
              if (!existMat) {
                existMat = document.createElement('input');
                existMat.type = 'hidden';
                existMat.name = 'properties[Material]';
                form.appendChild(existMat);
              }
              existMat.value = window.FR_FRAME_PREFS.material;

              var existFrm = form.querySelector('input[name="properties[Frame]"]');
              if (!existFrm) {
                existFrm = document.createElement('input');
                existFrm.type = 'hidden';
                existFrm.name = 'properties[Frame]';
                form.appendChild(existFrm);
              }
              existFrm.value = window.FR_FRAME_PREFS.frame;
            }
          }, true);

          document.addEventListener('fr:variant-changed', syncFrameProperties);
          document.addEventListener('fr:variant-picker-updated', syncFrameProperties);
          document.addEventListener('shopify:section:load', syncFrameProperties);

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', syncFrameProperties);
          } else {
            syncFrameProperties();
          }
        })();
      </script>

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
      <script id="fr-variant-price-map" type="application/json">
        {%- liquid
           assign use_currency = settings.currency_code_enabled_product_pages
           assign is_wallpaper = false
           assign product_title_downcase = product_resource.title | downcase
           assign product_type_downcase = product_resource.type | downcase
           if product_resource.tags contains 'wallpaper' or product_type_downcase contains 'wallpaper' or product_title_downcase contains 'wallpaper'
             assign is_wallpaper = true
           endif
        -%}
        {
          {%- for variant in product_resource.variants -%}
            {%- liquid
              if use_currency
                assign formatted_price = variant.price | money_with_currency
                assign formatted_compare = variant.compare_at_price | money_with_currency
              else
                assign formatted_price = variant.price | money
                assign formatted_compare = variant.compare_at_price | money
              endif
              
              if is_wallpaper
                assign formatted_price = formatted_price | append: ' / sq. ft.'
                if variant.compare_at_price
                  assign formatted_compare = formatted_compare | append: ' / sq. ft.'
                endif
              endif
            -%}
            "{{ variant.id }}": {
              "price": {{ formatted_price | json }},
              "raw_price": {{ variant.price | json }},
              "compare_at_price": {% if variant.compare_at_price %}{{ formatted_compare | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      </script>
    </form>
  </variant-picker>
{% endunless %}

