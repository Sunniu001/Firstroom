<section class="fr-about-timeline" id="fr-about-timeline-{{ section.id }}" style="background-color: {{ section.settings.section_bg }};">
  <div class="fr-about-timeline__wrapper" style="
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    ">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-about-timeline__main-heading" style="text-align: {{ section.settings.heading_align }}; font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="fr-about-timeline__container">
      <div class="fr-about-timeline__line"></div>
      
      {%- for block in section.blocks -%}
        {%- assign is_even = forloop.index | modulo: 2 -%}
        
        <div class="fr-about-timeline__item {% if is_even == 0 %}fr-about-timeline__item--even{% else %}fr-about-timeline__item--odd{% endif %}" {{ block.shopify_attributes }}>
          
          <div class="fr-about-timeline__col-image">
            <div class="fr-about-timeline__image-wrapper" style="width: {{ section.settings.image_size }}px; height: {{ section.settings.image_size }}px;">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="fr-about-timeline__img">
              {%- else -%}
                <div class="fr-about-timeline__placeholder"></div>
              {%- endif -%}
            </div>
            <div class="fr-about-timeline__connector"></div>
          </div>
          
          <div class="fr-about-timeline__col-text">
            <div class="fr-about-timeline__text-content" style="background-color: {{ section.settings.text_bg_color }}; padding: {{ section.settings.text_padding }}px;">
              {%- if block.settings.title != blank -%}
                <h3 class="fr-about-timeline__title" style="font-size: {{ section.settings.title_size }}px; color: {{ section.settings.title_color }};">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="fr-about-timeline__body" style="font-size: {{ section.settings.text_size }}px; color: {{ section.settings.text_color }};">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
            </div>
          </div>
          
        </div>
      {%- endfor -%}
    </div>
    
  </div>
</section>

<style>
  #fr-about-timeline-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.7;
    width: 100%;
  }

  #fr-about-timeline-{{ section.id }} .fr-about-timeline__wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  .fr-about-timeline__main-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 60px;
    letter-spacing: 0.01em;
  }

  #fr-about-timeline-{{ section.id }} .fr-about-timeline__container {
    position: relative;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .fr-about-timeline__line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: {{ section.settings.line_color }};
    transform: translateX(-50%);
    z-index: 1;
  }

  @media (max-width: 767px) {
    .fr-about-timeline__line {
      left: 20px;
      transform: none;
    }
  }

  .fr-about-timeline__item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-bottom: 60px;
    position: relative;
    z-index: 2;
  }

  .fr-about-timeline__item:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 767px) {
    .fr-about-timeline__item {
      grid-template-columns: 1fr;
      margin-bottom: 40px;
    }
  }

  /* Odd Items (Image Left, Text Right) */
  .fr-about-timeline__item--odd .fr-about-timeline__col-image {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding-right: 40px;
    position: relative;
  }
  .fr-about-timeline__item--odd .fr-about-timeline__connector {
    position: absolute;
    right: 0;
    top: 50%;
    width: 40px;
    height: 1px;
    background-color: {{ section.settings.line_color }};
    z-index: 0;
  }
  .fr-about-timeline__item--odd .fr-about-timeline__col-text {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding-left: 40px;
  }

  /* Even Items (Text Left, Image Right) */
  .fr-about-timeline__item--even .fr-about-timeline__col-text {
    order: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding-right: 40px;
    text-align: right;
  }
  .fr-about-timeline__item--even .fr-about-timeline__col-image {
    order: 2;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding-left: 40px;
    position: relative;
  }
  .fr-about-timeline__item--even .fr-about-timeline__connector {
    position: absolute;
    left: 0;
    top: 50%;
    width: 40px;
    height: 1px;
    background-color: {{ section.settings.line_color }};
    z-index: 0;
  }

  /* Mobile Overrides */
  @media (max-width: 767px) {
    .fr-about-timeline__item--odd .fr-about-timeline__col-image,
    .fr-about-timeline__item--even .fr-about-timeline__col-image {
      order: 1;
      justify-content: flex-start;
      padding-left: 50px;
      padding-right: 0;
      margin-bottom: 20px;
    }
    .fr-about-timeline__item--odd .fr-about-timeline__col-text,
    .fr-about-timeline__item--even .fr-about-timeline__col-text {
      order: 2;
      justify-content: flex-start;
      padding-left: 50px;
      padding-right: 0;
      text-align: left;
    }
    .fr-about-timeline__item--odd .fr-about-timeline__connector,
    .fr-about-timeline__item--even .fr-about-timeline__connector {
      left: 20px;
      right: auto;
      width: 30px;
    }
  }

  .fr-about-timeline__image-wrapper {
    position: relative;
    border-radius: 50%;
    overflow: hidden;
    background-color: #faf8f5;
    z-index: 2;
    box-shadow: 0 0 0 4px {{ section.settings.section_bg }};
  }

  .fr-about-timeline__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .fr-about-timeline__placeholder {
    width: 100%;
    height: 100%;
    background-color: #e5e7eb;
  }

  .fr-about-timeline__text-content {
    max-width: 400px;
    position: relative;
    z-index: 2;
  }

  .fr-about-timeline__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin: 0 0 10px 0;
    letter-spacing: 0.01em;
  }

  .fr-about-timeline__body p {
    margin: 0 0 10px 0;
  }
  .fr-about-timeline__body p:last-child {
    margin-bottom: 0;
  }
</style>

{% schema %}
{
  "name": "FR About Timeline",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Honouring Craft"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Timeline Layout"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line Color",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Circle Image Size",
      "default": 160
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Title Size",
      "default": 22
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "text_bg_color",
      "label": "Text Background Color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "text_padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Text Box Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "timeline_item",
      "name": "Timeline Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Description for this step in the timeline.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR About Timeline",
      "blocks": [
        { "type": "timeline_item" },
        { "type": "timeline_item" },
        { "type": "timeline_item" }
      ]
    }
  ]
}
{% endschema %}
