<section class="fr-about-staggered" id="fr-about-staggered-{{ section.id }}" style="background-color: {{ section.settings.section_bg }};">
  <div class="fr-about-staggered__wrapper" style="
      --pt-d: {{ section.settings.padding_top }}px;
      --pb-d: {{ section.settings.padding_bottom }}px;
      --pl-d: {{ section.settings.padding_left }}px;
      --pr-d: {{ section.settings.padding_right }}px;
      --pt-m: {{ section.settings.padding_top_mobile | default: section.settings.padding_top }}px;
      --pb-m: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom }}px;
      --pl-m: {{ section.settings.padding_left_mobile | default: 20 }}px;
      --pr-m: {{ section.settings.padding_right_mobile | default: 20 }}px;
      --fz-mh-d: {{ section.settings.heading_size }}px;
      --fz-mh-m: {{ section.settings.heading_size_mobile | default: section.settings.heading_size | times: 0.8 | round }}px;
      --fz-t-d: {{ section.settings.title_size }}px;
      --fz-t-m: {{ section.settings.title_size_mobile | default: section.settings.title_size | times: 0.8 | round }}px;
      --fz-b-d: {{ section.settings.text_size }}px;
      --fz-b-m: {{ section.settings.text_size_mobile | default: section.settings.text_size }}px;
      --ta-d: {{ section.settings.text_align }};
      --ta-m: {{ section.settings.text_align_mobile | default: section.settings.text_align }};
      --img-w-m: {{ section.settings.image_max_width_mobile | default: 300 }}px;
    ">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-about-staggered__main-heading" style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="fr-about-staggered__container" style="
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: {{ section.settings.grid_gap }}px;
    ">
      {%- for block in section.blocks -%}
        <div class="fr-about-staggered__item" {{ block.shopify_attributes }} style="grid-column: {{ block.settings.column_start }}; transform: translateY({{ block.settings.offset_y }}px);">
          
          <div class="fr-about-staggered__image-wrapper">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="fr-about-staggered__img">
            {%- else -%}
              <div class="fr-about-staggered__placeholder"></div>
            {%- endif -%}
            
            {%- if block.settings.number != blank -%}
              <div class="fr-about-staggered__number">{{ block.settings.number }}</div>
            {%- endif -%}
          </div>

          {%- if block.settings.title != blank or block.settings.text != blank -%}
            <div class="fr-about-staggered__text-content">
              {%- if block.settings.title != blank -%}
                <h3 class="fr-about-staggered__title" style="color: {{ section.settings.title_color }};">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="fr-about-staggered__body" style="color: {{ section.settings.text_color }};">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
          
        </div>
      {%- endfor -%}
    </div>
    
  </div>
</section>

<style>
  #fr-about-staggered-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.7;
    width: 100%;
  }

  #fr-about-staggered-{{ section.id }} .fr-about-staggered__wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    padding-left: var(--pl-m);
    padding-right: var(--pr-m);
  }

  @media (min-width: 768px) {
    #fr-about-staggered-{{ section.id }} .fr-about-staggered__wrapper {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
      padding-left: var(--pl-d);
      padding-right: var(--pr-d);
    }
  }

  .fr-about-staggered__main-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 60px;
    letter-spacing: 0.01em;
    font-size: var(--fz-mh-m);
    text-align: {{ section.settings.heading_align_mobile | default: section.settings.heading_align }};
  }
  @media (min-width: 768px) {
    .fr-about-staggered__main-heading {
      font-size: var(--fz-mh-d);
      text-align: {{ section.settings.heading_align }};
    }
  }

  #fr-about-staggered-{{ section.id }} .fr-about-staggered__container {
    display: grid;
    grid-template-columns: 1fr;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    /* Desktop columns defined inline */
  }

  @media (max-width: 767px) {
    .fr-about-staggered__container {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
    .fr-about-staggered__item {
      grid-column: 1 / -1 !important;
      transform: none !important;
      max-width: var(--img-w-m);
      margin: 0 auto;
    }
  }

  .fr-about-staggered__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    align-self: start;
  }

  .fr-about-staggered__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background-color: #c4c4c4; /* Matching the gray from the mockup */
    margin-bottom: 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }

  .fr-about-staggered__img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }
  
  .fr-about-staggered__placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: #c4c4c4;
  }

  .fr-about-staggered__number {
    position: absolute;
    top: 0;
    left: 0;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #1a1a1a;
    background-color: transparent;
    padding: 10px;
  }

  .fr-about-staggered__text-content {
    text-align: var(--ta-m);
  }
  @media (min-width: 768px) {
    .fr-about-staggered__text-content {
      text-align: var(--ta-d);
    }
  }

  .fr-about-staggered__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin: 0 0 8px 0;
    letter-spacing: 0.01em;
    font-size: var(--fz-t-m);
  }
  @media (min-width: 768px) {
    .fr-about-staggered__title { font-size: var(--fz-t-d); }
  }

  .fr-about-staggered__body {
    margin: 0;
    font-size: var(--fz-b-m);
  }
  @media (min-width: 768px) {
    .fr-about-staggered__body { font-size: var(--fz-b-d); }
  }
</style>

{% schema %}
{
  "name": "FR About Staggered",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Our Process"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Desktop Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
