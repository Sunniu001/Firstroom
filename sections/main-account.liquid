</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var subtabs = document.querySelectorAll('.fr-orders__subtab');
    var subpanels = document.querySelectorAll('.fr-orders__subpanel');
    
    subtabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var targetPanel = this.getAttribute('data-orders-subtab');
        
        subtabs.forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        
        subpanels.forEach(function(panel) {
          if(panel.getAttribute('data-orders-subpanel') === targetPanel) {
            panel.classList.add('active');
            panel.style.display = 'block';
          } else {
            panel.classList.remove('active');
            panel.style.display = 'none';
          }
        });
      });
    });
  });

  function openOrderModal(orderId) {
    var modal = document.getElementById('fr-order-modal-' + orderId);
    if(modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  }

  function closeOrderModal(orderId) {
    var modal = document.getElementById('fr-order-modal-' + orderId);
    if(modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  (function() {
    function switchTab(tabId) {
      // Hide all panels
      document.querySelectorAll('.fr-account-panel').forEach(function(panel) {
        panel.classList.remove('active');
      });
      document.querySelectorAll('.fr-account-nav-btn').forEach(function(btn) {
        btn.classList.remove('active');
      });

      // Show target panel
      var targetPanel = document.querySelector('.fr-account-panel[data-panel="' + tabId + '"]');
      var targetBtn = document.querySelector('.fr-account-nav-btn[data-tab="' + tabId + '"]');

      if (targetPanel && targetBtn) {
        targetPanel.classList.add('active');
        targetBtn.classList.add('active');
      }
    }

    function initTabs() {
      // Set active tab based on URL Hash
      var hash = window.location.hash.replace('#', '') || 'orders';
      // Fallback/validation: check if hash is one of our tabs
      if (hash !== 'profile' && hash !== 'orders' && hash !== 'addresses' && hash !== 'password') {
        hash = 'orders';
      }
      switchTab(hash);

      // Bind tab links
      var tabButtons = document.querySelectorAll('.fr-account-nav-btn[data-tab]');
      tabButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var tab = this.getAttribute('data-tab');
          if (tab) {
            window.location.hash = tab;
            switchTab(tab);
          }
        });
      });

      // Handle popstate/hashchange
      window.addEventListener('hashchange', function() {
        var hash = window.location.hash.replace('#', '') || 'orders';
        if (hash === 'profile' || hash === 'orders' || hash === 'addresses' || hash === 'password') {
          switchTab(hash);
        }
      });

      // Bind Addresses Management Form Panel Toggles
      var toggleAddBtn = document.getElementById('toggle-add-address-btn');
      var addAddressPanel = document.getElementById('add-address-panel');
      var cancelAddBtn = document.querySelector('.cancel-add-btn');
      var listContainer = document.getElementById('address-list-container');

      if (toggleAddBtn && addAddressPanel) {
        toggleAddBtn.addEventListener('click', function() {
          addAddressPanel.classList.remove('hide');
          toggleAddBtn.classList.add('hide');
          if (listContainer) listContainer.classList.add('hide');
        });
      }

      if (cancelAddBtn && addAddressPanel && toggleAddBtn) {
        cancelAddBtn.addEventListener('click', function() {
          addAddressPanel.classList.add('hide');
          toggleAddBtn.classList.remove('hide');
          if (listContainer) listContainer.classList.remove('hide');
        });
      }

      var editButtons = document.querySelectorAll('[data-edit-address-id]');
      editButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = this.getAttribute('data-edit-address-id');
          var panel = document.getElementById('edit-address-panel-' + id);
          if (panel) {
            panel.classList.toggle('hide');
          }
        });
      });

      var cancelEditButtons = document.querySelectorAll('[data-cancel-address-id]');
      cancelEditButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = this.getAttribute('data-cancel-address-id');
          var panel = document.getElementById('edit-address-panel-' + id);
          if (panel) {
            panel.classList.add('hide');
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initTabs);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initTabs();
    }
  })();
</script>

