  }

  .fr-account__btn-primary {
    height: 48px;
    padding: 0 32px;
    background-color: #1a1a1a;
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    border: 1px solid #1a1a1a;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.25s ease;
    margin-top: 10px;
    font-family: 'Lato', system-ui, sans-serif;
  }

  .fr-account__btn-primary:hover {
    background-color: #ffffff;
    color: #1a1a1a;
  }

  /* ── My Order Table and Tabs ── */
  .fr-account__orders-tabs {
    display: flex;
    border-bottom: 1px solid #ebebeb;
    gap: 30px;
    margin-bottom: 24px;
  }

  .fr-account__orders-tab-btn {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #888;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 12px 0;
    cursor: pointer;
    font-family: 'Lato', system-ui, sans-serif;
    transition: all 0.2s ease;
