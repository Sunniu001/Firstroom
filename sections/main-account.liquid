<section class="fr-account" id="fr-account-{{ section.id }}">
  {%- if customer -%}
    <script>
      // Redirect to custom designed /pages/my-account page only if not already on it
      if (window.location.pathname !== '/pages/my-account') {
        window.location.replace('/pages/my-account' + window.location.hash);
      }
    </script>
    <div class="fr-account__container">
      
      <!-- Left Column: Sidebar -->
      <aside class="fr-account__sidebar">
        <div class="fr-account__user-info">
          <h2 class="fr-account__user-name">
            {{ customer.first_name | default: 'Account' }} {{ customer.last_name }}
          </h2>
          <p class="fr-account__user-email">{{ customer.email }}</p>
        </div>

        <nav class="fr-account__nav">
          <button type="button" class="fr-account__nav-btn fr-account-nav-btn" data-tab="profile">
            Account info
          </button>
          <button type="button" class="fr-account__nav-btn fr-account-nav-btn active" data-tab="orders">
            My order
          </button>
          <button type="button" class="fr-account__nav-btn fr-account-nav-btn" data-tab="addresses">
            My address
          </button>
          <button type="button" class="fr-account__nav-btn fr-account-nav-btn" data-tab="password">
            Change password
          </button>
          <a href="{{ routes.account_logout_url }}" class="fr-account__nav-link fr-account__nav-link--logout">
            Log Out
          </a>
        </nav>
      </aside>

      <!-- Right Column: Content Panel -->
      <main class="fr-account__content">
        
        <!-- Tab 1: Account Info -->
        <div class="fr-account__panel fr-account-panel" data-panel="profile">
          <h3 class="fr-account__panel-title">Account Info</h3>
          
          {%- if customer.default_address -%}
            {%- form 'customer_address', customer.default_address, class: 'fr-account__form' -%}
              <div class="fr-account__form-grid">
                <div class="fr-account__field">
                  <label for="profile-first-name">First Name <span class="required">*</span></label>
                  <input type="text" id="profile-first-name" name="address[first_name]" value="{{ customer.first_name }}" placeholder="First name" required>
                </div>
                <div class="fr-account__field">
                  <label for="profile-last-name">Last Name <span class="required">*</span></label>
                  <input type="text" id="profile-last-name" name="address[last_name]" value="{{ customer.last_name }}" placeholder="Last name" required>
                </div>
              </div>

              <div class="fr-account__field">
                <label for="profile-email">Email Address <span class="required">*</span></label>
                <input type="email" id="profile-email" value="{{ customer.email }}" placeholder="Email address" disabled class="disabled-field">
                <small class="field-hint">Email address cannot be changed. Please contact support if you need to update it.</small>
              </div>

              <div class="fr-account__field">
                <label for="profile-phone">Phone Number <span class="optional">(Optional)</span></label>
                <input type="tel" id="profile-phone" name="address[phone]" value="{{ customer.phone | default: customer.default_address.phone }}" placeholder="+91 XXXXXXXXXX">
              </div>

              <button type="submit" class="fr-account__btn-primary">SAVE CHANGES</button>
            {%- endform -%}
          {%- else -%}
            {%- form 'customer_address', customer.new_address, class: 'fr-account__form' -%}
              <input type="hidden" name="address[default]" value="true">
              <div class="fr-account__form-grid">
                <div class="fr-account__field">
                  <label for="profile-first-name-new">First Name <span class="required">*</span></label>
                  <input type="text" id="profile-first-name-new" name="address[first_name]" value="{{ customer.first_name }}" placeholder="First name" required>
                </div>
                <div class="fr-account__field">
                  <label for="profile-last-name-new">Last Name <span class="required">*</span></label>
                  <input type="text" id="profile-last-name-new" name="address[last_name]" value="{{ customer.last_name }}" placeholder="Last name" required>
                </div>
              </div>

              <div class="fr-account__field">
                <label for="profile-email-new">Email Address <span class="required">*</span></label>
                <input type="email" id="profile-email-new" value="{{ customer.email }}" placeholder="Email address" disabled class="disabled-field">
                <small class="field-hint">Email address cannot be changed. Please contact support if you need to update it.</small>
              </div>

              <div class="fr-account__field">
                <label for="profile-phone-new">Phone Number <span class="optional">(Optional)</span></label>
                <input type="tel" id="profile-phone-new" name="address[phone]" value="{{ customer.phone }}" placeholder="+91 XXXXXXXXXX">
              </div>

              <button type="submit" class="fr-account__btn-primary">SAVE CHANGES</button>
            {%- endform -%}
          {%- endif -%}
        </div>

        <!-- Tab 2: My Order -->
        <div class="fr-account__panel fr-account-panel active" data-panel="orders">
          <h3 class="fr-account__panel-title">My Orders</h3>
          
          <!-- Order Subtabs -->
          <div class="fr-orders__subtabs-container">
            <div class="fr-orders__subtabs">
              <button type="button" class="fr-orders__subtab active" data-orders-subtab="wallpaper">WALLPAPER</button>
              <button type="button" class="fr-orders__subtab" data-orders-subtab="homedecor">HOME DECOR</button>
            </div>
          </div>

          <!-- Wallpaper Orders Table Container -->
          <div class="fr-account__table-container fr-orders__subpanel active" data-orders-subpanel="wallpaper">
            <table class="fr-account__table">
              <thead>
                <tr>
                  <th>PRODUCTS</th>
                  <th class="text-center">SIZE IN SQ FEET</th>
                  <th class="text-center">PRICE</th>
                  <th class="text-center">STATUS</th>
                </tr>
              </thead>
              <tbody>
                {%- assign wallpaper_orders_exist = false -%}
                {%- for order in customer.orders -%}
                  {%- for line_item in order.line_items -%}
                    
                    {%- assign is_wallpaper = false -%}
                    {%- for property in line_item.properties -%}
                      {%- if property.first == 'Area (sq.ft)' or property.first == 'Height (ft)' or property.first == 'Width (ft)' or property.first == 'Area' -%}
                        {%- assign is_wallpaper = true -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign product_title_downcase = line_item.product.title | downcase -%}
                    {%- if line_item.product.tags contains 'wallpaper' or line_item.variant.sku contains 'FMWPAR' or product_title_downcase contains 'wallpaper' -%}
                      {%- assign is_wallpaper = true -%}
                    {%- endif -%}

                    {%- if is_wallpaper -%}
                      {%- assign wallpaper_orders_exist = true -%}
                      <tr>
                        <td class="fr-account__product-cell">
                          <div class="fr-account__product-info">
                            <div class="fr-account__product-img">
                              {%- if line_item.image != blank -%}
                                <img src="{{ line_item.image | image_url: width: 120 }}" alt="{{ line_item.title | escape }}" loading="lazy">
                              {%- else -%}
                                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                              {%- endif -%}
                            </div>
                            <div class="fr-account__product-meta">
                              <span class="fr-account__product-title">{{ line_item.product.title | default: line_item.title }}</span>
                              <span class="fr-account__order-date">{{ order.created_at | date: "%d %b %Y" }}</span>
                              <div class="fr-account__line-properties">
                                {%- for property in line_item.properties -%}
                                  {%- assign prop_first = property.first | downcase -%}
                                  {%- unless property.last == blank or prop_first == 'area' or prop_first == 'area (sq.ft)' -%}
                                    <span>
                                      {%- if prop_first contains 'height' -%}
                                        Height: {{ property.last }}
                                      {%- elsif prop_first contains 'width' -%}
                                        Width: {{ property.last }}
                                      {%- elsif prop_first contains 'material' -%}
                                        Material: {{ property.last }}
                                      {%- else -%}
                                        {{ property.first }}: {{ property.last }}
                                      {%- endif -%}
                                    </span>
                                  {%- endunless -%}
                                {%- endfor -%}
                              </div>
                            </div>
                          </div>
                        </td>
                        <td class="text-center">
                          {%- if line_item.properties['Area (sq.ft)'] != blank -%}
                            {{ line_item.properties['Area (sq.ft)'] }}
                          {%- elsif line_item.properties['Area'] != blank -%}
                            {{ line_item.properties['Area'] }}
                          {%- else -%}
                            {{ line_item.quantity }}.00
                          {%- endif -%}
                        </td>
                        <td class="text-center font-medium">
                          {{ line_item.final_line_price | money_without_trailing_zeros }}
                        </td>
                        <td class="text-center">
                          <div class="fr-account__status-col">
                            {%- if order.fulfillment_status == 'fulfilled' -%}
                              <span class="status-badge status-delivered">DELIVERED</span>
                            {%- else -%}
                              <span class="status-badge status-pending">PENDING</span>
                            {%- endif -%}
                            <button type="button" class="fr-account__details-link" onclick="openOrderModal('{{ order.id }}')" style="background:none; border:none; padding:0; cursor:pointer;">VIEW DETAILS</button>
                          </div>
                        </td>
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}

                {%- if wallpaper_orders_exist == false -%}
                  <tr>
                    <td colspan="4" class="text-center fr-account__empty-table">
                      No wallpaper orders found.
                    </td>
                  </tr>
                {%- endif -%}
              </tbody>
            </table>
          </div>

          <!-- Home Decor Orders Table Container -->
          <div class="fr-account__table-container fr-orders__subpanel" data-orders-subpanel="homedecor" style="display: none;">
            <table class="fr-account__table">
              <thead>
                <tr>
                  <th>PRODUCTS</th>
                  <th class="text-center">QUANTITY</th>
                  <th class="text-center">PRICE</th>
                  <th class="text-center">STATUS</th>
                </tr>
              </thead>
              <tbody>
                {%- assign homedecor_orders_exist = false -%}
                {%- for order in customer.orders -%}
                  {%- for line_item in order.line_items -%}
                    
                    {%- assign is_wallpaper = false -%}
                    {%- for property in line_item.properties -%}
                      {%- if property.first == 'Area (sq.ft)' or property.first == 'Height (ft)' or property.first == 'Width (ft)' or property.first == 'Area' -%}
                        {%- assign is_wallpaper = true -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign product_title_downcase = line_item.product.title | downcase -%}
                    {%- if line_item.product.tags contains 'wallpaper' or line_item.variant.sku contains 'FMWPAR' or product_title_downcase contains 'wallpaper' -%}
                      {%- assign is_wallpaper = true -%}
                    {%- endif -%}

                    {%- unless is_wallpaper -%}
                      {%- assign homedecor_orders_exist = true -%}
                      <tr>
                        <td class="fr-account__product-cell">
                          <div class="fr-account__product-info">
                            <div class="fr-account__product-img">
                              {%- if line_item.image != blank -%}
                                <img src="{{ line_item.image | image_url: width: 120 }}" alt="{{ line_item.title | escape }}" loading="lazy">
                              {%- else -%}
                                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                              {%- endif -%}
                            </div>
                            <div class="fr-account__product-meta">
                              <span class="fr-account__product-title">{{ line_item.product.title | default: line_item.title }}</span>
                              <span class="fr-account__order-date">{{ order.created_at | date: "%d %b %Y" }}</span>
                              <div class="fr-account__line-properties">
                                {%- for option in line_item.options_with_values -%}
                                  <span>{{ option.name }}: {{ option.value }}</span>
                                {%- endfor -%}
                                {%- for property in line_item.properties -%}
                                  {%- unless property.last == blank or property.first.first == '_' -%}
                                    <span>{{ property.first }}: {{ property.last }}</span>
                                  {%- endunless -%}
                                {%- endfor -%}
                              </div>
                            </div>
                          </div>
                        </td>
                        <td class="text-center">
                          {{ line_item.quantity }}
                        </td>
                        <td class="text-center font-medium">
                          {{ line_item.final_line_price | money_without_trailing_zeros }}
                        </td>
                        <td class="text-center">
                          <div class="fr-account__status-col">
                            {%- if order.fulfillment_status == 'fulfilled' -%}
                              <span class="status-badge status-delivered">DELIVERED</span>
                            {%- else -%}
                              <span class="status-badge status-pending">PENDING</span>
                            {%- endif -%}
                            <button type="button" class="fr-account__details-link" onclick="openOrderModal('{{ order.id }}')" style="background:none; border:none; padding:0; cursor:pointer;">VIEW DETAILS</button>
                          </div>
                        </td>
                      </tr>
                    {%- endunless -%}
                  {%- endfor -%}
                {%- endfor -%}

                {%- if homedecor_orders_exist == false -%}
                  <tr>
                    <td colspan="4" class="text-center fr-account__empty-table">
                      No home decor orders found.
                    </td>
                  </tr>
                {%- endif -%}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab 3: My Address (Merged Tab) -->
        <div class="fr-account__panel fr-account-panel" data-panel="addresses">
          <h3 class="fr-account__panel-title">My Address</h3>
          
          <div class="fr-addresses__action-bar">
            <button type="button" class="fr-account__btn-primary" id="toggle-add-address-btn">
              ADD NEW ADDRESS
            </button>
          </div>

          <!-- Add Address Form -->
          <div class="fr-addresses__form-panel hide" id="add-address-panel">
            <h4 class="fr-addresses__sub-title">Add New Address</h4>
            
            {%- form 'customer_address', customer.new_address, class: 'fr-account__form' -%}
              <input type="hidden" name="address[country]" value="India">
              
              <div class="fr-account__form-grid">
                <div class="fr-account__field">
                  <label for="AddressFirstNameNew">First Name <span class="required">*</span></label>
                  <input type="text" id="AddressFirstNameNew" name="address[first_name]" placeholder="First name" required>
                </div>
                <div class="fr-account__field">
                  <label for="AddressLastNameNew">Last Name <span class="required">*</span></label>
                  <input type="text" id="AddressLastNameNew" name="address[last_name]" placeholder="Last name" required>
                </div>
              </div>

              <div class="fr-account__form-grid">
                <div class="fr-account__field">
                  <label for="AddressEmailNew">Email <span class="required">*</span></label>
                  <input type="email" id="AddressEmailNew" value="{{ customer.email }}" disabled class="disabled-field">
                </div>
                <div class="fr-account__field">
                  <label for="AddressPhoneNew">Phone Number <span class="required">*</span></label>
                  <input type="tel" id="AddressPhoneNew" name="address[phone]" placeholder="+91 XXXXXXXXXX" required>
                </div>
              </div>

              <div class="fr-account__field">
                <label for="AddressAddress1New">Address <span class="required">*</span></label>
                <input type="text" id="AddressAddress1New" name="address[address1]" placeholder="Street address, Apartment, Suite, etc." required>
              </div>

              <div class="fr-account__form-grid">
                <div class="fr-account__field">
                  <label for="AddressCityNew">City <span class="required">*</span></label>
                  <input type="text" id="AddressCityNew" name="address[city]" placeholder="City" required>
                </div>
                <div class="fr-account__field">
                  <label for="AddressProvinceNew">State <span class="required">*</span></label>
                  <select id="AddressProvinceNew" name="address[province]" required>
                    <option value="" disabled selected>Select State</option>
                    <option value="Andhra Pradesh">Andhra Pradesh</option>
                    <option value="Arunachal Pradesh">Arunachal Pradesh</option>
                    <option value="Assam">Assam</option>
                    <option value="Bihar">Bihar</option>
                    <option value="Chhattisgarh">Chhattisgarh</option>
                    <option value="Goa">Goa</option>
                    <option value="Gujarat">Gujarat</option>
                    <option value="Haryana">Haryana</option>
                    <option value="Himachal Pradesh">Himachal Pradesh</option>
                    <option value="Jharkhand">Jharkhand</option>
                    <option value="Karnataka">Karnataka</option>
                    <option value="Kerala">Kerala</option>
                    <option value="Madhya Pradesh">Madhya Pradesh</option>
                    <option value="Maharashtra">Maharashtra</option>
                    <option value="Manipur">Manipur</option>
                    <option value="Meghalaya">Meghalaya</option>
                    <option value="Mizoram">Mizoram</option>
                    <option value="Nagaland">Nagaland</option>
                    <option value="Odisha">Odisha</option>
                    <option value="Punjab">Punjab</option>
                    <option value="Rajasthan">Rajasthan</option>
                    <option value="Sikkim">Sikkim</option>
                    <option value="Tamil Nadu">Tamil Nadu</option>
                    <option value="Telangana">Telangana</option>
                    <option value="Tripura">Tripura</option>
                    <option value="Uttar Pradesh">Uttar Pradesh</option>
                    <option value="Uttarakhand">Uttarakhand</option>
                    <option value="West Bengal">West Bengal</option>
                    <option value="Delhi">Delhi</option>
                  </select>
                </div>
                <div class="fr-account__field">
                  <label for="AddressZipNew">Pincode <span class="required">*</span></label>
                  <input type="text" id="AddressZipNew" name="address[zip]" placeholder="Pincode" required>
                </div>
              </div>

              <div class="fr-addresses__checkbox-field">
                <input type="checkbox" id="address_default_address_new" name="address[default]" value="1">
                <label for="address_default_address_new">Set as default address</label>
              </div>

              <div class="fr-addresses__form-buttons">
                <button type="submit" class="fr-account__btn-primary">SAVE ADDRESS</button>
                <button type="button" class="fr-account__btn-secondary cancel-add-btn">CANCEL</button>
              </div>
            {%- endform -%}
          </div>

          <!-- Existing Address List Grid -->
          <div class="fr-addresses__list" id="address-list-container">
            {%- if customer.addresses.size > 0 -%}
              <div class="fr-addresses__grid">
                {%- for address in customer.addresses -%}
                  <div class="fr-addresses__card {% if address == customer.default_address %}default-card{% endif %}">
                    <div class="fr-addresses__card-header">
                      <h4 class="fr-addresses__card-name">
                        {{ address.first_name }} {{ address.last_name }}
                        {%- if address == customer.default_address -%}
                          <span class="default-badge">DEFAULT</span>
                        {%- endif -%}
                      </h4>
                    </div>

                    <div class="fr-addresses__card-body">
                      <p class="fr-addresses__card-text">
                        {{ address.address1 }}<br>
                        {%- if address.address2 != blank -%}{{ address.address2 }}<br>{%- endif -%}
                        {{ address.city }}, {{ address.province }} - {{ address.zip }}<br>
                        India
                      </p>
                      {%- if address.phone != blank -%}
                        <p class="fr-addresses__card-phone">
                          <strong>Phone:</strong> {{ address.phone }}
                        </p>
                      {%- endif -%}
                    </div>

                    <div class="fr-addresses__card-actions">
                      <button type="button" class="fr-addresses__edit-btn" data-edit-address-id="{{ address.id }}">Edit</button>
                      <form class="fr-addresses__delete-form" method="post" action="/account/addresses/{{ address.id }}" onsubmit="return confirm('Are you sure you want to delete this address?');">
                        <input type="hidden" name="_method" value="delete">
                        <button type="submit" class="fr-addresses__delete-btn">Delete</button>
                      </form>
                    </div>

                    <!-- Edit Form Panel (Inline per Address) -->
                    <div class="fr-addresses__edit-form-panel hide" id="edit-address-panel-{{ address.id }}">
                      <h4 class="fr-addresses__sub-title text-left">Edit Address</h4>
                      {%- form 'customer_address', address, class: 'fr-account__form' -%}
                        <input type="hidden" name="address[country]" value="India">
                        
                        <div class="fr-account__form-grid">
                          <div class="fr-account__field">
                            <label for="AddressFirstName_{{ address.id }}">First Name <span class="required">*</span></label>
                            <input type="text" id="AddressFirstName_{{ address.id }}" name="address[first_name]" value="{{ form.first_name }}" required>
                          </div>
                          <div class="fr-account__field">
                            <label for="AddressLastName_{{ address.id }}">Last Name <span class="required">*</span></label>
                            <input type="text" id="AddressLastName_{{ address.id }}" name="address[last_name]" value="{{ form.last_name }}" required>
                          </div>
                        </div>

                        <div class="fr-account__form-grid">
                          <div class="fr-account__field">
                            <label for="AddressEmail_{{ address.id }}">Email <span class="required">*</span></label>
                            <input type="email" id="AddressEmail_{{ address.id }}" value="{{ customer.email }}" disabled class="disabled-field">
                          </div>
                          <div class="fr-account__field">
                            <label for="AddressPhone_{{ address.id }}">Phone Number <span class="required">*</span></label>
                            <input type="tel" id="AddressPhone_{{ address.id }}" name="address[phone]" value="{{ form.phone }}" required>
                          </div>
                        </div>

                        <div class="fr-account__field">
                          <label for="AddressAddress1_{{ address.id }}">Address <span class="required">*</span></label>
                          <input type="text" id="AddressAddress1_{{ address.id }}" name="address[address1]" value="{{ form.address1 }}" required>
                        </div>

                        <div class="fr-account__form-grid">
                          <div class="fr-account__field">
                            <label for="AddressCity_{{ address.id }}">City <span class="required">*</span></label>
                            <input type="text" id="AddressCity_{{ address.id }}" name="address[city]" value="{{ form.city }}" required>
                          </div>
                          <div class="fr-account__field">
                            <label for="AddressProvince_{{ address.id }}">State <span class="required">*</span></label>
                            <select id="AddressProvince_{{ address.id }}" name="address[province]" required>
                              <option value="{{ form.province }}" selected>{{ form.province }}</option>
                              <option value="Andhra Pradesh">Andhra Pradesh</option>
                              <option value="Arunachal Pradesh">Arunachal Pradesh</option>
                              <option value="Assam">Assam</option>
                              <option value="Bihar">Bihar</option>
                              <option value="Chhattisgarh">Chhattisgarh</option>
                              <option value="Goa">Goa</option>
                              <option value="Gujarat">Gujarat</option>
                              <option value="Haryana">Haryana</option>
                              <option value="Himachal Pradesh">Himachal Pradesh</option>
                              <option value="Jharkhand">Jharkhand</option>
                              <option value="Karnataka">Karnataka</option>
                              <option value="Kerala">Kerala</option>
                              <option value="Madhya Pradesh">Madhya Pradesh</option>
                              <option value="Maharashtra">Maharashtra</option>
                              <option value="Manipur">Manipur</option>
                              <option value="Meghalaya">Meghalaya</option>
                              <option value="Mizoram">Mizoram</option>
                              <option value="Nagaland">Nagaland</option>
                              <option value="Odisha">Odisha</option>
                              <option value="Punjab">Punjab</option>
                              <option value="Rajasthan">Rajasthan</option>
                              <option value="Sikkim">Sikkim</option>
                              <option value="Tamil Nadu">Tamil Nadu</option>
                              <option value="Telangana">Telangana</option>
                              <option value="Tripura">Tripura</option>
                              <option value="Uttar Pradesh">Uttar Pradesh</option>
                              <option value="Uttarakhand">Uttarakhand</option>
                              <option value="West Bengal">West Bengal</option>
                              <option value="Delhi">Delhi</option>
                            </select>
                          </div>
                          <div class="fr-account__field">
                            <label for="AddressZip_{{ address.id }}">Pincode <span class="required">*</span></label>
                            <input type="text" id="AddressZip_{{ address.id }}" name="address[zip]" value="{{ form.zip }}" required>
                          </div>
                        </div>

                        <div class="fr-addresses__checkbox-field">
                          {{ form.set_as_default_checkbox }}
                          <label for="address_default_address_{{ address.id }}">Set as default address</label>
                        </div>

                        <div class="fr-addresses__form-buttons">
                          <button type="submit" class="fr-account__btn-primary">UPDATE ADDRESS</button>
                          <button type="button" class="fr-account__btn-secondary cancel-edit-btn" data-cancel-address-id="{{ address.id }}">CANCEL</button>
                        </div>
                      {%- endform -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="fr-addresses__empty">
                <p>No addresses found. Add an address to use during checkout.</p>
              </div>
            {%- endif -%}
          </div>

        </div>

        <!-- Tab 4: Change Password -->
        <div class="fr-account__panel fr-account-panel" data-panel="password">
          <h3 class="fr-account__panel-title">Change Password</h3>
          <p class="fr-account__password-desc">
            For security reasons, password updates are completed via a secure recovery process. 
            Click the button below to request a password reset email linked to your account.
          </p>

          {%- form 'recover_customer_password', class: 'fr-account__password-form' -%}
            <input type="hidden" name="email" value="{{ customer.email }}">
            
            {%- if form.posted_successfully? -%}
              <div class="fr-account__message success">
                A password reset link has been successfully sent to your email address ({{ customer.email }}).
              </div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="fr-account__message error">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <button type="submit" class="fr-account__btn-primary">SEND PASSWORD RESET LINK</button>
          {%- endform -%}
        </div>

      </main>


    <!-- Order Modals -->
    {%- for order in customer.orders -%}
      <div id="fr-order-modal-{{ order.id }}" class="fr-order-modal" style="display:none;" role="dialog" aria-modal="true">
        <div class="fr-order-modal__overlay" onclick="closeOrderModal('{{ order.id }}')"></div>
        <div class="fr-order-modal__content">
          <div class="fr-order-modal__inner">
            
            <div class="fr-order__header">
              <button type="button" class="fr-order__close-btn" onclick="closeOrderModal('{{ order.id }}')" aria-label="Close modal">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
              
              <div class="fr-order__title-row">
                <h2 class="fr-order__title">Order {{ order.name }}</h2>
                <div class="fr-order__badges">
                  {%- if order.financial_status_label != blank -%}
                    <span class="status-badge status-pending">
                      {{ order.financial_status_label | upcase }}
                    </span>
                  {%- endif -%}
                  {%- if order.fulfillment_status_label != blank -%}
                    <span class="status-badge {% if order.fulfillment_status == 'fulfilled' %}status-delivered{% else %}status-pending{% endif %}">
                      {{ order.fulfillment_status_label | upcase }}
                    </span>
                  {%- endif -%}
                </div>
              </div>
              <p class="fr-order__date">Placed on {{ order.created_at | date: "%d %b %Y at %I:%M %p" }}</p>
              {%- if order.cancelled -%}
                <div class="fr-order__cancelled">
                  <p>Order Cancelled on {{ order.cancelled_at | date: "%d %b %Y at %I:%M %p" }}</p>
                  <p>Reason: {{ order.cancel_reason_label }}</p>
                </div>
              {%- endif -%}

              <!-- Order Action Buttons -->
              <div class="fr-order__actions no-print">

                {%- if order.fulfillment_status == 'fulfilled' or order.fulfillment_status == 'partial' -%}
                  {%- assign tracking_url = '' -%}
                  {%- for fulfillment in order.fulfillments -%}
                    {%- if fulfillment.tracking_url -%}
                      {%- assign tracking_url = fulfillment.tracking_url -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if tracking_url != blank -%}
                    <a href="{{ tracking_url }}" target="_blank" class="fr-account__btn-primary fr-order__action-btn">Track Order</a>
                  {%- endif -%}
                  <button type="button" class="fr-account__btn-secondary fr-order__action-btn" onclick="window.print()">Print Invoice</button>
                {%- endif -%}
              </div>
            </div>

            <div class="fr-order__grid">
              
              <div class="fr-order__items">
                <div class="fr-account__table-container">
                  <table class="fr-account__table" style="min-width: 600px;">
                    <thead>
                      <tr>
                        <th>PRODUCT</th>
                        <th class="text-center">PRICE</th>
                        <th class="text-center">QTY</th>
                        <th class="text-right">TOTAL</th>
                      </tr>
                    </thead>
                    <tbody>
                      {%- for line_item in order.line_items -%}
                        <tr>
                          <td class="fr-account__product-cell">
                            <div class="fr-account__product-info">
                              <div class="fr-account__product-img">
                                {%- if line_item.image != blank -%}
                                  <img src="{{ line_item.image | image_url: width: 120 }}" alt="{{ line_item.title | escape }}" loading="lazy">
                                {%- else -%}
                                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                                {%- endif -%}
                              </div>
                              <div class="fr-account__product-meta">
                                <span class="fr-account__product-title">{{ line_item.product.title | default: line_item.title }}</span>
                                
                                <div class="fr-account__line-properties">
                                  {%- unless line_item.product.has_only_default_variant -%}
                                    {%- for option in line_item.options_with_values -%}
                                      <span>{{ option.name }}: {{ option.value }}</span>
                                    {%- endfor -%}
                                  {%- endunless -%}
                                  {%- for property in line_item.properties -%}
                                    {%- unless property.last == blank or property.first.first == '_' -%}
                                      <span>{{ property.first }}: {{ property.last }}</span>
                                    {%- endunless -%}
                                  {%- endfor -%}
                                </div>

                                {%- if line_item.fulfillment -%}
                                  <div class="fr-order__fulfillment">
                                    <span class="fr-order__fulfillment-status">Fulfilled on {{ line_item.fulfillment.created_at | date: "%d %b %Y" }}</span>
                                    {%- if line_item.fulfillment.tracking_number -%}
                                      <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" class="fr-order__tracking-link">
                                        Track package #{{ line_item.fulfillment.tracking_number }}
                                      </a>
                                    {%- endif -%}
                                  </div>
                                {%- endif -%}
                              </div>
                            </div>
                          </td>
                          <td class="text-center">
                            {%- if line_item.original_price != line_item.final_price -%}
                              <s class="fr-order__old-price">{{ line_item.original_price | money }}</s><br>
                            {%- endif -%}
                            {{ line_item.final_price | money }}
                          </td>
                          <td class="text-center">{{ line_item.quantity }}</td>
                          <td class="text-right font-medium">
                            {{ line_item.final_line_price | money }}
                          </td>
                        </tr>
                      {%- endfor -%}
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="fr-order__summary-col">
                <div class="fr-order__summary-box">
                  <h3 class="fr-order__summary-title">Order Summary</h3>
                  <div class="fr-order__summary-row">
                    <span>Subtotal</span>
                    <span>{{ order.line_items_subtotal_price | money }}</span>
                  </div>
                  
                  {%- for discount_application in order.cart_level_discount_applications -%}
                    <div class="fr-order__summary-row fr-order__summary-discount">
                      <span>Discount ({{ discount_application.title }})</span>
                      <span>-{{ discount_application.total_allocated_amount | money }}</span>
                    </div>
                  {%- endfor -%}

                  {%- for shipping_method in order.shipping_methods -%}
                    <div class="fr-order__summary-row">
                      <span>Shipping ({{ shipping_method.title }})</span>
                      <span>{{ shipping_method.price | money }}</span>
                    </div>
                  {%- endfor -%}

                  {%- for tax_line in order.tax_lines -%}
                    <div class="fr-order__summary-row">
                      <span>Tax ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</span>
                      <span>{{ tax_line.price | money }}</span>
                    </div>
                  {%- endfor -%}

                  <div class="fr-order__summary-row fr-order__summary-total">
                    <span>Total</span>
                    <span>{{ order.total_price | money_with_currency }}</span>
                  </div>
                </div>

                <div class="fr-order__addresses">
                  {%- if order.shipping_address -%}
                    <div class="fr-order__address-block">
                      <h4 class="fr-order__address-title">Shipping Address</h4>
                      <p class="fr-order__address-text">
                        {{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}<br>
                        {%- if order.shipping_address.company != blank -%}{{ order.shipping_address.company }}<br>{%- endif -%}
                        {{ order.shipping_address.street }}<br>
                        {{ order.shipping_address.city }}, {{ order.shipping_address.province }} {{ order.shipping_address.zip }}<br>
                        {{ order.shipping_address.country }}<br>
                        {%- if order.shipping_address.phone != blank -%}{{ order.shipping_address.phone }}{%- endif -%}
                      </p>
                    </div>
                  {%- endif -%}

                  {%- if order.billing_address -%}
                    <div class="fr-order__address-block">
                      <h4 class="fr-order__address-title">Billing Address</h4>
                      <p class="fr-order__address-text">
                        {{ order.billing_address.first_name }} {{ order.billing_address.last_name }}<br>
                        {%- if order.billing_address.company != blank -%}{{ order.billing_address.company }}<br>{%- endif -%}
                        {{ order.billing_address.street }}<br>
                        {{ order.billing_address.city }}, {{ order.billing_address.province }} {{ order.billing_address.zip }}<br>
                        {{ order.billing_address.country }}<br>
                        {%- if order.billing_address.phone != blank -%}{{ order.billing_address.phone }}{%- endif -%}
                      </p>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>

          </div>
          <!-- START PRINT INVOICE TEMPLATE -->
          <div class="fr-print-invoice-template">
            <!-- Header -->
            <div class="fr-print-header">
              <div class="fr-print-logo">
                <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}">
              </div>
              <div class="fr-print-store-info">
                <strong>First Room Collective</strong><br>
                A10, Greenwood City, Sector 45,<br>
                Gurugram, Haryana 122003<br>
                Church Road, Ranchi / Ranchi<br>
                JH 834001 / India<br>
                +91 96507 06644<br>
                support@firstroom.in<br>
                https://firstroom.in/
              </div>
            </div>

            <!-- Title & Order Info -->
            <div class="fr-print-title-row">
              <h1 class="fr-print-title">Invoice</h1>
              <table class="fr-print-meta-table">
                <tr>
                  <th>Order Number</th>
                  <th>Order Date</th>
                </tr>
                <tr>
                  <td>{{ order.name }}</td>
                  <td>{{ order.created_at | date: "%Y/%m/%d %I:%M:%S" }}</td>
                </tr>
              </table>
            </div>

            <!-- Addresses -->
            <div class="fr-print-addresses">
              <div class="fr-print-address-box">
                <div class="fr-print-box-title">Shipping Address</div>
                <div class="fr-print-box-content">
                  {{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}<br>
                  {{ customer.email }}<br>
                  {{ order.shipping_address.street }}<br>
                  {{ order.shipping_address.city }}<br>
                  {{ order.shipping_address.province }}<br>
                  {{ order.shipping_address.zip }}<br>
                  {{ order.shipping_address.country }}<br>
                  {{ order.shipping_address.phone }}
                </div>
              </div>
              <div class="fr-print-address-box">
                <div class="fr-print-box-title">Billing Address</div>
                <div class="fr-print-box-content">
                  {{ order.billing_address.first_name }} {{ order.billing_address.last_name }}<br>
                  {{ customer.email }}<br>
                  {{ order.billing_address.street }}<br>
                  {{ order.billing_address.city }}<br>
                  {{ order.billing_address.province }}<br>
                  {{ order.billing_address.zip }}<br>
                  {{ order.billing_address.country }}<br>
                  {{ order.billing_address.phone }}
                </div>
              </div>
              <div class="fr-print-address-box">
                <div class="fr-print-box-title">Client Address</div>
                <div class="fr-print-box-content">
                  {{ customer.first_name }} {{ customer.last_name }}<br>
                  {{ customer.email }}<br>
                  {%- if customer.default_address -%}
                    {{ customer.default_address.street }}<br>
                    {{ customer.default_address.city }}<br>
                    {{ customer.default_address.province }}<br>
                    {{ customer.default_address.zip }}<br>
                    {{ customer.default_address.country }}<br>
                  {%- endif -%}
                  {%- if customer.phone != blank -%}{{ customer.phone }}{%- endif -%}
                </div>
              </div>
            </div>

            <!-- Product Table -->
            <table class="fr-print-product-table">
              <thead>
                <tr>
                  <th colspan="2">Product Title</th>
                  <th class="text-center">Product<br>SKU</th>
                  <th class="text-center">Product<br>Quantity</th>
                  <th class="text-center">Product<br>Tax</th>
                  <th class="text-right">Product<br>Unit Price</th>
                  <th class="text-right">Product<br>Total Price</th>
                </tr>
              </thead>
              <tbody>
                {%- for line_item in order.line_items -%}
                  <tr>
                    <td class="fr-print-td-image">
                      {%- if line_item.image != blank -%}
                        <img src="{{ line_item.image | image_url: width: 60 }}" alt="">
                      {%- endif -%}
                    </td>
                    <td class="fr-print-td-title">
                      <strong>{{ line_item.product.title | default: line_item.title }}</strong><br>
                      <span style="color: #666; font-size: 0.85em;">
                        {%- unless line_item.product.has_only_default_variant -%}
                          {%- for option in line_item.options_with_values -%}
                            &bull; {{ option.value }} 
                          {%- endfor -%}
                        {%- endunless -%}
                      </span>
                    </td>
                    <td class="text-center">{{ line_item.sku | default: '-' }}</td>
                    <td class="text-center">x{{ line_item.quantity }}</td>
                    <td class="text-center">18%</td>
                    <td class="text-right">
                      {%- if line_item.original_price != line_item.final_price -%}
                        <s style="color: #999;">{{ line_item.original_price | money }}</s><br>
                      {%- endif -%}
                      {{ line_item.final_price | money }}
                    </td>
                    <td class="text-right">{{ line_item.final_line_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>

            <!-- Footer Breakdown -->
            <div class="fr-print-footer">
              <div class="fr-print-payment-method">
                <strong>Payment Method</strong><br>
                {%- if order.transactions.size > 0 -%}
                  {{ order.transactions.first.gateway | capitalize }}
                {%- else -%}
                  Cash on Delivery (COD)
                {%- endif -%}
              </div>
              <div class="fr-print-totals">
                <table class="fr-print-totals-table">
                  {%- for discount_application in order.cart_level_discount_applications -%}
                  <tr>
                    <th>Discounted Price</th>
                    <td>- {{ discount_application.total_allocated_amount | money }}</td>
                  </tr>
                  {%- endfor -%}
                  <tr>
                    <th>Subtotal Price</th>
                    <td>{{ order.line_items_subtotal_price | money }}</td>
                  </tr>
                  <tr>
                    <th>Shipping Price</th>
                    <td>{{ order.shipping_price | money }}</td>
                  </tr>
                  <tr>
                    <th>Total Tax Price</th>
                    <td>{{ order.tax_price | money }}</td>
                  </tr>
                  <tr>
                    <th>Total Price</th>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                  <tr>
                    <th>Total Paid</th>
                    <td>{%- assign total_paid = order.total_price | minus: order.total_outstanding -%}{{ total_paid | money }}</td>
                  </tr>
                  <tr>
                    <th>Amount Due</th>
                    <td>{{ order.total_outstanding | money }}</td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
          <!-- END PRINT INVOICE TEMPLATE -->
        </div>
      </div>
    {%- endfor -%}

    </div>
  {%- else -%}
    <!-- Non-logged in users redirect helper -->
    <script>
      window.location.href = "/customer_authentication/login?return_to=" + encodeURIComponent(window.location.pathname);
    </script>
    <div class="fr-account__loading" style="padding: 120px 24px; text-align: center;">
      <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.5rem; margin-bottom: 16px;">Redirecting you to login...</h3>
      <p style="font-size: 0.9rem; color: #666; margin-bottom: 24px;">Please wait while we establish a secure connection.</p>
      <a href="/customer_authentication/login?return_to={{ request.path | url_encode }}" class="fr-account__btn-primary" style="display: inline-flex; align-items: center; justify-content: center; text-decoration: none;">
        CLICK HERE IF NOT REDIRECTED
      </a>
    </div>
  {%- endif -%}
</section>

<style>
  .fr-account {
    font-family: 'Lato', system-ui, sans-serif;
    color: #1a1a1a;
    background-color: #ffffff;
    padding: 60px 0 100px 0;
  }

  .fr-account__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 768px) {
    .fr-account__container {
      grid-template-columns: 260px 1fr;
      gap: 60px;
    }
  }

  /* ── Sidebar Styling ── */
  .fr-account__sidebar {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .fr-account__user-info {
    border-bottom: 1px solid #ebebeb;
    padding-bottom: 20px;
  }

  .fr-account__user-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0 0 6px 0;
    color: #000;
  }

  .fr-account__user-email {
    font-size: 0.88rem;
    color: #666;
    margin: 0;
  }

  .fr-account__nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fr-account__nav-btn,
  .fr-account__nav-link {
    display: block;
    width: 100%;
    padding: 12px 20px;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: left;
    color: #4a4a4a;
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: 2px;
    text-decoration: none;
    font-family: 'Lato', system-ui, sans-serif;
    transition: all 0.2s ease;
  }

  .fr-account__nav-btn:hover,
  .fr-account__nav-link:hover {
    background-color: #f7f7f7;
    color: #000;
  }

  .fr-account__nav-btn.active {
    background-color: #1a1a1a;
    color: #ffffff;
  }

  .fr-account__nav-link--logout {
    margin-top: 10px;
    color: #999;
  }

  .fr-account__nav-link--logout:hover {
    color: #666;
  }

  /* ── Content Panel Styling ── */
  .fr-account__content {
    background-color: #ffffff;
    min-height: 400px;
  }

  .fr-account__panel {
    display: none;
  }

  .fr-account__panel.active {
    display: block;
  }

  .fr-orders__subtabs-container {
    border-bottom: 1px solid #ebebeb;
    margin-bottom: 24px;
  }
  .fr-orders__subtabs {
    display: flex;
    gap: 32px;
  }
  .fr-orders__subtab {
    background: none;
    border: none;
    padding: 0 0 12px 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: #666;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
    margin-bottom: -1px;
  }
  .fr-orders__subtab:hover {
    color: #1a1a1a;
  }
  .fr-orders__subtab.active {
    color: #1a1a1a;
    border-bottom: 2px solid #1a1a1a;
  }

  .fr-account__panel-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 30px;
  }

  /* ── Profile/Account Form ── */
  .fr-account__form {
    max-width: 700px;
  }

  .fr-account__form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 576px) {
    .fr-account__form-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fr-account__field {
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fr-account__field label {
    font-size: 0.85rem;
    font-weight: 500;
    color: #1a1a1a;
  }

  .fr-account__field label span.required {
    color: #B53939;
  }

  .fr-account__field label span.optional {
    color: #888;
    font-weight: 400;
  }

  .fr-account__field input,
  .fr-account__field select {
