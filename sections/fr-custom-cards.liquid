{%- comment -%}
  FR Custom Cards Section (e.g. "What can be customised")
{%- endcomment -%}

<section id="fr-custom-cards-{{ section.id }}" class="fr-custom-cards" style="
  background-color: {{ section.settings.bg_color }};
  --pt-m: {{ section.settings.padding_top_mobile | default: section.settings.padding_top }}px;
  --pb-m: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom }}px;
  --pt-d: {{ section.settings.padding_top }}px;
  --pb-d: {{ section.settings.padding_bottom }}px;
  padding-left: {{ section.settings.padding_left }}px;
  padding-right: {{ section.settings.padding_right }}px;
  --fz-txt-d: {{ section.settings.text_size_desktop }}px;
  --fz-txt-m: {{ section.settings.text_size_mobile }}px;
  --fz-desc-d: {{ section.settings.desc_size_desktop }}px;
  --fz-desc-m: {{ section.settings.desc_size_mobile }}px;
">
  <div class="fr-custom-cards__container" style="max-width: {{ section.settings.content_max_width }}px;">
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-custom-cards__heading" style="
        font-size: {{ section.settings.heading_size }}px;
        color: {{ section.settings.heading_color }};
        --ha-m: {{ section.settings.heading_align_mobile | default: section.settings.heading_alignment }};
        --ha-d: {{ section.settings.heading_alignment }};
      ">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="fr-custom-cards__grid" style="gap: {{ section.settings.gap }}px;">
      {%- for block in section.blocks -%}
        <div class="fr-custom-cards__card" {{ block.shopify_attributes }} style="transform: translateY({{ block.settings.offset_y }}px); --ta-m: {{ section.settings.text_align_mobile | default: 'center' }}; --ta-d: {{ section.settings.text_align | default: 'center' }};">
          <div class="fr-custom-cards__image-wrapper" style="
            padding-bottom: {{ block.settings.aspect_ratio }}%;
          ">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" class="fr-custom-cards__image">
            {%- else -%}
              <div class="fr-custom-cards__placeholder"></div>
            {%- endif -%}
          </div>
          {%- if block.settings.text != blank -%}
            <div class="fr-custom-cards__text" style="color: {{ section.settings.text_color }};">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <div class="fr-custom-cards__desc" style="color: {{ section.settings.text_color }};">{{ block.settings.description }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.text_font | font_face: font_display: 'swap' }}

  #fr-custom-cards-{{ section.id }} {
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }
  
  #fr-custom-cards-{{ section.id }} .fr-custom-cards__text {
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    font-size: var(--fz-txt-m);
    margin-top: 15px;
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__desc {
    font-family: 'Lato', system-ui, sans-serif;
    font-size: var(--fz-desc-m);
    margin-top: 8px;
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__container {
    margin: 0 auto;
    text-align: center;
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__heading {
    display: block;
    width: 100%;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    font-weight: {{ section.settings.heading_font.weight | default: 500 }};
    text-align: var(--ha-m);
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__grid {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center; /* This helps with staggered heights if images vary */
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__card {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    text-align: var(--ta-m);
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__image-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #e0e0e0;
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #d8d8d8;
  }
  
  #fr-custom-cards-{{ section.id }} .fr-custom-cards__text {
    margin-top: 16px;
    font-weight: {{ section.settings.text_font.weight | default: 400 }};
  }

  @media (min-width: 768px) {
    #fr-custom-cards-{{ section.id }} {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
    }
    #fr-custom-cards-{{ section.id }} .fr-custom-cards__heading {
      text-align: var(--ha-d);
    }
    #fr-custom-cards-{{ section.id }} .fr-custom-cards__card {
      text-align: var(--ta-d);
    }
    #fr-custom-cards-{{ section.id }} .fr-custom-cards__text {
      font-size: var(--fz-txt-d);
    }
    #fr-custom-cards-{{ section.id }} .fr-custom-cards__desc {
      font-size: var(--fz-desc-d);
    }
  }

  @media (max-width: 767px) {
    #fr-custom-cards-{{ section.id }} .fr-custom-cards__grid {
      flex-direction: column;
    }
    #fr-custom-cards-{{ section.id }} .fr-custom-cards__card {
      width: 100%;
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "FR Custom Cards",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What can be customised"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Content Max Width",
      "default": 1200
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "playfair_display_n5"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
      "label": "Heading Alignment (Mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Margin Bottom",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Text Font",
      "default": "lato_n4"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text Size (Mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "desc_size_desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Size (Desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "desc_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Size (Mobile)",
      "default": 12
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text Alignment (Mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Space between cards",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "aspect_ratio",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "%",
          "label": "Image Height (Aspect Ratio)",
          "info": "100% is square, 150% is tall, 75% is wide.",
          "default": 120
        },
        {
          "type": "range",
          "id": "offset_y",
          "min": -100,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Vertical Offset",
          "info": "Use this to push individual cards up or down to create a staggered look.",
          "default": 0
        },
        {
          "type": "text",
          "id": "text",
          "label": "Title Text"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Custom Cards",
      "blocks": [
        { "type": "card", "settings": { "aspect_ratio": 130 } },
        { "type": "card", "settings": { "aspect_ratio": 100 } },
        { "type": "card", "settings": { "aspect_ratio": 130 } }
      ]
    }
  ]
}
{% endschema %}
