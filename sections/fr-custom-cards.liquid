{%- comment -%}
  FR Custom Cards Section (e.g. "What can be customised")
{%- endcomment -%}

<section id="fr-custom-cards-{{ section.id }}" class="fr-custom-cards" style="
  background-color: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  padding-left: {{ section.settings.padding_left }}px;
  padding-right: {{ section.settings.padding_right }}px;
">
  <div class="fr-custom-cards__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-custom-cards__heading" style="
        font-size: {{ section.settings.heading_size }}px;
        color: {{ section.settings.heading_color }};
      ">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="fr-custom-cards__grid" style="gap: {{ section.settings.gap }}px;">
      {%- for block in section.blocks -%}
        <div class="fr-custom-cards__card" {{ block.shopify_attributes }}>
          <div class="fr-custom-cards__image-wrapper" style="
            padding-bottom: {{ block.settings.aspect_ratio }}%;
          ">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" class="fr-custom-cards__image">
            {%- else -%}
              <div class="fr-custom-cards__placeholder"></div>
            {%- endif -%}
          </div>
          {%- if block.settings.text != blank -%}
            <div class="fr-custom-cards__text" style="
              font-size: {{ section.settings.text_size }}px;
              color: {{ section.settings.text_color }};
            ">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #fr-custom-cards-{{ section.id }} .fr-custom-cards__container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__heading {
    margin: 0 0 40px 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 500;
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center; /* This helps with staggered heights if images vary */
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__card {
    flex: 1 1 300px;
    max-width: 400px;
    display: flex;
    flex-direction: column;
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__image-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #e0e0e0;
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #fr-custom-cards-{{ section.id }} .fr-custom-cards__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #d8d8d8;
  }
  
  #fr-custom-cards-{{ section.id }} .fr-custom-cards__text {
    margin-top: 16px;
    font-family: 'Lato', system-ui, sans-serif;
  }

  @media (max-width: 767px) {
    #fr-custom-cards-{{ section.id }} .fr-custom-cards__grid {
      flex-direction: column;
    }
    #fr-custom-cards-{{ section.id }} .fr-custom-cards__card {
      width: 100%;
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "FR Custom Cards",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What can be customised"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Space between cards",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "aspect_ratio",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "%",
          "label": "Image Height (Aspect Ratio)",
          "info": "100% is square, 150% is tall, 75% is wide.",
          "default": 120
        },
        {
          "type": "text",
          "id": "text",
          "label": "Optional Text below image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Custom Cards",
      "blocks": [
        { "type": "card", "settings": { "aspect_ratio": 130 } },
        { "type": "card", "settings": { "aspect_ratio": 100 } },
        { "type": "card", "settings": { "aspect_ratio": 130 } }
      ]
    }
  ]
}
{% endschema %}
