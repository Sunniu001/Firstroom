<section class="fr-about-hero" id="fr-about-hero-{{ section.id }}">
  {%- if section.settings.hero_image != blank -%}
    <div class="fr-about-hero__wrapper" style="background-image: linear-gradient(rgba(0, 0, 0, {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }}), rgba(0, 0, 0, {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }})), url('{{ section.settings.hero_image | image_url: width: 2400 }}'); height: {{ section.settings.hero_height }}vh;">
      <div class="fr-about-hero__content">
        <h1 class="fr-about-hero__title">{{ section.settings.hero_title }}</h1>
      </div>
    </div>
  {%- else -%}
    <div class="fr-about-hero__wrapper fr-about-hero__wrapper--no-img" style="height: 25vh; background-color: #faf8f5;">
      <div class="fr-about-hero__content">
        <h1 class="fr-about-hero__title" style="color: #1a1a1a;">{{ section.settings.hero_title }}</h1>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  #fr-about-hero-{{ section.id }} {
    width: 100%;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .fr-about-hero__wrapper {
    position: relative;
    width: 100%;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .fr-about-hero__wrapper--no-img {
    border-bottom: 1px solid #e5e7eb;
  }

  .fr-about-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 20px;
  }

  .fr-about-hero__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0.01em;
    margin: 0;
    color: #ffffff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.15);
  }
</style>

{% schema %}
{
  "name": "FR About Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "About Us"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 40,
      "max": 90,
      "step": 5,
      "unit": "vh",
      "label": "Hero Height",
      "default": 65
    },
    {
      "type": "range",
      "id": "hero_overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Hero Overlay Opacity",
      "default": 15
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "FR About Hero"
    }
  ]
}
{% endschema %}
