{%- comment -%}
  FR Custom Hero Section
{%- endcomment -%}

<section id="fr-custom-hero-{{ section.id }}" class="fr-custom-hero">
  <div class="fr-custom-hero__inner">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'fr-custom-hero__bg', loading: 'lazy' }}
    {%- else -%}
      <div class="fr-custom-hero__placeholder"></div>
    {%- endif -%}

    <div class="fr-custom-hero__overlay" style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

    <div class="fr-custom-hero__content-wrapper" style="
      justify-content: {{ section.settings.content_alignment_horizontal }};
      align-items: {{ section.settings.content_alignment_vertical }};
      --pt-d: {{ section.settings.padding_top }}px;
      --pb-d: {{ section.settings.padding_bottom }}px;
      --pt-m: {{ section.settings.padding_top_mobile | default: section.settings.padding_top }}px;
      --pb-m: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    ">
      <div class="fr-custom-hero__content" style="
        --ta-d: {{ section.settings.text_alignment }};
        --ta-m: {{ section.settings.text_align_mobile | default: section.settings.text_alignment }};
        max-width: {{ section.settings.content_max_width }}px;
      ">
        {%- if section.settings.heading != blank -%}
          <h1 class="fr-custom-hero__heading" style="
            --fz-hd-d: {{ section.settings.heading_size }}px;
            --fz-hd-m: {{ section.settings.heading_size_mobile | default: section.settings.heading_size | times: 0.7 | round }}px;
            color: {{ section.settings.heading_color }};
          ">{{ section.settings.heading }}</h1>
        {%- endif -%}
        
        {%- if section.settings.text != blank -%}
          <div class="fr-custom-hero__text" style="
            --fz-txt-d: {{ section.settings.text_size }}px;
            --fz-txt-m: {{ section.settings.text_size_mobile | default: section.settings.text_size | times: 0.9 | round }}px;
            color: {{ section.settings.text_color }};
          ">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="fr-custom-hero__btn" style="
            background-color: {{ section.settings.button_bg }};
            color: {{ section.settings.button_text }};
          ">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.text_font | font_face: font_display: 'swap' }}
  {{ section.settings.button_font | font_face: font_display: 'swap' }}

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }
  
  #fr-custom-hero-{{ section.id }} .fr-custom-hero__text {
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
  }

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__btn {
    font-family: {{ section.settings.button_font.family }}, {{ section.settings.button_font.fallback_families }};
  }

  #fr-custom-hero-{{ section.id }} {
    width: 100%;
    position: relative;
    box-sizing: border-box;
  }
  
  #fr-custom-hero-{{ section.id }} .fr-custom-hero__inner {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.min_height }}px;
    display: flex;
    overflow: hidden;
  }

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #e0e0e0;
    z-index: 1;
  }

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__content-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    display: flex;
    box-sizing: border-box;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
  }
  
  #fr-custom-hero-{{ section.id }} .fr-custom-hero__content {
    display: flex;
    flex-direction: column;
    text-align: var(--ta-m);
  }
  
  #fr-custom-hero-{{ section.id }} .fr-custom-hero__heading {
    font-size: var(--fz-hd-m) !important;
  }
  
  #fr-custom-hero-{{ section.id }} .fr-custom-hero__text {
    font-size: var(--fz-txt-m) !important;
  }
  
  @media (min-width: 768px) {
    #fr-custom-hero-{{ section.id }} .fr-custom-hero__content-wrapper {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
    }
    #fr-custom-hero-{{ section.id }} .fr-custom-hero__content {
      text-align: var(--ta-d);
    }
    #fr-custom-hero-{{ section.id }} .fr-custom-hero__heading {
      font-size: var(--fz-hd-d) !important;
    }
    #fr-custom-hero-{{ section.id }} .fr-custom-hero__text {
      font-size: var(--fz-txt-d) !important;
    }
  }

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__heading {
    margin: 0;
    font-weight: {{ section.settings.heading_font.weight | default: 500 }};
    line-height: 1.1;
  }

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__text {
    font-weight: {{ section.settings.text_font.weight | default: 400 }};
    line-height: 1.5;
  }

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__btn {
    display: inline-block;
    padding: 12px 0;
    text-decoration: none;
    font-size: 14px;
    font-weight: {{ section.settings.button_font.weight | default: 600 }};
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
    cursor: pointer;
    align-self: flex-start;
    transition: opacity 0.3s ease;
  }

  #fr-custom-hero-{{ section.id }} .fr-custom-hero__btn:hover {
    opacity: 0.8;
  }

  @media (max-width: 767px) {
    #fr-custom-hero-{{ section.id }} .fr-custom-hero__inner {
      min-height: {{ section.settings.min_height_mobile }}px;
    }
    #fr-custom-hero-{{ section.id }} .fr-custom-hero__content-wrapper {
      padding: 20px;
      justify-content: center;
      align-items: center;
    }
    #fr-custom-hero-{{ section.id }} .fr-custom-hero__content {
      align-items: center;
    }
    #fr-custom-hero-{{ section.id }} .fr-custom-hero__heading {
      margin-bottom: 20px;
    }
    #fr-custom-hero-{{ section.id }} .fr-custom-hero__btn {
      align-self: center;
    }
  }
</style>

{% schema %}
{
  "name": "FR Custom Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 200,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Minimum Height (Desktop)",
      "default": 600
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum Height (Mobile)",
      "default": 400
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 20
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create something uniquely yours."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "playfair_display_n5"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A little bit about the custom design process and what you get...</p>"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Text Font",
      "default": "lato_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size (Mobile)",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Button Font",
      "default": "lato_n7"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Alignment"
    },
    {
      "type": "select",
      "id": "content_alignment_horizontal",
      "label": "Horizontal Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "content_alignment_vertical",
      "label": "Vertical Alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text Alignment (Mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 300,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Content Max Width",
      "default": 500
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "FR Custom Hero"
    }
  ]
}
{% endschema %}
