<section class="fr-statement-section" id="fr-statement-{{ section.id }}">
  <div class="fr-statement__container">
    {%- if section.settings.subheading != blank -%}
      <p class="fr-statement__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="fr-statement__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="fr-statement__text rte">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="fr-statement__actions">
        <a href="{{ section.settings.button_link | default: '#' }}" class="fr-statement__btn">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #fr-statement-{{ section.id }} {
    width: 100%;
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: {{ section.settings.padding_left_mobile }}px;
    padding-right: {{ section.settings.padding_right_mobile }}px;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    #fr-statement-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }

  #fr-statement-{{ section.id }} .fr-statement__container {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.text_align == 'left' %}flex-start{% elsif section.settings.text_align == 'right' %}flex-end{% else %}center{% endif %};
    text-align: {{ section.settings.text_align_mobile | default: section.settings.text_align }};
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    #fr-statement-{{ section.id }} .fr-statement__container {
      text-align: {{ section.settings.text_align }};
      align-items: {% if section.settings.text_align == 'left' %}flex-start{% elsif section.settings.text_align == 'right' %}flex-end{% else %}center{% endif %};
    }
  }

  #fr-statement-{{ section.id }} .fr-statement__subheading {
    font-size: {{ section.settings.subheading_size_mobile }}px;
    color: {{ section.settings.subheading_color }};
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    margin: 0 0 12px 0;
  }

  @media (min-width: 768px) {
    #fr-statement-{{ section.id }} .fr-statement__subheading {
      font-size: {{ section.settings.subheading_size }}px;
      margin-bottom: 16px;
    }
  }

  #fr-statement-{{ section.id }} .fr-statement__heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    color: {{ section.settings.heading_color }};
    font-weight: 400;
    line-height: 1.25;
    margin: 0 0 18px 0;
  }

  @media (min-width: 768px) {
    #fr-statement-{{ section.id }} .fr-statement__heading {
      font-size: {{ section.settings.heading_size }}px;
      margin-bottom: 24px;
    }
  }

  #fr-statement-{{ section.id }} .fr-statement__text {
    font-size: {{ section.settings.text_size_mobile }}px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  #fr-statement-{{ section.id }} .fr-statement__text p {
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    margin: 0 0 14px 0;
  }

  #fr-statement-{{ section.id }} .fr-statement__text p:last-child {
    margin-bottom: 0;
  }

  #fr-statement-{{ section.id }} .fr-statement__text strong {
    font-weight: 600;
    color: #1a1a1a;
  }

  @media (min-width: 768px) {
    #fr-statement-{{ section.id }} .fr-statement__text {
      font-size: {{ section.settings.text_size }}px;
      line-height: 1.75;
    }
  }

  #fr-statement-{{ section.id }} .fr-statement__actions {
    margin-top: {{ section.settings.button_margin_top_mobile }}px;
    display: flex;
    justify-content: {% if section.settings.text_align == 'left' %}flex-start{% elsif section.settings.text_align == 'right' %}flex-end{% else %}center{% endif %};
    width: 100%;
  }

  @media (min-width: 768px) {
    #fr-statement-{{ section.id }} .fr-statement__actions {
      margin-top: {{ section.settings.button_margin_top }}px;
    }
  }

  #fr-statement-{{ section.id }} .fr-statement__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.button_bg | default: '#1a1a1a' }};
    color: {{ section.settings.button_text | default: '#ffffff' }};
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 500;
    text-decoration: none;
    padding: {{ section.settings.button_padding_v }}px {{ section.settings.button_padding_h }}px;
    border-radius: {{ section.settings.button_radius }}px;
    border: 1px solid {{ section.settings.button_border_color | default: 'transparent' }};
    transition: all 0.25s ease;
    cursor: pointer;
    letter-spacing: 0.02em;
    min-width: 140px;
  }

  #fr-statement-{{ section.id }} .fr-statement__btn:hover {
    background-color: {{ section.settings.button_hover_bg | default: '#333333' }};
    color: {{ section.settings.button_hover_text | default: '#ffffff' }};
    border-color: {{ section.settings.button_hover_border_color | default: 'transparent' }};
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }
</style>

{% schema %}
