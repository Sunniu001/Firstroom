<section class="fr-home-triple" id="fr-home-triple-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="fr-home-triple__wrapper" style="
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    ">
    
    {%- if section.settings.main_heading != blank -%}
      <h2 class="fr-home-triple__main-heading" style="text-align: {{ section.settings.main_heading_align }}; font-size: {{ section.settings.main_heading_size }}px; color: {{ section.settings.main_heading_color }};">
        {{ section.settings.main_heading }}
      </h2>
    {%- endif -%}

    {% assign ratio_parts = section.settings.column_ratio | split: '|' %}
    {% assign col1_ratio = ratio_parts[0] | default: '1fr' %}
    {% assign col2_ratio = ratio_parts[1] | default: '1fr' %}
    {% assign col3_ratio = ratio_parts[2] | default: '1fr' %}

    <div class="fr-home-triple__container" style="
        grid-template-columns: {{ col1_ratio }} {{ col2_ratio }} {{ col3_ratio }};
        gap: {{ section.settings.gap }}px;
        align-items: {{ section.settings.vertical_align }};
      ">
      
      <!-- Image 1 Column -->
      <div class="fr-home-triple__col-image">
        <div class="fr-home-triple__image-wrapper" style="border-radius: {{ section.settings.image_radius }}px;">
          {%- if section.settings.image_1 != blank -%}
            <img src="{{ section.settings.image_1 | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" class="fr-home-triple__img">
          {%- else -%}
            <div class="fr-home-triple__placeholder"></div>
          {%- endif -%}
        </div>
      </div>

      <!-- Text Column -->
      <div class="fr-home-triple__col-text" style="text-align: {{ section.settings.text_align }}; background-color: {{ section.settings.text_bg_color }}; padding: {{ section.settings.text_padding }}px;">
        <div class="fr-home-triple__text-content">
          {%- if section.settings.heading != blank -%}
            <h3 class="fr-home-triple__heading" style="font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">
              {{ section.settings.heading }}
            </h3>
          {%- endif -%}
          
          {%- if section.settings.text != blank -%}
            <div class="fr-home-triple__body" style="font-size: {{ section.settings.text_size }}px; color: {{ section.settings.text_color }};">
              {{ section.settings.text }}
            </div>
          {%- endif -%}
          
          {%- if section.settings.button_text != blank -%}
            <a href="{{ section.settings.button_link }}" class="fr-home-triple__btn" style="
                background-color: {{ section.settings.btn_bg_color }};
                color: {{ section.settings.btn_text_color }};
              ">
              {{ section.settings.button_text }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Image 2 Column -->
      <div class="fr-home-triple__col-image">
        <div class="fr-home-triple__image-wrapper" style="border-radius: {{ section.settings.image_radius }}px;">
          {%- if section.settings.image_2 != blank -%}
            <img src="{{ section.settings.image_2 | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" class="fr-home-triple__img">
          {%- else -%}
            <div class="fr-home-triple__placeholder"></div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #fr-home-triple-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.7;
    width: 100%;
  }

  #fr-home-triple-{{ section.id }} .fr-home-triple__wrapper {
    max-width: 100%;
    margin: 0 auto;
  }
  
  .fr-home-triple__main-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 40px;
    letter-spacing: 0.01em;
    max-width: {{ section.settings.content_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  #fr-home-triple-{{ section.id }} .fr-home-triple__container {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    /* Desktop columns applied inline */
  }

  @media (max-width: 767px) {
    #fr-home-triple-{{ section.id }} .fr-home-triple__container {
      grid-template-columns: 1fr !important;
      gap: 30px !important;
    }
    .fr-home-triple__col-image {
      margin: 0 auto;
      max-width: 400px;
      width: 100%;
    }
  }

  .fr-home-triple__image-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .fr-home-triple__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .fr-home-triple__placeholder {
    width: 100%;
    height: 400px;
    background-color: #e5e7eb;
  }

  .fr-home-triple__col-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .fr-home-triple__text-content {
    width: 100%;
  }

  .fr-home-triple__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin: 0 0 20px 0;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .fr-home-triple__body p {
    margin: 0 0 15px 0;
  }
  .fr-home-triple__body p:last-child {
    margin-bottom: 0;
  }

  .fr-home-triple__btn {
    display: inline-block;
    margin-top: 25px;
    padding: 12px 30px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }
  .fr-home-triple__btn:hover {
    opacity: 0.8;
  }
</style>

{% schema %}
{
  "name": "FR Home Triple Split",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 1400
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Section Heading",
      "default": "What inspires the company"
    },
    {
      "type": "select",
      "id": "main_heading_align",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "main_heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 32
    },
    {
      "type": "color",
      "id": "main_heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "column_ratio",
      "label": "Desktop Column Ratio (Img : Text : Img)",
      "options": [
        { "value": "1fr|1fr|1fr", "label": "Equal (33 / 33 / 33)" },
        { "value": "1fr|2fr|1fr", "label": "Wide Text (25 / 50 / 25)" },
        { "value": "2fr|3fr|2fr", "label": "Slightly Wide Text" }
      ],
      "default": "1fr|1fr|1fr"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical Alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap Between Columns",
      "default": 40
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Left Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Right Image"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "color",
      "id": "text_bg_color",
      "label": "Text Background Color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "text_padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Text Padding (if using bg color)",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Our Inspiration"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title Size",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Write a brief description here to accompany your images.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4b5563"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "FR Home Triple Split"
    }
  ]
}
{% endschema %}
