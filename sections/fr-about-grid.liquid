      "default": 40
    },
    {
      "type": "checkbox",
      "id": "show_vertical_borders",
      "label": "Show Vertical Borders between items",
      "default": false
    },
    {
      "type": "header",
      "content": "Image Shape"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image Shape",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "arch", "label": "Arch" },
        { "value": "original", "label": "Original (Auto)" }
      ],
      "default": "circle"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius (For Square/Original)",
