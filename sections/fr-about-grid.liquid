      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Desktop Image Max Width",
      "default": 200
    },
    {
      "type": "range",
      "id": "image_max_width_mobile",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Mobile Image Max Width",
      "default": 150
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Desktop Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Mobile Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size (Desktop)",
      "default": 18
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size (Mobile)",
      "default": 16
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "subtitle_size",
