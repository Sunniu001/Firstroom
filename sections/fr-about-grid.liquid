<section class="fr-about-grid" id="fr-about-grid-{{ section.id }}" style="background-color: {{ section.settings.section_bg }};">
  <div class="fr-about-grid__wrapper" style="
      --pt-d: {{ section.settings.padding_top }}px;
      --pb-d: {{ section.settings.padding_bottom }}px;
      --pl-d: {{ section.settings.padding_left }}px;
      --pr-d: {{ section.settings.padding_right }}px;
      --pt-m: {{ section.settings.padding_top_mobile | default: section.settings.padding_top }}px;
      --pb-m: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom }}px;
      --pl-m: {{ section.settings.padding_left_mobile | default: section.settings.padding_left }}px;
      --pr-m: {{ section.settings.padding_right_mobile | default: section.settings.padding_right }}px;
      --ta-d: {{ section.settings.text_align }};
      --ta-m: {{ section.settings.text_align_mobile | default: section.settings.text_align }};
      --img-mw-d: {{ section.settings.image_max_width }}px;
      --img-mw-m: {{ section.settings.image_max_width_mobile | default: section.settings.image_max_width }}px;
    ">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-about-grid__main-heading" style="--fz-mh-d: {{ section.settings.heading_size }}px; --fz-mh-m: {{ section.settings.heading_size_mobile | default: section.settings.heading_size | times: 0.8 | round }}px; color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="fr-about-grid__container" style="
      --cols-d: {{ section.settings.columns_desktop }};
      --cols-m: {{ section.settings.columns_mobile }};
      gap: {{ section.settings.grid_gap }}px;
      {%- if section.settings.show_vertical_borders -%}
        gap: 0;
      {%- endif -%}
    ">
      {%- for block in section.blocks -%}
        <div class="fr-about-grid__item {% if section.settings.show_vertical_borders and forloop.last == false %}fr-about-grid__item--border{% endif %}" {{ block.shopify_attributes }} style="{% if section.settings.show_vertical_borders %}padding: 0 {{ section.settings.grid_gap | divided_by: 2 }}px;{% endif %}">
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="fr-about-grid__link"></a>
          {%- endif -%}
          
          <div class="fr-about-grid__image-wrapper fr-about-grid__shape--{{ section.settings.image_shape }}">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="fr-about-grid__img">
            {%- else -%}
              <div class="fr-about-grid__placeholder"></div>
            {%- endif -%}
          </div>

          {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
            <div class="fr-about-grid__text-content">
              {%- if block.settings.title != blank -%}
                <h3 class="fr-about-grid__title" style="--fz-t-d: {{ section.settings.title_size }}px; --fz-t-m: {{ section.settings.title_size_mobile | default: section.settings.title_size | times: 0.8 | round }}px; color: {{ section.settings.title_color }};">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="fr-about-grid__subtitle" style="--fz-s-d: {{ section.settings.subtitle_size }}px; --fz-s-m: {{ section.settings.subtitle_size_mobile | default: section.settings.subtitle_size | times: 0.9 | round }}px; color: {{ section.settings.subtitle_color }};">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
          
        </div>
      {%- endfor -%}
    </div>
    
  </div>
</section>

<style>
  #fr-about-grid-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.7;
    width: 100%;
  }

  #fr-about-grid-{{ section.id }} .fr-about-grid__wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    padding-left: var(--pl-m);
    padding-right: var(--pr-m);
  }

  .fr-about-grid__main-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 40px;
    letter-spacing: 0.01em;
    font-size: var(--fz-mh-m);
    text-align: {{ section.settings.heading_align_mobile | default: section.settings.heading_align }};
  }

  @media (min-width: 768px) {
    .fr-about-grid__main-heading {
      text-align: {{ section.settings.heading_align }};
    }
    #fr-about-grid-{{ section.id }} .fr-about-grid__wrapper {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
      padding-left: var(--pl-d);
      padding-right: var(--pr-d);
    }
  }

  #fr-about-grid-{{ section.id }} .fr-about-grid__container {
    display: grid;
    grid-template-columns: repeat(var(--cols-m), 1fr);
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    #fr-about-grid-{{ section.id }} .fr-about-grid__container {
      grid-template-columns: repeat(var(--cols-d), 1fr);
    }
  }

  .fr-about-grid__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }
  
  .fr-about-grid__link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
  }

  .fr-about-grid__item--border {
    border-right: 1px solid #e5e7eb;
  }
  @media (max-width: 767px) {
    .fr-about-grid__item--border {
      border-right: none;
      border-bottom: 1px solid #e5e7eb;
      padding-bottom: 30px;
      margin-bottom: 30px;
    }
  }

  .fr-about-grid__image-wrapper {
    position: relative;
    overflow: hidden;
    margin: 0 auto 24px auto;
    max-width: var(--img-mw-m);
  }

  @media (min-width: 768px) {
    .fr-about-grid__image-wrapper {
      max-width: var(--img-mw-d);
    }
  }

  /* Shapes */
  .fr-about-grid__shape--circle {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
  }
  
  .fr-about-grid__shape--square {
    aspect-ratio: 1 / 1;
    border-radius: {{ section.settings.image_radius }}px !important;
  }
  
  .fr-about-grid__shape--arch {
    aspect-ratio: 3 / 4;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
  }
  
  .fr-about-grid__shape--original {
    border-radius: {{ section.settings.image_radius }}px !important;
  }

  .fr-about-grid__shape--square .fr-about-grid__img,
  .fr-about-grid__shape--original .fr-about-grid__img {
    border-radius: {{ section.settings.image_radius }}px !important;
  }

  .fr-about-grid__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  
  .fr-about-grid__shape--original .fr-about-grid__img {
    object-fit: contain;
    height: auto;
  }

  .fr-about-grid__placeholder {
    width: 100%;
    height: 100%;
    min-height: 100px;
    background-color: #e5e7eb;
  }

  .fr-about-grid__text-content {
    width: 100%;
    text-align: var(--ta-m);
  }

  @media (min-width: 768px) {
    .fr-about-grid__text-content {
      text-align: var(--ta-d);
    }
  }

  .fr-about-grid__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin: 0 0 4px 0;
    letter-spacing: 0.01em;
    font-size: var(--fz-t-m);
  }

  .fr-about-grid__subtitle {
    margin: 0;
    font-size: var(--fz-s-m);
  }

  @media (min-width: 768px) {
    .fr-about-grid__main-heading { font-size: var(--fz-mh-d); }
    .fr-about-grid__title { font-size: var(--fz-t-d); }
    .fr-about-grid__subtitle { font-size: var(--fz-s-d); }
  }
</style>

{% schema %}
{
  "name": "FR About Grid",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Design Philosophy"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Desktop Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
      "label": "Mobile Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size (Mobile)",
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
