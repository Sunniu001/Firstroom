{{ 'base.css' | asset_url | stylesheet_tag }}

<style>
  .fr-wishlist-page-container {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
    font-family: var(--font-body-family);
  }
  .fr-wishlist-filters {
    display: flex;
    gap: 15px;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }
  .fr-wishlist-filter-btn {
    border: 1px solid #111;
    background: transparent;
    color: #111;
    padding: 10px 20px;
    font-size: 14px;
    cursor: pointer;
    transition: 0.2s;
  }
  .fr-wishlist-filter-btn:hover,
  .fr-wishlist-filter-btn.is-active {
    background: #111;
    color: #fff;
  }
  .fr-wishlist-table-container {
    border: 1px solid #eaeaea;
    background: #fff;
    width: 100%;
    overflow-x: auto;
  }
  .fr-wishlist-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
  }
  .fr-wishlist-table th {
    background: #f4f4f4;
    padding: 15px 20px;
    font-size: 12px;
    font-weight: 600;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: left;
    border-bottom: 1px solid #eaeaea;
  }
  .fr-wishlist-table td {
    padding: 20px;
    border-bottom: 1px solid #eaeaea;
    text-align: left;
    vertical-align: middle;
  }
  .fr-wishlist-table tr:last-child td {
    border-bottom: none;
  }
  .fr-wishlist-product-col {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .fr-wishlist-product-col input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }
  .fr-wishlist-product-img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    background: #f9f9f9;
  }
  .fr-wishlist-product-title {
    font-size: 14px;
    color: #111;
    text-decoration: none;
    font-weight: 500;
  }
  .fr-wishlist-price-col {
    font-size: 14px;
    color: #333;
  }
  .fr-wishlist-price-col strike {
    color: #999;
    margin-right: 8px;
  }
  .fr-wishlist-stock-col {
    font-size: 13px;
    font-weight: 600;
  }
  .fr-wishlist-stock-col.in-stock {
    color: #666;
  }
  .fr-wishlist-stock-col.out-of-stock {
    color: #c2593f;
  }
  .fr-wishlist-action-btn {
    border: 1px solid #111;
    background: #fff;
    color: #111;
    padding: 10px 15px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: 0.2s;
    width: 100%;
    max-width: 140px;
  }
  .fr-wishlist-action-btn:hover {
    background: #111;
    color: #fff;
  }
  .fr-wishlist-bottom-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-top: 1px solid #eaeaea;
    background: #fff;
  }
  .fr-wishlist-bottom-actions .left-actions {
    display: flex;
    gap: 15px;
  }
  .fr-wishlist-bottom-actions .right-actions {
    display: flex;
    gap: 15px;
  }
  .fr-wishlist-btn-return {
    border: 1px solid #111;
    background: #fff;
    color: #111;
    padding: 12px 20px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: 0.2s;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .fr-wishlist-btn-return:hover {
    background: #f9f9f9;
  }
  .fr-wishlist-btn-remove {
    border: 1px solid #c2593f;
    background: #fff;
    color: #c2593f;
    padding: 12px 20px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: 0.2s;
  }
  .fr-wishlist-btn-remove:hover:not(:disabled) {
    background: #c2593f;
    color: #fff;
  }
  
  .fr-wishlist-action-btn:disabled, .fr-wishlist-btn-remove:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: #f4f4f4 !important;
    color: #999 !important;
    border-color: #ddd !important;
  }
  
  .fr-wishlist-title {
    font-family: var(--font-heading-family);
    font-size: 28px;
    margin-bottom: 20px;
  }
  .fr-wishlist-empty {
    padding: 60px 20px;
    text-align: center;
    font-size: 16px;
    color: #666;
  }
</style>

<div class="fr-wishlist-page-container">
  <div class="fr-wishlist-filters" id="fr-wishlist-filters">
    <!-- Populated by JS based on product types -->
  </div>
  
  <h1 class="fr-wishlist-title">Wishlist</h1>

  <div class="fr-wishlist-table-container">
    <table class="fr-wishlist-table">
      <thead>
        <tr>
          <th style="width: 45%;">PRODUCTS</th>
          <th style="width: 20%;">PRICE</th>
          <th style="width: 20%;">STOCK STATUS</th>
          <th style="width: 15%;">ACTION</th>
        </tr>
      </thead>
      <tbody id="fr-wishlist-body">
        <!-- Populated by JS -->
        <tr>
          <td colspan="4" class="fr-wishlist-empty">Loading wishlist...</td>
        </tr>
      </tbody>
    </table>
    
    <div class="fr-wishlist-bottom-actions">
      <div class="left-actions">
        <a href="{{ routes.all_products_collection_url }}" class="fr-wishlist-btn-return">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          RETURN TO SHOP
        </a>
      </div>
      <div class="right-actions">
        <button class="fr-wishlist-action-btn" id="fr-global-move" onclick="addSelectedToCart()" disabled>MOVE TO CART</button>
        <button class="fr-wishlist-btn-remove" id="fr-global-remove" onclick="removeSelectedFromWishlist()" disabled>REMOVE FROM WISHLIST</button>
      </div>
    </div>
  </div>
</div>

<script>
  let wishlistProductsCache = [];
  let currentFilter = '';
  let wishlistsData = [];

  async function loadWishlistPage() {
    const data = getWishlistData();
    wishlistsData = data.wishlists;
    
    if (wishlistsData.length > 0 && !currentFilter) {
      currentFilter = wishlistsData[0].id;
    }

    let allHandles = new Set();
    wishlistsData.forEach(list => list.items.forEach(item => allHandles.add(item)));
    allHandles = Array.from(allHandles);

    if (allHandles.length === 0) {
      document.getElementById('fr-wishlist-body').innerHTML = '<tr><td colspan="4" class="fr-wishlist-empty">Your wishlists are currently empty.</td></tr>';
      renderFilters();
      return;
    }

    const fetches = allHandles.map(handle => 
      fetch(`/products/${handle}.js`).then(res => {
        if (!res.ok) throw new Error('Not found');
        return res.json();
      }).catch(err => null)
    );

    const results = await Promise.all(fetches);
    wishlistProductsCache = results.filter(p => p !== null);
    
    renderFilters();
    renderTable();
  }

  function renderFilters() {
    let html = '';
    
    wishlistsData.forEach(list => {
      html += `<button class="fr-wishlist-filter-btn ${currentFilter === list.id ? 'is-active' : ''}" onclick="setFilter('${list.id}')">${list.name}</button>`;
    });
    
    document.getElementById('fr-wishlist-filters').innerHTML = html;
  }
  
  function setFilter(id) {
    currentFilter = id;
    renderFilters();
    renderTable();
  }

  function renderTable() {
    const tbody = document.getElementById('fr-wishlist-body');
    let html = '';
    
    const activeList = wishlistsData.find(l => l.id === currentFilter);
    if (!activeList) return;

    const filtered = wishlistProductsCache.filter(p => activeList.items.includes(p.handle));

    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" class="fr-wishlist-empty">This wishlist is empty.</td></tr>';
      return;
    }

    filtered.forEach(product => {
      const hasOptions = product.variants.length > 1 || product.type === 'Nameplate' || product.type === 'Wallpaper' || product.type === 'Custom Design';
      const variant = product.variants[0];
      const isAvailable = product.available;
      const stockText = isAvailable ? 'IN STOCK' : 'OUT OF STOCK';
      const stockClass = isAvailable ? 'in-stock' : 'out-of-stock';
      
      const price = Shopify.formatMoney ? Shopify.formatMoney(product.price) : `Rs. ${(product.price / 100).toFixed(2)}`;
      const comparePrice = product.compare_at_price > product.price 
        ? (Shopify.formatMoney ? Shopify.formatMoney(product.compare_at_price) : `Rs. ${(product.compare_at_price / 100).toFixed(2)}`) 
        : '';
        
      const img = product.featured_image ? product.featured_image : '';

      html += `
        <tr>
          <td>
            <div class="fr-wishlist-product-col">
              <input type="checkbox" class="fr-wishlist-checkbox" value="${product.handle}" data-variant-id="${variant.id}" data-has-options="${hasOptions}" onchange="updateGlobalButtons()">
              <img src="${img}" class="fr-wishlist-product-img" alt="">
              <a href="${product.url}" class="fr-wishlist-product-title">${product.title}</a>
            </div>
          </td>
          <td class="fr-wishlist-price-col">
            ${comparePrice ? `<strike>${comparePrice}</strike>` : ''} ${price}
          </td>
          <td class="fr-wishlist-stock-col ${stockClass}">
            ${stockText}
          </td>
          <td>
            ${isAvailable 
              ? (hasOptions 
                  ? `<a href="${product.url}" class="fr-wishlist-action-btn" style="display:inline-block; text-align:center; text-decoration:none; box-sizing:border-box;">SELECT OPTIONS</a>` 
                  : `<button class="fr-wishlist-action-btn" onclick="addToCart(${variant.id}, '${product.handle}')">MOVE TO CART</button>`)
              : `<button class="fr-wishlist-action-btn" disabled>UNAVAILABLE</button>`}
          </td>
        </tr>
      `;
    });
    
    tbody.innerHTML = html;
    updateGlobalButtons();
  }

  function updateGlobalButtons() {
    const checkedBoxes = Array.from(document.querySelectorAll('.fr-wishlist-checkbox:checked'));
    
    // REMOVE FROM WISHLIST should be enabled if ANY box is checked
    document.getElementById('fr-global-remove').disabled = checkedBoxes.length === 0;
    
    // MOVE TO CART should be enabled only if at least one checked box is valid (does not have options)
    const hasValidMoveItem = checkedBoxes.some(cb => cb.getAttribute('data-has-options') !== 'true');
    document.getElementById('fr-global-move').disabled = !hasValidMoveItem;
  }
  
  function addToCart(variantId, productHandle) {
    let formData = {
      'items': [{
        'id': variantId,
        'quantity': 1
      }]
    };
    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    })
    .then(response => {
      const data = getWishlistData();
      const activeList = data.wishlists.find(l => l.id === currentFilter);
      if (activeList) {
        activeList.items = activeList.items.filter(handle => handle !== productHandle);
        saveWishlistData(data);
      }
      
      // Update cart drawer in Dawn theme
      if (document.querySelector('cart-drawer')) {
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            document.documentElement.dispatchEvent(new CustomEvent('cart:change', {
              bubbles: true,
              detail: { cart }
            }));
          });
      }
      
      loadWishlistPage();
    })
    .catch((error) => {
      console.error('Error:', error);
    });
  }
  
  function addSelectedToCart() {
    const checkboxes = document.querySelectorAll('.fr-wishlist-checkbox:checked');
    if (checkboxes.length === 0) return;
    
    const items = [];
    const handlesToRemove = [];
    let skippedOptions = false;
    
    checkboxes.forEach(cb => {
      if (cb.getAttribute('data-has-options') === 'true') {
        skippedOptions = true;
      } else {
        items.push({
          id: parseInt(cb.getAttribute('data-variant-id')),
          quantity: 1
        });
        handlesToRemove.push(cb.value);
      }
    });

    if (skippedOptions) {
      alert('Products requiring custom options were skipped. Please click "SELECT OPTIONS" to configure them individually.');
    }

    if (items.length === 0) return;
    
    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(response => {
      const data = getWishlistData();
      const activeList = data.wishlists.find(l => l.id === currentFilter);
      if (activeList) {
        activeList.items = activeList.items.filter(handle => !handlesToRemove.includes(handle));
        saveWishlistData(data);
      }
      
      // Update cart drawer in Dawn theme
      if (document.querySelector('cart-drawer')) {
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            document.documentElement.dispatchEvent(new CustomEvent('cart:change', {
              bubbles: true,
              detail: { cart }
            }));
          });
      }
      
      loadWishlistPage();
    });
  }
  
  function removeSelectedFromWishlist() {
    const checkboxes = document.querySelectorAll('.fr-wishlist-checkbox:checked');
    if (checkboxes.length === 0) return;
    
    const handlesToRemove = Array.from(checkboxes).map(cb => cb.value);
    const data = getWishlistData();
    
    // Remove from the currently active wishlist
    const activeList = data.wishlists.find(l => l.id === currentFilter);
    if (activeList) {
      activeList.items = activeList.items.filter(handle => !handlesToRemove.includes(handle));
    }
    
    saveWishlistData(data);
    loadWishlistPage(); // reload UI
  }

  document.addEventListener('DOMContentLoaded', loadWishlistPage);
</script>

{% schema %}
{
  "name": "Wishlist Page",
  "settings": []
}
{% endschema %}
