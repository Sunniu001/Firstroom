<section class="fr-coll-tabs-section" id="fr-coll-tabs-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="fr-coll-tabs__wrapper" style="
      --pt-d: {{ section.settings.padding_top }}px;
      --pb-d: {{ section.settings.padding_bottom }}px;
      --pl-d: {{ section.settings.padding_left }}px;
      --pr-d: {{ section.settings.padding_right }}px;
      --pt-m: {{ section.settings.padding_top_mobile | default: section.settings.padding_top }}px;
      --pb-m: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom }}px;
      --pl-m: {{ section.settings.padding_left_mobile | default: section.settings.padding_left }}px;
      --pr-m: {{ section.settings.padding_right_mobile | default: section.settings.padding_right }}px;
      --max-w: {{ section.settings.content_max_width }}px;
    ">
    
    {%- if section.settings.heading != blank -%}
      <div class="fr-coll-tabs__header" style="text-align: {{ section.settings.heading_align }};">
        <h2 class="fr-coll-tabs__main-heading" style="
            color: {{ section.settings.heading_color }};
            --fz-d: {{ section.settings.heading_size }}px;
            --fz-m: {{ section.settings.heading_size_mobile | default: section.settings.heading_size | times: 0.85 | round }}px;
          ">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.description != blank -%}
          <div class="fr-coll-tabs__main-desc" style="color: {{ section.settings.description_color }};">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fr-coll-tabs__nav" role="tablist">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tab_collection = collections[block.settings.collection]
            assign tab_label = block.settings.title
            if tab_label == blank and tab_collection != blank
              assign tab_label = tab_collection.title
            elsif tab_label == blank
              assign tab_label = 'Tab ' | append: forloop.index
            endif

            assign tab_url = block.settings.custom_view_all_link
            if tab_url == blank and tab_collection != blank
              assign tab_url = tab_collection.url
            endif
          -%}
          <button
            class="fr-coll-tabs__tab-btn {% if forloop.first %}fr-coll-tabs__tab-btn--active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-tab-target="tab-pane-{{ section.id }}-{{ block.id }}"
            data-view-all-url="{{ tab_url | default: routes.all_products_collection_url }}"
            {{ block.shopify_attributes }}
          >
            {{ tab_label }}
          </button>
        {%- endfor -%}
      </div>

      <div class="fr-coll-tabs__panels">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tab_collection = collections[block.settings.collection]
            assign product_limit = block.settings.product_limit | default: 4
            assign products_to_show = empty

            if block.settings.product_list != blank
              assign products_to_show = block.settings.product_list
            elsif tab_collection != blank and tab_collection.products_count > 0
              assign products_to_show = tab_collection.products
            endif
          -%}

          <div
            class="fr-coll-tabs__panel {% if forloop.first %}fr-coll-tabs__panel--active{% endif %}"
            id="tab-pane-{{ section.id }}-{{ block.id }}"
            role="tabpanel"
          >
            <div class="fr-coll-tabs__grid" style="
                --cols-d: {{ section.settings.columns_desktop }};
                --cols-m: {{ section.settings.columns_mobile }};
                --gap-d: {{ section.settings.grid_gap }}px;
                --gap-m: {{ section.settings.grid_gap_mobile }}px;
                --card-ar: {{ section.settings.card_aspect_ratio }};
                --card-radius: {{ section.settings.card_radius }}px;
              ">
              {%- if products_to_show != empty and products_to_show.size > 0 -%}
                {%- for product in products_to_show limit: product_limit -%}
                  <div class="fr-coll-tabs__card">
                    <a href="{{ product.url }}" class="fr-coll-tabs__card-media">
                      {%- if product.featured_media != blank -%}
                        <img
                          src="{{ product.featured_media | image_url: width: 700 }}"
                          alt="{{ product.title | escape }}"
                          loading="lazy"
                          class="fr-coll-tabs__img fr-coll-tabs__img--primary"
                        >
                        {%- if product.media.size > 1 and section.settings.show_secondary_image -%}
                          <img
                            src="{{ product.media[1] | image_url: width: 700 }}"
                            alt="{{ product.title | escape }}"
                            loading="lazy"
                            class="fr-coll-tabs__img fr-coll-tabs__img--secondary"
                          >
                        {%- endif -%}
                      {%- else -%}
                        <div class="fr-coll-tabs__placeholder">
                          {{ 'product-1' | placeholder_svg_tag: 'fr-coll-tabs__placeholder-svg' }}
                        </div>
                      {%- endif -%}

                      {%- if product.compare_at_price > product.price and section.settings.show_sale_badge -%}
                        <span class="fr-coll-tabs__badge">Sale</span>
                      {%- endif -%}
                    </a>

                    <div class="fr-coll-tabs__card-info" style="text-align: {{ section.settings.card_text_align }};">
                      <h3 class="fr-coll-tabs__card-title">
                        <a href="{{ product.url }}">{{ product.title }}</a>
                      </h3>

                      <div class="fr-coll-tabs__card-price">
                        {%- if product.compare_at_price > product.price -%}
                          <span class="fr-coll-tabs__price-regular">{{ product.price | money }}</span>
                          <span class="fr-coll-tabs__price-compare">{{ product.compare_at_price | money }}</span>
                        {%- else -%}
                          <span class="fr-coll-tabs__price-regular">{{ product.price | money }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..product_limit) -%}
                  <div class="fr-coll-tabs__card">
                    <div class="fr-coll-tabs__card-media">
                      <div class="fr-coll-tabs__placeholder">
                        <div class="fr-coll-tabs__placeholder-inner">Product {{ i }}</div>
                      </div>
                    </div>
                    <div class="fr-coll-tabs__card-info" style="text-align: {{ section.settings.card_text_align }};">
                      <h3 class="fr-coll-tabs__card-title"><a href="#">Example Product {{ i }}</a></h3>
                      <div class="fr-coll-tabs__card-price"><span class="fr-coll-tabs__price-regular">₹1,999.00</span></div>
                    </div>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all -%}
        {%- liquid
          assign first_block = section.blocks.first
          assign first_collection = collections[first_block.settings.collection]
          assign initial_view_all_url = first_block.settings.custom_view_all_link
          if initial_view_all_url == blank and first_collection != blank
            assign initial_view_all_url = first_collection.url
          endif
        -%}
        <div class="fr-coll-tabs__view-all-wrapper" style="text-align: {{ section.settings.view_all_align }};">
          <a
            href="{{ initial_view_all_url | default: routes.all_products_collection_url }}"
            class="fr-coll-tabs__view-all-btn fr-coll-tabs__view-all-btn--{{ section.settings.view_all_style }}"
          >
            {{ section.settings.view_all_text }}
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</section>

<style>
  #fr-coll-tabs-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    width: 100%;
    position: relative;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__wrapper {
    max-width: var(--max-w);
    margin: 0 auto;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    padding-left: var(--pl-m);
    padding-right: var(--pr-m);
  }

  @media (min-width: 768px) {
    #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__wrapper {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
      padding-left: var(--pl-d);
      padding-right: var(--pr-d);
    }
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__header {
    margin-bottom: 24px;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__main-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--fz-m);
    font-weight: 400;
    margin: 0 0 8px 0;
    letter-spacing: 0.01em;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__main-desc {
    font-size: 14px;
    margin-top: 4px;
  }

  @media (min-width: 768px) {
    #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__main-heading {
      font-size: var(--fz-d);
    }
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    margin-bottom: 40px;
    border-bottom: 1px solid #eaeaea;
    padding-bottom: 12px;
  }

  @media (max-width: 768px) {
    #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__nav {
      gap: 20px;
      margin-bottom: 28px;
      overflow-x: auto;
      white-space: nowrap;
      justify-content: flex-start;
      scrollbar-width: none;
    }
    #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__nav::-webkit-scrollbar {
      display: none;
    }
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__tab-btn {
    background: none;
    border: none;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #6b7280;
    cursor: pointer;
    padding: 6px 4px;
    position: relative;
    transition: color 0.25s ease;
    text-decoration: none;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__tab-btn:hover {
    color: #111827;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__tab-btn--active {
    color: #111827;
    font-weight: 600;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__tab-btn--active::after {
    content: '';
    position: absolute;
    bottom: -13px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #111827;
    border-radius: 2px;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__panels {
    position: relative;
    width: 100%;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__panel {
    display: none;
    animation: frFadeIn 0.35s ease forwards;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__panel--active {
    display: block;
  }

  @keyframes frFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols-m), 1fr);
    gap: var(--gap-m);
  }

  @media (min-width: 768px) {
    #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__grid {
      grid-template-columns: repeat(var(--cols-d), 1fr);
      gap: var(--gap-d);
    }
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__card {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__card-media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--card-ar);
    border-radius: var(--card-radius);
    overflow: hidden;
    background-color: #f6f6f6;
    display: block;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__img--secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__card-media:hover .fr-coll-tabs__img--primary {
    transform: scale(1.04);
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__card-media:hover .fr-coll-tabs__img--secondary {
    opacity: 1;
    transform: scale(1.04);
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__placeholder {
    width: 100%;
    height: 100%;
    background-color: #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__placeholder-inner {
    color: #9ca3af;
    font-size: 14px;
    font-weight: 500;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: #1a1a1a;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: 2px;
    z-index: 2;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__card-info {
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__card-title {
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
    color: #1f2937;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__card-title a:hover {
    color: #000000;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__card-price {
    font-size: 13px;
    font-weight: 600;
    color: #111827;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__price-compare {
    text-decoration: line-through;
    color: #9ca3af;
    font-weight: 400;
    font-size: 12px;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__view-all-wrapper {
    margin-top: 48px;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__view-all-btn {
    display: inline-block;
    text-decoration: none;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    transition: all 0.25s ease;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__view-all-btn--link {
    color: #111827;
    border-bottom: 1.5px solid #111827;
    padding-bottom: 4px;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__view-all-btn--link:hover {
    opacity: 0.7;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__view-all-btn--button {
    background-color: #111827;
    color: #ffffff;
    padding: 12px 36px;
    border-radius: 0px;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  #fr-coll-tabs-{{ section.id }} .fr-coll-tabs__view-all-btn--button:hover {
    background-color: #374151;
  }
</style>

<script>
  (function() {
    function initCollTabs() {
      const section = document.getElementById('fr-coll-tabs-{{ section.id }}');
      if (!section) return;

      const tabButtons = section.querySelectorAll('.fr-coll-tabs__tab-btn');
      const tabPanels = section.querySelectorAll('.fr-coll-tabs__panel');
      const viewAllBtn = section.querySelector('.fr-coll-tabs__view-all-btn');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-tab-target');
          const viewAllUrl = btn.getAttribute('data-view-all-url');

          tabButtons.forEach(b => {
            b.classList.remove('fr-coll-tabs__tab-btn--active');
            b.setAttribute('aria-selected', 'false');
          });
          tabPanels.forEach(p => {
            p.classList.remove('fr-coll-tabs__panel--active');
          });

          btn.classList.add('fr-coll-tabs__tab-btn--active');
          btn.setAttribute('aria-selected', 'true');

          const targetPanel = section.querySelector('#' + targetId);
          if (targetPanel) {
            targetPanel.classList.add('fr-coll-tabs__panel--active');
          }

          if (viewAllBtn && viewAllUrl) {
            viewAllBtn.setAttribute('href', viewAllUrl);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCollTabs);
    } else {
      initCollTabs();
    }
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initCollTabs();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "FR Collection Tabs",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Max Width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collection"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size (Desktop)",
      "min": 18,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile)",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description / Subtitle (Optional)"
