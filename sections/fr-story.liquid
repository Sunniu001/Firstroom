<section class="fr-story" id="fr-story-{{ section.id }}" style="background-color: {{ section.settings.section_bg }};">
  
  <!-- Section 1: Hero Banner -->
  {%- if section.settings.show_hero and section.settings.hero_image != blank -%}
    <div class="fr-story__hero" style="background-image: linear-gradient(rgba(0, 0, 0, {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }}), rgba(0, 0, 0, {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }})), url('{{ section.settings.hero_image | image_url: width: 2400 }}'); height: {{ section.settings.hero_height }}vh;">
      <div class="fr-story__hero-content">
        <h1 class="fr-story__hero-title">{{ section.settings.hero_title }}</h1>
      </div>
    </div>
  {%- elsif section.settings.show_hero -%}
    <div class="fr-story__hero fr-story__hero--no-img" style="height: 25vh; background-color: #faf8f5;">
      <div class="fr-story__hero-content">
        <h1 class="fr-story__hero-title" style="color: #1a1a1a;">{{ section.settings.hero_title }}</h1>
      </div>
    </div>
  {%- endif -%}

  <!-- Section 2: Intro Statement -->
  <div class="fr-story__intro">
    <div class="fr-story__wrapper fr-story__wrapper--narrow">
      <h2 class="fr-story__intro-title">{{ section.settings.intro_title }}</h2>
      <div class="fr-story__intro-text">
        {{ section.settings.intro_text }}
      </div>
    </div>
  </div>

  <!-- Section 3: About The Founders -->
  <div class="fr-story__founders" style="background-color: {{ section.settings.founders_bg }};">
    <div class="fr-story__wrapper">
      <div class="fr-story__founders-grid">
        <div class="fr-story__founder-image-wrapper">
          {%- if section.settings.founders_image != blank -%}
            <img
              src="{{ section.settings.founders_image | image_url: width: 1000 }}"
              alt="{{ section.settings.founders_title | escape }}"
              class="fr-story__founder-img"
              loading="lazy"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'fr-story__placeholder' }}
          {%- endif -%}
        </div>
        <div class="fr-story__founder-content">
          <h2 class="fr-story__section-title">{{ section.settings.founders_title }}</h2>
          <div class="fr-story__bio-text">
            {{ section.settings.founders_bio }}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 4: Tradition Collage -->
  <div class="fr-story__tradition">
    <div class="fr-story__wrapper">
      <h2 class="fr-story__section-title fr-story__text-center">{{ section.settings.tradition_title }}</h2>
      <div class="fr-story__tradition-collage-wrapper">
        {%- if section.settings.tradition_image != blank -%}
          <img
            src="{{ section.settings.tradition_image | image_url: width: 1600 }}"
            alt="{{ section.settings.tradition_title | escape }}"
            class="fr-story__tradition-img"
            loading="lazy"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'fr-story__placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- Section 5: Our Brand Philosophy -->
  <div class="fr-story__philosophy" style="background-color: {{ section.settings.philosophy_bg }};">
    <div class="fr-story__wrapper">
      <h2 class="fr-story__section-title fr-story__text-center">{{ section.settings.philosophy_title }}</h2>
      {%- if section.settings.philosophy_desc != blank -%}
        <div class="fr-story__philosophy-desc fr-story__text-center">
          {{ section.settings.philosophy_desc }}
        </div>
      {%- endif -%}
      
      <div class="fr-story__philosophy-gallery">
        <div class="fr-story__phil-img-wrapper">
          {%- if section.settings.phil_image_1 != blank -%}
            <img
              src="{{ section.settings.phil_image_1 | image_url: width: 800 }}"
              alt="Brand Philosophy Detail 1"
              class="fr-story__phil-img"
              loading="lazy"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'fr-story__placeholder' }}
          {%- endif -%}
        </div>
        <div class="fr-story__phil-img-wrapper">
          {%- if section.settings.phil_image_2 != blank -%}
            <img
              src="{{ section.settings.phil_image_2 | image_url: width: 800 }}"
              alt="Brand Philosophy Detail 2"
              class="fr-story__phil-img"
              loading="lazy"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'fr-story__placeholder' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <!-- Section 6: Accordion Details -->
  {%- if section.blocks.size > 0 -%}
    <div class="fr-story__accordion-section">
      <div class="fr-story__wrapper fr-story__wrapper--narrow">
        <div class="fr-story__accordion-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion_item' -%}
              <div class="fr-story__accordion-item" {{ block.shopify_attributes }}>
                <button class="fr-story__accordion-trigger" aria-expanded="false">
                  <span>{{ block.settings.heading }}</span>
                  <span class="fr-story__accordion-indicator"></span>
                </button>
                <div class="fr-story__accordion-panel">
                  <div class="fr-story__accordion-panel-content">
                    {{ block.settings.content }}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

</section>

<style>
  .fr-story {
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.7;
    color: #4a4a4a;
    overflow-x: hidden;
  }

  .fr-story__wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .fr-story__wrapper--narrow {
    max-width: 800px;
  }

  .fr-story__text-center {
    text-align: center;
  }

  /* Hero Section */
  .fr-story__hero {
    position: relative;
    width: 100%;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .fr-story__hero--no-img {
    border-bottom: 1px solid #e5e7eb;
  }

  .fr-story__hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 20px;
  }

  .fr-story__hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0.01em;
    margin: 0;
    color: #ffffff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.15);
  }

  /* Intro Section Styling */
  .fr-story__intro {
    padding: 80px 0;
    text-align: center;
  }

  @media (max-width: 768px) {
    .fr-story__intro {
      padding: 60px 0;
    }
  }

  .fr-story__intro-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.25;
    margin-top: 0;
    margin-bottom: 25px;
    color: #1a1a1a;
  }

  @media (max-width: 768px) {
    .fr-story__intro-title {
      font-size: 28px;
    }
  }

  .fr-story__intro-text {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.85;
    color: #4a4a4a;
  }

  .fr-story__intro-text p {
    margin: 0 0 15px 0;
  }
  .fr-story__intro-text p:last-child {
    margin-bottom: 0;
  }

  /* Founders Block Styling */
  .fr-story__founders {
    padding: 80px 0;
  }

  @media (max-width: 768px) {
    .fr-story__founders {
      padding: 50px 0;
    }
  }

  .fr-story__founders-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 768px) {
    .fr-story__founders-grid {
      grid-template-columns: 1fr 1.2fr;
      gap: 80px;
    }
  }

  .fr-story__founder-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: #faf8f5;
  }

  .fr-story__founder-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fr-story__section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.25;
    margin-top: 0;
    margin-bottom: 25px;
    letter-spacing: 0.01em;
    color: #1a1a1a;
  }

  .fr-story__bio-text {
    font-size: 15px;
    line-height: 1.75;
    color: #4a4a4a;
  }

  .fr-story__bio-text p {
    margin: 0 0 20px 0;
  }
  .fr-story__bio-text p:last-child {
    margin-bottom: 0;
  }

  /* Tradition Block Styling */
  .fr-story__tradition {
    padding: 80px 0;
  }

  @media (max-width: 768px) {
    .fr-story__tradition {
      padding: 50px 0;
    }
  }

  .fr-story__tradition-collage-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #faf8f5;
  }

  .fr-story__tradition-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Philosophy Block Styling */
  .fr-story__philosophy {
    padding: 80px 0;
  }

  @media (max-width: 768px) {
    .fr-story__philosophy {
      padding: 50px 0;
    }
  }

  .fr-story__philosophy-desc {
    max-width: 800px;
    margin: 0 auto 50px auto;
    font-size: 15px;
    line-height: 1.75;
    color: #4a4a4a;
  }

  .fr-story__philosophy-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  @media (min-width: 576px) {
    .fr-story__philosophy-gallery {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
  }

  .fr-story__phil-img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #faf8f5;
  }

  .fr-story__phil-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Accordion Block Styling */
  .fr-story__accordion-section {
    padding: 60px 0 100px 0;
  }

  @media (max-width: 768px) {
    .fr-story__accordion-section {
      padding: 40px 0 60px 0;
    }
  }

  .fr-story__accordion-list {
    border-top: 1px solid #e5e7eb;
  }

  .fr-story__accordion-item {
    border-bottom: 1px solid #e5e7eb;
  }

  .fr-story__accordion-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 18px;
    font-weight: 500;
    text-align: left;
    color: #1a1a1a;
    font-family: 'Playfair Display', Georgia, serif;
    transition: color 0.2s ease;
  }

  .fr-story__accordion-trigger:hover {
    color: #000000;
  }

  .fr-story__accordion-indicator {
    position: relative;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
  }

  .fr-story__accordion-indicator::after {
    content: '+';
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 22px;
    font-weight: 300;
    line-height: 1;
    display: block;
  }

  .fr-story__accordion-trigger[aria-expanded="true"] .fr-story__accordion-indicator::after {
    content: '−';
  }

  .fr-story__accordion-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fr-story__accordion-panel-content {
    padding-bottom: 24px;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.65;
    color: #666;
  }

  .fr-story__accordion-panel-content p {
    margin: 0 0 12px 0;
  }
  .fr-story__accordion-panel-content p:last-child {
    margin-bottom: 0;
  }

  .fr-story__placeholder {
    width: 100%;
    height: 100%;
    background-color: #faf8f5;
    color: #cccccc;
  }
</style>

<script>
  (function() {
    function initStoryAccordions(container) {
      var root = container || document;
      const triggers = root.querySelectorAll('.fr-story__accordion-trigger');
      
      triggers.forEach(trigger => {
        if (trigger.getAttribute('data-accordion-initialized') === 'true') return;
        trigger.setAttribute('data-accordion-initialized', 'true');
        
        trigger.addEventListener('click', function() {
          const isExpanded = this.getAttribute('aria-expanded') === 'true';
          const panel = this.nextElementSibling;
          const list = this.closest('.fr-story__accordion-list');
          
          // Close all other panels in this list
          if (list) {
            list.querySelectorAll('.fr-story__accordion-trigger').forEach(btn => {
              if (btn !== this) {
                btn.setAttribute('aria-expanded', 'false');
                if (btn.nextElementSibling) {
                  btn.nextElementSibling.style.maxHeight = null;
                }
              }
            });
          }
          
          // Toggle current panel
          if (isExpanded) {
            this.setAttribute('aria-expanded', 'false');
            if (panel) panel.style.maxHeight = null;
          } else {
            this.setAttribute('aria-expanded', 'true');
            if (panel) panel.style.maxHeight = panel.scrollHeight + 'px';
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      var sectionContainer = document.getElementById('fr-story-{{ section.id }}');
      initStoryAccordions(sectionContainer);
    });

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target && e.target.classList.contains('fr-story-section')) {
        initStoryAccordions(e.target);
      }
    });
    
    // Run immediately if DOM element is already parsed
    var sectionContainer = document.getElementById('fr-story-{{ section.id }}');
    if (sectionContainer) {
      initStoryAccordions(sectionContainer);
    }
  })();
</script>

