<section class="fr-video-section" id="fr-video-{{ section.id }}">
  <h2 class="fr-video-section__title">{{ section.settings.title }}</h2>
  <div class="fr-video-section__wrapper">
    {%- if section.settings.video_url != blank -%}
      {%- comment -%}
        Shopify hosted video via Liquid video object
      {%- endcomment -%}
      {%- assign video_url = section.settings.video_url -%}
      {%- if video_url contains 'youtube.com' or video_url contains 'youtu.be' -%}
        {%- comment -%} YouTube embed {%- endcomment -%}
        {%- assign video_id = video_url | split: 'v=' | last | split: '&' | first -%}
        {%- if video_url contains 'youtu.be/' -%}
          {%- assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
        {%- endif -%}
        <iframe
          class="fr-video-section__iframe"
          src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&mute=1&loop=1&playlist={{ video_id }}&controls=0&playsinline=1&rel=0"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      {%- elsif video_url contains 'vimeo.com' -%}
        {%- assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first -%}
        <iframe
          class="fr-video-section__iframe"
          src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&muted=1&loop=1&background=1"
          frameborder="0"
          allow="autoplay; fullscreen"
        ></iframe>
      {%- else -%}
        <video
          class="fr-video-section__iframe"
          autoplay
          muted
          loop
          playsinline
        >
          <source src="{{ video_url }}" type="video/mp4">
        </video>
      {%- endif -%}
    {%- elsif section.settings.shopify_video != blank -%}
      <video
        class="fr-video-section__iframe"
        autoplay
        muted
        loop
        playsinline
      >
        {%- for source in section.settings.shopify_video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    {%- endif -%}
  </div>
</section>

<style>
  #fr-video-{{ section.id }} {
    padding: 10px 0 0 0;
    text-align: center;
    background-color: #ffffff;
  }

  .fr-video-section__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 32px;
    font-weight: 400;
    color: #1a1a1a;
    margin-bottom: 60px;
    padding: 60px 2rem 0;
  }

  @media (max-width: 768px) {
    .fr-video-section__title {
      font-size: 26px;
      padding: 40px 24px 0;
      margin-bottom: 40px;
    }
  }

  .fr-video-section__wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0;
    aspect-ratio: 16 / 9;
    background-color: #000;
    overflow: hidden;
  }

  .fr-video-section__iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 115%;
    transform: translate(-50%, -50%) scale(1.2);
    border: none;
    pointer-events: none;
    object-fit: cover;
  }
</style>

{% schema %}
{
  "name": "FR Video Section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "When Your Vision Becomes Your Space"
    },
    {
      "type": "video",
      "id": "shopify_video",
      "label": "Video (Upload to Shopify)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Or paste a YouTube / Vimeo URL",
      "info": "Leave blank if using an uploaded Shopify video above."
    }
  ],
  "presets": [
    {
      "name": "FR Video Section"
    }
  ]
}
{% endschema %}