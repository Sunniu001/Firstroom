{%- comment -%}
  FR New Projects Section (2-Tier Layout matching Diagram)
  - Centered/Configurable Heading
  - Row 1: 2 Featured Cards (Wide Left ~58% + Medium Right ~42%) with bottom-left floating badges
  - Row 2: 4 Equal Grid Cards with bottom-left floating badges
  - Fully responsive (Mobile adapts cleanly to stacked/2-column layout)
{%- endcomment -%}

<section id="fr-new-projects-{{ section.id }}" class="fr-new-projects" style="
  background-color: {{ section.settings.bg_color | default: '#ffffff' }};
  --pt-m: {{ section.settings.padding_top_mobile | default: 40 }}px;
  --pb-m: {{ section.settings.padding_bottom_mobile | default: 50 }}px;
  --pt-d: {{ section.settings.padding_top | default: 70 }}px;
  --pb-d: {{ section.settings.padding_bottom | default: 90 }}px;
  --gap-d: {{ section.settings.grid_gap_desktop | default: 24 }}px;
  --gap-m: {{ section.settings.grid_gap_mobile | default: 16 }}px;
  --row1-h-d: {{ section.settings.row1_height | default: 440 }}px;
  --row1-h-m: {{ section.settings.row1_height_mobile | default: 250 }}px;
  --row1-split: {{ section.settings.row1_split | default: 58 }}%;
  --row2-aspect: {{ section.settings.row2_aspect_ratio | default: 105 }}%;
  --card-radius: {{ section.settings.card_border_radius | default: 0 }}px;
  --badge-bg: {{ section.settings.badge_bg_color | default: '#ffffff' }};
  --badge-title-color: {{ section.settings.badge_title_color | default: '#1a1a1a' }};
  --badge-sub-color: {{ section.settings.badge_sub_color | default: '#777777' }};
  --badge-pad-v: {{ section.settings.badge_padding_v | default: 12 }}px;
  --badge-pad-h: {{ section.settings.badge_padding_h | default: 20 }}px;
  --badge-radius: {{ section.settings.badge_radius | default: 0 }}px;
  --badge-shadow: {% if section.settings.badge_shadow %}0 4px 16px rgba(0,0,0,0.08){% else %}none{% endif %};
">
  <div class="fr-new-projects__container" style="max-width: {{ section.settings.container_max_width | default: 1300 }}px;">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-new-projects__heading" style="
        font-size: {{ section.settings.heading_size | default: 36 }}px;
        color: {{ section.settings.heading_color | default: '#1a1a1a' }};
        --ha-m: {{ section.settings.heading_align_mobile | default: 'center' }};
        --ha-d: {{ section.settings.heading_alignment | default: 'center' }};
        margin-bottom: {{ section.settings.heading_margin_bottom | default: 40 }}px;
      ">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="fr-new-projects__subheading" style="
        color: {{ section.settings.subheading_color | default: '#666666' }};
        --ha-m: {{ section.settings.heading_align_mobile | default: 'center' }};
        --ha-d: {{ section.settings.heading_alignment | default: 'center' }};
      ">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {%- comment -%} Capture blocks by type or order {%- endcomment -%}
    {%- assign blocks_count = section.blocks.size -%}
    
    <div class="fr-new-projects__wrapper">
      
      {%- comment -%} ================= ROW 1 (2 Featured Cards) ================= {%- endcomment -%}
      <div class="fr-new-projects__row1">
        {%- for block in section.blocks limit: 2 -%}
          {%- assign card_class = 'fr-new-projects__card--medium' -%}
          {%- if forloop.first -%}
            {%- assign card_class = 'fr-new-projects__card--wide' -%}
          {%- endif -%}

          <div class="fr-new-projects__card fr-new-projects__card--row1 {{ card_class }}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="fr-new-projects__card-link">
            {%- else -%}
              <div class="fr-new-projects__card-link">
            {%- endif -%}

              <div class="fr-new-projects__card-inner">
                <div class="fr-new-projects__image-box">
                  {%- if block.settings.image != blank -%}
                    <img 
                      src="{{ block.settings.image | image_url: width: 1400 }}" 
                      alt="{{ block.settings.title | default: 'Project' | escape }}" 
                      class="fr-new-projects__img" 
                      loading="lazy">
                  {%- else -%}
                    <div class="fr-new-projects__placeholder">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                      <span>Select Project Image</span>
                    </div>
                  {%- endif -%}
                </div>

                <!-- Bottom-Left Floating White Badge -->
                {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                  <div class="fr-new-projects__badge">
                    {%- if block.settings.title != blank -%}
                      <h3 class="fr-new-projects__badge-title">{{ block.settings.title }}</h3>
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                      <div class="fr-new-projects__badge-sub">{{ block.settings.subtitle }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} ================= ROW 2 (4 Equal Grid Cards) ================= {%- endcomment -%}
      {%- if blocks_count > 2 -%}
        <div class="fr-new-projects__row2">
          {%- for block in section.blocks offset: 2 limit: 4 -%}
            <div class="fr-new-projects__card fr-new-projects__card--row2" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="fr-new-projects__card-link">
              {%- else -%}
                <div class="fr-new-projects__card-link">
              {%- endif -%}

                <div class="fr-new-projects__card-inner">
                  <div class="fr-new-projects__image-box">
                    {%- if block.settings.image != blank -%}
                      <img 
                        src="{{ block.settings.image | image_url: width: 800 }}" 
                        alt="{{ block.settings.title | default: 'Project' | escape }}" 
                        class="fr-new-projects__img" 
                        loading="lazy">
                    {%- else -%}
                      <div class="fr-new-projects__placeholder">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                        <span>Select Image</span>
                      </div>
                    {%- endif -%}
                  </div>

                  <!-- Bottom-Left Floating White Badge -->
                  {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                    <div class="fr-new-projects__badge">
                      {%- if block.settings.title != blank -%}
                        <h3 class="fr-new-projects__badge-title">{{ block.settings.title }}</h3>
                      {%- endif -%}
                      {%- if block.settings.subtitle != blank -%}
                        <div class="fr-new-projects__badge-sub">{{ block.settings.subtitle }}</div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>

              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

  </div>
</section>

<style>
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.title_font | font_face: font_display: 'swap' }}
  {{ section.settings.sub_font | font_face: font_display: 'swap' }}

  #fr-new-projects-{{ section.id }} {
    width: 100%;
    box-sizing: border-box;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 860px) {
    #fr-new-projects-{{ section.id }} {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
    }
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__container {
    margin: 0 auto;
    width: 100%;
    padding: 0 24px;
    box-sizing: border-box;
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__heading {
    display: block;
    width: 100%;
    margin-top: 0;
    font-family: {{ section.settings.heading_font.family | default: "'Playfair Display'" }}, {{ section.settings.heading_font.fallback_families | default: 'serif' }};
    font-weight: {{ section.settings.heading_font.weight | default: 400 }};
    font-style: {{ section.settings.heading_font.style | default: 'normal' }};
    text-align: var(--ha-m);
    line-height: 1.25;
  }

  @media (min-width: 860px) {
    #fr-new-projects-{{ section.id }} .fr-new-projects__heading {
      text-align: var(--ha-d);
    }
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__subheading {
    font-family: {{ section.settings.sub_font.family | default: "'Lato'" }}, {{ section.settings.sub_font.fallback_families | default: 'sans-serif' }};
    font-size: 14px;
    text-align: var(--ha-m);
    margin-top: -24px;
    margin-bottom: 36px;
  }

  @media (min-width: 860px) {
    #fr-new-projects-{{ section.id }} .fr-new-projects__subheading {
      text-align: var(--ha-d);
    }
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--gap-m);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 860px) {
    #fr-new-projects-{{ section.id }} .fr-new-projects__wrapper {
      gap: var(--gap-d);
    }
  }

  /* ==========================================
     ROW 1: TWO ASYMMETRIC FEATURED CARDS
     ========================================== */
  #fr-new-projects-{{ section.id }} .fr-new-projects__row1 {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--gap-m);
    box-sizing: border-box;
  }

  @media (min-width: 860px) {
    #fr-new-projects-{{ section.id }} .fr-new-projects__row1 {
      flex-direction: row;
      align-items: stretch;
      gap: var(--gap-d);
    }
    #fr-new-projects-{{ section.id }} .fr-new-projects__card--wide {
      width: calc(var(--row1-split) - (var(--gap-d) / 2));
      flex-shrink: 0;
    }
    #fr-new-projects-{{ section.id }} .fr-new-projects__card--medium {
      width: calc((100% - var(--row1-split)) - (var(--gap-d) / 2));
      flex-shrink: 0;
    }
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__card--row1 .fr-new-projects__card-inner {
    height: var(--row1-h-m);
  }

  @media (min-width: 860px) {
    #fr-new-projects-{{ section.id }} .fr-new-projects__card--row1 .fr-new-projects__card-inner {
      height: var(--row1-h-d);
    }
  }

  /* ==========================================
     ROW 2: FOUR EQUAL GRID CARDS
     ========================================== */
  #fr-new-projects-{{ section.id }} .fr-new-projects__row2 {
    display: grid;
    grid-template-columns: repeat({{ section.settings.row2_cols_mobile | default: 2 }}, 1fr);
    width: 100%;
    gap: var(--gap-m);
    box-sizing: border-box;
  }

  @media (min-width: 860px) {
    #fr-new-projects-{{ section.id }} .fr-new-projects__row2 {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--gap-d);
    }
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__card--row2 .fr-new-projects__card-inner {
    width: 100%;
    padding-bottom: var(--row2-aspect);
    height: 0;
  }

  /* ==========================================
     CARD STYLING & FLOATING BADGE
     ========================================== */
  #fr-new-projects-{{ section.id }} .fr-new-projects__card {
    position: relative;
    box-sizing: border-box;
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    width: 100%;
    height: 100%;
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__card-inner {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--card-radius);
    background-color: #f3f3f3;
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__image-box {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__card-link:hover .fr-new-projects__img {
    transform: scale(1.04);
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: #e5e5e5;
    color: #888888;
    font-size: 13px;
    font-family: sans-serif;
  }

  /* Floating Bottom-Left White Badge */
  #fr-new-projects-{{ section.id }} .fr-new-projects__badge {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background-color: var(--badge-bg);
    padding: var(--badge-pad-v) var(--badge-pad-h);
    border-radius: var(--badge-radius);
    box-shadow: var(--badge-shadow);
    z-index: 3;
    max-width: calc(100% - 32px);
    box-sizing: border-box;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  @media (min-width: 860px) {
    #fr-new-projects-{{ section.id }} .fr-new-projects__badge {
      bottom: 20px;
      left: 20px;
      max-width: calc(100% - 40px);
    }
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__card-link:hover .fr-new-projects__badge {
    transform: translateY(-2px);
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__badge-title {
    margin: 0;
    font-family: {{ section.settings.title_font.family | default: "'Playfair Display'" }}, {{ section.settings.title_font.fallback_families | default: 'serif' }};
    font-weight: {{ section.settings.title_font.weight | default: 500 }};
    font-style: {{ section.settings.title_font.style | default: 'normal' }};
    font-size: {{ section.settings.badge_title_size | default: 16 }}px;
    color: var(--badge-title-color);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #fr-new-projects-{{ section.id }} .fr-new-projects__badge-sub {
    margin: 3px 0 0 0;
    font-family: {{ section.settings.sub_font.family | default: "'Lato'" }}, {{ section.settings.sub_font.fallback_families | default: 'sans-serif' }};
    font-weight: {{ section.settings.sub_font.weight | default: 400 }};
    font-style: {{ section.settings.sub_font.style | default: 'normal' }};
    font-size: {{ section.settings.badge_sub_size | default: 12 }}px;
    color: var(--badge-sub-color);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

{% schema %}
{
  "name": "FR New Projects",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Projects."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (Optional)"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1300
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "playfair_display_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
      "label": "Heading Alignment (Mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Heading Margin Bottom",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#666666"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Badge Title Font",
      "default": "playfair_display_n5"
    },
    {
      "type": "range",
      "id": "badge_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Badge Title Size",
      "default": 16
    },
    {
      "type": "font_picker",
      "id": "sub_font",
      "label": "Badge Subtitle Font",
      "default": "lato_n4"
    },
    {
      "type": "range",
      "id": "badge_sub_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Badge Subtitle Size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout & Sizing"
    },
    {
      "type": "range",
      "id": "row1_split",
      "min": 50,
      "max": 75,
      "step": 1,
      "unit": "%",
      "label": "Row 1: Left Card Width Share",
      "info": "58% matches the reference diagram.",
      "default": 58
    },
    {
      "type": "range",
      "id": "row1_height",
      "min": 250,
      "max": 650,
      "step": 10,
      "unit": "px",
      "label": "Row 1: Height (Desktop)",
      "default": 440
    },
    {
      "type": "range",
      "id": "row1_height_mobile",
      "min": 160,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Row 1: Height (Mobile)",
      "default": 250
    },
    {
      "type": "range",
      "id": "row2_aspect_ratio",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Row 2: Card Aspect Ratio (Height / Width)",
      "info": "100% = Square, 105% = Near Square, 125% = Portrait",
      "default": 105
    },
    {
      "type": "select",
      "id": "row2_cols_mobile",
      "label": "Row 2: Columns on Mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Floating Badge Style"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_title_color",
      "label": "Badge Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "badge_sub_color",
      "label": "Badge Subtitle Color",
      "default": "#777777"
    },
    {
      "type": "range",
      "id": "badge_padding_v",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Badge Vertical Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "badge_padding_h",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Badge Horizontal Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "badge_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Badge Border Radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "badge_shadow",
      "label": "Enable Badge Drop Shadow",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
