{%- comment -%}
  FR Custom Features Section (e.g. "What is custom design")
{%- endcomment -%}

<section id="fr-custom-features-{{ section.id }}" class="fr-custom-features" style="
  background-color: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  padding-left: {{ section.settings.padding_left }}px;
  padding-right: {{ section.settings.padding_right }}px;
">
  <div class="fr-custom-features__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-custom-features__heading" style="
        font-size: {{ section.settings.heading_size }}px;
        color: {{ section.settings.heading_color }};
        text-align: {{ section.settings.heading_alignment }};
      ">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="fr-custom-features__grid" style="gap: {{ section.settings.gap }}px;">
      {%- for block in section.blocks -%}
        <div class="fr-custom-features__item" {{ block.shopify_attributes }}>
          <div class="fr-custom-features__icon-wrapper" style="width: {{ block.settings.icon_size | default: section.settings.icon_size }}px; height: {{ block.settings.icon_size | default: section.settings.icon_size }}px;">
            {%- if block.settings.icon != blank -%}
              <img src="{{ block.settings.icon | image_url: width: 300 }}" alt="{{ block.settings.text | escape }}" loading="lazy" class="fr-custom-features__icon">
            {%- else -%}
              <div class="fr-custom-features__icon-placeholder"></div>
            {%- endif -%}
          </div>
          {%- if block.settings.text != blank -%}
            <span class="fr-custom-features__text" style="
              font-size: {{ section.settings.text_size }}px;
              color: {{ section.settings.text_color }};
            ">{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.text_font | font_face: font_display: 'swap' }}

  #fr-custom-features-{{ section.id }} .fr-custom-features__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }
  
  #fr-custom-features-{{ section.id }} .fr-custom-features__text {
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__heading {
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    font-weight: {{ section.settings.heading_font.weight | default: 500 }};
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 200px;
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__icon-wrapper {
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #f5f5f5;
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__icon-placeholder {
    width: 100%;
    height: 100%;
    background-color: #ddd;
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__text {
    font-weight: {{ section.settings.text_font.weight | default: 400 }};
    line-height: 1.4;
    text-align: center;
  }

  @media (max-width: 767px) {
    #fr-custom-features-{{ section.id }} .fr-custom-features__grid {
      gap: 20px;
    }
    #fr-custom-features-{{ section.id }} .fr-custom-features__item {
      width: calc(50% - 10px);
    }
  }
</style>

{% schema %}
{
  "name": "FR Custom Features",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What is custom design"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "playfair_display_n5"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Margin Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Icon/Image Size",
      "default": 80
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Text Font",
      "default": "lato_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Spacing Between Items",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon/Image (Circular)"
        },
        {
          "type": "range",
          "id": "icon_size",
          "min": 40,
          "max": 200,
          "step": 5,
          "unit": "px",
          "label": "Image Size (Overrides Section Default)",
          "default": 80
        },
        {
          "type": "text",
          "id": "text",
          "label": "Label Text",
          "default": "Feature Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Custom Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
