{%- liquid
  assign cols_m = section.settings.columns_mobile | default: 'slider_peek'
  if cols_m == 'slider_1'
    assign card_w_m = '100%'
  elsif cols_m == 'slider_peek'
    assign card_w_m = '75%'
  elsif cols_m == 'slider_2'
    assign card_w_m = 'calc((100% - var(--gap-m)) / 2)'
  elsif cols_m == 'grid_2'
    assign card_w_m = 'calc((100% - var(--gap-m)) / 2)'
  else
    assign card_w_m = section.settings.card_width_mobile | default: 75 | append: '%'
  endif
-%}

<section id="fr-custom-features-{{ section.id }}" class="fr-custom-features" style="
  background-color: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top_mobile | default: section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom }}px;
  --pt-d: {{ section.settings.padding_top }}px;
  --pb-d: {{ section.settings.padding_bottom }}px;
  padding-left: {{ section.settings.padding_left }}px;
  padding-right: {{ section.settings.padding_right }}px;
  --fz-txt-d: {{ section.settings.text_size }}px;
  --fz-txt-m: {{ section.settings.text_size_mobile | default: section.settings.text_size }}px;
  --fz-hd-d: {{ section.settings.heading_size }}px;
  --fz-hd-m: {{ section.settings.heading_size_mobile | default: section.settings.heading_size }}px;
  --icon-sz-d: {{ section.settings.icon_size }}px;
  --icon-sz-m: {{ section.settings.icon_size_mobile | default: section.settings.icon_size }}px;
  --gap-d: {{ section.settings.gap }}px;
  --gap-m: {{ section.settings.gap_mobile | default: section.settings.gap }}px;
  --card-w-m: {{ card_w_m }};
">
  <div class="fr-custom-features__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-custom-features__heading" style="
        color: {{ section.settings.heading_color }};
        --ha-d: {{ section.settings.heading_alignment }};
        --ha-m: {{ section.settings.heading_align_mobile | default: section.settings.heading_alignment }};
      ">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="fr-custom-features__wrapper">
      {%- if section.settings.show_arrows -%}
        <button class="fr-custom-features__arrow fr-custom-features__arrow--prev" type="button" aria-label="Previous feature">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
      {%- endif -%}

      <div class="fr-custom-features__grid">
        {%- for block in section.blocks -%}
          <div class="fr-custom-features__item" {{ block.shopify_attributes }}>
            <div class="fr-custom-features__icon-wrapper">
              {%- if block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 300 }}" alt="{{ block.settings.text | escape }}" loading="lazy" class="fr-custom-features__icon">
              {%- else -%}
                <div class="fr-custom-features__icon-placeholder"></div>
              {%- endif -%}
            </div>
            {%- if block.settings.text != blank -%}
              <span class="fr-custom-features__text" style="
                color: {{ section.settings.text_color }};
              ">{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_arrows -%}
        <button class="fr-custom-features__arrow fr-custom-features__arrow--next" type="button" aria-label="Next feature">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.text_font | font_face: font_display: 'swap' }}

  #fr-custom-features-{{ section.id }} .fr-custom-features__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }
  
  #fr-custom-features-{{ section.id }} .fr-custom-features__text {
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  
  @media (min-width: 768px) {
    #fr-custom-features-{{ section.id }} {
      padding-top: var(--pt-d) !important;
      padding-bottom: var(--pb-d) !important;
    }
    #fr-custom-features-{{ section.id }} .fr-custom-features__heading {
      text-align: var(--ha-d) !important;
      font-size: var(--fz-hd-d) !important;
    }
    #fr-custom-features-{{ section.id }} .fr-custom-features__text {
      font-size: var(--fz-txt-d) !important;
    }
    #fr-custom-features-{{ section.id }} .fr-custom-features__icon-wrapper {
      width: var(--icon-sz-d) !important;
      height: var(--icon-sz-d) !important;
    }
    #fr-custom-features-{{ section.id }} .fr-custom-features__grid {
      gap: var(--gap-d) !important;
    }
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__heading {
    display: block;
    width: 100%;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    font-weight: {{ section.settings.heading_font.weight | default: 500 }};
    text-align: var(--ha-m);
    font-size: var(--fz-hd-m);
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-m);
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 200px;
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__icon-wrapper {
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #f5f5f5;
    width: var(--icon-sz-m);
    height: var(--icon-sz-m);
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__icon-placeholder {
    width: 100%;
    height: 100%;
    background-color: #ddd;
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__text {
    font-weight: {{ section.settings.text_font.weight | default: 400 }};
    line-height: 1.4;
    text-align: center;
    font-size: var(--fz-txt-m);
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__wrapper {
    position: relative;
    width: 100%;
  }

  #fr-custom-features-{{ section.id }} .fr-custom-features__arrow {
    display: none;
  }

  @media (max-width: 767px) {
    {%- if section.settings.columns_mobile contains 'slider' -%}
      #fr-custom-features-{{ section.id }} .fr-custom-features__grid {
        display: flex !important;
        flex-wrap: nowrap !important;
        overflow-x: auto !important;
        scroll-snap-type: x mandatory !important;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-bottom: 12px;
        justify-content: flex-start !important;
      }
      #fr-custom-features-{{ section.id }} .fr-custom-features__grid::-webkit-scrollbar {
        display: none;
      }
      #fr-custom-features-{{ section.id }} .fr-custom-features__item {
        flex: 0 0 var(--card-w-m) !important;
        min-width: 0 !important;
        max-width: none !important;
        scroll-snap-align: center !important;
      }
      #fr-custom-features-{{ section.id }} .fr-custom-features__arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #ffffff;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
        border: 1px solid rgba(0, 0, 0, 0.08);
        color: #1a1a1a;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s ease;
        opacity: 0.9;
      }
      #fr-custom-features-{{ section.id }} .fr-custom-features__arrow svg {
        width: 16px;
        height: 16px;
      }
      #fr-custom-features-{{ section.id }} .fr-custom-features__arrow--prev {
        left: 4px;
      }
      #fr-custom-features-{{ section.id }} .fr-custom-features__arrow--next {
        right: 4px;
      }
    {%- else -%}
      #fr-custom-features-{{ section.id }} .fr-custom-features__item {
        width: calc(50% - (var(--gap-m) / 2));
      }
    {%- endif -%}
  }
</style>

<script>
  (function() {
    function initCustomFeaturesSlider() {
      const section = document.getElementById('fr-custom-features-{{ section.id }}');
      if (!section) return;

      const track = section.querySelector('.fr-custom-features__grid');
      const prevBtn = section.querySelector('.fr-custom-features__arrow--prev');
      const nextBtn = section.querySelector('.fr-custom-features__arrow--next');
      const enableAutoplay = {{ section.settings.enable_autoplay | json }};
      const duration = ({{ section.settings.slider_duration | default: 4 }} * 1000);

      if (!track) return;

      let timer = null;

      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        const maxScrollLeft = track.scrollWidth - track.clientWidth - 5;
        prevBtn.style.opacity = track.scrollLeft <= 5 ? '0' : '0.9';
        prevBtn.style.pointerEvents = track.scrollLeft <= 5 ? 'none' : 'auto';
        nextBtn.style.opacity = track.scrollLeft >= maxScrollLeft ? '0' : '0.9';
        nextBtn.style.pointerEvents = track.scrollLeft >= maxScrollLeft ? 'none' : 'auto';
      }

      function scrollNext() {
        const item = track.querySelector('.fr-custom-features__item');
        const gap = parseInt(window.getComputedStyle(track).gap) || 20;
        const step = item ? item.offsetWidth + gap : 240;
        const maxScroll = track.scrollWidth - track.clientWidth;
        
        if (track.scrollLeft >= maxScroll - 5) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: step, behavior: 'smooth' });
        }
      }

      function scrollPrev() {
        const item = track.querySelector('.fr-custom-features__item');
        const gap = parseInt(window.getComputedStyle(track).gap) || 20;
        const step = item ? item.offsetWidth + gap : 240;
        track.scrollBy({ left: -step, behavior: 'smooth' });
      }

      if (prevBtn) prevBtn.addEventListener('click', scrollPrev);
      if (nextBtn) nextBtn.addEventListener('click', scrollNext);

      function startTimer() {
        if (enableAutoplay && window.innerWidth <= 767 && duration > 0) {
          timer = setInterval(scrollNext, duration);
        }
      }

      function stopTimer() {
        if (timer) clearInterval(timer);
      }

      track.addEventListener('scroll', updateArrows, { passive: true });
      track.addEventListener('touchstart', stopTimer, { passive: true });
      window.addEventListener('resize', updateArrows);

      startTimer();
      setTimeout(updateArrows, 100);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCustomFeaturesSlider);
    } else {
      initCustomFeaturesSlider();
    }
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initCustomFeaturesSlider();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "FR Custom Features",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Layout Style",
      "options": [
        { "value": "slider_peek", "label": "1 Card + Peeking Next Card Slider" },
        { "value": "slider_1", "label": "1 Card Slider (Full Width)" },
        { "value": "slider_2", "label": "2 Cards Slider" },
        { "value": "grid_2", "label": "2 Columns Grid (Stacked)" }
      ],
      "default": "slider_peek",
      "info": "Choose a slider option to enable horizontal swipe on mobile"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Mobile Auto Slider",
      "default": true
    },
    {
      "type": "range",
      "id": "slider_duration",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Mobile Autoplay Duration",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows on Mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Custom Mobile Card Width %",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What is custom design"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "playfair_display_n5"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
      "label": "Heading Alignment (Mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Margin Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Icon/Image Size (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "min": 30,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Icon/Image Size (Mobile)",
      "default": 60
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Text Font",
      "default": "lato_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size (Desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size (Mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Spacing Between Items (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 100,
