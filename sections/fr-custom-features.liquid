      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon/Image (Circular)"
        },
        {
          "type": "range",
          "id": "icon_size",
          "min": 40,
          "max": 200,
          "step": 5,
          "unit": "px",
          "label": "Image Size (Overrides Section Default)",
          "default": 80
        },
        {
