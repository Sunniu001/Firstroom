<section class="fr-home-hero" id="fr-home-hero-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="fr-home-hero__wrapper" style="
      --pt-d: {{ section.settings.padding_top }}px;
      --pb-d: {{ section.settings.padding_bottom }}px;
      --pt-m: {{ section.settings.padding_top_mobile | default: section.settings.padding_top }}px;
      --pb-m: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom }}px;
    ">
    
    <div class="fr-home-hero__background">
      {%- assign first_slide_rendered = false -%}
      
      {%- assign bg_img = section.settings.bg_image -%}
      {%- if bg_img != blank -%}
        <img src="{{ bg_img | image_url: width: 2400 }}" alt="{{ section.settings.title | escape }}" loading="eager" class="fr-home-hero__bg-img fr-home-hero__slide is-active">
        {%- assign first_slide_rendered = true -%}
      {%- endif -%}

      {%- for i in (2..5) -%}
        {%- assign image_key = 'slide_' | append: i -%}
        {%- assign img = section.settings[image_key] -%}
        {%- if img != blank -%}
          <img src="{{ img | image_url: width: 2400 }}" alt="{{ section.settings.title | escape }}" loading="eager" class="fr-home-hero__bg-img fr-home-hero__slide {% if first_slide_rendered == false %}is-active{% endif %}">
          {%- assign first_slide_rendered = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- assign slide_blocks = section.blocks | where: "type", "slide" -%}
      {%- if slide_blocks.size > 0 -%}
        {%- for block in slide_blocks -%}
          <img src="{{ block.settings.image | image_url: width: 2400 }}" alt="Slide" loading="eager" class="fr-home-hero__bg-img fr-home-hero__slide {% if first_slide_rendered == false and forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if first_slide_rendered == false and forloop.first -%}
            {%- assign first_slide_rendered = true -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if first_slide_rendered == false -%}
        <div class="fr-home-hero__placeholder"></div>
      {%- endif -%}
      
      <div class="fr-home-hero__overlay" style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    </div>

    <div class="fr-home-hero__content-container" style="max-width: {{ section.settings.content_max_width }}px;">
      <div class="fr-home-hero__content" style="
          text-align: {{ section.settings.text_align }};
          align-items: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
        ">
        
        {%- if section.settings.title != blank -%}
          <h1 class="fr-home-hero__title" style="--fz-d: {{ section.settings.title_size }}px; --fz-m: {{ section.settings.title_size_mobile | default: section.settings.title_size | times: 0.6 | round }}px; color: {{ section.settings.title_color }};">
            {{ section.settings.title }}
          </h1>
        {%- endif -%}
        
        {%- if section.settings.subtitle != blank -%}
          <p class="fr-home-hero__subtitle" style="--fz-d: {{ section.settings.subtitle_size }}px; --fz-m: {{ section.settings.subtitle_size_mobile | default: section.settings.subtitle_size | times: 0.8 | round }}px; color: {{ section.settings.subtitle_color }};">
            {{ section.settings.subtitle }}
          </p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="fr-home-hero__buttons-stack">
            {%- for block in section.blocks -%}
              {%- if block.type == 'button' -%}
                <style>
                  .fr-home-hero__btn-{{ block.id }} {
                    background-color: {{ block.settings.bg_color }};
                    color: {{ block.settings.text_color }};
                    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
                    font-size: {{ block.settings.text_size_mobile | default: block.settings.text_size }}px !important;
                  }
                  .fr-home-hero__btn-{{ block.id }}:hover {
                    background-color: {{ block.settings.hover_bg_color }} !important;
                    color: {{ block.settings.hover_text_color }} !important;
                    border-color: {{ block.settings.hover_border_color }} !important;
                  }
                  @media(min-width: 768px) {
                    .fr-home-hero__btn-{{ block.id }} {
                      font-size: {{ block.settings.text_size }}px !important;
                    }
                  }
                </style>
                <a href="{{ block.settings.link }}" class="fr-home-hero__btn fr-home-hero__btn-{{ block.id }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

<style>
  #fr-home-hero-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    width: 100%;
    position: relative;
  }

  .fr-home-hero__wrapper {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.min_height }}vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
  }
  @media (min-width: 768px) {
    .fr-home-hero__wrapper {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
    }
  }

  .fr-home-hero__background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .fr-home-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fr-home-hero__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }
  .fr-home-hero__slide.is-active {
    opacity: 1;
  }

  .fr-home-hero__placeholder {
    width: 100%;
    height: 100%;
    background-color: #d1d5db;
  }

  .fr-home-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .fr-home-hero__content-container {
    position: relative;
    z-index: 3;
    width: 100%;
    padding: 0 20px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .fr-home-hero__content {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .fr-home-hero__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin: 0 0 20px 0;
    line-height: 1.2;
    font-size: var(--fz-m);
  }

  .fr-home-hero__subtitle {
    margin: 0 0 40px 0;
    line-height: 1.6;
    max-width: 800px;
    font-size: var(--fz-m);
  }

  @media(min-width: 768px) {
    .fr-home-hero__title { font-size: var(--fz-d); }
    .fr-home-hero__subtitle { font-size: var(--fz-d); }
  }

  .fr-home-hero__buttons-stack {
    display: flex;
    flex-wrap: wrap;
    justify-content: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
    gap: 15px;
    width: 100%;
  }

  .fr-home-hero__btn {
    display: inline-block;
    padding: 15px 40px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .fr-home-hero__btn:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 767px) {
    .fr-home-hero__wrapper {
      min-height: {{ section.settings.min_height_mobile }}vh;
    }
    .fr-home-hero__btn {
      padding: 15px 20px;
    }
  }
</style>

