<section class="fr-home-badges" id="fr-home-badges-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="fr-home-badges__wrapper" style="
      --pt-d: {{ section.settings.padding_top }}px;
      --pb-d: {{ section.settings.padding_bottom }}px;
      --pl-d: {{ section.settings.padding_left }}px;
      --pr-d: {{ section.settings.padding_right }}px;
      --pt-m: {{ section.settings.padding_top_mobile | default: section.settings.padding_top }}px;
      --pb-m: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom }}px;
      --pl-m: {{ section.settings.padding_left_mobile | default: section.settings.padding_left }}px;
      --pr-m: {{ section.settings.padding_right_mobile | default: section.settings.padding_right }}px;
    ">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-home-badges__main-heading" style="text-align: {{ section.settings.heading_align }}; --fz-d: {{ section.settings.heading_size }}px; --fz-m: {{ section.settings.heading_size_mobile | default: section.settings.heading_size | times: 0.8 | round }}px; color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="fr-home-badges__container" style="
        grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
        gap: {{ section.settings.grid_gap }}px;
      ">
      
      {%- for block in section.blocks -%}
        <div class="fr-home-badges__item" {{ block.shopify_attributes }}>
          
          <div class="fr-home-badges__icon" style="--sz-d: {{ section.settings.icon_size }}px; --sz-m: {{ section.settings.icon_size_mobile | default: section.settings.icon_size | times: 0.8 | round }}px;">
            {%- if block.settings.svg_code != blank -%}
              {{ block.settings.svg_code }}
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="fr-home-badges__img">
            {%- else -%}
              <!-- Fallback Icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            {%- endif -%}
          </div>

          <div class="fr-home-badges__text" style="text-align: {{ section.settings.text_align }};">
            {%- if block.settings.title != blank -%}
              <h3 class="fr-home-badges__title" style="--fz-t-d: {{ section.settings.title_size }}px; --fz-t-m: {{ section.settings.title_size_mobile | default: section.settings.title_size | times: 0.8 | round }}px; color: {{ section.settings.title_color }};">
                {{ block.settings.title }}
              </h3>
            {%- endif -%}
            
            {%- if block.settings.subtitle != blank -%}
              <p class="fr-home-badges__subtitle" style="--fz-s-d: {{ section.settings.subtitle_size }}px; --fz-s-m: {{ section.settings.subtitle_size_mobile | default: section.settings.subtitle_size | times: 0.9 | round }}px; color: {{ section.settings.subtitle_color }};">
                {{ block.settings.subtitle }}
              </p>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
      
    </div>
  </div>
</section>

<style>
  #fr-home-badges-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.5;
    width: 100%;
  }

  #fr-home-badges-{{ section.id }} .fr-home-badges__wrapper {
    max-width: 100%;
    margin: 0 auto;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    padding-left: var(--pl-m);
    padding-right: var(--pr-m);
  }
  
  #fr-home-badges-{{ section.id }} .fr-home-badges__container {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
  }

  .fr-home-badges__main-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 40px;
    letter-spacing: 0.01em;
    max-width: {{ section.settings.content_max_width }}px;
    margin-left: auto;
    margin-right: auto;
    font-size: var(--fz-m);
  }

  @media (min-width: 768px) {
    #fr-home-badges-{{ section.id }} .fr-home-badges__wrapper {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
      padding-left: var(--pl-d);
      padding-right: var(--pr-d);
    }
  }

  @media (max-width: 767px) {
    #fr-home-badges-{{ section.id }} .fr-home-badges__container {
      grid-template-columns: 1fr !important; /* Stack on mobile */
      gap: 30px !important;
    }
  }

  .fr-home-badges__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    {% if section.settings.show_circle_border %}
      border: 1px solid {{ section.settings.circle_border_color }};
      border-radius: 50%;
      aspect-ratio: 1 / 1;
      width: 100%;
      max-width: 260px;
      margin: 0 auto;
      padding: 15px;
      box-sizing: border-box;
    {% endif %}
  }
  .fr-home-badges__item:hover {
    transform: translateY(-5px);
  }

  .fr-home-badges__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
    color: #1a1a1a;
    width: var(--sz-m);
    height: var(--sz-m);
  }

  .fr-home-badges__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .fr-home-badges__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .fr-home-badges__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin: 0 0 5px 0;
    letter-spacing: 0.01em;
    font-size: var(--fz-t-m);
  }

  .fr-home-badges__subtitle {
    margin: 0;
    font-size: var(--fz-s-m);
  }

  @media (min-width: 768px) {
    .fr-home-badges__main-heading { font-size: var(--fz-d); }
    .fr-home-badges__icon { width: var(--sz-d); height: var(--sz-d); }
    .fr-home-badges__title { font-size: var(--fz-t-d); }
    .fr-home-badges__subtitle { font-size: var(--fz-s-d); }
  }
</style>

{% schema %}
{
  "name": "FR Home Badges",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 1200
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Promotional Banners"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size (Mobile)",
      "default": 22
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Grid Gap",
      "default": 40
    },
    {
      "type": "header",
      "content": "Circle Style"
    },
    {
      "type": "checkbox",
      "id": "show_circle_border",
      "label": "Show Circle Border",
      "default": true
    },
    {
      "type": "color",
      "id": "circle_border_color",
      "label": "Circle Border Color",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Icon Settings"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Icon Size (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Icon Size (Mobile)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size (Desktop)",
      "default": 18
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size (Mobile)",
      "default": 16
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size (Desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size (Mobile)",
      "default": 12
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right (Mobile)",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "textarea",
          "id": "svg_code",
          "label": "SVG Code (Optional)",
          "info": "Paste raw SVG code here. It overrides the image picker."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Eco Friendly"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Sustainable materials."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Home Badges",
      "blocks": [
        { "type": "badge", "settings": { "title": "Eco Friendly Wallpaper" } },
        { "type": "badge", "settings": { "title": "PVC Free Material" } },
        { "type": "badge", "settings": { "title": "Removable Without Damage" } }
      ]
    }
  ]
}
{% endschema %}
