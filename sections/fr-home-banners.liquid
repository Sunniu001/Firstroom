<section class="fr-home-banners" id="fr-home-banners-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="fr-home-banners__wrapper" style="
      --pt-d: {{ section.settings.padding_top }}px;
      --pb-d: {{ section.settings.padding_bottom }}px;
      --pl-d: {{ section.settings.padding_left }}px;
      --pr-d: {{ section.settings.padding_right }}px;
      --pt-m: {{ section.settings.padding_top_mobile | default: section.settings.padding_top }}px;
      --pb-m: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom }}px;
      --pl-m: {{ section.settings.padding_left_mobile | default: section.settings.padding_left }}px;
      --pr-m: {{ section.settings.padding_right_mobile | default: section.settings.padding_right }}px;
    ">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-home-banners__main-heading" style="text-align: {{ section.settings.heading_align }}; --fz-d: {{ section.settings.heading_size }}px; --fz-m: {{ section.settings.heading_size_mobile | default: section.settings.heading_size | times: 0.8 | round }}px; color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="fr-home-banners__container" style="
        --cols-d: {{ section.settings.columns_desktop }};
        --cols-m: {{ section.settings.columns_mobile }};
        gap: {{ section.settings.grid_gap }}px;
      ">
      
      {%- for block in section.blocks -%}
        <div class="fr-home-banners__item" {{ block.shopify_attributes }}>
          
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="fr-home-banners__link" aria-label="{{ block.settings.heading | escape }}"></a>
          {%- endif -%}

          <div class="fr-home-banners__image-wrapper fr-home-banners__aspect--{{ section.settings.aspect_ratio }}" style="border-radius: {{ section.settings.image_radius }}px;">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.heading | escape }}" loading="lazy" class="fr-home-banners__img">
            {%- else -%}
              <div class="fr-home-banners__placeholder"></div>
            {%- endif -%}
            
            {%- if section.settings.text_position == 'overlay' -%}
              <div class="fr-home-banners__overlay" style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
              <div class="fr-home-banners__overlay-content" style="align-items: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %}; text-align: {{ section.settings.text_align }};">
                {%- if block.settings.heading != blank -%}
                  <h3 class="fr-home-banners__heading" style="color: {{ block.settings.text_color }}; --fz-t-d: {{ section.settings.title_size }}px; --fz-t-m: {{ section.settings.title_size_mobile | default: section.settings.title_size | times: 0.8 | round }}px;">{{ block.settings.heading }}</h3>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if section.settings.text_position == 'below' -%}
            {%- if block.settings.heading != blank -%}
              <div class="fr-home-banners__text-below" style="text-align: {{ section.settings.text_align }};">
                <h3 class="fr-home-banners__heading" style="color: {{ block.settings.text_color }}; --fz-t-d: {{ section.settings.title_size }}px; --fz-t-m: {{ section.settings.title_size_mobile | default: section.settings.title_size | times: 0.8 | round }}px;">{{ block.settings.heading }}</h3>
              </div>
            {%- endif -%}
          {%- endif -%}

        </div>
      {%- endfor -%}
      
    </div>
  </div>
</section>

<style>
  #fr-home-banners-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.7;
    width: 100%;
  }

  #fr-home-banners-{{ section.id }} .fr-home-banners__wrapper {
    max-width: 100%;
    margin: 0 auto;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    padding-left: var(--pl-m);
    padding-right: var(--pr-m);
  }
  
  #fr-home-banners-{{ section.id }} .fr-home-banners__container {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(var(--cols-m), 1fr);
  }

  .fr-home-banners__main-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 40px;
    letter-spacing: 0.01em;
    max-width: {{ section.settings.content_max_width }}px;
    margin-left: auto;
    margin-right: auto;
    font-size: var(--fz-m);
  }

  @media (max-width: 767px) {
    #fr-home-banners-{{ section.id }} .fr-home-banners__container {
      gap: 20px !important;
    }
  }

  @media (min-width: 768px) {
    #fr-home-banners-{{ section.id }} .fr-home-banners__wrapper {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
      padding-left: var(--pl-d);
      padding-right: var(--pr-d);
    }
    #fr-home-banners-{{ section.id }} .fr-home-banners__container {
      grid-template-columns: repeat(var(--cols-d), 1fr);
    }
  }

  .fr-home-banners__item {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.3s ease;
  }
  .fr-home-banners__item:hover {
    transform: translateY(-4px);
  }

  .fr-home-banners__link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
  }

  .fr-home-banners__image-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f3f4f6;
  }

  .fr-home-banners__aspect--panoramic {
    aspect-ratio: 21 / 9;
  }
  .fr-home-banners__aspect--landscape {
    aspect-ratio: 16 / 9;
  }
  .fr-home-banners__aspect--standard {
    aspect-ratio: 4 / 3;
  }
  .fr-home-banners__aspect--auto {
    /* No aspect ratio */
  }

  .fr-home-banners__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .fr-home-banners__item:hover .fr-home-banners__img {
    transform: scale(1.05);
  }

  .fr-home-banners__placeholder {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background-color: #e5e7eb;
  }

  .fr-home-banners__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    transition: opacity 0.3s ease;
  }
  .fr-home-banners__item:hover .fr-home-banners__overlay {
    opacity: 0.1 !important; /* Slightly fade overlay on hover */
  }

  .fr-home-banners__overlay-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 30px;
  }

  .fr-home-banners__text-below {
    padding-top: 15px;
  }

  .fr-home-banners__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin: 0;
    letter-spacing: 0.01em;
    font-size: var(--fz-t-m);
  }

  @media (min-width: 768px) {
    .fr-home-banners__main-heading { font-size: var(--fz-d); }
    .fr-home-banners__heading { font-size: var(--fz-t-d); }
  }
</style>

{% schema %}
{
  "name": "FR Home Banners",
  "tag": "section",
  "settings": [
    {
