{%- comment -%}
  FR Custom FAQ Section
{%- endcomment -%}

<section id="fr-custom-faq-{{ section.id }}" class="fr-custom-faq" style="
  background-color: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  padding-left: {{ section.settings.padding_left }}px;
  padding-right: {{ section.settings.padding_right }}px;
">
  <div class="fr-custom-faq__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-custom-faq__heading" style="
        font-size: {{ section.settings.heading_size }}px;
        color: {{ section.settings.heading_color }};
      ">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="fr-custom-faq__list">
      {%- for block in section.blocks -%}
        <div class="fr-custom-faq__item" {{ block.shopify_attributes }}>
          <button class="fr-custom-faq__question" aria-expanded="false" aria-controls="faq-answer-{{ block.id }}">
            <span class="fr-custom-faq__question-text">{{ block.settings.question }}</span>
            <span class="fr-custom-faq__icon">+</span>
          </button>
          <div id="faq-answer-{{ block.id }}" class="fr-custom-faq__answer">
            <div class="fr-custom-faq__answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #fr-custom-faq-{{ section.id }} .fr-custom-faq__container {
    max-width: 800px;
    margin: 0 auto;
  }

  #fr-custom-faq-{{ section.id }} .fr-custom-faq__heading {
    margin: 0 0 40px 0;
    text-align: center;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 500;
  }

  #fr-custom-faq-{{ section.id }} .fr-custom-faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #fr-custom-faq-{{ section.id }} .fr-custom-faq__item {
    background-color: #f5f5f5;
  }

  #fr-custom-faq-{{ section.id }} .fr-custom-faq__question {
    width: 100%;
    text-align: left;
    padding: 18px 24px;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 16px;
    color: #1a1a1a;
    font-weight: 600;
  }

  #fr-custom-faq-{{ section.id }} .fr-custom-faq__icon {
    font-size: 20px;
    font-weight: 400;
    transition: transform 0.3s ease;
  }

  #fr-custom-faq-{{ section.id }} .fr-custom-faq__question[aria-expanded="true"] .fr-custom-faq__icon {
    transform: rotate(45deg);
  }

  #fr-custom-faq-{{ section.id }} .fr-custom-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  #fr-custom-faq-{{ section.id }} .fr-custom-faq__answer-inner {
    padding: 0 24px 24px 24px;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 14px;
    color: #444;
    line-height: 1.5;
  }

  #fr-custom-faq-{{ section.id }} .fr-custom-faq__answer-inner p:first-child { margin-top: 0; }
  #fr-custom-faq-{{ section.id }} .fr-custom-faq__answer-inner p:last-child { margin-bottom: 0; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqSection = document.getElementById('fr-custom-faq-{{ section.id }}');
    if (!faqSection) return;

    const buttons = faqSection.querySelectorAll('.fr-custom-faq__question');

    buttons.forEach(button => {
      button.addEventListener('click', function() {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        const answer = this.nextElementSibling;
        
        // Close all others
        buttons.forEach(btn => {
          if (btn !== this) {
            btn.setAttribute('aria-expanded', 'false');
            btn.nextElementSibling.style.maxHeight = null;
          }
        });

        // Toggle current
        if (isExpanded) {
          this.setAttribute('aria-expanded', 'false');
          answer.style.maxHeight = null;
        } else {
          this.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FR Custom FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ's"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 30
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Frequently asked question?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Here is the answer to the frequently asked question.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Custom FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
