<section class="fr-story-philosophy" id="fr-story-philosophy-{{ section.id }}" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;">
  <div class="fr-story-philosophy__wrapper">

    <!-- Title & Description -->
    {%- if section.settings.title != blank -%}
      <h2 class="fr-story-philosophy__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="fr-story-philosophy__desc">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    <!-- Dual Image Gallery -->
    {%- if section.settings.image_1 != blank or section.settings.image_2 != blank -%}
      <div class="fr-story-philosophy__gallery">
        {%- if section.settings.image_1 != blank -%}
          <div class="fr-story-philosophy__img-wrapper">
            <img
              src="{{ section.settings.image_1 | image_url: width: 900 }}"
              alt="Brand Philosophy Image 1"
              class="fr-story-philosophy__img"
              loading="lazy"
            >
          </div>
        {%- endif -%}
        {%- if section.settings.image_2 != blank -%}
          <div class="fr-story-philosophy__img-wrapper">
            <img
              src="{{ section.settings.image_2 | image_url: width: 900 }}"
              alt="Brand Philosophy Image 2"
              class="fr-story-philosophy__img"
              loading="lazy"
            >
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Accordion -->
    {%- if section.blocks.size > 0 -%}
      <div class="fr-story-philosophy__accordion-wrapper">
        {%- if section.settings.accordion_title != blank -%}
          <h3 class="fr-story-philosophy__accordion-heading">{{ section.settings.accordion_title }}</h3>
        {%- endif -%}
        <div class="fr-story-philosophy__accordion-list" id="accordion-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion_item' -%}
              <div class="fr-story-philosophy__accordion-item" {{ block.shopify_attributes }}>
                <button class="fr-story-philosophy__accordion-trigger" aria-expanded="false">
                  <span>{{ block.settings.heading }}</span>
                  <span class="fr-story-philosophy__accordion-icon"></span>
                </button>
                <div class="fr-story-philosophy__accordion-panel">
                  <div class="fr-story-philosophy__accordion-content">
                    {{ block.settings.content }}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .fr-story-philosophy {
    font-family: 'Lato', system-ui, sans-serif;
  }

  .fr-story-philosophy__wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Title */
  .fr-story-philosophy__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 400;
    text-align: center;
    margin-top: 0;
    margin-bottom: 20px;
    color: #1a1a1a;
  }

  /* Description */
  .fr-story-philosophy__desc {
    max-width: 800px;
    margin: 0 auto 50px auto;
    font-size: 15px;
    line-height: 1.8;
    color: #4a4a4a;
    text-align: center;
  }

  .fr-story-philosophy__desc p {
    margin: 0 0 12px 0;
  }

  .fr-story-philosophy__desc p:last-child {
    margin-bottom: 0;
  }

  /* Gallery */
  .fr-story-philosophy__gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 60px;
  }

  @media (min-width: 576px) {
    .fr-story-philosophy__gallery {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fr-story-philosophy__img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #faf8f5;
  }

  .fr-story-philosophy__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Accordion */
  .fr-story-philosophy__accordion-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .fr-story-philosophy__accordion-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 24px;
    font-weight: 400;
    text-align: center;
    margin-top: 0;
    margin-bottom: 32px;
    color: #1a1a1a;
  }

  .fr-story-philosophy__accordion-list {
    border-top: 1px solid #e5e7eb;
  }

  .fr-story-philosophy__accordion-item {
    border-bottom: 1px solid #e5e7eb;
  }

  .fr-story-philosophy__accordion-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 0;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 17px;
    font-weight: 500;
    text-align: left;
    color: #1a1a1a;
    font-family: 'Playfair Display', Georgia, serif;
    transition: color 0.2s ease;
  }

  .fr-story-philosophy__accordion-trigger:hover {
    color: #000;
  }

  .fr-story-philosophy__accordion-icon {
    position: relative;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
  }

  .fr-story-philosophy__accordion-icon::after {
    content: '+';
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 22px;
    font-weight: 300;
    line-height: 1;
    display: block;
  }

  .fr-story-philosophy__accordion-trigger[aria-expanded="true"] .fr-story-philosophy__accordion-icon::after {
    content: '−';
  }

  .fr-story-philosophy__accordion-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fr-story-philosophy__accordion-content {
    padding-bottom: 22px;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #666;
  }

  .fr-story-philosophy__accordion-content p {
    margin: 0 0 12px 0;
  }

  .fr-story-philosophy__accordion-content p:last-child {
    margin-bottom: 0;
  }
</style>

<script>
  (function() {
    function initPhilAccordion(container) {
      if (!container) return;
      var triggers = container.querySelectorAll('.fr-story-philosophy__accordion-trigger');
      triggers.forEach(function(trigger) {
        if (trigger.getAttribute('data-accordion-initialized') === 'true') return;
        trigger.setAttribute('data-accordion-initialized', 'true');

        trigger.addEventListener('click', function() {
          var isExpanded = this.getAttribute('aria-expanded') === 'true';
          var panel = this.nextElementSibling;
          var list = this.closest('.fr-story-philosophy__accordion-list');

          if (list) {
            list.querySelectorAll('.fr-story-philosophy__accordion-trigger').forEach(function(btn) {
              if (btn !== trigger) {
                btn.setAttribute('aria-expanded', 'false');
                if (btn.nextElementSibling) {
                  btn.nextElementSibling.style.maxHeight = null;
                }
              }
            });
          }

          if (isExpanded) {
            this.setAttribute('aria-expanded', 'false');
            if (panel) panel.style.maxHeight = null;
          } else {
            this.setAttribute('aria-expanded', 'true');
            if (panel) panel.style.maxHeight = panel.scrollHeight + 'px';
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      var sectionContainer = document.getElementById('fr-story-philosophy-{{ section.id }}');
      initPhilAccordion(sectionContainer);
    });

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target && e.target.classList.contains('fr-story-philosophy-section')) {
        initPhilAccordion(e.target);
      }
    });

    // Run immediately if DOM element is already parsed
    var sectionContainer = document.getElementById('fr-story-philosophy-{{ section.id }}');
    if (sectionContainer) {
      initPhilAccordion(sectionContainer);
    }
  })();
</script>

{% schema %}
{
  "name": "FR Story Philosophy",
  "tag": "section",
  "class": "fr-story-philosophy-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Brand Philosophy"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>At <strong>First Room Collective</strong>, we believe every design carries a story—and every story begins with you. The way you live, dream, and express yourself becomes the starting point of our creative process.</p>"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Gallery Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Gallery Image 2"
    },
    {
      "type": "text",
      "id": "accordion_title",
      "label": "Accordion Heading (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Item Heading",
          "default": "Customer Experience"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Item Content",
          "default": "<p>Description details for this item.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Story Philosophy",
      "blocks": [
        {
          "type": "accordion_item",
          "settings": { "heading": "Customer Experience" }
        },
        {
          "type": "accordion_item",
          "settings": { "heading": "Diverse Design" }
        },
        {
          "type": "accordion_item",
          "settings": { "heading": "Customisation" }
        },
        {
          "type": "accordion_item",
          "settings": { "heading": "Comfort" }
        },
        {
          "type": "accordion_item",
          "settings": { "heading": "Aesthetics with Soul" }
        }
      ]
    }
  ]
}
{% endschema %}
