<div class="fr-product-tabs-section fr-pt-{{ section.id }} page-width" id="{{ section.id }}">
  <div class="fr-tabs-header">
    <button class="fr-tab-btn active" data-target="tab-description">Product Details</button>
    <button class="fr-tab-btn" data-target="tab-material">Shipping & Care</button>
    <button class="fr-tab-btn" data-target="tab-shipping">Zero Waste Initiative</button>
    <button class="fr-tab-btn" data-target="tab-quality">Information</button>
  </div>
  
  <div class="fr-tabs-content">
    <div class="fr-tab-panel active" id="tab-description">
      {{ section.settings.description_html | default: product.description }}
    </div>
    <div class="fr-tab-panel" id="tab-material">
      {{ section.settings.material_html }}
    </div>
    <div class="fr-tab-panel" id="tab-shipping">
      {{ section.settings.shipping_html }}
    </div>
    <div class="fr-tab-panel" id="tab-quality">
      {{ section.settings.quality_html }}
    </div>
  </div>
</div>

<style>
  .fr-pt-{{ section.id }} {
    margin-top: 2rem;
    margin-bottom: 2rem;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
  }
  .fr-pt-{{ section.id }} .fr-tabs-header {
    display: flex;
    justify-content: {{ section.settings.alignment_desktop | default: 'flex-start' }};
    gap: {{ section.settings.tab_gap_desktop | default: 40 }}px;
    border-bottom: 1px solid #f0f0f0;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    overflow-x: auto;
  }
  .fr-pt-{{ section.id }} .fr-tab-btn {
    background: none;
    border: none;
    padding: 0;
    font-size: {{ section.settings.tab_font_size_desktop | default: 14 }}px;
    color: #888;
    cursor: pointer;
    white-space: nowrap;
    position: relative;
    transition: color 0.2s ease;
  }
  .fr-pt-{{ section.id }} .fr-tab-btn:hover {
    color: #555;
  }
  .fr-pt-{{ section.id }} .fr-tab-btn.active {
    color: #111;
  }
  .fr-pt-{{ section.id }} .fr-tab-panel {
    display: none;
    font-size: {{ section.settings.content_font_size_desktop | default: 14 }}px;
    line-height: 1.6;
    color: #444;
  }
  .fr-pt-{{ section.id }} .fr-tab-panel.active {
    display: block;
  }

  @media (max-width: 767px) {
    .fr-pt-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 20 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 20 }}px;
      padding-left: {{ section.settings.padding_left_mobile | default: 16 }}px;
      padding-right: {{ section.settings.padding_right_mobile | default: 16 }}px;
    }
    .fr-pt-{{ section.id }} .fr-tabs-header {
      justify-content: {{ section.settings.alignment_mobile | default: 'flex-start' }};
      gap: {{ section.settings.tab_gap_mobile | default: 20 }}px;
      margin-bottom: 1.25rem;
      padding-bottom: 0.75rem;
      -webkit-overflow-scrolling: touch;
    }
    .fr-pt-{{ section.id }} .fr-tab-btn {
      font-size: {{ section.settings.tab_font_size_mobile | default: 13 }}px;
    }
    .fr-pt-{{ section.id }} .fr-tab-panel {
      font-size: {{ section.settings.content_font_size_mobile | default: 13 }}px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('{{ section.id }}');
    if (!section) return;
    const tabBtns = section.querySelectorAll('.fr-tab-btn');
    const tabPanels = section.querySelectorAll('.fr-tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        tabPanels.forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const target = btn.getAttribute('data-target');
        section.querySelector('#' + target).classList.add('active');
      });
    });
  });
</script>

{% schema %}
{
  "name": "FR - Product Tabs",
  "settings": [
    {
      "type": "richtext",
      "id": "description_html",
      "label": "Product Details Content (Default: Product Description)"
    },
    {
      "type": "richtext",
      "id": "material_html",
      "label": "Shipping & Care Content"
    },
    {
      "type": "richtext",
      "id": "shipping_html",
      "label": "Zero Waste Initiative Content"
    },
    {
      "type": "richtext",
      "id": "quality_html",
      "label": "Information Content"
    },
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "select",
      "id": "alignment_desktop",
      "label": "Desktop Tabs Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "space-between", "label": "Space Between" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "tab_font_size_desktop",
      "min": 11,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "label": "Desktop Tab Button Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "content_font_size_desktop",
      "min": 11,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "label": "Desktop Content Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "tab_gap_desktop",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Desktop Tab Gap",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Left Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Right Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile Responsiveness Settings"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "Mobile Tabs Alignment",
      "options": [
        { "value": "flex-start", "label": "Left (Scrollable)" },
        { "value": "center", "label": "Center" },
        { "value": "space-between", "label": "Space Between" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "tab_font_size_mobile",
      "min": 10,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "label": "Mobile Tab Button Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "content_font_size_mobile",
      "min": 10,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "label": "Mobile Content Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "tab_gap_mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile Tab Gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile Left Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile Right Padding",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "FR - Product Tabs"
    }
  ]
}
{% endschema %}
