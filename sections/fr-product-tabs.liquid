<div class="fr-product-tabs-section page-width" id="{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; padding-left: {{ section.settings.padding_left }}px; padding-right: {{ section.settings.padding_right }}px;">
  <div class="fr-tabs-header">
    <button class="fr-tab-btn active" data-target="tab-description">{{ section.settings.tab_title_description | default: 'Description' }}</button>
    <button class="fr-tab-btn" data-target="tab-material">{{ section.settings.tab_title_material | default: 'Material' }}</button>
    <button class="fr-tab-btn" data-target="tab-shipping">{{ section.settings.tab_title_shipping | default: 'Shipping' }}</button>
    <button class="fr-tab-btn" data-target="tab-quality">{{ section.settings.tab_title_quality | default: 'Quality & Installation' }}</button>
  </div>
  
  <div class="fr-tabs-content">
    <div class="fr-tab-panel active" id="tab-description">
      {{ section.settings.description_html | default: product.description }}
    </div>
    <div class="fr-tab-panel" id="tab-material">
      {{ section.settings.material_html }}
    </div>
    <div class="fr-tab-panel" id="tab-shipping">
      {{ section.settings.shipping_html }}
    </div>
    <div class="fr-tab-panel" id="tab-quality">
      {{ section.settings.quality_html }}
    </div>
  </div>
</div>

<style>
  .fr-product-tabs-section {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  .fr-tabs-header {
    display: flex;
    gap: 2.5rem;
    border-bottom: 1px solid #f0f0f0;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
  }
  .fr-tab-btn {
    background: none;
    border: none;
    padding: 0;
    font-size: 14px;
    color: #888;
    cursor: pointer;
    position: relative;
    transition: color 0.2s ease;
  }
  .fr-tab-btn:hover {
    color: #555;
  }
  .fr-tab-btn.active {
    color: #111;
  }
  .fr-tab-panel {
    display: none;
    font-size: 14px;
    line-height: 1.6;
    color: #444;
  }
  .fr-tab-panel.active {
    display: block;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('{{ section.id }}');
    const btns = section.querySelectorAll('.fr-tab-btn');
    const panels = section.querySelectorAll('.fr-tab-panel');
    
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        
        btn.classList.add('active');
        section.querySelector('#' + btn.dataset.target).classList.add('active');
      });
    });
  });
</script>

{% schema %}
{
  "name": "FR - Product Tabs",
  "settings": [
    {
      "type": "text",
      "id": "tab_title_description",
      "label": "Description Tab Title",
      "default": "Description"
    },
    {
      "type": "richtext",
      "id": "description_html",
      "label": "Description Override (Leave blank to use product description)"
    },
    {
      "type": "text",
      "id": "tab_title_material",
      "label": "Material Tab Title",
      "default": "Material"
    },
    {
      "type": "richtext",
      "id": "material_html",
      "label": "Material Content"
    },
    {
      "type": "text",
      "id": "tab_title_shipping",
      "label": "Shipping Tab Title",
      "default": "Shipping"
    },
    {
      "type": "richtext",
      "id": "shipping_html",
      "label": "Shipping Content"
    },
    {
      "type": "text",
      "id": "tab_title_quality",
      "label": "Quality Tab Title",
      "default": "Quality & Installation"
    },
    {
      "type": "richtext",
      "id": "quality_html",
      "label": "Quality & Installation Content"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Left Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Right Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "FR - Product Tabs"
    }
  ]
}
{% endschema %}
