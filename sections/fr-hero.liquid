{{ 'fr-hero.css' | asset_url | stylesheet_tag }}

<section class="fr-hero" id="fr-hero-section">
  <div class="fr-hero__bg" style="background-image: url('{{ section.settings.bg_image | image_url: width: 2400 }}');"></div>
  <div class="fr-hero__overlay"></div>
  <div class="fr-hero__content" id="fr-hero-content">
    <h1 class="fr-hero__title">{{ section.settings.title }}</h1>
    <p class="fr-hero__subtitle">{{ section.settings.subtitle }}</p>
    <a href="{{ section.settings.button_link }}" class="fr-hero__btn">{{ section.settings.button_text }}</a>
  </div>
</section>

<style>
  .fr-hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 2rem;
    color: #ffffff;
    overflow: hidden;
  }

  .fr-hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center center;
    background-attachment: fixed;
    background-repeat: no-repeat;
    z-index: 0;
  }

  @media (max-width: 768px) {
    .fr-hero__bg {
      background-attachment: scroll;
    }
  }

  .fr-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.42);
    z-index: 1;
  }

  .fr-hero__content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    will-change: transform, opacity;
  }

  .fr-hero__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 40px;
    font-weight: 400;
    line-height: 1.35;
    margin: 0;
    letter-spacing: 0.02em;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .fr-hero__title {
      font-size: 28px;
    }
  }

  .fr-hero__subtitle {
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 18px;
    font-weight: 500;
    max-width: 560px;
    margin: 0.5rem 0 1.5rem 0;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.92);
  }

  @media (max-width: 768px) {
    .fr-hero__subtitle {
      font-size: 15px;
    }
  }

  .fr-hero__btn {
    display: inline-block;
    background-color: #ffffff;
    color: #B53939;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 13px 36px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 2px solid #ffffff;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .fr-hero__btn:hover {
    background-color: transparent;
    color: #ffffff;
  }
</style>

<script>
  (function() {
    const heroContent = document.getElementById('fr-hero-content');
    if (!heroContent) return;

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(function() {
          const scrollY = window.scrollY;
          const opacity = Math.max(0, 1 - scrollY / 500);
          const translateY = scrollY * 0.35;
          heroContent.style.transform = 'translateY(' + translateY + 'px)';
          heroContent.style.opacity = opacity;
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "FR Hero",
  "tag": "section",
  "class": "fr-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Luxury Walls. Personal Stories.\nTimeless Design."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Crafted for refined interiors, our bespoke wallpapers transform blank walls into evocative expressions of identity."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "FR Hero"
    }
  ]
}
{% endschema %}
