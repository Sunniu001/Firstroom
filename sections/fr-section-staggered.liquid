    }
  ],
  "presets": [
    {
      "name": "FR About Staggered",
      "blocks": [
        { "type": "staggered_item", "settings": { "number": "1.", "title": "Discovery", "text": "Understanding your vision, space, and aesthetic intent." } },
        { "type": "staggered_item", "settings": { "number": "2.", "title": "Design", "text": "Curating custom motifs, textures, and bespoke palettes." } },
        { "type": "staggered_item", "settings": { "number": "3.", "title": "Sampling", "text": "Creating tactile strike-offs and exact material proofs." } },
        { "type": "staggered_item", "settings": { "number": "4.", "title": "Production", "text": "Precision crafting with museum-grade wallpaper finishes." } },
        { "type": "staggered_item", "settings": { "number": "5.", "title": "Installation", "text": "Seamless on-site application and architectural care." } }
      ]
    }
  ]
}
{% endschema %}
