<section class="fr-about-staggered" id="fr-about-staggered-{{ section.id }}" style="background-color: {{ section.settings.section_bg | default: '#ffffff' }};">
  <div class="fr-about-staggered__wrapper">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-about-staggered__main-heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <!-- Desktop Horizontal Timeline -->
    <div class="fr-staggered-timeline-desktop">
      <div class="fr-staggered-axis"></div>
      
      <div class="fr-staggered-track" style="--total-items: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          {%- assign is_even = forloop.index | modulo: 2 -%}
          {%- assign pos = 'bottom' -%}
          {%- if is_even == 0 -%}
            {%- assign pos = 'top' -%}
          {%- else -%}
            {%- assign pos = 'bottom' -%}
          {%- endif -%}

          <div class="fr-staggered-step fr-staggered-step--pos-{{ pos }}" {{ block.shopify_attributes }}>
            
            <!-- Top Slot -->
            <div class="fr-staggered-slot fr-staggered-slot--top">
              {%- if pos == 'top' -%}
                <div class="fr-staggered-card">
                  {%- if block.settings.number != blank -%}
                    <div class="fr-staggered-num">{{ block.settings.number }}</div>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h3 class="fr-staggered-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="fr-staggered-text">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
                <div class="fr-staggered-stem fr-staggered-stem--top"></div>
              {%- endif -%}
            </div>

            <!-- Center Circle Node -->
            <div class="fr-staggered-node-wrapper">
              <div class="fr-staggered-node-circle" style="{% if block.settings.border_width > 0 %}border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};{% endif %}">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="fr-staggered-node-img">
                {%- endif -%}
              </div>
            </div>

            <!-- Bottom Slot -->
            <div class="fr-staggered-slot fr-staggered-slot--bottom">
              {%- if pos == 'bottom' -%}
                <div class="fr-staggered-stem fr-staggered-stem--bottom"></div>
                <div class="fr-staggered-card">
                  {%- if block.settings.number != blank -%}
                    <div class="fr-staggered-num">{{ block.settings.number }}</div>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h3 class="fr-staggered-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="fr-staggered-text">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Mobile Vertical Timeline -->
    <div class="fr-staggered-timeline-mobile">
      <div class="fr-staggered-v-axis"></div>
      
      <div class="fr-staggered-mobile-list">
        {%- for block in section.blocks -%}
          <div class="fr-staggered-mobile-item" {{ block.shopify_attributes }}>
            <div class="fr-staggered-m-node-col">
              <div class="fr-staggered-node-circle">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 120 }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="fr-staggered-node-img">
                {%- endif -%}
              </div>
            </div>
            
            <div class="fr-staggered-m-content-col">
              {%- if block.settings.number != blank -%}
                <div class="fr-staggered-num">{{ block.settings.number }}</div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="fr-staggered-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="fr-staggered-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

<style>
  {{ section.settings.heading_font | font_face }}
  {{ section.settings.title_font | font_face }}
  {{ section.settings.text_font | font_face }}

  #fr-about-staggered-{{ section.id }} {
    width: 100%;
    background-color: {{ section.settings.section_bg | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    padding-left: {{ section.settings.padding_left_mobile | default: 24 }}px;
    padding-right: {{ section.settings.padding_right_mobile | default: 24 }}px;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    #fr-about-staggered-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
      padding-left: {{ section.settings.padding_left | default: 60 }}px;
      padding-right: {{ section.settings.padding_right | default: 60 }}px;
    }
  }

  #fr-about-staggered-{{ section.id }} .fr-about-staggered__wrapper {
    max-width: {{ section.settings.content_max_width | default: 1400 }}px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  #fr-about-staggered-{{ section.id }} .fr-about-staggered__main-heading {
    font-family: {{ section.settings.heading_font.family | default: "'Playfair Display'" }}, {{ section.settings.heading_font.fallback_families | default: 'Georgia, serif' }};
    font-weight: {{ section.settings.heading_font.weight | default: 400 }};
    font-style: {{ section.settings.heading_font.style | default: 'normal' }};
    font-size: {{ section.settings.heading_size_mobile | default: 28 }}px;
    color: {{ section.settings.heading_color | default: '#1a1a1a' }};
    line-height: 1.25;
    text-align: {{ section.settings.heading_align_mobile | default: section.settings.heading_align | default: 'center' }};
    margin: 0 0 40px 0;
    letter-spacing: 0.01em;
  }

  @media (min-width: 768px) {
    #fr-about-staggered-{{ section.id }} .fr-about-staggered__main-heading {
      font-size: {{ section.settings.heading_size | default: 36 }}px;
      text-align: {{ section.settings.heading_align | default: 'center' }};
      margin-bottom: 60px;
    }
  }

  /* Node Circle */
  #fr-about-staggered-{{ section.id }} .fr-staggered-node-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #c4c4c4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 3;
    transition: transform 0.3s ease, background-color 0.3s ease;
    box-sizing: border-box;
    overflow: hidden;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    #fr-about-staggered-{{ section.id }} .fr-staggered-node-circle {
      width: 52px;
      height: 52px;
    }
  }

  #fr-about-staggered-{{ section.id }} .fr-staggered-step:hover .fr-staggered-node-circle,
  #fr-about-staggered-{{ section.id }} .fr-staggered-mobile-item:hover .fr-staggered-node-circle {
    transform: scale(1.1);
    background-color: #1a1a1a;
  }

  .fr-staggered-node-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Typography */
  .fr-staggered-card {
    text-align: center;
    box-sizing: border-box;
    padding: 0 10px;
  }

  .fr-staggered-num {
    font-size: 13px;
    font-weight: 600;
    color: #888888;
    margin-bottom: 4px;
    letter-spacing: 0.05em;
    font-family: {{ section.settings.text_font.family | default: "'Lato'" }}, {{ section.settings.text_font.fallback_families | default: 'sans-serif' }};
  }

  .fr-staggered-title {
    font-family: {{ section.settings.title_font.family | default: "'Lato'" }}, {{ section.settings.title_font.fallback_families | default: 'sans-serif' }};
    font-weight: {{ section.settings.title_font.weight | default: 600 }};
    font-style: {{ section.settings.title_font.style | default: 'normal' }};
    font-size: {{ section.settings.title_size | default: 16 }}px;
    color: {{ section.settings.title_color | default: '#1a1a1a' }};
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  .fr-staggered-text {
    font-family: {{ section.settings.text_font.family | default: "'Lato'" }}, {{ section.settings.text_font.fallback_families | default: 'sans-serif' }};
    font-weight: {{ section.settings.text_font.weight | default: 400 }};
    font-style: {{ section.settings.text_font.style | default: 'normal' }};
    font-size: {{ section.settings.text_size | default: 13 }}px;
    line-height: 1.55;
    color: {{ section.settings.text_color | default: '#666666' }};
    margin: 0;
  }

  /* Desktop Layout */
  .fr-staggered-timeline-desktop {
    display: none;
    position: relative;
    width: 100%;
    padding: 40px 0;
  }

  @media (min-width: 768px) {
    .fr-staggered-timeline-desktop {
      display: block;
    }
    .fr-staggered-timeline-mobile {
      display: none;
    }
  }

  .fr-staggered-axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 1px;
    background-color: #dcdcdc;
    z-index: 1;
  }

  .fr-staggered-track {
    display: grid;
    grid-template-columns: repeat(var(--total-items, 5), 1fr);
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .fr-staggered-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .fr-staggered-slot {
    width: 100%;
    min-height: 130px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  .fr-staggered-slot--top {
    justify-content: flex-end;
  }

  .fr-staggered-slot--bottom {
    justify-content: flex-start;
  }

  .fr-staggered-node-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    padding: 6px 0;
  }

  .fr-staggered-stem {
    width: 1px;
    height: 40px;
    background-color: #dcdcdc;
    flex-shrink: 0;
  }

  .fr-staggered-stem--top {
    margin-top: 10px;
  }

  .fr-staggered-stem--bottom {
    margin-bottom: 10px;
  }

  /* Mobile Layout */
  .fr-staggered-timeline-mobile {
    position: relative;
    width: 100%;
    padding: 10px 0 10px 10px;
    box-sizing: border-box;
  }

  .fr-staggered-v-axis {
    position: absolute;
    left: calc(10px + 22px - 0.5px);
    top: 20px;
    bottom: 20px;
    width: 1px;
    background-color: #dcdcdc;
    z-index: 1;
  }

  .fr-staggered-mobile-list {
    display: flex;
    flex-direction: column;
    gap: 36px;
    position: relative;
    z-index: 2;
  }

  .fr-staggered-mobile-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    position: relative;
  }

  .fr-staggered-m-node-col {
    position: relative;
    z-index: 3;
    background-color: {{ section.settings.section_bg | default: '#ffffff' }};
    padding: 4px 0;
    flex-shrink: 0;
  }

  .fr-staggered-m-content-col {
    flex: 1;
    padding-top: 4px;
    text-align: left;
  }

  .fr-staggered-m-content-col .fr-staggered-card {
    text-align: left;
    padding: 0;
  }
</style>

{% schema %}
{
  "name": "FR About Staggered",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Our process."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "playfair_display_n4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
