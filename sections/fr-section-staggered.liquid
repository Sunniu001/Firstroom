          "type": "image_picker",
          "id": "image",
          "label": "Image / Node Icon"
        },
        {
          "type": "range",
          "id": "border_width",
          "min": 0,
          "max": 10,
          "step": 1,
          "unit": "px",
          "label": "Node Border Width",
          "default": 0
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Node Border Color",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "number",
