<section class="fr-order-page" id="fr-order-{{ section.id }}">
  <div class="fr-order__container">
    
    <!-- Header: Back link & Title -->
    <div class="fr-order__header">
      <a href="{{ routes.account_url }}#orders" class="fr-order__back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to My Orders
      </a>
      
      <div class="fr-order__title-row">
        <h1 class="fr-order__title">Order {{ order.name }}</h1>
        <div class="fr-order__badges">
          {%- if order.financial_status_label != blank -%}
            <span class="status-badge status-pending">
              {{ order.financial_status_label | upcase }}
            </span>
          {%- endif -%}
          {%- if order.fulfillment_status_label != blank -%}
            <span class="status-badge {% if order.fulfillment_status == 'fulfilled' %}status-delivered{% else %}status-pending{% endif %}">
              {{ order.fulfillment_status_label | upcase }}
            </span>
          {%- endif -%}
        </div>
      </div>
      <p class="fr-order__date">Placed on {{ order.created_at | date: "%d %b %Y at %I:%M %p" }}</p>
      {%- if order.cancelled -%}
        <div class="fr-order__cancelled">
          <p>Order Cancelled on {{ order.cancelled_at | date: "%d %b %Y at %I:%M %p" }}</p>
          <p>Reason: {{ order.cancel_reason_label }}</p>
        </div>
      {%- endif -%}
    </div>

    <!-- Main Content: Two Column Grid -->
    <div class="fr-order__grid">
      
      <!-- Left Column: Items -->
      <div class="fr-order__items">
        <div class="fr-account__table-container">
          <table class="fr-account__table">
            <thead>
              <tr>
                <th>PRODUCT</th>
                <th class="text-center">PRICE</th>
                <th class="text-center">QUANTITY</th>
                <th class="text-right">TOTAL</th>
              </tr>
            </thead>
            <tbody>
              {%- for line_item in order.line_items -%}
                <tr>
                  <td class="fr-account__product-cell">
                    <div class="fr-account__product-info">
                      <div class="fr-account__product-img">
                        {%- if line_item.image != blank -%}
                          <img src="{{ line_item.image | image_url: width: 120 }}" alt="{{ line_item.title | escape }}" loading="lazy">
                        {%- else -%}
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                      <div class="fr-account__product-meta">
                        <span class="fr-account__product-title">{{ line_item.product.title | default: line_item.title }}</span>
                        
                        <div class="fr-account__line-properties">
                          {%- unless line_item.product.has_only_default_variant -%}
                            {%- for option in line_item.options_with_values -%}
                              <span>{{ option.name }}: {{ option.value }}</span>
                            {%- endfor -%}
                          {%- endunless -%}
                          {%- for property in line_item.properties -%}
                            {%- unless property.last == blank or property.first.first == '_' -%}
                              <span>{{ property.first }}: {{ property.last }}</span>
                            {%- endunless -%}
                          {%- endfor -%}
                        </div>

                        {%- if line_item.fulfillment -%}
                          <div class="fr-order__fulfillment">
                            <span class="fr-order__fulfillment-status">Fulfilled on {{ line_item.fulfillment.created_at | date: "%d %b %Y" }}</span>
                            {%- if line_item.fulfillment.tracking_number -%}
                              <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" class="fr-order__tracking-link">
                                Track package #{{ line_item.fulfillment.tracking_number }}
                              </a>
                            {%- endif -%}
                          </div>
                        {%- endif -%}

                      </div>
                    </div>
                  </td>
                  <td class="text-center">
                    {%- if line_item.original_price != line_item.final_price -%}
                      <s class="fr-order__old-price">{{ line_item.original_price | money }}</s><br>
                    {%- endif -%}
                    {{ line_item.final_price | money }}
                  </td>
                  <td class="text-center">{{ line_item.quantity }}</td>
                  <td class="text-right font-medium">
                    {{ line_item.final_line_price | money }}
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Right Column: Summary & Addresses -->
      <div class="fr-order__summary-col">
        
        <!-- Summary Box -->
        <div class="fr-order__summary-box">
          <h3 class="fr-order__summary-title">Order Summary</h3>
          <div class="fr-order__summary-row">
            <span>Subtotal</span>
            <span>{{ order.line_items_subtotal_price | money }}</span>
          </div>
          
          {%- for discount_application in order.cart_level_discount_applications -%}
            <div class="fr-order__summary-row fr-order__summary-discount">
              <span>Discount ({{ discount_application.title }})</span>
              <span>-{{ discount_application.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}

          {%- for shipping_method in order.shipping_methods -%}
            <div class="fr-order__summary-row">
              <span>Shipping ({{ shipping_method.title }})</span>
              <span>{{ shipping_method.price | money }}</span>
            </div>
          {%- endfor -%}

          {%- for tax_line in order.tax_lines -%}
            <div class="fr-order__summary-row">
              <span>Tax ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</span>
              <span>{{ tax_line.price | money }}</span>
            </div>
          {%- endfor -%}

          <div class="fr-order__summary-row fr-order__summary-total">
            <span>Total</span>
            <span>{{ order.total_price | money_with_currency }}</span>
          </div>
        </div>

        <!-- Addresses Box -->
        <div class="fr-order__addresses">
          
          {%- if order.shipping_address -%}
            <div class="fr-order__address-block">
              <h4 class="fr-order__address-title">Shipping Address</h4>
              <p class="fr-order__address-text">
                {{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}<br>
                {%- if order.shipping_address.company != blank -%}{{ order.shipping_address.company }}<br>{%- endif -%}
                {{ order.shipping_address.street }}<br>
                {{ order.shipping_address.city }}, {{ order.shipping_address.province }} {{ order.shipping_address.zip }}<br>
                {{ order.shipping_address.country }}<br>
                {%- if order.shipping_address.phone != blank -%}{{ order.shipping_address.phone }}{%- endif -%}
              </p>
            </div>
          {%- endif -%}

          {%- if order.billing_address -%}
            <div class="fr-order__address-block">
              <h4 class="fr-order__address-title">Billing Address</h4>
              <p class="fr-order__address-text">
                {{ order.billing_address.first_name }} {{ order.billing_address.last_name }}<br>
                {%- if order.billing_address.company != blank -%}{{ order.billing_address.company }}<br>{%- endif -%}
                {{ order.billing_address.street }}<br>
                {{ order.billing_address.city }}, {{ order.billing_address.province }} {{ order.billing_address.zip }}<br>
                {{ order.billing_address.country }}<br>
                {%- if order.billing_address.phone != blank -%}{{ order.billing_address.phone }}{%- endif -%}
              </p>
            </div>
          {%- endif -%}

        </div>

      </div>

    </div>
  </div>
</section>

<style>
  .fr-order-page {
    background-color: #fafafa;
    min-height: 80vh;
    padding: 60px 20px;
  }

  .fr-order__container {
    max-width: 1200px;
    margin: 0 auto;
    font-family: 'Lato', system-ui, sans-serif;
  }

  /* Header */
  .fr-order__header {
    margin-bottom: 40px;
  }

  .fr-order__back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: #555;
    text-decoration: none;
    margin-bottom: 24px;
    transition: color 0.2s ease;
  }

  .fr-order__back-link:hover {
    color: #1a1a1a;
  }

  .fr-order__title-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .fr-order__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.2rem;
    font-weight: 500;
    color: #1a1a1a;
    margin: 0;
  }

  .fr-order__badges {
    display: flex;
    gap: 12px;
  }

  .status-badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 2px;
    display: inline-block;
  }

  .status-badge.status-delivered {
    background-color: #eaf6ed;
    color: #2b7040;
  }

  .status-badge.status-pending {
    background-color: #f7f7f7;
    color: #4a4a4a;
  }

  .fr-order__date {
    font-size: 0.95rem;
    color: #666;
    margin: 0;
  }

  .fr-order__cancelled {
    margin-top: 16px;
    padding: 16px;
    background-color: #fbf1f1;
    border: 1px solid #f5dede;
    color: #b53939;
    border-radius: 2px;
    font-size: 0.9rem;
  }

  .fr-order__cancelled p {
    margin: 0;
    line-height: 1.4;
  }

  /* Grid Layout */
  .fr-order__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .fr-order__grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  /* Table Container */
  .fr-order__items {
    background-color: #ffffff;
    border: 1px solid #ebebeb;
    border-radius: 2px;
    padding: 30px;
  }

  .fr-account__table-container {
    width: 100%;
    overflow-x: auto;
  }

  .fr-account__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    min-width: 600px;
  }

  .fr-account__table th {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #888;
    padding: 12px 16px;
    border-bottom: 1px solid #ebebeb;
    text-align: left;
    background-color: #ffffff;
  }

  .fr-account__table td {
    padding: 24px 16px;
    border-bottom: 1px solid #f2f2f2;
    vertical-align: middle;
  }

  .fr-account__table tr:last-child td {
    border-bottom: none;
    padding-bottom: 0;
  }

  .text-center { text-align: center !important; }
  .text-right { text-align: right !important; }
  .font-medium { font-weight: 500; }

  /* Product Details */
  .fr-account__product-cell {
    max-width: 320px;
  }

  .fr-account__product-info {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .fr-account__product-img {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    background-color: #faf8f5;
    border-radius: 2px;
    overflow: hidden;
  }

  .fr-account__product-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fr-account__product-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fr-account__product-title {
    font-weight: 600;
    color: #1a1a1a;
  }

  .fr-account__line-properties {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 4px;
    font-size: 0.75rem;
    color: #666;
  }

  .fr-order__fulfillment {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fr-order__fulfillment-status {
    font-size: 0.75rem;
    font-weight: 600;
    color: #2b7040;
  }

  .fr-order__tracking-link {
    font-size: 0.75rem;
    color: #1a1a1a;
    text-decoration: underline;
  }

  .fr-order__tracking-link:hover {
    color: #b53939;
  }

  /* Right Column */
  .fr-order__summary-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .fr-order__summary-box {
    background-color: #ffffff;
    border: 1px solid #ebebeb;
    border-radius: 2px;
    padding: 30px;
  }

  .fr-order__summary-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 500;
    margin-top: 0;
    margin-bottom: 24px;
    color: #1a1a1a;
  }

  .fr-order__summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #f2f2f2;
    font-size: 0.95rem;
    color: #555;
  }

  .fr-order__summary-row:last-child {
    border-bottom: none;
  }

  .fr-order__summary-discount {
    color: #b53939;
  }

  .fr-order__summary-total {
    margin-top: 12px;
    padding-top: 20px;
    border-top: 2px solid #1a1a1a;
    font-size: 1.2rem;
    font-weight: 600;
    color: #1a1a1a;
  }

  .fr-order__addresses {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .fr-order__address-block {
    background-color: #ffffff;
    border: 1px solid #ebebeb;
    border-radius: 2px;
    padding: 30px;
  }

  .fr-order__address-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 0;
    margin-bottom: 16px;
    color: #1a1a1a;
  }

  .fr-order__address-text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #555;
    margin: 0;
  }
</style>
