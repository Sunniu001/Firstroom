<div class="fr-reviews-section page-width" id="{{ section.id }}">
  <div class="fr-reviews-header">
    <h2 class="fr-reviews-title">{{ section.settings.title }}</h2>
    
    <div class="fr-reviews-aggregates">
      <div class="fr-aggregate-box">
        <div class="fr-aggregate-logo">Google</div>
        <div class="fr-aggregate-score">4.9/5</div>
        <div class="fr-aggregate-count">1100+ reviews</div>
      </div>
      <div class="fr-aggregate-box">
        <div class="fr-aggregate-logo">Trustpilot</div>
        <div class="fr-aggregate-score">4.8/5</div>
        <div class="fr-aggregate-count">140+ reviews</div>
      </div>
    </div>
    
    <div class="fr-reviews-features">
      {{ section.settings.features_text }}
    </div>
  </div>

  <div class="fr-reviews-carousel-wrapper">
    <button class="fr-carousel-btn fr-prev" aria-label="Previous">‹</button>
    <div class="fr-reviews-carousel">
      <div class="fr-reviews-track">
        {% for block in section.blocks %}
          <div class="fr-review-card" {{ block.shopify_attributes }}>
            <div class="fr-review-card-header">
              <div class="fr-review-author">
                <span class="fr-author-name">{{ block.settings.author }}</span>
                <span class="fr-review-date">{{ block.settings.date }}</span>
              </div>
              <div class="fr-review-source-icon">
                {% if block.settings.source == 'google' %}
                  <svg viewBox="0 0 24 24" width="16" height="16"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.15v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.15C1.43 8.55 1 10.22 1 12s.43 3.45 1.15 4.93l3.69-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.15 7.07l3.69 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" width="16" height="16"><path fill="#00b67a" d="M24 8.784l-9.17-.674L12 0 8.17 8.11 0 8.784l6.93 6.096L4.85 24 12 19.674 19.15 24l-2.08-9.12z"/></svg>
                {% endif %}
              </div>
            </div>
            <div class="fr-review-stars">
              {% for i in (1..5) %}
                <svg viewBox="0 0 24 24" width="14" height="14" fill="#FFC107"><path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.787 1.4 8.168L12 18.896l-7.334 3.858 1.4-8.168-5.934-5.787 8.2-1.192z"/></svg>
              {% endfor %}
            </div>
            <div class="fr-review-text">
              {{ block.settings.text }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    <button class="fr-carousel-btn fr-next" aria-label="Next">›</button>
  </div>
  <div class="fr-carousel-dots">
    {% for block in section.blocks %}
      <div class="fr-dot {% if forloop.first %}active{% endif %}"></div>
    {% endfor %}
  </div>
</div>

<style>
  .fr-reviews-section {
    padding-top: 4rem;
    padding-bottom: 4rem;
    border-top: 1px solid #f0f0f0;
    text-align: center;
  }
  .fr-reviews-title {
    font-size: 16px;
    font-weight: 500;
    color: #333;
    margin-bottom: 1.5rem;
  }
  .fr-reviews-aggregates {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-bottom: 1.5rem;
  }
  .fr-aggregate-box {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .fr-aggregate-logo {
    font-size: 12px;
    font-weight: 600;
    color: #111;
    margin-bottom: 4px;
  }
  .fr-aggregate-score {
    font-size: 18px;
    font-weight: 400;
    color: #b58c67;
  }
  .fr-aggregate-count {
    font-size: 10px;
    color: #888;
    margin-top: 4px;
  }
  .fr-reviews-features {
    font-size: 11px;
    color: #666;
    font-style: italic;
    margin-bottom: 2rem;
    letter-spacing: 0.2px;
  }
  
  .fr-reviews-carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .fr-reviews-carousel {
    flex: 1;
    overflow: hidden;
  }
  .fr-reviews-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
    padding-bottom: 10px;
  }
  .fr-reviews-track::-webkit-scrollbar {
    display: none;
  }
  .fr-review-card {
    flex: 0 0 calc(25% - 1.125rem); /* 4 items */
    min-width: 240px;
    background: #f8f8f8;
    border-radius: 6px;
    padding: 1.5rem;
    scroll-snap-align: start;
    text-align: left;
  }
  @media (max-width: 900px) {
    .fr-review-card { flex: 0 0 calc(33.333% - 1rem); }
  }
  @media (max-width: 700px) {
    .fr-review-card { flex: 0 0 calc(50% - 0.75rem); }
  }
  @media (max-width: 450px) {
    .fr-review-card { flex: 0 0 100%; }
  }
  
  .fr-review-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }
  .fr-review-author {
    display: flex;
    flex-direction: column;
  }
  .fr-author-name {
    font-size: 12px;
    font-weight: 600;
    color: #111;
  }
  .fr-review-date {
    font-size: 10px;
    color: #888;
    margin-top: 2px;
  }
  .fr-review-stars {
    margin-bottom: 12px;
  }
  .fr-review-text {
    font-size: 12px;
    color: #444;
    line-height: 1.5;
  }
  
  .fr-carousel-btn {
    background: none;
    border: none;
    font-size: 24px;
    color: #999;
    cursor: pointer;
    padding: 10px;
    transition: color 0.2s;
  }
  .fr-carousel-btn:hover {
    color: #333;
  }
  .fr-carousel-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 1rem;
  }
  .fr-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ccc;
    transition: background 0.2s;
  }
  .fr-dot.active {
    background: #666;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.querySelector('#{{ section.id }} .fr-reviews-track');
    const prevBtn = document.querySelector('#{{ section.id }} .fr-prev');
    const nextBtn = document.querySelector('#{{ section.id }} .fr-next');
    
    if (track && prevBtn && nextBtn) {
      nextBtn.addEventListener('click', () => {
        const scrollAmount = track.clientWidth > 600 ? track.clientWidth / 2 : track.clientWidth;
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
      prevBtn.addEventListener('click', () => {
        const scrollAmount = track.clientWidth > 600 ? track.clientWidth / 2 : track.clientWidth;
        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "FR Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Loved by our customers"
    },
    {
      "type": "text",
      "id": "features_text",
      "label": "Features text",
      "default": "Storyled designs • Exceptional service • Luxury materials • Prompt support • Trusted across 28 countries"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Customer Name"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "Jul 1, 2026"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "This product is amazing!"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Source Icon",
          "options": [
            { "value": "google", "label": "Google" },
            { "value": "trustpilot", "label": "Trustpilot" }
          ],
          "default": "google"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Customer Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
