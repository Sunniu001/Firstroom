{% comment %}
  FR Footer – Block-based footer section
  4 block types: brand, quick_links, information, contact
  Background image set via Shopify Visual Builder on the section itself.
{% endcomment %}

<style>
  .fr-footer {
    font-family: var(--font-body--family, 'Inter', sans-serif);
    position: relative;
  }

  .fr-footer__grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 40px 60px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
  }

  /* ── Block: Brand ── */
  .fr-footer-brand__logo {
    display: block;
    margin-bottom: 22px;
    width: 130px;
  }
  .fr-footer-brand__logo img {
    width: 100%;
    height: auto;
  }
  .fr-footer-brand__tagline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3a3a3a;
    margin-bottom: 14px;
  }
  .fr-footer-brand__socials {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .fr-footer-brand__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid #3a3a3a;
    color: #3a3a3a;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }
  .fr-footer-brand__social-link:hover {
    background: #3a3a3a;
    color: #fff;
  }
  .fr-footer-brand__social-link svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  /* ── Block: Links (Quick Links & Information) ── */
  .fr-footer-links__title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #3a3a3a;
    margin-bottom: 18px;
  }
  .fr-footer-links__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .fr-footer-links__list a {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a4a4a;
    text-decoration: none;
    transition: color 0.2s ease;
    line-height: 1.4;
  }
  .fr-footer-links__list a:hover {
    color: #c2593f;
  }

  /* ── Block: Contact ── */
  .fr-footer-contact__title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #3a3a3a;
    margin-bottom: 18px;
  }
  .fr-footer-contact__item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 16px;
  }
  .fr-footer-contact__icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid #4a4a4a;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .fr-footer-contact__icon svg {
    width: 13px;
    height: 13px;
    stroke: #4a4a4a;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fr-footer-contact__text {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #4a4a4a;
    line-height: 1.6;
  }
  .fr-footer-contact__text a {
    color: inherit;
    text-decoration: none;
  }
  .fr-footer-contact__text a:hover {
    color: #c2593f;
  }

  /* ── Copyright bar ── */
  .fr-footer__copyright {
    background: #fff;
    text-align: center;
    padding: 14px 20px;
    font-size: 12px;
    color: #555;
    letter-spacing: 0.03em;
    border-top: 1px solid #e0e0e0;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .fr-footer__grid {
      grid-template-columns: 1fr 1fr;
      padding: 40px 24px 40px;
    }
  }
  @media (max-width: 540px) {
    .fr-footer__grid {
      grid-template-columns: 1fr;
      padding: 32px 20px 32px;
    }
  }
</style>

{%- if section.settings.background_image != blank -%}
  {%- assign bg_url = section.settings.background_image | image_url: width: 2000 -%}
  <section class="fr-footer" id="fr-footer" style="background-image: url('{{ bg_url }}'); background-size: cover; background-position: center; background-repeat: no-repeat;">
{%- else -%}
  <section class="fr-footer" id="fr-footer">
{%- endif -%}
  <div class="fr-footer__grid" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;">

    {%- for block in section.blocks -%}

      {%- case block.type -%}

        {%- when 'brand' -%}
          <div class="fr-footer-block fr-footer-block--brand" {{ block.shopify_attributes }}>
            <a href="/" class="fr-footer-brand__logo" aria-label="{{ shop.name }}">
              {%- if settings.logo != blank -%}
                <img
                  src="{{ settings.logo | image_url: width: 260 }}"
                  alt="{{ shop.name }}"
                  width="130"
                  loading="lazy"
                >
              {%- else -%}
                <span style="font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#3a3a3a;">{{ shop.name }}</span>
              {%- endif -%}
            </a>

            <p class="fr-footer-brand__tagline">{{ block.settings.tagline }}</p>

            <div class="fr-footer-brand__socials">
              {%- if block.settings.instagram_url != blank -%}
                <a href="{{ block.settings.instagram_url }}" class="fr-footer-brand__social-link" aria-label="Instagram" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
              {%- endif -%}
              {%- if block.settings.facebook_url != blank -%}
                <a href="{{ block.settings.facebook_url }}" class="fr-footer-brand__social-link" aria-label="Facebook" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
              {%- endif -%}
              {%- if block.settings.linkedin_url != blank -%}
                <a href="{{ block.settings.linkedin_url }}" class="fr-footer-brand__social-link" aria-label="LinkedIn" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
              {%- endif -%}
              {%- if block.settings.pinterest_url != blank -%}
                <a href="{{ block.settings.pinterest_url }}" class="fr-footer-brand__social-link" aria-label="Pinterest" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
                </a>
              {%- endif -%}
              {%- if block.settings.whatsapp_url != blank -%}
                <a href="{{ block.settings.whatsapp_url }}" class="fr-footer-brand__social-link" aria-label="WhatsApp" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>

        {%- when 'quick_links' -%}
          <div class="fr-footer-block fr-footer-block--links" {{ block.shopify_attributes }}>
            <p class="fr-footer-links__title">{{ block.settings.heading | default: 'Quick Links' }}</p>
            <ul class="fr-footer-links__list">
              {%- if block.settings.link_1_label != blank -%}
                <li><a href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_2_label != blank -%}
                <li><a href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_3_label != blank -%}
                <li><a href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_4_label != blank -%}
                <li><a href="{{ block.settings.link_4_url }}">{{ block.settings.link_4_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_5_label != blank -%}
                <li><a href="{{ block.settings.link_5_url }}">{{ block.settings.link_5_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_6_label != blank -%}
                <li><a href="{{ block.settings.link_6_url }}">{{ block.settings.link_6_label }}</a></li>
              {%- endif -%}
            </ul>
          </div>

        {%- when 'information' -%}
          <div class="fr-footer-block fr-footer-block--links" {{ block.shopify_attributes }}>
            <p class="fr-footer-links__title">{{ block.settings.heading | default: 'Information' }}</p>
            <ul class="fr-footer-links__list">
              {%- if block.settings.link_1_label != blank -%}
                <li><a href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_2_label != blank -%}
                <li><a href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_3_label != blank -%}
                <li><a href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_4_label != blank -%}
                <li><a href="{{ block.settings.link_4_url }}">{{ block.settings.link_4_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_5_label != blank -%}
                <li><a href="{{ block.settings.link_5_url }}">{{ block.settings.link_5_label }}</a></li>
              {%- endif -%}
            </ul>
          </div>

        {%- when 'contact' -%}
          <div class="fr-footer-block fr-footer-block--contact" {{ block.shopify_attributes }}>
            <p class="fr-footer-contact__title">{{ block.settings.heading | default: 'Contact Us' }}</p>

            {%- if block.settings.phone != blank -%}
              <div class="fr-footer-contact__item">
                <div class="fr-footer-contact__icon">
                  <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.43 2 2 0 0 1 3.6 1.24l3-.01a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.84a16 16 0 0 0 6.29 6.29l1.17-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div class="fr-footer-contact__text">
                  <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a>
                </div>
              </div>
            {%- endif -%}

            {%- if block.settings.email != blank -%}
              <div class="fr-footer-contact__item">
                <div class="fr-footer-contact__icon">
                  <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div class="fr-footer-contact__text">
                  <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                </div>
              </div>
            {%- endif -%}

            {%- if block.settings.address != blank -%}
              <div class="fr-footer-contact__item">
                <div class="fr-footer-contact__icon">
                  <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div class="fr-footer-contact__text">{{ block.settings.address }}</div>
              </div>
            {%- endif -%}
          </div>

      {%- endcase -%}

    {%- endfor -%}

  </div>

  <div class="fr-footer__copyright">
    {{ section.settings.copyright_text | default: 'All rights reserved | © 2026 First Room Collective' }}
  </div>
</section>

{% schema %}
{
  "name": "FR Footer",
  "tag": "div",
  "class": "fr-footer-wrapper",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Recommended: wide image, 2000px+. Displays behind all 4 footer columns."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding Left & Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "All rights reserved | \u00a9 2026 First Room Collective"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand & Social",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Stay in touch with us"
        },
        {
          "type": "header",
          "content": "Social Links"
        },
        {
          "type": "url",
          "id": "instagram_url",
          "label": "Instagram URL"
        },
        {
          "type": "url",
          "id": "facebook_url",
          "label": "Facebook URL"
        },
        {
          "type": "url",
          "id": "linkedin_url",
          "label": "LinkedIn URL"
        },
        {
          "type": "url",
          "id": "pinterest_url",
          "label": "Pinterest URL"
        },
        {
          "type": "url",
          "id": "whatsapp_url",
          "label": "WhatsApp URL",
          "info": "e.g. https://wa.me/919650706644"
        }
      ]
    },
    {
      "type": "quick_links",
      "name": "Quick Links",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        { "type": "header", "content": "Link 1" },
        { "type": "text", "id": "link_1_label", "label": "Label", "default": "Wallpaper" },
        { "type": "url", "id": "link_1_url", "label": "URL" },
        { "type": "header", "content": "Link 2" },
        { "type": "text", "id": "link_2_label", "label": "Label", "default": "Home Decor" },
        { "type": "url", "id": "link_2_url", "label": "URL" },
        { "type": "header", "content": "Link 3" },
        { "type": "text", "id": "link_3_label", "label": "Label", "default": "Custom Design" },
        { "type": "url", "id": "link_3_url", "label": "URL" },
        { "type": "header", "content": "Link 4" },
        { "type": "text", "id": "link_4_label", "label": "Label", "default": "Our Story" },
        { "type": "url", "id": "link_4_url", "label": "URL" },
        { "type": "header", "content": "Link 5" },
        { "type": "text", "id": "link_5_label", "label": "Label", "default": "Contact" },
        { "type": "url", "id": "link_5_url", "label": "URL" },
        { "type": "header", "content": "Link 6 (optional)" },
        { "type": "text", "id": "link_6_label", "label": "Label" },
        { "type": "url", "id": "link_6_url", "label": "URL" }
      ]
    },
    {
      "type": "information",
      "name": "Information",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Information"
        },
        { "type": "header", "content": "Link 1" },
        { "type": "text", "id": "link_1_label", "label": "Label", "default": "Terms and Conditions" },
        { "type": "url", "id": "link_1_url", "label": "URL" },
        { "type": "header", "content": "Link 2" },
        { "type": "text", "id": "link_2_label", "label": "Label", "default": "Privacy Policy" },
        { "type": "url", "id": "link_2_url", "label": "URL" },
