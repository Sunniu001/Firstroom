{% comment %}
  FR Footer – Block-based footer section
  4 block types: brand, quick_links, information, contact
  Full typography, alignment, and mobile controls.
{% endcomment %}

{%- liquid
  assign bg_img = section.settings.background_image
  assign bg_img_mobile = section.settings.background_image_mobile
  assign bg_pos = section.settings.bg_position | default: 'center'
  assign bg_pos_mobile = section.settings.bg_position_mobile | default: bg_pos

  assign heading_font = section.settings.heading_font
  assign link_font = section.settings.link_font

  assign h_size = section.settings.heading_size | default: 11
  assign h_size_m = section.settings.heading_size_mobile | default: h_size
  assign h_color = section.settings.heading_color | default: '#3a3a3a'
  assign h_spacing = section.settings.heading_letter_spacing | default: 16
  assign h_weight = section.settings.heading_weight | default: '700'

  assign l_size = section.settings.link_size | default: 11
  assign l_size_m = section.settings.link_size_mobile | default: l_size
  assign l_color = section.settings.link_color | default: '#4a4a4a'
  assign l_hover = section.settings.link_hover_color | default: '#c2593f'
  assign l_weight = section.settings.link_weight | default: '500'
  assign l_spacing = section.settings.link_letter_spacing | default: 10

  assign t_align = section.settings.text_align | default: 'left'
  assign t_align_m = section.settings.text_align_mobile | default: t_align

  assign cols_m = section.settings.columns_mobile | default: 1
  assign grid_max = section.settings.grid_max_width | default: 1200
  assign grid_gap = section.settings.grid_gap | default: 40

  assign pt = section.settings.padding_top | default: 60
  assign pb = section.settings.padding_bottom | default: 60
  assign ph = section.settings.padding_horizontal | default: 40
  assign pt_m = section.settings.padding_top_mobile | default: pt
  assign pb_m = section.settings.padding_bottom_mobile | default: pb
  assign ph_m = section.settings.padding_horizontal_mobile | default: ph

  assign copyright_color = section.settings.copyright_color | default: '#555555'
  assign copyright_bg = section.settings.copyright_bg | default: '#ffffff'
-%}

<style>
  #fr-footer-{{ section.id }} {
    --fr-footer-h-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --fr-footer-h-style: {{ heading_font.style }};
    --fr-footer-h-weight: {{ h_weight }};
    --fr-footer-h-size: {{ h_size }}px;
    --fr-footer-h-size-m: {{ h_size_m }}px;
    --fr-footer-h-color: {{ h_color }};
    --fr-footer-h-spacing: {{ h_spacing | divided_by: 100.0 }}em;

    --fr-footer-l-font: {{ link_font.family }}, {{ link_font.fallback_families }};
    --fr-footer-l-style: {{ link_font.style }};
    --fr-footer-l-weight: {{ l_weight }};
    --fr-footer-l-size: {{ l_size }}px;
    --fr-footer-l-size-m: {{ l_size_m }}px;
    --fr-footer-l-color: {{ l_color }};
    --fr-footer-l-hover: {{ l_hover }};
    --fr-footer-l-spacing: {{ l_spacing | divided_by: 100.0 }}em;

    --fr-footer-align: {{ t_align }};
    --fr-footer-align-m: {{ t_align_m }};

    --fr-footer-grid-max: {{ grid_max }}px;
    --fr-footer-grid-gap: {{ grid_gap }}px;

    --fr-footer-pt: {{ pt }}px;
    --fr-footer-pb: {{ pb }}px;
    --fr-footer-ph: {{ ph }}px;
    --fr-footer-pt-m: {{ pt_m }}px;
    --fr-footer-pb-m: {{ pb_m }}px;
    --fr-footer-ph-m: {{ ph_m }}px;

    position: relative;
    overflow: hidden;
  }

  /* ── Background image layers ── */
  #fr-footer-{{ section.id }} .fr-footer__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #fr-footer-{{ section.id }} .fr-footer__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #fr-footer-{{ section.id }} .fr-footer__bg .fr-footer__bg-desktop {
    object-position: {{ bg_pos }};
  }
  #fr-footer-{{ section.id }} .fr-footer__bg .fr-footer__bg-mobile {
    object-position: {{ bg_pos_mobile }};
    display: none;
  }
  @media (max-width: 767px) {
    #fr-footer-{{ section.id }} .fr-footer__bg .fr-footer__bg-desktop {
      {% if bg_img_mobile != blank %}display: none;{% endif %}
    }
    #fr-footer-{{ section.id }} .fr-footer__bg .fr-footer__bg-mobile {
      display: block;
    }
  }

  /* ── Grid ── */
  #fr-footer-{{ section.id }} .fr-footer__grid {
    position: relative;
    z-index: 1;
    max-width: var(--fr-footer-grid-max);
    margin: 0 auto;
    padding: var(--fr-footer-pt) var(--fr-footer-ph) var(--fr-footer-pb);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--fr-footer-grid-gap);
    text-align: var(--fr-footer-align);
  }

  @media (max-width: 767px) {
    #fr-footer-{{ section.id }} .fr-footer__grid {
      grid-template-columns: repeat({{ cols_m }}, 1fr);
      padding: var(--fr-footer-pt-m) var(--fr-footer-ph-m) var(--fr-footer-pb-m);
      text-align: var(--fr-footer-align-m);
    }
  }

  /* ── Brand block ── */
  #fr-footer-{{ section.id }} .fr-footer-brand__logo {
    display: block;
    margin-bottom: 22px;
    width: 130px;
  }
  #fr-footer-{{ section.id }} .fr-footer-brand__logo img {
    width: 100%;
    height: auto;
  }
  #fr-footer-{{ section.id }} .fr-footer-brand__tagline {
    font-family: var(--fr-footer-h-font);
    font-style: var(--fr-footer-h-style);
    font-weight: var(--fr-footer-h-weight);
    font-size: var(--fr-footer-h-size);
    letter-spacing: var(--fr-footer-h-spacing);
    text-transform: uppercase;
    color: var(--fr-footer-h-color);
    margin-bottom: 14px;
  }
  @media (max-width: 767px) {
    #fr-footer-{{ section.id }} .fr-footer-brand__tagline {
      font-size: var(--fr-footer-h-size-m);
    }
    #fr-footer-{{ section.id }} .fr-footer-brand__logo {
      {% if t_align_m == 'center' %}margin-left: auto; margin-right: auto;{% elsif t_align_m == 'right' %}margin-left: auto;{% endif %}
    }
  }

  #fr-footer-{{ section.id }} .fr-footer-brand__socials {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    {% if t_align == 'center' %}justify-content: center;{% elsif t_align == 'right' %}justify-content: flex-end;{% endif %}
  }
  @media (max-width: 767px) {
    #fr-footer-{{ section.id }} .fr-footer-brand__socials {
      {% if t_align_m == 'center' %}justify-content: center;{% elsif t_align_m == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
    }
  }

  #fr-footer-{{ section.id }} .fr-footer-brand__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--fr-footer-h-color);
    color: var(--fr-footer-h-color);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }
  #fr-footer-{{ section.id }} .fr-footer-brand__social-link:hover {
    background: var(--fr-footer-h-color);
    color: #fff;
  }
  #fr-footer-{{ section.id }} .fr-footer-brand__social-link svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  /* ── Links blocks ── */
  #fr-footer-{{ section.id }} .fr-footer-links__title {
    font-family: var(--fr-footer-h-font);
    font-style: var(--fr-footer-h-style);
    font-weight: var(--fr-footer-h-weight);
    font-size: var(--fr-footer-h-size);
    letter-spacing: var(--fr-footer-h-spacing);
    text-transform: uppercase;
    color: var(--fr-footer-h-color);
    margin-bottom: 18px;
  }
  @media (max-width: 767px) {
    #fr-footer-{{ section.id }} .fr-footer-links__title {
      font-size: var(--fr-footer-h-size-m);
    }
  }

  #fr-footer-{{ section.id }} .fr-footer-links__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  #fr-footer-{{ section.id }} .fr-footer-links__list a {
    font-family: var(--fr-footer-l-font);
    font-style: var(--fr-footer-l-style);
    font-weight: var(--fr-footer-l-weight);
    font-size: var(--fr-footer-l-size);
    letter-spacing: var(--fr-footer-l-spacing);
    text-transform: uppercase;
    color: var(--fr-footer-l-color);
    text-decoration: none;
    transition: color 0.2s ease;
    line-height: 1.4;
  }
  @media (max-width: 767px) {
    #fr-footer-{{ section.id }} .fr-footer-links__list a {
      font-size: var(--fr-footer-l-size-m);
    }
  }
  #fr-footer-{{ section.id }} .fr-footer-links__list a:hover {
    color: var(--fr-footer-l-hover);
  }

  /* ── Contact block ── */
  #fr-footer-{{ section.id }} .fr-footer-contact__title {
    font-family: var(--fr-footer-h-font);
    font-style: var(--fr-footer-h-style);
    font-weight: var(--fr-footer-h-weight);
    font-size: var(--fr-footer-h-size);
    letter-spacing: var(--fr-footer-h-spacing);
    text-transform: uppercase;
    color: var(--fr-footer-h-color);
    margin-bottom: 18px;
  }
  @media (max-width: 767px) {
    #fr-footer-{{ section.id }} .fr-footer-contact__title {
      font-size: var(--fr-footer-h-size-m);
    }
  }

  #fr-footer-{{ section.id }} .fr-footer-contact__item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 16px;
    {% if t_align == 'center' %}justify-content: center;{% elsif t_align == 'right' %}justify-content: flex-end;{% endif %}
  }
  @media (max-width: 767px) {
    #fr-footer-{{ section.id }} .fr-footer-contact__item {
      {% if t_align_m == 'center' %}justify-content: center;{% elsif t_align_m == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
    }
  }

  #fr-footer-{{ section.id }} .fr-footer-contact__icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--fr-footer-l-color);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  #fr-footer-{{ section.id }} .fr-footer-contact__icon svg {
    width: 13px;
    height: 13px;
    stroke: var(--fr-footer-l-color);
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #fr-footer-{{ section.id }} .fr-footer-contact__text {
    font-family: var(--fr-footer-l-font);
    font-style: var(--fr-footer-l-style);
    font-weight: var(--fr-footer-l-weight);
    font-size: var(--fr-footer-l-size);
    letter-spacing: var(--fr-footer-l-spacing);
    text-transform: uppercase;
    color: var(--fr-footer-l-color);
    line-height: 1.6;
  }
  @media (max-width: 767px) {
    #fr-footer-{{ section.id }} .fr-footer-contact__text {
      font-size: var(--fr-footer-l-size-m);
    }
  }
  #fr-footer-{{ section.id }} .fr-footer-contact__text a {
    color: inherit;
    text-decoration: none;
  }
  #fr-footer-{{ section.id }} .fr-footer-contact__text a:hover {
    color: var(--fr-footer-l-hover);
  }

  /* ── Copyright bar ── */
  #fr-footer-{{ section.id }} .fr-footer__copyright {
    position: relative;
    z-index: 1;
    background: {{ copyright_bg }};
    text-align: center;
    padding: 14px 20px;
    font-size: 12px;
    color: {{ copyright_color }};
    letter-spacing: 0.03em;
    border-top: 1px solid #e0e0e0;
  }
</style>

<section id="fr-footer-{{ section.id }}">
  {%- comment -%} Background image layer {%- endcomment -%}
  {%- if bg_img != blank or bg_img_mobile != blank -%}
    <div class="fr-footer__bg" aria-hidden="true">
      {%- if bg_img != blank -%}
        <img
          class="fr-footer__bg-desktop"
          src="{{ bg_img | image_url: width: 2400 }}"
          alt=""
          loading="lazy"
          width="{{ bg_img.width }}"
          height="{{ bg_img.height }}"
        >
      {%- endif -%}
      {%- if bg_img_mobile != blank -%}
        <img
          class="fr-footer__bg-mobile"
          src="{{ bg_img_mobile | image_url: width: 800 }}"
          alt=""
          loading="lazy"
          width="{{ bg_img_mobile.width }}"
          height="{{ bg_img_mobile.height }}"
        >
      {%- elsif bg_img != blank -%}
        <img
          class="fr-footer__bg-mobile"
          src="{{ bg_img | image_url: width: 800 }}"
          alt=""
          loading="lazy"
          width="{{ bg_img.width }}"
          height="{{ bg_img.height }}"
        >
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="fr-footer__grid">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'brand' -%}
          <div class="fr-footer-block fr-footer-block--brand" {{ block.shopify_attributes }}>
            <a href="/" class="fr-footer-brand__logo" aria-label="{{ shop.name }}">
              {%- if settings.logo != blank -%}
                <img
                  src="{{ settings.logo | image_url: width: 260 }}"
                  alt="{{ shop.name }}"
                  width="130"
                  loading="lazy"
                >
              {%- else -%}
                <span style="font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--fr-footer-h-color);">{{ shop.name }}</span>
              {%- endif -%}
            </a>

            <p class="fr-footer-brand__tagline">{{ block.settings.tagline }}</p>

            <div class="fr-footer-brand__socials">
              {%- if block.settings.instagram_url != blank -%}
                <a href="{{ block.settings.instagram_url }}" class="fr-footer-brand__social-link" aria-label="Instagram" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
              {%- endif -%}
              {%- if block.settings.facebook_url != blank -%}
                <a href="{{ block.settings.facebook_url }}" class="fr-footer-brand__social-link" aria-label="Facebook" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
              {%- endif -%}
              {%- if block.settings.linkedin_url != blank -%}
                <a href="{{ block.settings.linkedin_url }}" class="fr-footer-brand__social-link" aria-label="LinkedIn" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
              {%- endif -%}
              {%- if block.settings.pinterest_url != blank -%}
                <a href="{{ block.settings.pinterest_url }}" class="fr-footer-brand__social-link" aria-label="Pinterest" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
                </a>
              {%- endif -%}
              {%- if block.settings.whatsapp_url != blank -%}
                <a href="{{ block.settings.whatsapp_url }}" class="fr-footer-brand__social-link" aria-label="WhatsApp" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>

        {%- when 'quick_links' -%}
          <div class="fr-footer-block fr-footer-block--links" {{ block.shopify_attributes }}>
            <p class="fr-footer-links__title">{{ block.settings.heading | default: 'Quick Links' }}</p>
            <ul class="fr-footer-links__list">
              {%- if block.settings.link_1_label != blank -%}
                <li><a href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_2_label != blank -%}
                <li><a href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_3_label != blank -%}
                <li><a href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_4_label != blank -%}
                <li><a href="{{ block.settings.link_4_url }}">{{ block.settings.link_4_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_5_label != blank -%}
                <li><a href="{{ block.settings.link_5_url }}">{{ block.settings.link_5_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_6_label != blank -%}
                <li><a href="{{ block.settings.link_6_url }}">{{ block.settings.link_6_label }}</a></li>
              {%- endif -%}
            </ul>
          </div>

        {%- when 'information' -%}
          <div class="fr-footer-block fr-footer-block--links" {{ block.shopify_attributes }}>
            <p class="fr-footer-links__title">{{ block.settings.heading | default: 'Information' }}</p>
            <ul class="fr-footer-links__list">
              {%- if block.settings.link_1_label != blank -%}
                <li><a href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_2_label != blank -%}
                <li><a href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_3_label != blank -%}
                <li><a href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_4_label != blank -%}
                <li><a href="{{ block.settings.link_4_url }}">{{ block.settings.link_4_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_5_label != blank -%}
                <li><a href="{{ block.settings.link_5_url }}">{{ block.settings.link_5_label }}</a></li>
              {%- endif -%}
            </ul>
          </div>

        {%- when 'contact' -%}
          <div class="fr-footer-block fr-footer-block--contact" {{ block.shopify_attributes }}>
            <p class="fr-footer-contact__title">{{ block.settings.heading | default: 'Contact Us' }}</p>

            {%- if block.settings.phone != blank -%}
              <div class="fr-footer-contact__item">
                <div class="fr-footer-contact__icon">
                  <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.43 2 2 0 0 1 3.6 1.24l3-.01a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.84a16 16 0 0 0 6.29 6.29l1.17-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div class="fr-footer-contact__text">
                  <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a>
                </div>
              </div>
            {%- endif -%}

            {%- if block.settings.email != blank -%}
              <div class="fr-footer-contact__item">
                <div class="fr-footer-contact__icon">
                  <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div class="fr-footer-contact__text">
                  <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                </div>
              </div>
            {%- endif -%}

            {%- if block.settings.address != blank -%}
              <div class="fr-footer-contact__item">
                <div class="fr-footer-contact__icon">
                  <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div class="fr-footer-contact__text">{{ block.settings.address }}</div>
              </div>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="fr-footer__copyright">
    {{ section.settings.copyright_text | default: 'All rights reserved | © 2026 First Room Collective' }}
  </div>
</section>

