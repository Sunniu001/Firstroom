{%- liquid
  assign slides_count = 0
  assign has_block_slides = false

  for block in section.blocks
    if block.type == 'slide' and block.settings.image != blank
      assign has_block_slides = true
    endif
  endfor

  if has_block_slides
    for block in section.blocks
      if block.type == 'slide' and block.settings.image != blank
        assign slides_count = slides_count | plus: 1
      endif
    endfor
  else
    if section.settings.hero_image != blank
      assign slides_count = slides_count | plus: 1
    endif
    if section.settings.hero_image_2 != blank
      assign slides_count = slides_count | plus: 1
    endif
    if section.settings.hero_image_3 != blank
      assign slides_count = slides_count | plus: 1
    endif
    if section.settings.hero_image_4 != blank
      assign slides_count = slides_count | plus: 1
    endif
  endif
-%}

<section class="fr-about-hero" id="fr-about-hero-{{ section.id }}">
  <div class="fr-about-hero__wrapper">
    
    <!-- Slides Container -->
    <div class="fr-about-hero__slides">
      {%- if has_block_slides -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' and block.settings.image != blank -%}
            <div class="fr-about-hero__slide {% if forloop.first %}active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <picture>
                {%- if block.settings.mobile_image != blank -%}
                  <source media="(max-width: 767px)" srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}">
                {%- endif -%}
                <img src="{{ block.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.hero_title | escape }}" class="fr-about-hero__bg-img" {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}>
              </picture>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- if section.settings.hero_image != blank -%}
          <div class="fr-about-hero__slide active" data-slide-index="0">
            <picture>
              {%- if section.settings.hero_image_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ section.settings.hero_image_mobile | image_url: width: 1200 }}">
              {%- endif -%}
              <img src="{{ section.settings.hero_image | image_url: width: 2400 }}" alt="{{ section.settings.hero_title | escape }}" class="fr-about-hero__bg-img" loading="eager">
            </picture>
          </div>
        {%- endif -%}
        {%- if section.settings.hero_image_2 != blank -%}
          <div class="fr-about-hero__slide" data-slide-index="1">
            <picture>
              {%- if section.settings.hero_image_2_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ section.settings.hero_image_2_mobile | image_url: width: 1200 }}">
              {%- endif -%}
              <img src="{{ section.settings.hero_image_2 | image_url: width: 2400 }}" alt="{{ section.settings.hero_title | escape }}" class="fr-about-hero__bg-img" loading="lazy">
            </picture>
          </div>
        {%- endif -%}
        {%- if section.settings.hero_image_3 != blank -%}
          <div class="fr-about-hero__slide" data-slide-index="2">
            <picture>
              {%- if section.settings.hero_image_3_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ section.settings.hero_image_3_mobile | image_url: width: 1200 }}">
              {%- endif -%}
              <img src="{{ section.settings.hero_image_3 | image_url: width: 2400 }}" alt="{{ section.settings.hero_title | escape }}" class="fr-about-hero__bg-img" loading="lazy">
            </picture>
          </div>
        {%- endif -%}
        {%- if section.settings.hero_image_4 != blank -%}
          <div class="fr-about-hero__slide" data-slide-index="3">
            <picture>
              {%- if section.settings.hero_image_4_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ section.settings.hero_image_4_mobile | image_url: width: 1200 }}">
              {%- endif -%}
              <img src="{{ section.settings.hero_image_4 | image_url: width: 2400 }}" alt="{{ section.settings.hero_title | escape }}" class="fr-about-hero__bg-img" loading="lazy">
            </picture>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <!-- Overlay -->
    <div class="fr-about-hero__overlay" style="background-color: rgba(0, 0, 0, {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }});"></div>

    <!-- Hero Content -->
    <div class="fr-about-hero__content">
      {%- if section.settings.hero_title != blank -%}
        <h1 class="fr-about-hero__title">{{ section.settings.hero_title }}</h1>
      {%- endif -%}
      {%- if section.settings.hero_subtitle != blank -%}
        <p class="fr-about-hero__subtitle">{{ section.settings.hero_subtitle }}</p>
      {%- endif -%}
    </div>

    <!-- Slider Controls -->
    {%- if slides_count > 1 -%}
      {%- if section.settings.show_dots -%}
        <div class="fr-about-hero__dots"></div>
      {%- endif -%}

      {%- if section.settings.show_arrows -%}
        <button class="fr-about-hero__arrow fr-about-hero__arrow--prev" type="button" aria-label="Previous slide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="fr-about-hero__arrow fr-about-hero__arrow--next" type="button" aria-label="Next slide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {%- endif -%}
    {%- endif -%}

  </div>
</section>

<style>
  {{ section.settings.title_font | font_face }}
  {{ section.settings.subtitle_font | font_face }}

  #fr-about-hero-{{ section.id }} {
    width: 100%;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__wrapper {
    position: relative;
    width: 100%;
    display: flex;
    overflow: hidden;
    {% if section.settings.aspect_ratio != blank and section.settings.aspect_ratio != 'vh' %}
      aspect-ratio: {{ section.settings.aspect_ratio_mobile | default: section.settings.aspect_ratio }};
      height: auto;
      min-height: 180px;
    {% else %}
      height: {{ section.settings.hero_height_mobile }}vh;
    {% endif %}
    align-items: {% if section.settings.content_alignment_vertical_mobile == 'top' %}flex-start{% elsif section.settings.content_alignment_vertical_mobile == 'bottom' %}flex-end{% else %}center{% endif %};
    justify-content: {% if section.settings.content_alignment_horizontal_mobile == 'left' %}flex-start{% elsif section.settings.content_alignment_horizontal_mobile == 'right' %}flex-end{% else %}center{% endif %};
  }

  @media (min-width: 768px) {
    #fr-about-hero-{{ section.id }} .fr-about-hero__wrapper {
      {% if section.settings.aspect_ratio != blank and section.settings.aspect_ratio != 'vh' %}
        aspect-ratio: {{ section.settings.aspect_ratio }};
        height: auto;
        min-height: 250px;
      {% else %}
        height: {{ section.settings.hero_height_desktop }}vh;
      {% endif %}
      align-items: {% if section.settings.content_alignment_vertical == 'top' %}flex-start{% elsif section.settings.content_alignment_vertical == 'bottom' %}flex-end{% else %}center{% endif %};
      justify-content: {% if section.settings.content_alignment_horizontal == 'left' %}flex-start{% elsif section.settings.content_alignment_horizontal == 'right' %}flex-end{% else %}center{% endif %};
    }
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__slides {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.2s ease-in-out, visibility 1.2s ease-in-out;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__slide.active {
    opacity: 1;
    visibility: visible;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__bg-img,
  #fr-about-hero-{{ section.id }} picture {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__content {
    position: relative;
    z-index: 3;
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
    padding-left: {{ section.settings.padding_left_mobile | default: 20 }}px;
    padding-right: {{ section.settings.padding_right_mobile | default: 20 }}px;
    width: max-content;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    #fr-about-hero-{{ section.id }} .fr-about-hero__content {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__title {
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    font-weight: {{ section.settings.title_font.weight }};
    font-style: {{ section.settings.title_font.style }};
    font-size: {{ section.settings.title_size_mobile }}px;
    color: {{ section.settings.title_color }};
    margin: 0;
    text-align: {{ section.settings.title_alignment_mobile | default: section.settings.title_alignment }};
    padding-top: {{ section.settings.title_padding_top_mobile | default: 0 }}px;
    padding-bottom: {{ section.settings.title_padding_bottom_mobile | default: 0 }}px;
    padding-left: {{ section.settings.title_padding_left_mobile | default: 0 }}px;
    padding-right: {{ section.settings.title_padding_right_mobile | default: 0 }}px;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.15);
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__subtitle {
    font-family: {{ section.settings.subtitle_font.family }}, {{ section.settings.subtitle_font.fallback_families }};
    font-weight: {{ section.settings.subtitle_font.weight }};
    font-style: {{ section.settings.subtitle_font.style }};
    font-size: {{ section.settings.subtitle_size_mobile }}px;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
    text-align: {{ section.settings.subtitle_alignment_mobile | default: section.settings.subtitle_alignment }};
    padding-top: {{ section.settings.subtitle_padding_top_mobile | default: 0 }}px;
    padding-bottom: {{ section.settings.subtitle_padding_bottom_mobile | default: 0 }}px;
    padding-left: {{ section.settings.subtitle_padding_left_mobile | default: 0 }}px;
    padding-right: {{ section.settings.subtitle_padding_right_mobile | default: 0 }}px;
    line-height: 1.4;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.15);
  }

  @media (min-width: 768px) {
    #fr-about-hero-{{ section.id }} .fr-about-hero__title {
      font-size: {{ section.settings.title_size_desktop }}px;
      text-align: {{ section.settings.title_alignment }};
      padding-top: {{ section.settings.title_padding_top }}px;
      padding-bottom: {{ section.settings.title_padding_bottom }}px;
      padding-left: {{ section.settings.title_padding_left }}px;
      padding-right: {{ section.settings.title_padding_right }}px;
    }
    #fr-about-hero-{{ section.id }} .fr-about-hero__subtitle {
      font-size: {{ section.settings.subtitle_size_desktop }}px;
      text-align: {{ section.settings.subtitle_alignment }};
      padding-top: {{ section.settings.subtitle_padding_top }}px;
      padding-bottom: {{ section.settings.subtitle_padding_bottom }}px;
      padding-left: {{ section.settings.subtitle_padding_left }}px;
      padding-right: {{ section.settings.subtitle_padding_right }}px;
    }
  }

  /* Slider Dots & Arrows */
  #fr-about-hero-{{ section.id }} .fr-about-hero__dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.8);
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__dot.active {
    background: #ffffff;
    width: 28px;
    border-radius: 6px;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__arrow svg {
    width: 20px;
    height: 20px;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__arrow:hover {
    background: rgba(255, 255, 255, 0.9);
    color: #111111;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__arrow--prev {
    left: 20px;
  }

  #fr-about-hero-{{ section.id }} .fr-about-hero__arrow--next {
    right: 20px;
  }

  @media (max-width: 767px) {
    #fr-about-hero-{{ section.id }} .fr-about-hero__arrow {
      width: 34px;
      height: 34px;
    }
    #fr-about-hero-{{ section.id }} .fr-about-hero__arrow--prev {
      left: 10px;
    }
    #fr-about-hero-{{ section.id }} .fr-about-hero__arrow--next {
      right: 10px;
    }
  }
</style>

<script>
  (function() {
    function initAboutHeroSlider() {
      const section = document.getElementById('fr-about-hero-{{ section.id }}');
      if (!section) return;

      const slides = section.querySelectorAll('.fr-about-hero__slide');
      if (slides.length <= 1) return;

      const dotsContainer = section.querySelector('.fr-about-hero__dots');
      const prevBtn = section.querySelector('.fr-about-hero__arrow--prev');
      const nextBtn = section.querySelector('.fr-about-hero__arrow--next');
      const autoplay = {{ section.settings.enable_autoplay | json }};
      const duration = ({{ section.settings.slider_duration | default: 6 }} * 1000);
      
      let currentIndex = 0;
      let timer = null;

      // Render dots dynamically
      if (dotsContainer) {
        dotsContainer.innerHTML = '';
        slides.forEach((_, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'fr-about-hero__dot' + (idx === 0 ? ' active' : '');
          btn.setAttribute('aria-label', 'Go to slide ' + (idx + 1));
          btn.addEventListener('click', () => goToSlide(idx));
          dotsContainer.appendChild(btn);
        });
      }

      function goToSlide(index) {
        slides[currentIndex].classList.remove('active');
        const dots = dotsContainer ? dotsContainer.children : [];
        if (dots[currentIndex]) dots[currentIndex].classList.remove('active');

        currentIndex = (index + slides.length) % slides.length;

        slides[currentIndex].classList.add('active');
        if (dots[currentIndex]) dots[currentIndex].classList.add('active');

        resetTimer();
      }

      function nextSlide() {
        goToSlide(currentIndex + 1);
      }

      function prevSlide() {
        goToSlide(currentIndex - 1);
      }

      if (prevBtn) prevBtn.addEventListener('click', prevSlide);
      if (nextBtn) nextBtn.addEventListener('click', nextSlide);

      // Touch Swipe Support
      let touchStartX = 0;
      const wrapper = section.querySelector('.fr-about-hero__wrapper');
      if (wrapper) {
        wrapper.addEventListener('touchstart', (e) => {
          touchStartX = e.touches[0].clientX;
        }, { passive: true });

        wrapper.addEventListener('touchend', (e) => {
          const touchEndX = e.changedTouches[0].clientX;
          const diffX = touchStartX - touchEndX;
          if (Math.abs(diffX) > 40) {
            if (diffX > 0) nextSlide();
            else prevSlide();
          }
        }, { passive: true });
      }

      function startTimer() {
        if (autoplay && duration > 0) {
          timer = setInterval(nextSlide, duration);
        }
      }

      function resetTimer() {
        if (timer) clearInterval(timer);
        startTimer();
      }

      startTimer();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAboutHeroSlider);
    } else {
      initAboutHeroSlider();
    }
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initAboutHeroSlider();
      }
    });
  })();
</script>

