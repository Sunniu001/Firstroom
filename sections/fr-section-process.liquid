<section class="fr-process-section" id="fr-process-{{ section.id }}">
  <div class="fr-process__wrapper">
    
    {%- if section.settings.subheading != blank -%}
      <p class="fr-process__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="fr-process__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="fr-process__container">
      
      <!-- Desktop Horizontal Timeline -->
      <div class="fr-process__timeline-desktop fr-process__timeline-desktop--{{ section.settings.desktop_layout | default: 'alternating' }}">
        <div class="fr-process__horizontal-axis"></div>

        <div class="fr-process__steps-track" style="--total-steps: {{ section.blocks.size }};">
          {%- for block in section.blocks -%}
            {%- assign is_even = forloop.index | modulo: 2 -%}
            {%- assign pos = 'bottom' -%}
            {%- if section.settings.desktop_layout == 'alternating' -%}
              {%- if is_even == 0 -%}
                {%- assign pos = 'top' -%}
              {%- else -%}
                {%- assign pos = 'bottom' -%}
              {%- endif -%}
            {%- elsif section.settings.desktop_layout == 'top_only' -%}
              {%- assign pos = 'top' -%}
            {%- else -%}
              {%- assign pos = 'bottom' -%}
            {%- endif -%}

            {%- if block.settings.override_position != 'auto' and block.settings.override_position != blank -%}
              {%- assign pos = block.settings.override_position -%}
            {%- endif -%}

            <div class="fr-process__step-item fr-process__step-item--pos-{{ pos }}" {{ block.shopify_attributes }}>
              
              <!-- Content Slot TOP -->
              <div class="fr-process__slot fr-process__slot--top">
                {%- if pos == 'top' -%}
                  <div class="fr-process__card">
                    {%- if block.settings.number != blank -%}
                      <div class="fr-process__card-num">{{ block.settings.number }}</div>
                    {%- endif -%}
                    {%- if block.settings.title != blank -%}
                      <h3 class="fr-process__card-title">{{ block.settings.title }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="fr-process__card-text">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                  <div class="fr-process__stem fr-process__stem--top"></div>
                {%- endif -%}
              </div>

              <!-- Node Circle on Center Axis -->
              <div class="fr-process__node-center">
                <div class="fr-process__node-circle">
                  {%- if block.settings.icon != blank -%}
                    <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}" class="fr-process__node-icon" loading="lazy">
                  {%- elsif section.settings.show_number_in_node and block.settings.number != blank -%}
                    <span class="fr-process__node-number">{{ block.settings.number | remove: '.' }}</span>
                  {%- endif -%}
                </div>
              </div>

              <!-- Content Slot BOTTOM -->
              <div class="fr-process__slot fr-process__slot--bottom">
                {%- if pos == 'bottom' -%}
                  <div class="fr-process__stem fr-process__stem--bottom"></div>
                  <div class="fr-process__card">
                    {%- if block.settings.number != blank -%}
                      <div class="fr-process__card-num">{{ block.settings.number }}</div>
                    {%- endif -%}
                    {%- if block.settings.title != blank -%}
                      <h3 class="fr-process__card-title">{{ block.settings.title }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="fr-process__card-text">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

            </div>
          {%- endfor -%}
        </div>
      </div>

      <!-- Mobile Vertical Timeline -->
      <div class="fr-process__timeline-mobile">
        <div class="fr-process__vertical-axis"></div>
        <div class="fr-process__mobile-list">
          {%- for block in section.blocks -%}
            <div class="fr-process__mobile-item" {{ block.shopify_attributes }}>
              <div class="fr-process__mobile-node-col">
                <div class="fr-process__node-circle">
                  {%- if block.settings.icon != blank -%}
                    <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="{{ block.settings.title | escape }}" class="fr-process__node-icon" loading="lazy">
                  {%- elsif section.settings.show_number_in_node and block.settings.number != blank -%}
                    <span class="fr-process__node-number">{{ block.settings.number | remove: '.' }}</span>
                  {%- endif -%}
                </div>
              </div>
              <div class="fr-process__mobile-content-col">
                {%- if block.settings.number != blank -%}
                  <div class="fr-process__card-num">{{ block.settings.number }}</div>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="fr-process__card-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="fr-process__card-text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #fr-process-{{ section.id }} {
    width: 100%;
    background-color: {{ section.settings.section_bg | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: {{ section.settings.padding_left_mobile }}px;
    padding-right: {{ section.settings.padding_right_mobile }}px;
    box-sizing: border-box;
    font-family: inherit;
  }

  @media (min-width: 768px) {
    #fr-process-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }

  #fr-process-{{ section.id }} .fr-process__wrapper {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  #fr-process-{{ section.id }} .fr-process__subheading {
    font-size: {{ section.settings.subheading_size_mobile }}px;
    color: {{ section.settings.subheading_color }};
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    text-align: {{ section.settings.heading_align_mobile | default: section.settings.heading_align }};
    margin: 0 0 10px 0;
  }

  @media (min-width: 768px) {
    #fr-process-{{ section.id }} .fr-process__subheading {
      font-size: {{ section.settings.subheading_size }}px;
      text-align: {{ section.settings.heading_align }};
      margin-bottom: 14px;
    }
  }

  #fr-process-{{ section.id }} .fr-process__heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    color: {{ section.settings.heading_color }};
    font-weight: 400;
    line-height: 1.25;
    text-align: {{ section.settings.heading_align_mobile | default: section.settings.heading_align }};
    margin: 0 0 40px 0;
    letter-spacing: 0.01em;
  }

  @media (min-width: 768px) {
    #fr-process-{{ section.id }} .fr-process__heading {
      font-size: {{ section.settings.heading_size }}px;
      text-align: {{ section.settings.heading_align }};
      margin-bottom: 60px;
    }
  }

  /* --- Node Circle Styles --- */
  #fr-process-{{ section.id }} .fr-process__node-circle {
    width: {{ section.settings.node_size_mobile }}px;
    height: {{ section.settings.node_size_mobile }}px;
    border-radius: 50%;
    background-color: {{ section.settings.node_bg_color | default: '#c4c4c4' }};
    border: {{ section.settings.node_border_width }}px solid {{ section.settings.node_border_color | default: 'transparent' }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 3;
    transition: transform 0.3s ease, background-color 0.3s ease;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    #fr-process-{{ section.id }} .fr-process__node-circle {
      width: {{ section.settings.node_size_desktop }}px;
      height: {{ section.settings.node_size_desktop }}px;
    }
  }

  #fr-process-{{ section.id }} .fr-process__step-item:hover .fr-process__node-circle,
  #fr-process-{{ section.id }} .fr-process__mobile-item:hover .fr-process__node-circle {
    transform: scale(1.1);
    background-color: {{ section.settings.node_hover_bg | default: section.settings.node_bg_color }};
  }

  #fr-process-{{ section.id }} .fr-process__node-number {
    font-size: {{ section.settings.node_number_size }}px;
    font-weight: 600;
    color: {{ section.settings.node_number_color | default: '#ffffff' }};
  }

  #fr-process-{{ section.id }} .fr-process__node-icon {
    max-width: 60%;
    max-height: 60%;
    object-fit: contain;
  }

  /* --- Card Typography & Styling --- */
  #fr-process-{{ section.id }} .fr-process__card {
    text-align: {{ section.settings.card_text_align }};
    box-sizing: border-box;
    padding: 0 10px;
  }

  #fr-process-{{ section.id }} .fr-process__card-num {
    font-size: {{ section.settings.num_size }}px;
    font-weight: 600;
    color: {{ section.settings.num_color | default: '#888888' }};
    margin-bottom: 4px;
    letter-spacing: 0.05em;
  }

  #fr-process-{{ section.id }} .fr-process__card-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 500;
    color: {{ section.settings.title_color | default: '#1a1a1a' }};
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  #fr-process-{{ section.id }} .fr-process__card-text {
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.55;
    color: {{ section.settings.text_color | default: '#666666' }};
    margin: 0;
  }

  /* --- Desktop Timeline Layout --- */
  #fr-process-{{ section.id }} .fr-process__timeline-desktop {
    display: none;
    position: relative;
    width: 100%;
    padding: 40px 0;
  }

  @media (min-width: 768px) {
    #fr-process-{{ section.id }} .fr-process__timeline-desktop {
      display: block;
    }
    #fr-process-{{ section.id }} .fr-process__timeline-mobile {
      display: none;
    }
  }

  #fr-process-{{ section.id }} .fr-process__horizontal-axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: {{ section.settings.axis_line_width }}px;
    background-color: {{ section.settings.axis_line_color | default: '#dcdcdc' }};
    z-index: 1;
  }

  #fr-process-{{ section.id }} .fr-process__steps-track {
    display: grid;
    grid-template-columns: repeat(var(--total-steps, 5), 1fr);
    position: relative;
    z-index: 2;
    width: 100%;
  }

  #fr-process-{{ section.id }} .fr-process__step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  #fr-process-{{ section.id }} .fr-process__slot {
    width: 100%;
    min-height: {{ section.settings.slot_min_height }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  #fr-process-{{ section.id }} .fr-process__slot--top {
    justify-content: flex-end;
  }

  #fr-process-{{ section.id }} .fr-process__slot--bottom {
    justify-content: flex-start;
  }

  #fr-process-{{ section.id }} .fr-process__node-center {
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    padding: 6px 0;
  }

  #fr-process-{{ section.id }} .fr-process__stem {
    width: {{ section.settings.stem_line_width }}px;
    height: {{ section.settings.stem_line_length }}px;
    background-color: {{ section.settings.stem_line_color | default: '#dcdcdc' }};
    flex-shrink: 0;
  }

  #fr-process-{{ section.id }} .fr-process__stem--top {
    margin-top: 10px;
  }

  #fr-process-{{ section.id }} .fr-process__stem--bottom {
    margin-bottom: 10px;
  }

  /* --- Mobile Timeline Layout --- */
  #fr-process-{{ section.id }} .fr-process__timeline-mobile {
    position: relative;
    width: 100%;
    padding: 10px 0 10px 10px;
    box-sizing: border-box;
  }

  #fr-process-{{ section.id }} .fr-process__vertical-axis {
    position: absolute;
    left: calc(10px + ({{ section.settings.node_size_mobile }}px / 2) - ({{ section.settings.axis_line_width }}px / 2));
    top: 20px;
    bottom: 20px;
    width: {{ section.settings.axis_line_width }}px;
    background-color: {{ section.settings.axis_line_color | default: '#dcdcdc' }};
    z-index: 1;
  }

  #fr-process-{{ section.id }} .fr-process__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 36px;
    position: relative;
    z-index: 2;
  }

  #fr-process-{{ section.id }} .fr-process__mobile-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    position: relative;
  }

  #fr-process-{{ section.id }} .fr-process__mobile-node-col {
    position: relative;
    z-index: 3;
    background-color: {{ section.settings.section_bg | default: '#ffffff' }};
    padding: 4px 0;
    flex-shrink: 0;
  }

  #fr-process-{{ section.id }} .fr-process__mobile-content-col {
    flex: 1;
    padding-top: 4px;
    text-align: left;
  }

  #fr-process-{{ section.id }} .fr-process__mobile-content-col .fr-process__card-title {
    font-size: {{ section.settings.title_size_mobile }}px;
  }

  #fr-process-{{ section.id }} .fr-process__mobile-content-col .fr-process__card-text {
    font-size: {{ section.settings.text_size_mobile }}px;
  }
</style>

{% schema %}
{
  "name": "FR Process Timeline",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size (Desktop)",
      "default": 13
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size (Mobile)",
      "default": 11
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Our process."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
      "label": "Heading Alignment (Mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Timeline Controls"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop Layout Mode",
      "options": [
        { "value": "alternating", "label": "Alternating (Up / Down)" },
        { "value": "bottom_only", "label": "All Bottom" },
        { "value": "top_only", "label": "All Top" }
      ],
      "default": "alternating"
    },
    {
      "type": "select",
      "id": "card_text_align",
      "label": "Card Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "slot_min_height",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Desktop Slot Height",
      "default": 140
    },
    {
      "type": "color",
      "id": "axis_line_color",
      "label": "Timeline Axis Line Color",
      "default": "#dcdcdc"
    },
    {
      "type": "range",
      "id": "axis_line_width",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Timeline Axis Line Width",
      "default": 1
    },
    {
      "type": "header",
      "content": "Circle Nodes"
    },
    {
      "type": "range",
      "id": "node_size_desktop",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Node Size (Desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "node_size_mobile",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Node Size (Mobile)",
      "default": 40
    },
    {
      "type": "color",
      "id": "node_bg_color",
      "label": "Node Background Color",
      "default": "#c4c4c4"
    },
    {
      "type": "color",
      "id": "node_hover_bg",
      "label": "Node Hover Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "node_border_width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Node Border Width",
      "default": 0
    },
    {
      "type": "color",
      "id": "node_border_color",
      "label": "Node Border Color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "checkbox",
      "id": "show_number_in_node",
      "label": "Show Number Inside Node Circle",
      "default": false
    },
    {
      "type": "color",
      "id": "node_number_color",
      "label": "Node Inner Number Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "node_number_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Node Inner Number Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Stem Connector Lines"
    },
    {
      "type": "color",
      "id": "stem_line_color",
      "label": "Connector Stem Line Color",
      "default": "#dcdcdc"
    },
    {
      "type": "range",
      "id": "stem_line_length",
      "min": 15,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Connector Stem Length",
      "default": 40
    },
    {
      "type": "range",
      "id": "stem_line_width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Connector Stem Width",
      "default": 1
    },
    {
      "type": "header",
      "content": "Step Content Typography"
    },
    {
      "type": "color",
      "id": "num_color",
      "label": "Step Number Color",
      "default": "#888888"
    },
    {
      "type": "range",
      "id": "num_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Step Number Size",
      "default": 13
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Step Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 13,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Step Title Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Step Title Size (Mobile)",
      "default": 15
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Step Text Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Step Text Size (Desktop)",
      "default": 13
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Step Text Size (Mobile)",
      "default": 13
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Left (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Right (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 16,
      "max": 120,
      "step": 4,
