<!-- fr-about-image-text -->
<section class="fr-about-imgtext" id="fr-about-imgtext-{{ section.id }}" style="background-color: {{ section.settings.section_bg }};">
  <div class="fr-about-imgtext__wrapper" style="
      --pt-d: {{ section.settings.padding_top }}px;
      --pb-d: {{ section.settings.padding_bottom }}px;
      --pl-d: {{ section.settings.padding_left }}px;
      --pr-d: {{ section.settings.padding_right }}px;
      --pt-m: {{ section.settings.padding_top_mobile | default: section.settings.padding_top }}px;
      --pb-m: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom }}px;
      --pl-m: {{ section.settings.padding_left_mobile | default: 20 }}px;
      --pr-m: {{ section.settings.padding_right_mobile | default: 20 }}px;
      --img-mw-d: {{ section.settings.image_max_width }}px;
      --img-mw-m: {{ section.settings.image_max_width_mobile | default: section.settings.image_max_width }}px;
      --gap-d: {{ section.settings.grid_gap }}px;
      --gap-m: {{ section.settings.grid_gap_mobile | default: section.settings.grid_gap }}px;
      --ia-d: {{ section.settings.image_align }};
      --ia-m: {{ section.settings.image_align_mobile | default: section.settings.image_align }};
      --ta-d: {{ section.settings.text_align }};
      --ta-m: {{ section.settings.text_align_mobile | default: section.settings.text_align }};
      --fz-sh-d: {{ section.settings.subheading_size }}px;
      --fz-sh-m: {{ section.settings.subheading_size_mobile | default: section.settings.subheading_size }}px;
      --fz-h-d: {{ section.settings.heading_size }}px;
      --fz-h-m: {{ section.settings.heading_size_mobile | default: section.settings.heading_size }}px;
      --fz-t-d: {{ section.settings.text_size }}px;
      --fz-t-m: {{ section.settings.text_size_mobile | default: section.settings.text_size }}px;
    ">
    
    <div class="fr-about-imgtext__grid fr-about-imgtext__grid--image-{{ section.settings.image_position }}" style="align-items: {{ section.settings.vertical_alignment }};">
      
      <!-- Image Column -->
      <div class="fr-about-imgtext__col-image">
        <div class="fr-about-imgtext__image-wrapper" style="{% if section.settings.aspect_ratio != 'auto' %}aspect-ratio: {{ section.settings.aspect_ratio }};{% endif %} border-radius: {{ section.settings.image_radius }}px;">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" class="fr-about-imgtext__image" style="{% if section.settings.aspect_ratio != 'auto' %}object-fit: cover; width: 100%; height: 100%;{% else %}width: 100%; height: auto;{% endif %}">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'fr-about-imgtext__placeholder' }}
          {%- endif -%}
        </div>
      </div>

      <!-- Text Column -->
      <div class="fr-about-imgtext__col-text">
        {%- if section.settings.subheading != blank -%}
          <p class="fr-about-imgtext__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="fr-about-imgtext__heading" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.body_text != blank -%}
          <div class="fr-about-imgtext__body" style="color: {{ section.settings.text_color }};">
            {{ section.settings.body_text }}
          </div>
        {%- endif -%}
        
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="fr-about-imgtext__button" style="background-color: {{ section.settings.button_bg }}; color: {{ section.settings.button_text }};">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>
</section>

<style>
  #fr-about-imgtext-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.7;
    width: 100%;
  }

  #fr-about-imgtext-{{ section.id }} .fr-about-imgtext__wrapper {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    padding-left: var(--pl-m);
    padding-right: var(--pr-m);
  }
  @media (min-width: 768px) {
    #fr-about-imgtext-{{ section.id }} .fr-about-imgtext__wrapper {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
      padding-left: var(--pl-d);
      padding-right: var(--pr-d);
    }
  }

  {% assign ratio_parts = section.settings.column_ratio | split: '|' %}
  {% assign col_image = ratio_parts[0] | default: '1fr' %}
  {% assign col_text = ratio_parts[1] | default: '1fr' %}

  #fr-about-imgtext-{{ section.id }} .fr-about-imgtext__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-m);
  }

  @media (min-width: 768px) {
    #fr-about-imgtext-{{ section.id }} .fr-about-imgtext__grid {
      grid-template-columns: {{ col_image }} {{ col_text }};
      gap: var(--gap-d);
    }
    #fr-about-imgtext-{{ section.id }} .fr-about-imgtext__grid--image-right {
      grid-template-columns: {{ col_text }} {{ col_image }};
    }
    #fr-about-imgtext-{{ section.id }} .fr-about-imgtext__grid--image-right .fr-about-imgtext__col-image {
      order: 2;
    }
    #fr-about-imgtext-{{ section.id }} .fr-about-imgtext__grid--image-right .fr-about-imgtext__col-text {
      order: 1;
    }
  }

  .fr-about-imgtext__col-image {
    width: 100%;
  }

  .fr-about-imgtext__image-wrapper {
    position: relative;
    overflow: hidden;
    background-color: #faf8f5;
    max-width: var(--img-mw-m);
    margin: 0 var(--ia-m);
  }
  @media (min-width: 768px) {
    .fr-about-imgtext__image-wrapper {
      max-width: var(--img-mw-d);
      margin: 0 var(--ia-d);
    }
  }

  .fr-about-imgtext__image {
    display: block;
  }

  .fr-about-imgtext__placeholder {
    width: 100%;
    height: 100%;
    background-color: #faf8f5;
    color: #cccccc;
    display: block;
  }

  .fr-about-imgtext__col-text {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: var(--ta-m);
  }
  @media (min-width: 768px) {
    .fr-about-imgtext__col-text {
      text-align: var(--ta-d);
    }
  }

  .fr-about-imgtext__subheading {
    font-family: 'Lato', system-ui, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #1a1a1a;
    margin: 0 0 16px 0;
    font-size: var(--fz-sh-m);
  }

  .fr-about-imgtext__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin: 0 0 24px 0;
    line-height: 1.15;
    letter-spacing: 0.01em;
    font-size: var(--fz-h-m);
  }

  .fr-about-imgtext__body {
    margin: 0 0 32px 0;
    font-size: var(--fz-t-m);
  }

  @media (min-width: 768px) {
    .fr-about-imgtext__subheading { font-size: var(--fz-sh-d); }
    .fr-about-imgtext__heading { font-size: var(--fz-h-d); }
    .fr-about-imgtext__body { font-size: var(--fz-t-d); }
  }

  .fr-about-imgtext__body p {
    margin: 0 0 16px 0;
  }
  .fr-about-imgtext__body p:last-child {
    margin-bottom: 0;
  }

  .fr-about-imgtext__button {
    display: inline-block;
    padding: 12px 32px;
    margin-top: 24px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: 4px;
    transition: opacity 0.2s ease;
    align-self: flex-start;
  }

  .fr-about-imgtext__button:hover {
    opacity: 0.9;
  }
</style>

{% schema %}
{
  "name": "FR About Image & Text",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 1400
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "column_ratio",
      "label": "Desktop Column Ratio (Image : Text)",
      "options": [
        { "value": "1fr|1fr", "label": "50% : 50% (Equal)" },
        { "value": "2fr|3fr", "label": "40% : 60%" },
        { "value": "3fr|2fr", "label": "60% : 40%" },
        { "value": "1fr|2fr", "label": "33% : 67%" },
        { "value": "2fr|1fr", "label": "67% : 33%" },
        { "value": "auto|1fr", "label": "Hug Image : Fill Text" }
      ],
      "default": "1fr|1fr"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical Alignment",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap between Image and Text (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap between Image and Text (Mobile)",
      "default": 40
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "auto", "label": "Original (Adapt to image)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "16 / 9", "label": "Landscape (16:9)" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Desktop Image Max Width",
      "default": 800
    },
    {
      "type": "range",
      "id": "image_max_width_mobile",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Mobile Image Max Width",
      "default": 800
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_align",
      "label": "Desktop Image Horizontal Align",
      "options": [
        { "value": "0 auto 0 0", "label": "Left" },
        { "value": "0 auto", "label": "Center" },
        { "value": "0 0 0 auto", "label": "Right" }
      ],
      "default": "0 auto"
    },
    {
      "type": "select",
      "id": "image_align_mobile",
      "label": "Mobile Image Horizontal Align",
      "options": [
        { "value": "0 auto 0 0", "label": "Left" },
        { "value": "0 auto", "label": "Center" },
        { "value": "0 0 0 auto", "label": "Right" }
      ],
      "default": "0 auto"
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "SUBHEADING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Desktop Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Mobile Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Desktop Subheading Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile Subheading Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop Heading Size",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile Heading Size",
      "default": 28
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Desktop Body Text Size",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile Body Text Size",
      "default": 14
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4a4a4a"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Left",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Right",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "FR About Image & Text"
    }
  ]
}
{% endschema %}
