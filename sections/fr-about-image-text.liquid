<section class="fr-about-imgtext" id="fr-about-imgtext-{{ section.id }}" style="background-color: {{ section.settings.section_bg }};">
  <div class="fr-about-imgtext__wrapper" style="
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    ">
    
    <div class="fr-about-imgtext__grid fr-about-imgtext__grid--image-{{ section.settings.image_position }}" style="gap: {{ section.settings.grid_gap }}px; align-items: {{ section.settings.vertical_alignment }};">
      
      <!-- Image Column -->
      <div class="fr-about-imgtext__col-image">
        <div class="fr-about-imgtext__image-wrapper" style="{% if section.settings.aspect_ratio != 'auto' %}aspect-ratio: {{ section.settings.aspect_ratio }};{% endif %} border-radius: {{ section.settings.image_radius }}px; max-width: {{ section.settings.image_max_width }}px; margin: 0 {{ section.settings.image_align }};">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" class="fr-about-imgtext__image" style="{% if section.settings.aspect_ratio != 'auto' %}object-fit: cover; width: 100%; height: 100%;{% else %}width: 100%; height: auto;{% endif %}">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'fr-about-imgtext__placeholder' }}
          {%- endif -%}
        </div>
      </div>

      <!-- Text Column -->
      <div class="fr-about-imgtext__col-text" style="text-align: {{ section.settings.text_align }};">
        {%- if section.settings.subheading != blank -%}
          <p class="fr-about-imgtext__subheading" style="font-size: {{ section.settings.subheading_size }}px;">{{ section.settings.subheading }}</p>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="fr-about-imgtext__heading" style="font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.body_text != blank -%}
          <div class="fr-about-imgtext__body" style="font-size: {{ section.settings.text_size }}px; color: {{ section.settings.text_color }};">
            {{ section.settings.body_text }}
          </div>
        {%- endif -%}
        
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="fr-about-imgtext__button" style="background-color: {{ section.settings.button_bg }}; color: {{ section.settings.button_text }};">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>
</section>

<style>
  #fr-about-imgtext-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.7;
    width: 100%;
  }

  .fr-about-imgtext__wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  .fr-about-imgtext__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .fr-about-imgtext__grid {
      grid-template-columns: 1fr 1fr;
    }
    .fr-about-imgtext__grid--image-right .fr-about-imgtext__col-image {
      order: 2;
    }
    .fr-about-imgtext__grid--image-right .fr-about-imgtext__col-text {
      order: 1;
    }
  }

  .fr-about-imgtext__col-image {
    width: 100%;
  }

  .fr-about-imgtext__image-wrapper {
    position: relative;
    overflow: hidden;
    background-color: #faf8f5;
  }

  .fr-about-imgtext__image {
    display: block;
  }

  .fr-about-imgtext__placeholder {
    width: 100%;
    height: 100%;
    background-color: #faf8f5;
    color: #cccccc;
    display: block;
  }

  .fr-about-imgtext__col-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .fr-about-imgtext__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 20px;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }

  .fr-about-imgtext__subheading {
    font-family: 'Lato', system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 12px;
    color: #1a1a1a;
  }

  .fr-about-imgtext__body {
    line-height: 1.75;
  }

  .fr-about-imgtext__body p {
    margin: 0 0 16px 0;
  }
  .fr-about-imgtext__body p:last-child {
    margin-bottom: 0;
  }

  .fr-about-imgtext__button {
    display: inline-block;
    padding: 12px 32px;
    margin-top: 24px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: 4px;
    transition: opacity 0.2s ease;
    align-self: flex-start;
  }

  .fr-about-imgtext__button:hover {
    opacity: 0.9;
  }
</style>

{% schema %}
{
  "name": "FR About Image & Text",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical Alignment",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap between Image and Text",
      "default": 60
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "auto", "label": "Original (Adapt to image)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "16 / 9", "label": "Landscape (16:9)" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Image Max Width",
      "default": 800
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_align",
      "label": "Image Horizontal Align",
      "options": [
        { "value": "0 auto 0 0", "label": "Left" },
        { "value": "0 auto", "label": "Center" },
        { "value": "0 0 0 auto", "label": "Right" }
      ],
      "default": "0 auto"
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "SUBHEADING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body Text Size",
      "default": 15
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4a4a4a"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "FR About Image & Text"
    }
  ]
}
{% endschema %}
