{%- comment -%}
  FR Custom Projects Section (2-Tier Grid matching Image 3)
  Row 1: 2 large featured cards (Asymmetric Wide + Medium)
  Row 2: 4 equal grid cards
  Each card features a bottom-left white label badge
{%- endcomment -%}

<section id="fr-custom-projects-{{ section.id }}" class="fr-custom-projects" style="
  background-color: {{ section.settings.bg_color | default: '#ffffff' }};
  --pt-m: {{ section.settings.padding_top_mobile | default: section.settings.padding_top | default: 40 }}px;
  --pb-m: {{ section.settings.padding_bottom_mobile | default: section.settings.padding_bottom | default: 40 }}px;
  --pt-d: {{ section.settings.padding_top | default: 60 }}px;
  --pb-d: {{ section.settings.padding_bottom | default: 80 }}px;
  padding-left: {{ section.settings.padding_left | default: 24 }}px;
  padding-right: {{ section.settings.padding_right | default: 24 }}px;
">
  <div class="fr-custom-projects__container" style="max-width: {{ section.settings.container_max_width | default: 1300 }}px;">
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-custom-projects__heading" style="
        font-size: {{ section.settings.heading_size | default: 36 }}px;
        color: {{ section.settings.heading_color | default: '#1a1a1a' }};
        --ha-m: {{ section.settings.heading_align_mobile | default: section.settings.heading_alignment | default: 'center' }};
        --ha-d: {{ section.settings.heading_alignment | default: 'center' }};
      ">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="fr-custom-projects__wrapper" style="gap: {{ section.settings.gap | default: 24 }}px;">
      
      {%- comment -%} --- ROW 1: 2 Featured Cards (Wide + Medium) --- {%- endcomment -%}
      {%- assign row1_blocks = section.blocks | slice: 0, 2 -%}
      {%- if row1_blocks.size > 0 -%}
        <div class="fr-custom-projects__row1" style="gap: {{ section.settings.gap | default: 24 }}px;">
          {%- for block in row1_blocks -%}
            {%- assign is_first = forloop.first -%}
            <div class="fr-custom-projects__card fr-custom-projects__card--row1 {% if is_first %}fr-custom-projects__card--wide{% else %}fr-custom-projects__card--medium{% endif %}" 
                 {{ block.shopify_attributes }}>
              <div class="fr-custom-projects__card-inner" style="
                border-radius: {{ section.settings.card_border_radius | default: 0 }}px;
                {%- if block.settings.aspect_ratio_override != blank and block.settings.aspect_ratio_override > 0 -%}
                  padding-bottom: {{ block.settings.aspect_ratio_override }}%;
                {%- else -%}
                  height: {{ section.settings.row1_height | default: 460 }}px;
                {%- endif -%}
              ">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.title | default: 'Project' | escape }}" loading="lazy" class="fr-custom-projects__image">
                {%- else -%}
                  <div class="fr-custom-projects__placeholder"></div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <div class="fr-custom-projects__badge" style="
                    background-color: {{ section.settings.badge_bg | default: '#ffffff' }};
                    color: {{ section.settings.badge_color | default: '#1a1a1a' }};
                    border-radius: {{ section.settings.badge_radius | default: 0 }}px;
                  ">
                    <span class="fr-custom-projects__badge-title">{{ block.settings.title }}</span>
                    {%- if block.settings.subtitle != blank -%}
                      <span class="fr-custom-projects__badge-sub">{{ block.settings.subtitle }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="fr-custom-projects__link" aria-label="{{ block.settings.title | escape }}"></a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} --- ROW 2: 4 Grid Cards --- {%- endcomment -%}
      {%- assign row2_blocks = section.blocks | slice: 2, 4 -%}
      {%- if row2_blocks.size > 0 -%}
        <div class="fr-custom-projects__row2" style="
          --cols-m: {{ section.settings.row2_cols_mobile | default: 2 }};
          gap: {{ section.settings.gap | default: 24 }}px;
        ">
          {%- for block in row2_blocks -%}
            <div class="fr-custom-projects__card fr-custom-projects__card--row2" {{ block.shopify_attributes }}>
              <div class="fr-custom-projects__card-inner" style="
                border-radius: {{ section.settings.card_border_radius | default: 0 }}px;
                padding-bottom: {{ block.settings.aspect_ratio_override | default: section.settings.row2_aspect_ratio | default: 110 }}%;
              ">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | default: 'Project' | escape }}" loading="lazy" class="fr-custom-projects__image">
                {%- else -%}
                  <div class="fr-custom-projects__placeholder"></div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <div class="fr-custom-projects__badge" style="
                    background-color: {{ section.settings.badge_bg | default: '#ffffff' }};
                    color: {{ section.settings.badge_color | default: '#1a1a1a' }};
                    border-radius: {{ section.settings.badge_radius | default: 0 }}px;
                  ">
                    <span class="fr-custom-projects__badge-title">{{ block.settings.title }}</span>
                    {%- if block.settings.subtitle != blank -%}
                      <span class="fr-custom-projects__badge-sub">{{ block.settings.subtitle }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="fr-custom-projects__link" aria-label="{{ block.settings.title | escape }}"></a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} --- ANY EXTRA BLOCKS (Beyond 6) --- {%- endcomment -%}
      {%- assign extra_blocks = section.blocks | slice: 6, 20 -%}
      {%- if extra_blocks.size > 0 -%}
        <div class="fr-custom-projects__row2" style="
          --cols-m: {{ section.settings.row2_cols_mobile | default: 2 }};
          gap: {{ section.settings.gap | default: 24 }}px;
        ">
          {%- for block in extra_blocks -%}
            <div class="fr-custom-projects__card fr-custom-projects__card--row2" {{ block.shopify_attributes }}>
              <div class="fr-custom-projects__card-inner" style="
                border-radius: {{ section.settings.card_border_radius | default: 0 }}px;
                padding-bottom: {{ block.settings.aspect_ratio_override | default: section.settings.row2_aspect_ratio | default: 110 }}%;
              ">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | default: 'Project' | escape }}" loading="lazy" class="fr-custom-projects__image">
                {%- else -%}
                  <div class="fr-custom-projects__placeholder"></div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <div class="fr-custom-projects__badge" style="
                    background-color: {{ section.settings.badge_bg | default: '#ffffff' }};
                    color: {{ section.settings.badge_color | default: '#1a1a1a' }};
                    border-radius: {{ section.settings.badge_radius | default: 0 }}px;
                  ">
                    <span class="fr-custom-projects__badge-title">{{ block.settings.title }}</span>
                  </div>
                {%- endif -%}

                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="fr-custom-projects__link" aria-label="{{ block.settings.title | escape }}"></a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

<style>
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.badge_font | font_face: font_display: 'swap' }}

  #fr-custom-projects-{{ section.id }} {
    width: 100%;
    box-sizing: border-box;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
  }

  @media (min-width: 768px) {
    #fr-custom-projects-{{ section.id }} {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
    }
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__container {
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__heading {
    display: block;
    width: 100%;
    margin: 0 0 {{ section.settings.heading_margin_bottom | default: 50 }}px 0;
    font-family: {{ section.settings.heading_font.family | default: "'Playfair Display'" }}, {{ section.settings.heading_font.fallback_families | default: 'serif' }};
    font-weight: {{ section.settings.heading_font.weight | default: 400 }};
    font-style: {{ section.settings.heading_font.style | default: 'normal' }};
    text-align: var(--ha-m);
    line-height: 1.25;
  }

  @media (min-width: 768px) {
    #fr-custom-projects-{{ section.id }} .fr-custom-projects__heading {
      text-align: var(--ha-d);
    }
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    box-sizing: border-box;
  }

  /* --- ROW 1 (Desktop: 2 cards, 60:40 or 58:42 ratio) --- */
  #fr-custom-projects-{{ section.id }} .fr-custom-projects__row1 {
    display: flex;
    flex-direction: column;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 860px) {
    #fr-custom-projects-{{ section.id }} .fr-custom-projects__row1 {
      flex-direction: row;
      align-items: stretch;
    }
    #fr-custom-projects-{{ section.id }} .fr-custom-projects__card--wide {
      flex: 1.45 1 0;
    }
    #fr-custom-projects-{{ section.id }} .fr-custom-projects__card--medium {
      flex: 1 1 0;
    }
  }

  /* --- ROW 2 (Desktop: 4 equal cards, Tablet/Mobile: 2x2 grid) --- */
  #fr-custom-projects-{{ section.id }} .fr-custom-projects__row2 {
    display: grid;
    grid-template-columns: repeat(var(--cols-m, 2), 1fr);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 860px) {
    #fr-custom-projects-{{ section.id }} .fr-custom-projects__row2 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__card {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__card-inner {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f0f0f0;
    box-sizing: border-box;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__card:hover .fr-custom-projects__image {
    transform: scale(1.04);
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #e5e5e5;
  }

  /* --- Bottom-Left Badge --- */
  #fr-custom-projects-{{ section.id }} .fr-custom-projects__badge {
    position: absolute;
    bottom: 16px;
    left: 16px;
    z-index: 2;
    padding: 10px 18px;
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    pointer-events: none;
    box-sizing: border-box;
    transition: transform 0.3s ease;
  }

  @media (min-width: 768px) {
    #fr-custom-projects-{{ section.id }} .fr-custom-projects__badge {
      bottom: 22px;
      left: 22px;
      padding: 12px 22px;
    }
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__card:hover .fr-custom-projects__badge {
    transform: translateY(-2px);
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__badge-title {
    font-family: {{ section.settings.badge_font.family | default: "'Lato'" }}, {{ section.settings.badge_font.fallback_families | default: 'sans-serif' }};
    font-weight: {{ section.settings.badge_font.weight | default: 600 }};
    font-style: {{ section.settings.badge_font.style | default: 'normal' }};
    font-size: {{ section.settings.badge_font_size | default: 13 }}px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__badge-sub {
    font-size: 11px;
    opacity: 0.75;
    line-height: 1.2;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
  }
</style>

{% schema %}
{
  "name": "FR Custom Projects",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Projects."
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1300
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "playfair_display_n5"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
      "label": "Heading Alignment (Mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Margin Bottom",
      "default": 50
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "row1_height",
      "min": 250,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Top Row Height (Desktop)",
      "default": 460
    },
    {
      "type": "range",
      "id": "row2_aspect_ratio",
      "min": 60,
      "max": 180,
      "step": 5,
      "unit": "%",
      "label": "Bottom Row Aspect Ratio",
      "info": "100% is square, 115% is standard rectangle, 130% is portrait.",
      "default": 115
    },
    {
      "type": "range",
      "id": "row2_cols_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Bottom Row Columns (Mobile)",
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Badge / Label Settings"
    },
    {
      "type": "font_picker",
      "id": "badge_font",
      "label": "Badge Font",
      "default": "lato_n6"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Badge Font Size",
      "default": 13
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "badge_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Badge Border Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Project Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Project Title",
          "default": "Project Name"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle (Optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Project Link (Optional)"
        },
        {
          "type": "range",
          "id": "aspect_ratio_override",
          "min": 0,
          "max": 200,
          "step": 5,
          "unit": "%",
          "label": "Custom Aspect Ratio (0 for default)",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Custom Projects",
      "blocks": [
        { "type": "project", "settings": { "title": "Project Name 1" } },
        { "type": "project", "settings": { "title": "Project Name 2" } },
        { "type": "project", "settings": { "title": "Project Name 3" } },
        { "type": "project", "settings": { "title": "Project Name 4" } },
        { "type": "project", "settings": { "title": "Project Name 5" } },
        { "type": "project", "settings": { "title": "Project Name 6" } }
      ]
    }
  ]
}
{% endschema %}
