{%- comment -%}
  FR Custom Projects Section (Advanced Staggered Grid)
{%- endcomment -%}

<section id="fr-custom-projects-{{ section.id }}" class="fr-custom-projects" style="
  background-color: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  padding-left: {{ section.settings.padding_left }}px;
  padding-right: {{ section.settings.padding_right }}px;
">
  <div class="fr-custom-projects__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-custom-projects__heading" style="
        font-size: {{ section.settings.heading_size }}px;
        color: {{ section.settings.heading_color }};
      ">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="fr-custom-projects__grid" style="
      gap: {{ section.settings.grid_gap }}px;
      max-width: {{ section.settings.grid_max_width }}px;
    ">
      {%- for block in section.blocks -%}
        <div class="fr-custom-projects__item fr-custom-projects__item--text-{{ block.settings.text_position }}" 
             {{ block.shopify_attributes }}
             style="grid-column: {{ block.settings.column_start }}; transform: translateY({{ block.settings.offset_y }}px); {%- if block.settings.is_invisible -%}opacity: 0; pointer-events: none;{%- endif -%}">
             
          <div class="fr-custom-projects__image-wrapper" style="padding-bottom: {{ block.settings.aspect_ratio }}%;">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="fr-custom-projects__image">
            {%- else -%}
              <div class="fr-custom-projects__placeholder"></div>
            {%- endif -%}
          </div>

          {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
            <div class="fr-custom-projects__content">
              {%- if block.settings.title != blank -%}
                <h3 class="fr-custom-projects__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="fr-custom-projects__subtitle">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #fr-custom-projects-{{ section.id }} .fr-custom-projects__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px; /* Extra padding so absolutely positioned text doesn't hit screen edge */
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__heading {
    margin: 0 0 60px 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 500;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    margin: 0 auto;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__item {
    position: relative;
    width: 100%;
    /* No margin bottom, we rely on grid gap */
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__image-wrapper {
    position: relative;
    width: 100%;
    background-color: #e0e0e0;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #e0e0e0;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__title {
    margin: 0 0 4px 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
    color: #1a1a1a;
  }

  #fr-custom-projects-{{ section.id }} .fr-custom-projects__subtitle {
    margin: 0;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 14px;
    color: #666;
  }

  /* Text Positioning */
  #fr-custom-projects-{{ section.id }} .fr-custom-projects__item--text-bottom .fr-custom-projects__content {
    margin-top: 16px;
    text-align: center;
  }

  @media (min-width: 768px) {
    #fr-custom-projects-{{ section.id }} .fr-custom-projects__item--text-left .fr-custom-projects__content {
      position: absolute;
      right: calc(100% + 20px);
      bottom: 20px;
      width: max-content;
      max-width: 250px;
      text-align: right;
      z-index: 2;
    }

    #fr-custom-projects-{{ section.id }} .fr-custom-projects__item--text-right .fr-custom-projects__content {
      position: absolute;
      left: calc(100% + 20px);
      bottom: 20px;
      width: max-content;
      max-width: 250px;
      text-align: left;
      z-index: 2;
    }
  }

  @media (max-width: 767px) {
    #fr-custom-projects-{{ section.id }} .fr-custom-projects__grid {
      grid-template-columns: 1fr;
    }
    #fr-custom-projects-{{ section.id }} .fr-custom-projects__item {
      grid-column: 1 !important;
      transform: none !important;
    }
    #fr-custom-projects-{{ section.id }} .fr-custom-projects__content {
      position: static !important;
      transform: none !important;
      width: 100% !important;
      padding: 16px 0 0 0 !important;
      text-align: center !important;
    }
  }
</style>

{% schema %}
{
  "name": "FR Custom Projects",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Projects."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_max_width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Grid Max Width (Desktop)",
      "default": 900
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Grid Gap",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Project Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Project Name"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Description"
        },
        {
          "type": "header",
          "content": "Advanced Layout"
        },
        {
          "type": "range",
          "id": "column_start",
          "min": 1,
          "max": 4,
          "step": 1,
          "label": "Grid Column (1 to 4)",
          "default": 1
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text Position (Desktop)",
          "options": [
            { "value": "left", "label": "Left of Image" },
            { "value": "bottom", "label": "Below Image" },
            { "value": "right", "label": "Right of Image" }
          ],
          "default": "bottom"
        },
        {
          "type": "range",
          "id": "offset_y",
          "min": -200,
          "max": 200,
          "step": 5,
          "unit": "px",
          "label": "Vertical Offset",
          "info": "Push this individual image up or down to create a staggered grid effect.",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "is_invisible",
          "label": "Make this project an invisible spacer",
          "default": false
        },
        {
          "type": "range",
          "id": "aspect_ratio",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "%",
          "label": "Image Height (Aspect Ratio)",
          "info": "100% is square, 150% is tall, 75% is wide.",
          "default": 130
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Custom Projects",
      "blocks": [
        { "type": "project", "settings": { "column_start": 2, "text_position": "left" } },
        { "type": "project", "settings": { "column_start": 3, "text_position": "right" } },
        { "type": "project", "settings": { "column_start": 1, "text_position": "left" } },
        { "type": "project", "settings": { "column_start": 2, "text_position": "bottom" } },
        { "type": "project", "settings": { "column_start": 3, "text_position": "right" } }
      ]
    }
  ]
}
{% endschema %}
