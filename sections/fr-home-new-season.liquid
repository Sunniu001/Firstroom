<section class="fr-new-season-section" id="fr-new-season-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="fr-new-season__wrapper" style="
      --pt-d: {{ section.settings.padding_top }}px;
      --pb-d: {{ section.settings.padding_bottom }}px;
      --pl-d: {{ section.settings.padding_left }}px;
      --pr-d: {{ section.settings.padding_right }}px;
      --pt-m: {{ section.settings.padding_top_mobile }}px;
      --pb-m: {{ section.settings.padding_bottom_mobile }}px;
      --pl-m: {{ section.settings.padding_left_mobile }}px;
      --pr-m: {{ section.settings.padding_right_mobile }}px;
      --max-w: {{ section.settings.content_max_width }}px;
    ">
    <div class="fr-new-season__inner">
      
      <!-- Left Column: Content -->
      <div class="fr-new-season__content" style="
          --content-align: {{ section.settings.content_align }};
        ">
        {%- if section.settings.badge_text != blank -%}
          <div class="fr-new-season__badge" style="
              background-color: {{ section.settings.badge_bg }};
              color: {{ section.settings.badge_color }};
              --fz-badge-d: {{ section.settings.badge_size }}px;
              --fz-badge-m: {{ section.settings.badge_size_mobile }}px;
            ">
            {{ section.settings.badge_text }}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="fr-new-season__heading" style="
              color: {{ section.settings.heading_color }};
              --fz-h-d: {{ section.settings.heading_size }}px;
              --fz-h-m: {{ section.settings.heading_size_mobile }}px;
            ">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="fr-new-season__desc" style="
              color: {{ section.settings.description_color }};
              --fz-desc-d: {{ section.settings.description_size }}px;
              --fz-desc-m: {{ section.settings.description_size_mobile }}px;
            ">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="fr-new-season__cta-wrap">
            <a href="{{ section.settings.button_link | default: '#' }}" class="fr-new-season__btn" style="
                background-color: {{ section.settings.btn_bg }};
                color: {{ section.settings.btn_color }};
                border: 1px solid {{ section.settings.btn_border_color | default: section.settings.btn_bg }};
                --btn-radius: {{ section.settings.btn_radius }}px;
                --btn-fz: {{ section.settings.btn_size }}px;
              ">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>

      <!-- Right Column: Vertical Cards Gallery -->
      <div class="fr-new-season__gallery-container">
        <div class="fr-new-season__gallery" style="
            --gap-d: {{ section.settings.cards_gap }}px;
            --gap-m: {{ section.settings.cards_gap_mobile }}px;
            --card-radius: {{ section.settings.card_border_radius }}px;
            --card-ar: {{ section.settings.card_aspect_ratio }};
            --card-min-h: {{ section.settings.card_custom_height }}px;
          ">
          {%- for block in section.blocks -%}
            <div class="fr-new-season__card-col" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: '#' }}" class="fr-new-season__card">
                <div class="fr-new-season__image-box">
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 700 }}"
                      alt="{{ block.settings.title | default: section.settings.heading | escape }}"
                      loading="lazy"
                      class="fr-new-season__img"
                    >
                  {%- else -%}
                    <div class="fr-new-season__placeholder">
                      <div class="fr-new-season__placeholder-inner">
                        <svg viewBox="0 0 100 100" class="fr-new-season__ph-icon" fill="none" stroke="#bbb" stroke-width="2">
                          <rect width="80" height="80" x="10" y="10" rx="4"></rect>
                          <circle cx="35" cy="35" r="10"></circle>
                          <polyline points="15 75 40 50 65 75"></polyline>
                          <polyline points="55 65 70 50 85 65"></polyline>
                        </svg>
                        <span>Card {{ forloop.index }}</span>
                      </div>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                    <div class="fr-new-season__card-overlay">
                      {%- if block.settings.subtitle != blank -%}
                        <span class="fr-new-season__card-sub">{{ block.settings.subtitle }}</span>
                      {%- endif -%}
                      {%- if block.settings.title != blank -%}
                        <h3 class="fr-new-season__card-title">{{ block.settings.title }}</h3>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #fr-new-season-{{ section.id }} {
    font-family: 'Lato', system-ui, -apple-system, sans-serif;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__wrapper {
    max-width: var(--max-w);
    margin: 0 auto;
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    padding-left: var(--pl-m);
    padding-right: var(--pr-m);
    box-sizing: border-box;
  }

  @media (min-width: 990px) {
    #fr-new-season-{{ section.id }} .fr-new-season__wrapper {
      padding-top: var(--pt-d);
      padding-bottom: var(--pb-d);
      padding-left: var(--pl-d);
      padding-right: var(--pr-d);
    }
  }

  #fr-new-season-{{ section.id }} .fr-new-season__inner {
    display: flex;
    flex-direction: column;
    gap: 36px;
    align-items: stretch;
  }

  @media (min-width: 990px) {
    #fr-new-season-{{ section.id }} .fr-new-season__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 48px;
    }
  }

  /* Left Column Content */
  #fr-new-season-{{ section.id }} .fr-new-season__content {
    display: flex;
    flex-direction: column;
    align-items: var(--content-align);
    text-align: var(--content-align);
    flex: 0 0 100%;
  }

  @media (min-width: 990px) {
    #fr-new-season-{{ section.id }} .fr-new-season__content {
      flex: 0 0 34%;
      max-width: 440px;
    }
  }

  #fr-new-season-{{ section.id }} .fr-new-season__badge {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 4px;
    font-size: var(--fz-badge-m);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 16px;
    line-height: 1.4;
  }

  @media (min-width: 990px) {
    #fr-new-season-{{ section.id }} .fr-new-season__badge {
      font-size: var(--fz-badge-d);
    }
  }

  #fr-new-season-{{ section.id }} .fr-new-season__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--fz-h-m);
    font-weight: 400;
    line-height: 1.25;
    margin: 0 0 16px 0;
    letter-spacing: 0.01em;
  }

  @media (min-width: 990px) {
    #fr-new-season-{{ section.id }} .fr-new-season__heading {
      font-size: var(--fz-h-d);
      margin-bottom: 20px;
    }
  }

  #fr-new-season-{{ section.id }} .fr-new-season__desc {
    font-size: var(--fz-desc-m);
    line-height: 1.65;
    margin: 0 0 24px 0;
    opacity: 0.9;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__desc p {
    margin: 0 0 10px 0;
  }
  #fr-new-season-{{ section.id }} .fr-new-season__desc p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 990px) {
    #fr-new-season-{{ section.id }} .fr-new-season__desc {
      font-size: var(--fz-desc-d);
      margin-bottom: 28px;
    }
  }

  #fr-new-season-{{ section.id }} .fr-new-season__cta-wrap {
    margin-top: 4px;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    font-size: var(--btn-fz);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: var(--btn-radius);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
  }

  #fr-new-season-{{ section.id }} .fr-new-season__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
    opacity: 0.95;
  }

  /* Right Column Gallery */
  #fr-new-season-{{ section.id }} .fr-new-season__gallery-container {
    flex: 1;
    width: 100%;
    min-width: 0;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-m);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 6px;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__gallery::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 767px) {
    #fr-new-season-{{ section.id }} .fr-new-season__gallery {
      display: flex;
      gap: var(--gap-m);
    }
    #fr-new-season-{{ section.id }} .fr-new-season__card-col {
      flex: 0 0 62%;
      scroll-snap-align: start;
    }
  }

  @media (min-width: 768px) and (max-width: 989px) {
    #fr-new-season-{{ section.id }} .fr-new-season__gallery {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--gap-d);
    }
  }

  @media (min-width: 990px) {
    #fr-new-season-{{ section.id }} .fr-new-season__gallery {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--gap-d);
    }
  }

  #fr-new-season-{{ section.id }} .fr-new-season__card-col {
    position: relative;
    box-sizing: border-box;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__card {
    display: block;
    text-decoration: none;
    color: inherit;
    width: 100%;
    height: 100%;
    border-radius: var(--card-radius);
    overflow: hidden;
    background-color: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
  }

  #fr-new-season-{{ section.id }} .fr-new-season__image-box {
    position: relative;
    width: 100%;
    aspect-ratio: var(--card-ar);
    min-height: var(--card-min-h);
    overflow: hidden;
    background-color: #f2f2f2;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #fr-new-season-{{ section.id }} .fr-new-season__card:hover .fr-new-season__img {
    transform: scale(1.06);
  }

  #fr-new-season-{{ section.id }} .fr-new-season__placeholder {
    width: 100%;
    height: 100%;
    background: #f7f7f7;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__placeholder-inner {
    text-align: center;
    color: #999999;
    font-size: 12px;
    font-weight: 500;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__ph-icon {
    width: 36px;
    height: 36px;
    margin: 0 auto 6px;
    display: block;
    opacity: 0.5;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 12px;
    background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.65) 100%);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__card-sub {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.85;
    margin-bottom: 2px;
  }

  #fr-new-season-{{ section.id }} .fr-new-season__card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 14px;
    font-weight: 400;
    margin: 0;
    color: #ffffff;
    line-height: 1.3;
  }
</style>

