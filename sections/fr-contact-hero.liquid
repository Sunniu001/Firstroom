<section id="fr-contact-hero-{{ section.id }}" class="fr-contact-hero" style="background-color: {{ section.settings.section_bg }};">
  <div
    class="fr-contact__hero-split"
    style="
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    "
  >
    <div class="fr-contact__hero-left">
      {%- if section.settings.heading != blank -%}
        <h1 class="fr-contact__main-title" style="font-size: {{ section.settings.heading_size }}px;">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      <div class="fr-contact__details-list">
        {%- if section.settings.phone != blank -%}
          <p class="fr-contact__detail-line" style="font-size: {{ section.settings.text_size }}px;">
            <span class="fr-contact__detail-label">{{ section.settings.phone_label }}</span>
            <a href="https://wa.me/{{ section.settings.phone | replace: ' ', '' | replace: '+', '' }}" target="_blank" class="fr-contact__detail-link">{{ section.settings.phone }}</a>
          </p>
        {%- endif -%}

        {%- if section.settings.email != blank -%}
          <p class="fr-contact__detail-line" style="font-size: {{ section.settings.text_size }}px;">
            <span class="fr-contact__detail-label">{{ section.settings.email_label }}</span>
            <a href="mailto:{{ section.settings.email }}" class="fr-contact__detail-link">{{ section.settings.email }}</a>
          </p>
        {%- endif -%}
      </div>

      <!-- Social Icons -->
      <div class="fr-contact__social-row">
        {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" class="fr-contact__social-icon" aria-label="Instagram" style="background-color: {{ section.settings.social_icon_bg }};">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_facebook != blank -%}
          <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" class="fr-contact__social-icon" aria-label="Facebook" style="background-color: {{ section.settings.social_icon_bg }};">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_linkedin != blank -%}
          <a href="{{ section.settings.social_linkedin }}" target="_blank" rel="noopener" class="fr-contact__social-icon" aria-label="LinkedIn" style="background-color: {{ section.settings.social_icon_bg }};">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_pinterest != blank -%}
          <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener" class="fr-contact__social-icon" aria-label="Pinterest" style="background-color: {{ section.settings.social_icon_bg }};">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641 0 12.017 0z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_whatsapp != blank -%}
          <a href="{{ section.settings.social_whatsapp }}" target="_blank" rel="noopener" class="fr-contact__social-icon" aria-label="WhatsApp" style="background-color: {{ section.settings.social_icon_bg }};">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="fr-contact__hero-right">
      {%- if section.settings.hero_image != blank -%}
        <img
          src="{{ section.settings.hero_image | image_url: width: 1200 }}"
          alt="{{ section.settings.heading | escape }}"
          class="fr-contact__hero-img"
          loading="eager"
          width="600"
          height="400"
          style="border-radius: {{ section.settings.image_radius }}px;"
        >
      {%- else -%}
        <div class="fr-contact__hero-placeholder" style="border-radius: {{ section.settings.image_radius }}px;"></div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #fr-contact-hero-{{ section.id }} {
    font-family: 'Lato', system-ui, sans-serif;
    line-height: 1.6;
    color: #1a1a1a;
  }

  .fr-contact__hero-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .fr-contact__hero-split {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  .fr-contact__hero-left {
    padding: 60px 40px 60px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .fr-contact__hero-left {
      padding: 40px 20px;
    }
  }

  .fr-contact__main-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    font-style: italic;
    color: #1a1a1a;
    margin: 0 0 24px 0;
    letter-spacing: 0.01em;
  }

  .fr-contact__details-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 20px;
  }

  .fr-contact__detail-line {
    margin: 0;
    font-weight: 400;
    color: #1a1a1a;
  }

  .fr-contact__detail-label {
    font-weight: 700;
    font-size: 0.9em;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-right: 4px;
  }

  .fr-contact__detail-link {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .fr-contact__detail-link:hover {
    color: {{ section.settings.accent_color }};
  }

  .fr-contact__social-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }

  .fr-contact__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #ffffff;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .fr-contact__social-icon:hover {
    transform: translateY(-2px);
    opacity: 0.85;
  }

  .fr-contact__hero-right {
    overflow: hidden;
    min-height: 260px;
  }

  .fr-contact__hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fr-contact__hero-placeholder {
    width: 100%;
    height: 100%;
    min-height: 260px;
    background-color: #f0ebe5;
  }
</style>

{% schema %}
{
  "name": "FR Contact Hero",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Hover Color",
      "default": "#B53939"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Care"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone Label",
      "default": "WHATSAPP:"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone / WhatsApp Number",
      "default": "+91 96507 06644"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Label",
      "default": "EMAIL:"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "support@firstroom.in"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image (right side)"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Image Corner Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 36
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Font Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_linkedin",
      "label": "LinkedIn URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "social_whatsapp",
      "label": "WhatsApp URL"
    },
    {
      "type": "color",
      "id": "social_icon_bg",
      "label": "Social Icon Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Right",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "FR Contact Hero"
    }
  ]
}
{% endschema %}
